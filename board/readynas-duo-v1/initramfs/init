#!/bin/busybox sh
# /init of the 6.18 kernel initramfs (ReadyNAS Duo v1).
# Looks, on USB disks ONLY (the internal SATA disks are never probed), for
# the ext2/3/4 partition holding $ROOTDIR/sbin/init (currently /rootfs-6.18
# on the key), mounts that folder as root and hands over to it. Fallback:
# shell on the console.
# Command line: rootdev=/dev/sdXN (no search), rootdir=/other,
# tests=1 (debugging tests before the search)
/bin/busybox --install -s /bin
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

ROOTDIR=/rootfs-6.18
ROOTDEV=
TESTS=
for a in $(cat /proc/cmdline); do
	case "$a" in
	rootdev=*) ROOTDEV="${a#rootdev=}" ;;
	tests=*) TESTS="${a#tests=}" ;;
	rootdir=*) ROOTDIR="${a#rootdir=}" ;;
	esac
done

t() { cut -d' ' -f1 /proc/uptime; }

# partitions of the disks whose sysfs path goes through USB
candidates() {
	if [ -n "$ROOTDEV" ]; then
		echo "$ROOTDEV"
		return
	fi
	for b in /sys/block/sd*; do
		[ -e "$b" ] || continue
		case "$(readlink -f "$b")" in
		*/usb*) ;;
		*) continue ;;
		esac
		d=${b##*/}
		for p in /sys/block/$d/$d[0-9]*; do
			[ -e "$p" ] && echo "/dev/${p##*/}"
		done
	done
}

find_root() {
	for p in $(candidates); do
		[ -b "$p" ] || continue
		# read-only without replaying the journal: probing writes nothing
		mount -t ext4 -o ro,noload "$p" /mnt 2>/dev/null || continue
		if [ -x "/mnt$ROOTDIR/sbin/init" ]; then
			umount /mnt
			echo "$p"
			return 0
		fi
		umount /mnt
	done
	return 1
}

# hundredths of a second since boot (no fork: read is a shell builtin)
cs() { read u _ < /proc/uptime; echo $(( ${u%.*} * 100 + 1${u#*.} - 100 )); }

# busy wait of $1 seconds, bounded in rounds if /proc/uptime stops moving
busy_wait() {
	end=$(( $(cs) + ${1:-1} * 100 )); i=0
	while [ "$(cs)" -lt "$end" ] && [ $i -lt 200000 ]; do i=$((i + 1)); done
}

state() {
	echo "init [$(t)] $1: $(grep timer /proc/interrupts | tr -s ' ')"
	grep -E '^ *(TIMER|HRTIMER|RCU):' /proc/softirqs 2>/dev/null | tr -s ' ' | sed 's/^/    softirq /'
	sed 's/^/    padre_tick /' /proc/padre_tick 2>/dev/null
}

# tests=1 (command line): debugging tests of the port (emulated FPU,
# register windows, fork/faults/sleep). Not part of the normal boot.
if [ "$TESTS" = 1 ]; then
	# FPU emulation, step-by-step test (load test: only busybox's FLOATING
	# POINT sleep stopped everything). The last "float tN ..." line without
	# OK points at the fatal instruction. The busybox of this initramfs is now
	# built without FLOAT_DURATION (integer sleep): the rest of /init no longer
	# uses floating point.
	echo "init [$(t)] float"
	/bin/float

	# Register windows + sleep (9th test): each must print "windows OK n"
	for f in 1 2 3; do
		echo "init [$(t)] windows $f"
		/bin/windows $f
	done

	# Reproducer (test A): c = fork without sleeper (control), b = sleeper + page
	# faults, a = sleeper + fork, e = sleeper + fork/exec. Each: "load x OK".
	for c in c b a e; do
		echo "init [$(t)] load $c"
		/bin/load $c
	done

	# Does sleeping work? sleep 1 in the background, then a 2 s busy wait.
	state "BEFORE sleep 1"
	echo "init [$(t)] usleep 100000 (nanosleep 0.1 s) ..."
	usleep 100000
	echo "init [$(t)] usleep OK"
	sleep 1 &
	spid=$!
	busy_wait 2
	state "AFTER 2 s of busy wait"
	st=Z
	read _ _ st _ 2>/dev/null < /proc/$spid/stat	# Z (zombie) or missing = done
	if [ "$st" != Z ]; then
		echo "init [$(t)] sleep 1 does not return: sleep is broken, busy wait instead"
		kill $spid 2>/dev/null
		SLEEP=busy_wait
	else
		echo "init [$(t)] sleep 1 returned: sleep works"
		SLEEP=sleep
	fi

fi

# USB key: poll every 0.1 s, 15 s at most (USB enumeration goes on
# meanwhile).
n=0
P=
while [ $n -lt 150 ]; do
	P=$(find_root) && break
	P=
	n=$((n + 1))
	usleep 100000
done

if [ -n "$P" ] && mount -t ext4 -o rw,noatime "$P" /mnt; then
	echo "init [$(t)]: root $P:$ROOTDIR"
	mount --bind "/mnt$ROOTDIR" /newroot
	mount --move /dev /newroot/dev
	umount /proc /sys
	exec switch_root /newroot /sbin/init
fi

echo "init [$(t)]: root not found or cannot be mounted, rescue shell"
echo "       (disks: $(ls /sys/block 2>/dev/null | tr '\n' ' '))"
dmesg | grep -E 'ehci|usb|padre: DMA' | tail -20 | sed 's/^/    /'
exec /bin/sh </dev/console >/dev/console 2>&1
