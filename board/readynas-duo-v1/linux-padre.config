# 6.18 kernel for the ReadyNAS Duo v1 (Infrant IT3107 "Padre")
# Minimal fragment: boots up to the initramfs shell.
# CONFIG_64BIT is not set
CONFIG_SPARC_PADRE=y
# 16 KiB pages (patch linux/0020, the only size offered on Padre)
CONFIG_PAGE_SIZE_16KB=y
# CONFIG_SMP is not set
# CONFIG_PCI is not set
# CONFIG_SBUS is not set
CONFIG_HZ_100=y
CONFIG_CMDLINE_BOOL=y
# usb-storage.delay_use=0: the stick is ready 1 s earlier (no settle delay;
# /init polls for it anyway), see docs/DEVELOPMENT.md "Kernel tuning"
CONFIG_CMDLINE="console=ttyS1,9600 quiet panic=10 padre_sata.dma=1 usb-storage.delay_use=0"
CONFIG_LOCALVERSION="-padre"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# periodic tick: the Padre timer clockevent is periodic-only (time_32.c),
# NO_HZ_IDLE would have no effect
CONFIG_HZ_PERIODIC=y
# CONFIG_NO_HZ_IDLE is not set
# CONFIG_NO_HZ_FULL is not set
# CONFIG_HIGH_RES_TIMERS is not set
CONFIG_LOG_BUF_SHIFT=15
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# -O2: the CPU is the bottleneck of every transfer; 14 % less CPU per MB written
# over SMB, 8 % read, for 1.2 MB more kernel (docs/DEVELOPMENT.md "Kernel tuning")
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_EXPERT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_SUNSU is not set
# CONFIG_SERIAL_SUNZILOG is not set
# CONFIG_SERIAL_SUNSAB is not set
# CONFIG_SERIAL_GRLIB_GAISLER_APBUART is not set
CONFIG_SERIAL_PADRE=y
CONFIG_SERIAL_PADRE_CONSOLE=y
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_FB is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_SUN_OPENPROMIO is not set
# CONFIG_OBP_FLASH is not set
# CONFIG_TADPOLE_TS102_UCTRL is not set
# CONFIG_SUN_OPENPROMFS is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_PRINTK=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=0
# CONFIG_DEBUG_BUGVERBOSE is not set
CONFIG_DEBUG_INFO_NONE=y
