# Padre kernel additions for the NAS: network, disks, ksmbd, nfsd
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=y
# DS1337 hardware clock: /dev/rtc0, time restored at boot, written back after NTP sync
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_INTF_DEV=y
CONFIG_PADRE_RTC=y
CONFIG_PADRE_LED=y
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH="/sbin/hotplug"
CONFIG_PADRE_HWMON=y
CONFIG_PADRE_GMAC=y
CONFIG_ATA=y
# CONFIG_SATA_PMP is not set
# CONFIG_ATA_BMDMA is not set
CONFIG_ATA_SFF=y
CONFIG_PADRE_SATA=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID1=y
CONFIG_MD_AUTODETECT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_SMB_SERVER=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFSD=y
CONFIG_NFSD_V4=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FUTEX=y
CONFIG_KEYS=y
# Root on the USB key (VIA EHCI on the Padre PCI bus)
CONFIG_PCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
# CONFIG_USB_UHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
CONFIG_USB_STORAGE=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_COMPRESSION_XZ=y
CONFIG_INITRAMFS_SOURCE="usr/padre-initramfs.list"
# Size (iboot loads a raw, uncompressed kernel)
# CONFIG_IO_URING is not set
# CONFIG_WIRELESS is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_FW_LOADER is not set
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# SATA disk temperature (SCT/SMART) in /sys/class/hwmon: fan control
# (rootfs-overlay/usr/sbin/padre-fan)
CONFIG_HWMON=y
CONFIG_SENSORS_DRIVETEMP=y
# X-RAID ext3 with 16 KiB blocks (RAIDiator/DIET): mounted by ext4 thanks
# to the 16 KiB pages (patch linux/0003); LVM of /c through dm
CONFIG_BLK_DEV_DM=y
