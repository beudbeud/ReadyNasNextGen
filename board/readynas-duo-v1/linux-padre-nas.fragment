# Padre kernel additions for the NAS: network, disks, ksmbd, nfsd
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=y
# DS1337 hardware clock: /dev/rtc0, time restored at boot, written back after NTP sync
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_INTF_DEV=y
CONFIG_PADRE_RTC=y
CONFIG_PADRE_LED=y
# Button and link events go through uevent_helper (padre_hwmon, padre_gmac):
# kept, but empty at boot; S95diet sets /sbin/hotplug once the system is up
# (otherwise every uevent of the boot forks a shell, 60 ms each)
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_PADRE_HWMON=y
CONFIG_PADRE_GMAC=y
CONFIG_ATA=y
# CONFIG_SATA_PMP is not set
# CONFIG_ATA_BMDMA is not set
CONFIG_ATA_SFF=y
CONFIG_PADRE_SATA=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID1=y
CONFIG_MD_AUTODETECT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_SMB_SERVER=y
# SMB 3 signing is cmac(aes): one function per update, 4 KiB of tables,
# instead of cmac(aes-generic) (patches/linux/0024)
CONFIG_CRYPTO_CMAC_AES_SPARC32=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFSD=y
CONFIG_NFSD_V4=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FUTEX=y
CONFIG_KEYS=y
# Root on the USB key (VIA EHCI on the Padre PCI bus)
CONFIG_PCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
# CONFIG_USB_UHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
CONFIG_USB_STORAGE=y
CONFIG_EXT4_USE_FOR_EXT2=y
# Built-in initramfs in gzip: unpacked in 0.6 s on the Padre against 2.2 s in xz,
# /init starts 0.9 s earlier (docs/DEVELOPMENT.md "Kernel tuning")
CONFIG_RD_GZIP=y
# CONFIG_RD_XZ is not set
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_INITRAMFS_SOURCE="usr/padre-initramfs.list"
# Size (iboot loads a raw, uncompressed kernel)
# CONFIG_IO_URING is not set
# WLAN (the wireless drivers menu) selects WIRELESS: both must be off
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BLK_DEV_BSG is not set
# Not used on this NAS: slab debugging, kyber scheduler (mq-deadline is the
# one in use), ksmbd Kerberos (no KDC), PTP/PPS clocks, PCIe ASPM, VGA arbiter
# CONFIG_SLUB_DEBUG is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_SMB_SERVER_KERBEROS5 is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_PPS is not set
# CONFIG_PCIEASPM is not set
# CONFIG_VGA_ARB is not set
# CONFIG_FW_LOADER is not set
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# SATA disk temperature (SCT/SMART) in /sys/class/hwmon: fan control
# (rootfs-overlay/usr/sbin/padre-fan)
CONFIG_HWMON=y
CONFIG_SENSORS_DRIVETEMP=y
# X-RAID ext3 with 16 KiB blocks (RAIDiator/DIET): mounted by ext4 thanks
# to the 16 KiB pages (patch linux/0020); LVM of /c through dm
CONFIG_BLK_DEV_DM=y
# NAND flash backup (padre_nand, patches-shelved/linux/) shelved: not built, see
# docs/DEVELOPMENT.md "NAND flash" (reading it while the system runs from the USB
# stick loses the stick)
