#!/bin/sh
# Kernel NFS server (nfs-utils). Replaces the Buildroot script so that it does
# not start when SVC_NFS=0 in /etc/diet.conf (stopped from the DIET interface),
# and so that "stop" really stops nfsd: its threads are kernel threads, which
# killall cannot reach; "rpc.nfsd 0" stops them. rpcbind (S30rpcbind) starts
# and stops with NFS.
# /etc/exports stays editable while NFS is stopped; it is read again at start.
NR_THREADS=2
# Largest NFS read/write per RPC. The kernel default for 256 MB of RAM is 32 KiB;
# 1 MiB means fewer requests for the same data. Measured 2026-11-19 (NFSv3, 500 MiB,
# Wi-Fi PC): writes 4.2 -> 5.0 MiB/s, 0.24 -> 0.19 CPU s/MiB; reads unchanged.
# Only settable while no nfsd thread runs (start runs after stop).
MAX_BLOCK=1048576
[ -r /etc/default/nfsd ] && . /etc/default/nfsd

start() {
	grep -qs '^SVC_NFS=0' /etc/diet.conf && { echo "nfs: disabled (/etc/diet.conf)"; return 0; }
	/etc/init.d/S30rpcbind start >/dev/null 2>&1	# idempotent; needed by NFS only
	mkdir -p /var/lock/subsys /var/run/nfs/sm /var/run/nfs/sm.bak
	touch /var/run/nfs/rmtab
	# rpc.nfsd mounts the nfsd file system itself, too late for max_block_size: mount it first
	grep -qs " /proc/fs/nfsd " /proc/mounts || mount -t nfsd nfsd /proc/fs/nfsd 2>/dev/null
	[ -w /proc/fs/nfsd/max_block_size ] && echo "$MAX_BLOCK" > /proc/fs/nfsd/max_block_size 2>/dev/null
	printf "Starting NFS statd: "
	rpc.statd && echo OK || echo FAIL
	printf "Starting NFS services: "
	exportfs -r && echo OK || echo FAIL
	printf "Starting NFS daemon: "
	rpc.nfsd "$NR_THREADS" && echo OK || echo FAIL
	printf "Starting NFS mountd: "
	rpc.mountd && echo OK || echo FAIL
	touch /var/lock/subsys/nfs
}

stop() {
	printf "Stopping NFS mountd: "
	killall -q rpc.mountd; echo OK
	printf "Stopping NFS daemon: "
	rpc.nfsd 0 && echo OK || echo FAIL
	printf "Unexporting: "
	exportfs -au && echo OK || echo FAIL
	printf "Stopping NFS statd: "
	killall -q rpc.statd; echo OK
	rm -f /var/lock/subsys/nfs /var/run/rpc.statd.pid
	/etc/init.d/S30rpcbind stop >/dev/null 2>&1
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	reload) grep -qs '^SVC_NFS=0' /etc/diet.conf || exportfs -r ;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
exit 0
