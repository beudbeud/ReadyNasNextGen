#!/bin/sh
# Time at boot, right after the network (S40network) and before the services.
# The kernel already set the system time from the DS1337 hardware clock
# (RTC_HCTOSYS); here a short NTP sync (15 s at most; ntpd is then kept
# running by S95diet), and the hardware clock is updated if it succeeded.
SERVER=pool.ntp.org

case "$1" in
start)
	printf "Setting the time: "
	ntpd -n -q -p $SERVER >/dev/null 2>&1 &
	p=$! i=0
	while kill -0 $p 2>/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done
	if kill -0 $p 2>/dev/null; then
		kill $p; echo "no NTP answer, hardware clock time $(date '+%F %T')"
	elif wait $p; then
		hwclock -w -u 2>/dev/null; echo "$(date '+%F %T') (NTP, hardware clock updated)"
	else
		echo "NTP failed, hardware clock time $(date '+%F %T')"
	fi
	;;
stop)
	;;
restart)
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"; exit 1
	;;
esac
