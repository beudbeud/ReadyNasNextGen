#!/bin/sh
# rpcbind, only needed by the NFS server. Replaces the Buildroot script so that
# it does not start when NFS is off (SVC_NFS=0 in /etc/diet.conf, the default);
# S60nfs starts and stops it together with NFS.
start() {
	grep -qs '^SVC_NFS=0' /etc/diet.conf && return 0
	printf "Starting rpcbind: "
	umask 077
	start-stop-daemon -S -q -p /var/run/rpcbind.pid --exec /usr/sbin/rpcbind
	echo "OK"
}
stop() {
	printf "Stopping rpcbind: "
	start-stop-daemon -K -q -p /var/run/rpcbind.pid
	echo "OK"
}
case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
