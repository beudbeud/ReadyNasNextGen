#!/bin/sh
# Starts ksmbd (in-kernel SMB server) with ksmbd-tools.
case "$1" in
start)
	mkdir -p /c /var/run
	printf "Starting ksmbd: "
	ksmbd.mountd && echo OK || echo FAIL
	;;
stop)
	ksmbd.control -s
	;;
restart)
	"$0" stop; "$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"; exit 1
	;;
esac
