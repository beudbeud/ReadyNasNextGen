#!/bin/sh
# rsync daemon (see /etc/rsyncd.conf; access denied until /etc/rsyncd.secrets exists).
# Does not start when SVC_RSYNC=0 in /etc/diet.conf (stopped from the DIET interface).
case "$1" in
	start)
		grep -qs '^SVC_RSYNC=0' /etc/diet.conf && { echo "rsyncd: disabled (/etc/diet.conf)"; exit 0; }
		printf "Starting rsyncd: "
		start-stop-daemon -S -q -p /var/run/rsyncd.pid -x /usr/bin/rsync -- --daemon \
			&& echo OK || echo FAIL ;;
	stop)
		printf "Stopping rsyncd: "
		start-stop-daemon -K -q -p /var/run/rsyncd.pid && echo OK || echo FAIL
		rm -f /var/run/rsyncd.pid ;;
	restart|reload) "$0" stop; sleep 1; "$0" start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
