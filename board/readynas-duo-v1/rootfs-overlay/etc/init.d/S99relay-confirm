#!/bin/sh
# Linux 6.18 side of the relay (board/readynas-duo-v1/relay/).
# The boot is complete: remove the marker written by relay-switch, so that
# the next power-on hands over to 6.18 again. While the marker is still
# there, relay-switch starts DIET instead (6.18 failed or was cut off).
# The marker lives in the 6.18 root itself (rootfs-6.18 on the USB stick):
# nothing is written to the RAIDiator system volume.
#   touch /.relay_skip_once   -> the next power-on starts DIET once
case "$1" in
start) rm -f /.relay_pending ;;
esac
exit 0
