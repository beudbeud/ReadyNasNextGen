#!/bin/sh
# avahi-daemon (mDNS/DNS-SD: <name>.local and /etc/avahi/services). Replaces
# the Buildroot script so that it does not start when SVC_AVAHI=0 in
# /etc/diet.conf (stopped from the DIET interface).
DAEMON=/usr/sbin/avahi-daemon
case "$1" in
	start)
		grep -qs '^SVC_AVAHI=0' /etc/diet.conf && { echo "avahi-daemon: disabled (/etc/diet.conf)"; exit 0; }
		$DAEMON -c || $DAEMON -D ;;
	stop) $DAEMON -c && $DAEMON -k ;;
	reload) $DAEMON -c && $DAEMON -r ;;
	restart) "$0" stop; sleep 1; "$0" start ;;
	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
