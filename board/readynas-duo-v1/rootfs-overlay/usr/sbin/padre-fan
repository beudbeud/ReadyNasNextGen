#!/bin/sh
# Fan control for the ReadyNAS Duo v1 under Linux 6.18 (padre_hwmon).
# Curve taken from diet-hwmon (DIET): the Duo has no LM75 (temp_0 = 0), the
# temperature comes from the SATA disks, read by the drivetemp kernel driver
# (/sys/class/hwmon/hwmonN/temp1_input, millidegrees). The setpoint is written
# on every round: padre_hwmon goes back to full speed after 5 min without one.
. /etc/fan.conf
H=/proc/sys/dev/hwmon
HOT=0

disks() {	# hottest disk temperature (°C), 0 if unknown
	max=0
	for d in /sys/class/hwmon/hwmon*; do
		[ "$(cat $d/name 2>/dev/null)" = drivetemp ] || continue
		t=$(cat $d/temp1_input 2>/dev/null) || continue
		t=$((t / 1000))
		[ $t -gt $max ] && max=$t
	done
	echo $max
}

while true; do
	T=$(cut -d. -f1 $H/temp_0 2>/dev/null); T=${T:-0}
	DT=$(disks)
	[ "$T" -eq 0 ] && T=$DT
	if [ "$T" -eq 0 ]; then
		P=$FAN_PWM_MAX			# no temperature at all: play safe
	elif [ $T -le $TEMP_LOW ]; then
		P=$FAN_PWM_MIN
	elif [ $T -ge $TEMP_HIGH ]; then
		P=$FAN_PWM_MAX
	else
		P=$(( FAN_PWM_MIN + (T - TEMP_LOW) * (FAN_PWM_MAX - FAN_PWM_MIN) / (TEMP_HIGH - TEMP_LOW) ))
	fi
	[ $DT -ge $DISK_HIGH ] && P=$FAN_PWM_MAX
	echo $P > $H/fan0_speed_control
	[ -e $H/fan1_speed_control ] && echo $P > $H/fan1_speed_control
	if [ $DT -ge $DISK_CRIT ]; then
		HOT=$((HOT + 1))
		logger -t padre-fan "disks OVERHEATING ${DT}C ($HOT)"
		if [ $HOT -ge 2 ]; then
			logger -t padre-fan "emergency shutdown"
			poweroff
		fi
	else
		HOT=0
	fi
	echo "temp=$T disks=$DT fan=$(cat $H/fan_0 2>/dev/null) pwm=$P" > /var/run/fan.state
	sleep $PERIOD
done
