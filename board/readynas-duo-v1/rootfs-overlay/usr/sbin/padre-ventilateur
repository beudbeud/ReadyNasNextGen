#!/bin/sh
# Régulation du ventilateur du ReadyNAS Duo v1 sous Linux 6.18 (padre_hwmon).
# Courbe de diet-hwmon (DIET) : le Duo n'a pas de LM75 (temp_0 = 0), la
# température vient des disques SATA, lue par le pilote noyau drivetemp
# (/sys/class/hwmon/hwmonN/temp1_input, millidegrés). Consigne écrite à chaque
# tour : padre_hwmon repasse à plein régime s'il ne reçoit rien pendant 5 min.
. /etc/ventilateur.conf
H=/proc/sys/dev/hwmon
HOT=0

disques() {	# température max des disques (°C), 0 si inconnue
	max=0
	for d in /sys/class/hwmon/hwmon*; do
		[ "$(cat $d/name 2>/dev/null)" = drivetemp ] || continue
		t=$(cat $d/temp1_input 2>/dev/null) || continue
		t=$((t / 1000))
		[ $t -gt $max ] && max=$t
	done
	echo $max
}

while true; do
	T=$(cut -d. -f1 $H/temp_0 2>/dev/null); T=${T:-0}
	DT=$(disques)
	[ "$T" -eq 0 ] && T=$DT
	if [ "$T" -eq 0 ]; then
		P=$FAN_PWM_MAX			# aucune température : prudence
	elif [ $T -le $TEMP_LOW ]; then
		P=$FAN_PWM_MIN
	elif [ $T -ge $TEMP_HIGH ]; then
		P=$FAN_PWM_MAX
	else
		P=$(( FAN_PWM_MIN + (T - TEMP_LOW) * (FAN_PWM_MAX - FAN_PWM_MIN) / (TEMP_HIGH - TEMP_LOW) ))
	fi
	[ $DT -ge $DISK_HIGH ] && P=$FAN_PWM_MAX
	echo $P > $H/fan0_speed_control
	[ -e $H/fan1_speed_control ] && echo $P > $H/fan1_speed_control
	if [ $DT -ge $DISK_CRIT ]; then
		HOT=$((HOT + 1))
		logger -t ventilateur "SURCHAUFFE disques ${DT}C ($HOT)"
		if [ $HOT -ge 2 ]; then
			logger -t ventilateur "arrêt d'urgence"
			poweroff
		fi
	else
		HOT=0
	fi
	echo "temp=$T disques=$DT fan=$(cat $H/fan_0 2>/dev/null) pwm=$P" > /var/run/ventilateur.etat
	sleep $PERIODE
done
