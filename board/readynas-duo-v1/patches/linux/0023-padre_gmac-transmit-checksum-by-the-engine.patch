+/* Any change of the transmit checksum starts from an engine that was just
+ * reset: the way back in particular must not rely on the engine obeying a
+ * command (on the NAS, its state once was the opposite of the commands).
+ */
+static int gm_set_features(struct net_device *dev, netdev_features_t f)
+{
+	bool on = f & NETIF_F_IP_CSUM;
