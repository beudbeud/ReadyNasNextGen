+static void reset_task(struct work_struct *unused)
+{
+	if (!rtnl_trylock()) {		/* gm_close waits for us with the lock held */
+		schedule_delayed_work(&reset_work, HZ / 10);
+		return;
+	}
+	if (netif_running(gdev)) {
+		netdev_warn(gdev, "%s, resetting (ctrl=%08x gmt=%08x tx=%u/%u)\n",
+			    gfault ?: "transmit fault", GM_get(G_CTRL), DJ_get(GMT0_STAT),
+			    tx_tail, tx_head);
+		hw_restart(gdev, false);
+	}
+	if (gdev->features & NETIF_F_IP_CSUM) {
+		netdev_err(gdev, "transmit checksum by the engine turned off, back to software checksums\n");
+		tx_fallback++;
+		gdev->wanted_features &= ~(NETIF_F_IP_CSUM | NETIF_F_SG);
+		netdev_update_features(gdev);
+	}
+	gfault = NULL;
+	rtnl_unlock();
 }
 
