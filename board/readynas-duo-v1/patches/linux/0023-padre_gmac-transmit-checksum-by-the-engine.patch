-	d = txd[tx_head];
-	txs[tx_head] = skb;
-	d->buf = PA(a);
-	d->stat = 0;
-	d->ctl = D_OWN | D_SOP | D_EOP | D_INTR0 | skb->len;
-	tx_head = (tx_head + 1) & RMASK;
-	if (!tx_free())
+	if (need >= 0 && need != meta_cur) {	/* nothing may fail from here on */
+		meta = meta_cur << 8 | need;
+		meta_cur = need;
+		tx_meta++;
+	}
+	if (need > 0)
+		tx_csum_hw++;
+	tx_put(skb, meta);
+	if (tx_free() < TX_ROOM)
 		netif_stop_queue(dev);
