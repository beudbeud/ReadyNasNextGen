+/* ---------- tx_csum_verify: what the engine does, seen in MAC loopback ----------
+ *
+ * echo 1 > /sys/module/padre_gmac/parameters/tx_csum_verify (link up; the
+ * network stops for a few seconds). Frames to ourselves go through the same
+ * tx_put as the real ones, with the commands of the table below, and come
+ * back through the receive ring: U = checksum field untouched (engine off),
+ * S = summed (field = complete checksum), X = something else, L = lost.
+ * The field is sent as the stack leaves it for an offload (pseudo-header
+ * sum; 0 for ICMP). Nothing of this can be seen on real frames: the engine
+ * inserts the sum on the way out, the buffer and the descriptor keep no
+ * trace of it; for those, capture on the peer (docs/DEVELOPMENT.md).
+ */
+enum { VT_UDP, VT_TCP, VT_ICMP, VT_ARP, VT_OPT, VT_FRAG };
+
+/* the sequences of the 2.6.17 driver: resting state c0, 00 for one frame */
+static const struct vt_step {
+	u8 kind, reset;
+	int meta;
+	u16 pay;
+	char want;
+	const char *what;
+} vt_steps[] = {
+	{ VT_TCP,  1, -1,     100,  'U', "reset, no command" },
+	{ VT_TCP,  0, 0x00c0, 100,  'S', "command 00->c0" },
+	{ VT_TCP,  0, -1,     100,  'S', "no command, still on" },
+	{ VT_TCP,  0, -1,     1460, 'S', "TCP, full frame" },
+	{ VT_TCP,  0, -1,     101,  'S', "TCP, odd length" },
+	{ VT_TCP,  0, -1,     0,    'S', "TCP without data" },
+	{ VT_ARP,  0, -1,     28,   'U', "not IPv4 (ARP type)" },
+	{ VT_ICMP, 0, 0xc000, 56,   'U', "command c0->00, ICMP" },
+	{ VT_UDP,  0, -1,     100,  'U', "UDP, engine off" },
+	{ VT_TCP,  0, 0x00c0, 100,  'S', "command 00->c0 again" },
+	{ VT_TCP,  0, 0xc080, 100,  'U', "command c0->80" },
+	{ VT_TCP,  0, 0x80c0, 100,  'S', "command 80->c0" },
+	{ VT_TCP,  1, -1,     100,  'U', "reset from on" },
+	{ VT_TCP,  0, 0x00c0, 100,  'S', "command 00->c0 after reset" },
+	{ VT_TCP,  0, 0xc000, 100,  'U', "command c0->00" },
+	{ VT_TCP,  0, 0x0040, 100,  'S', "command 00->40" },
+	{ VT_TCP,  0, 0x40c0, 100,  'S', "command 40->c0" },
+	{ VT_TCP,  0, 0xc000, 100,  'U', "command c0->00, last" },
+};
+#define VT_ALT	40		/* then 00->c0 (S), c0->00 (U), alternately */
+
+/* *off: offset of the checksum field (0: none), *full: the complete checksum */
+static struct sk_buff *vt_frame(struct net_device *dev, const struct vt_step *s,
+				unsigned int *off, __sum16 *full)
+{
+	bool tcp = s->kind == VT_TCP;
+	unsigned int ihl = s->kind == VT_OPT ? 24 : 20, l4 = (tcp ? 20 : 8) + s->pay, i;
+	u8 proto = tcp ? IPPROTO_TCP : s->kind == VT_ICMP ? IPPROTO_ICMP : IPPROTO_UDP;
+	struct sk_buff *skb = alloc_skb(NET_IP_ALIGN + ETH_HLEN + ihl + l4, GFP_KERNEL);
+	__sum16 seed = 0;
+	struct iphdr *iph;
+	u8 *p, *h;
+
+	if (!skb)
+		return NULL;
+	skb_reserve(skb, NET_IP_ALIGN);
+	p = skb_put_zero(skb, ETH_HLEN + ihl + l4);
+	iph = (struct iphdr *)(p + ETH_HLEN);
+	h = p + ETH_HLEN + ihl;
+	memcpy(p, dev->dev_addr, ETH_ALEN);
+	memcpy(p + ETH_ALEN, dev->dev_addr, ETH_ALEN);
+	p[12] = 0x08;				/* ETH_P_IP, ETH_P_ARP */
+	for (i = 0; i < l4; i++)
+		h[i] = i * 7 + s->kind;
+	if (s->kind == VT_ARP) {
+		p[13] = 0x06;
+		return skb;
+	}
+	if (tcp) {
+		h[12] = 0x50;			/* header of 20 bytes, ACK */
+		h[13] = 0x10;
+	} else if (proto == IPPROTO_UDP) {
+		h[4] = l4 >> 8;
+		h[5] = l4;
+	} else {
+		h[0] = 8;			/* echo request */
+		h[1] = 0;
+	}
+	iph->version = 4;
+	iph->ihl = ihl / 4;
+	iph->tot_len = htons(ihl + l4);
+	iph->frag_off = htons(s->kind == VT_FRAG ? IP_MF : IP_DF);
+	iph->ttl = 64;
+	iph->protocol = proto;
+	iph->saddr = htonl(0xc0000201);		/* 192.0.2.1 -> .2 (TEST-NET-1) */
+	iph->daddr = htonl(0xc0000202);
+	iph->check = ip_fast_csum(iph, iph->ihl);
+	if (proto != IPPROTO_ICMP)
+		seed = ~csum_tcpudp_magic(iph->saddr, iph->daddr, l4, proto, 0);
+	*off = ETH_HLEN + ihl + (tcp ? 16 : proto == IPPROTO_UDP ? 6 : 2);
+	memcpy(p + *off, &seed, 2);
+	*full = csum_fold(csum_partial(h, l4, 0));
+	return skb;
+}
+
+static char vt_step(struct net_device *dev, const struct vt_step *s, unsigned int n)
+{
+	unsigned int off = 0, len;
+	__sum16 full = 0, sent = 0, got = 0;
+	struct sk_buff *skb, *b;
+	char r = 'L';
+	u8 *ref;
+
+	skb = vt_frame(dev, s, &off, &full);
+	if (!skb)
+		return '?';
+	len = skb->len;
+	ref = kmemdup(skb->data, len, GFP_KERNEL);
+	if (!ref) {
+		kfree_skb(skb);
+		return '?';
+	}
+	local_bh_disable();
+	kfree_skb(vt_back);			/* a late one */
+	vt_back = NULL;
+	reinit_completion(&vt_done);
+	spin_lock(&glock);
+	tx_put(skb, s->meta);			/* freed by tx_clean */
+	spin_unlock(&glock);
+	local_bh_enable();
+	wait_for_completion_timeout(&vt_done, HZ / 5);
+	local_bh_disable();
+	b = vt_back;
+	vt_back = NULL;
+	local_bh_enable();
+	if (b && b->len >= len) {
+		if (off) {
+			memcpy(&sent, ref + off, 2);
+			memcpy(&got, b->data + off, 2);
+			memcpy(b->data + off, &sent, 2);
+		}
+		r = memcmp(b->data, ref, len) ? 'X' : got == sent ? 'U' : got == full ? 'S' : 'X';
+	}
+	if (n < ARRAY_SIZE(vt_steps) || r != s->want)
+		netdev_info(dev, "tx_csum_verify %2u %-26s: %c (sent %04x got %04x full %04x, rx %02x, gmt %08x)\n",
+		    n, s->what, r, ntohs(sent), ntohs(got), ntohs(full),
+		    b ? (vt_ctl >> 17) & 0x3f : 0, DJ_get(GMT0_STAT));
+	kfree_skb(b);
+	kfree(ref);
+	return r;
+}
+
+static int vt_run(struct net_device *dev)
+{
+	static const struct vt_step on = { VT_TCP, 0, 0x00c0, 100, 'S', "alternation 00->c0" },
+				    off = { VT_TCP, 0, 0xc000, 100, 'U', "alternation c0->00" };
+	char r[ARRAY_SIZE(vt_steps) + 1] = "", alt[VT_ALT + 1] = "";
+	unsigned int i, bad = 0;
+	bool ok = true;
+
+	netdev_info(dev, "tx_csum_verify: MAC loopback, the network stops for a few seconds\n");
+	netif_device_detach(dev);
+	gtest = 1;
+	for (i = 0; i < ARRAY_SIZE(vt_steps); i++) {
+		if (vt_steps[i].reset)
+			hw_restart(dev, true);
+		r[i] = vt_step(dev, &vt_steps[i], i);
+		if (i < 2 && r[i] == 'L')
+			break;
+		ok &= r[i] == vt_steps[i].want;
+	}
+	for (i = 0; ok && i < VT_ALT; i++) {
+		const struct vt_step *s = i & 1 ? &off : &on;
+
+		alt[i] = vt_step(dev, s, ARRAY_SIZE(vt_steps) + i);
+		bad += alt[i] != s->want;
+	}
+	gtest = 0;
+	hw_restart(dev, false);
+	netif_device_attach(dev);
+	if (strchr(r, 'L') && strlen(r) <= 2) {
+		netdev_err(dev, "tx_csum_verify: %s, nothing comes back: no MAC loopback here, capture on the peer instead\n", r);
+		return -ENODATA;
+	}
+	ok &= alt[0] && !bad;
+	netdev_info(dev, "tx_csum_verify: %s %s: engine %s (%u of %u alternations wrong)\n",
+		    r, alt, ok ? "as the driver expects" : "NOT as the driver expects",
+		    bad, VT_ALT);
+	return ok ? 0 : -EIO;
+}
+
+static int vt_set(const char *val, const struct kernel_param *kp)
+{
+	int r = -ENETDOWN;
+
+	if (!gdev)			/* on the command line: too early */
+		return r;
+	rtnl_lock();
+	if (netif_running(gdev) && glink)
+		r = vt_run(gdev);
+	rtnl_unlock();
+	return r;
+}
+
+static const struct kernel_param_ops vt_ops = { .set = vt_set };
+module_param_cb(tx_csum_verify, &vt_ops, NULL, 0200);
+
+/* tx_csum: the feature without an ethtool binary (serial console) */
+static int tc_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+	int r = kstrtobool(val, &on);
+
+	if (r)
+		return r;
+	if (!gdev) {			/* on the command line: gm_init reads it */
+		eng_ok = on;
+		return 0;
+	}
+	rtnl_lock();
+	if (on)
+		gdev->wanted_features |= NETIF_F_IP_CSUM;
+	else
+		gdev->wanted_features &= ~(NETIF_F_IP_CSUM | NETIF_F_SG);
+	netdev_update_features(gdev);	/* gm_set_features */
+	rtnl_unlock();
+	return 0;
+}
+
+static const struct kernel_param_ops tc_ops = { .set = tc_set, .get = param_get_bool };
+module_param_cb(tx_csum, &tc_ops, &eng_ok, 0644);
+
+/* sg: scatter-gather without an ethtool binary; needs tx_csum (the stack
+ * drops it otherwise), turned off with it. Read back: the device features.
+ */
+static int sg_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+	int r = kstrtobool(val, &on);
+
+	if (r || !gdev)
+		return r ?: -ENODEV;
+	rtnl_lock();
+	if (on)
+		gdev->wanted_features |= NETIF_F_SG;
+	else
+		gdev->wanted_features &= ~NETIF_F_SG;
+	netdev_update_features(gdev);
+	rtnl_unlock();
+	return 0;
+}
+
+static int sg_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%c\n", gdev && (gdev->features & NETIF_F_SG) ? 'Y' : 'N');
+}
+
+static const struct kernel_param_ops sg_ops = { .set = sg_set, .get = sg_get };
+module_param_cb(sg, &sg_ops, NULL, 0644);
