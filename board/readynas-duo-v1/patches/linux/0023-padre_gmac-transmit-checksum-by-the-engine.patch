-static netdev_tx_t gm_xmit(struct sk_buff *skb, struct net_device *dev)
+/* The transmit side cannot be trusted any more: no command to the engine
+ * from now on, and reset_task puts it back in its reset state.
+ */
+static void gm_fault(const char *why)
+{
+	WRITE_ONCE(eng_ok, false);
+	if (!gfault)
+		gfault = why;
+	schedule_delayed_work(&reset_work, 0);
+}
+
+static void tx_fill(unsigned int i, u32 buf, u32 ctl)
 {
+	volatile struct m4d *d = txd[i];
+
+	if (unlikely(d->ctl & D_OWN))
+		gm_fault("transmit descriptor still owned by the engine");
+	d->buf = buf;
+	d->stat = 0;
+	d->ctl = D_OWN | ctl;		/* ownership last */
+}
+
+/* Queue a frame the way the 2.6.17 driver does (GMAC description §5.3);
+ * glock held, TX_ROOM descriptors free. meta >= 0: first a command
+ * descriptor, two bytes {old command, new command}, no interrupt, handed to
+ * the engine at once. Then one descriptor per buffer; the first one of the
+ * frame is handed over last.
+ */
+static void tx_put(struct sk_buff *skb, int meta)
+{
+	unsigned int i = tx_head, first, f, n = skb_shinfo(skb)->nr_frags;
 	unsigned long a = (unsigned long)skb->data;
-	volatile struct m4d *d;
 
-	if (skb->len > RXBUF) {
-		dev->stats.tx_dropped++;
-		dev_kfree_skb_any(skb);
-		return NETDEV_TX_OK;
+	if (meta >= 0) {
+		volatile u8 *m = meta_ddr ? meta_ram + i * 16 : (volatile u8 *)(META_SRAM + i * 16);
+
+		m[0] = meta >> 8;
+		m[1] = meta;
+		if (meta_ddr)
+			padre_clean_dcache_range((unsigned long)m, (unsigned long)m + 16);
+		tx_fill(i, PA(m), D_META | 2);
+		i = (i + 1) & RMASK;
+	}
+	first = i;
+	padre_clean_dcache_range(a, a + skb_headlen(skb));	/* the DMA reads memory */
+	for (f = 0; f < n; f++) {
+		const skb_frag_t *fr = &skb_shinfo(skb)->frags[f];
+		unsigned long fa = (unsigned long)skb_frag_address(fr);
+
+		padre_clean_dcache_range(fa, fa + skb_frag_size(fr));
+		i = (i + 1) & RMASK;
+		tx_fill(i, PA(fa), D_INTR0 | (f == n - 1 ? D_EOP : 0) | skb_frag_size(fr));
+	}
+	txs[i] = skb;
+	tx_fill(first, PA(a), D_SOP | D_INTR0 | (n ? 0 : D_EOP) | skb_headlen(skb));
+	tx_head = (i + 1) & RMASK;
+	if (M4_get(M_TX_CTRL) & 2)
+		M4_set(M_TX_CTRL, 1);	/* restart a stopped channel */
+}
+
+/* A frame the engine is known to sum like the stack expects: TCP or UDP over
+ * IPv4 without options, not a fragment. The engine finds the checksum field
+ * by itself and sums the whole L4 part, field included (seen on the NAS: it
+ * zeroes a checksum that was already complete).
+ */
+static bool tx_hw_ok(const struct sk_buff *skb)
+{
+	const struct iphdr *iph = (const struct iphdr *)(skb->data + ETH_HLEN);
+
+	return skb->protocol == htons(ETH_P_IP) &&
+	       skb_headlen(skb) >= ETH_HLEN + sizeof(*iph) + sizeof(struct udphdr) &&
+	       iph->ihl == 5 && !ip_is_fragment(iph) &&
+	       iph->protocol == IPPROTO_TCP &&	/* the engine sums UDP wrong */
+	       skb_checksum_start_offset(skb) == ETH_HLEN + sizeof(*iph);
+}
+
+/* the engine wants a buffer of less than 8 bytes on an 8-byte boundary */
+static bool tx_sg_ok(const struct sk_buff *skb)
+{
+	int f;
+
+	if (skb_headlen(skb) < 8)
+		return false;
+	for (f = 0; f < skb_shinfo(skb)->nr_frags; f++) {
+		const skb_frag_t *fr = &skb_shinfo(skb)->frags[f];
+
+		if (!skb_frag_size(fr) ||
+		    (skb_frag_size(fr) < 8 && ((unsigned long)skb_frag_address(fr) & 7)))
+			return false;
+	}
+	return true;
+}
+
+static netdev_tx_t gm_xmit(struct sk_buff *skb, struct net_device *dev)
+{
