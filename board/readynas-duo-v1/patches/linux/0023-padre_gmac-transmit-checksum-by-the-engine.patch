-		M4_set(M_TX_CTRL, 1);	/* restart a stopped channel */
 	netif_trans_update(dev);
 	spin_unlock(&glock);
 	return NETDEV_TX_OK;
+drop:
+	dev->stats.tx_dropped++;
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
 }
 
 /* ---------- events for /etc/hotplug/gmac.agent (like 2.6.17) ---------- */
@@ -714,6 +894,45 @@ static void hotplug(const char *action, int up, int speed)
 
 /* ---------- link (88E1111 polled every second) ---------- */
 
+/* Every second while the engine sums: back to software checksums when
+ * transmission looks wrong. Nothing tells the state of the engine, so the
+ * signs are indirect: no completion with frames pending, FIFO underruns,
+ * or TCP that only retransmits (peers refusing our checksums).
+ */
+static void tx_watch(void)
+{
+	static unsigned long done0, und0, r0, o0;
+	static unsigned int stall, tick;
+	unsigned long r, o;
+	bool idle;
+
+	if (!eng_ok) {
+		stall = tick = 0;
+		und0 = tx_und;
+		return;
+	}
+	spin_lock_bh(&glock);
+	idle = tx_tail == tx_head || tx_done != done0 || !glink;
+	done0 = tx_done;
+	if (!idle && (M4_get(M_TX_CTRL) & 2))
+		M4_set(M_TX_CTRL, 1);	/* a restart that was missed */
+	spin_unlock_bh(&glock);
+	stall = idle ? 0 : stall + 1;
+	if (stall >= 2)
+		gm_fault("no transmit completion for 2 s");
+	else if (tx_und - und0 >= 8)
+		gm_fault("transmit FIFO underruns");
+	und0 = tx_und;
+	if (tx_guard <= 0 || (++tick & 3))
+		return;
+	r = snmp_fold_field(init_net.mib.tcp_statistics, TCP_MIB_RETRANSSEGS);
+	o = snmp_fold_field(init_net.mib.tcp_statistics, TCP_MIB_OUTSEGS);
+	if (tick > 4 && r - r0 >= tx_guard && (r - r0) * 2 >= o - o0)
+		gm_fault("TCP only retransmits (checksums refused by the peers?)");
+	r0 = r;
+	o0 = o;
+}
