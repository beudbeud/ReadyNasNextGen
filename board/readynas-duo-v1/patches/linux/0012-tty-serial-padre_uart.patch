diff --git a/drivers/tty/serial/padre_uart.c b/drivers/tty/serial/padre_uart.c
new file mode 100644
index 0000000000000000000000000000000000000000..49b81aee738d40480f9b6957fde401843c372156
--- /dev/null
+++ b/drivers/tty/serial/padre_uart.c
@@ -0,0 +1,348 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_uart.c: UART of the Infrant IT3107 "Padre" (ReadyNAS Duo v1).
+ *
+ * Same numbering as the NETGEAR 2.6.17 kernel (padre_serial.c, GPL):
+ *   ttyS0 = UART 0x6000_0070, IRQ 7; ttyS1 = UART 0x6000_0060, IRQ 8,
+ *   console at 9600 baud. 5 MHz clock, divisor = 5e6 / (8 x baud) - 1.
+ * Interrupt-driven receive, polled transmit (like 2.6.17, which did not
+ * use the transmit interrupt).
+ *
+ * Not verified on the hardware.
+ */
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/console.h>
+#include <linux/serial_core.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+#include <linux/interrupt.h>
+#include <linux/platform_device.h>
+
+#include <asm/padre.h>
+
+#define PU_DATA		0x0
+#define PU_STAT		0x4
+#define  PU_STAT_DR	0x01
+#define  PU_STAT_TH	0x04
+#define  PU_STAT_BR	0x08
+#define  PU_STAT_OV	0x10
+#define  PU_STAT_PE	0x20
+#define  PU_STAT_FE	0x40
+#define PU_CTRL		0x8
+#define  PU_CTRL_RE	0x01
+#define  PU_CTRL_TE	0x02
+#define  PU_CTRL_RI	0x04
+#define  PU_CTRL_EV	0x10
+#define  PU_CTRL_PE	0x20
+#define PU_SCAL		0xc
+
+#define PORT_PADRE	PORT_APBUART	/* close GRLIB cousin */
+#define PU_CLK		5000000
+#define PU_NR		2
+#define PU_CONSOLE	1	/* ttyS1 */
+
+static struct uart_port padre_ports[PU_NR];
+
+static inline u32 pu_in(struct uart_port *p, int off)
+{
+	return __raw_readl(p->membase + off);
+}
+
+static inline void pu_out(struct uart_port *p, int off, u32 v)
+{
+	__raw_writel(v, p->membase + off);
+}
+
+static void pu_wait_tx(struct uart_port *p)
+{
+	unsigned int n = 100000;
+
+	while (!(pu_in(p, PU_STAT) & PU_STAT_TH) && --n)
+		cpu_relax();
+}
+
+static unsigned int padre_tx_empty(struct uart_port *p)
+{
+	return pu_in(p, PU_STAT) & PU_STAT_TH ? TIOCSER_TEMT : 0;
+}
+
+static void padre_set_mctrl(struct uart_port *p, unsigned int mctrl) { }
+
+static unsigned int padre_get_mctrl(struct uart_port *p)
+{
+	return TIOCM_CAR | TIOCM_DSR | TIOCM_CTS;
+}
+
+static void padre_stop_tx(struct uart_port *p) { }
+
+/* blocking transmit (9600 baud ~ 1 ms per byte) as in 2.6.17;
+ * switch to the TI interrupt if the console gets in the way.
+ */
+static void padre_start_tx(struct uart_port *p)
+{
+	struct tty_port *tport = &p->state->port;
+	unsigned char ch;
+
+	if (p->x_char) {
+		pu_wait_tx(p);
+		pu_out(p, PU_DATA, p->x_char);
+		p->icount.tx++;
+		p->x_char = 0;
+	}
+	while (!uart_tx_stopped(p) && uart_fifo_get(p, &ch)) {
+		pu_wait_tx(p);
+		pu_out(p, PU_DATA, ch);
+	}
+	if (kfifo_len(&tport->xmit_fifo) < WAKEUP_CHARS)
+		uart_write_wakeup(p);
+}
+
+static void padre_stop_rx(struct uart_port *p)
+{
+	pu_out(p, PU_CTRL, pu_in(p, PU_CTRL) & ~PU_CTRL_RI);
+}
+
+static irqreturn_t padre_uart_irq(int irq, void *dev_id)
+{
+	struct uart_port *p = dev_id;
+	unsigned int max = 256;
+	u32 st;
+
+	uart_port_lock(p);
+	while (((st = pu_in(p, PU_STAT)) & PU_STAT_DR) && max--) {
+		u8 ch = pu_in(p, PU_DATA);
+		u8 flag = TTY_NORMAL;
+
+		p->icount.rx++;
+		if (st & (PU_STAT_BR | PU_STAT_PE | PU_STAT_FE | PU_STAT_OV)) {
+			pu_out(p, PU_STAT, 0xff);	/* clear the errors */
+			if (st & PU_STAT_BR) {
+				p->icount.brk++;
+				if (uart_handle_break(p))
+					continue;
+				flag = TTY_BREAK;
+			} else if (st & PU_STAT_PE) {
+				p->icount.parity++;
+				flag = TTY_PARITY;
+			} else if (st & PU_STAT_FE) {
+				p->icount.frame++;
+				flag = TTY_FRAME;
+			}
+			if (st & PU_STAT_OV)
+				p->icount.overrun++;
+		}
+		if (uart_handle_sysrq_char(p, ch))
+			continue;
+		uart_insert_char(p, st, PU_STAT_OV, ch, flag);
+	}
+	uart_port_unlock(p);
+	tty_flip_buffer_push(&p->state->port);
+	return IRQ_HANDLED;
+}
+
+static int padre_startup(struct uart_port *p)
+{
+	int ret = request_irq(p->irq, padre_uart_irq, 0, "padre-uart", p);
+
+	if (ret)
+		return ret;
+	pu_out(p, PU_STAT, 0xff);
+	pu_out(p, PU_CTRL, pu_in(p, PU_CTRL) | PU_CTRL_RE | PU_CTRL_TE |
+	       PU_CTRL_RI);
+	return 0;
+}
+
+static void padre_shutdown(struct uart_port *p)
+{
+	pu_out(p, PU_CTRL, pu_in(p, PU_CTRL) & ~PU_CTRL_RI);
+	free_irq(p->irq, p);
+}
+
+static void padre_set_termios(struct uart_port *p, struct ktermios *t,
+			      const struct ktermios *old)
+{
+	unsigned long flags;
+	unsigned int baud;
+	u32 ctrl = PU_CTRL_RE | PU_CTRL_TE | PU_CTRL_RI;
+
+	t->c_cflag &= ~(CSIZE | CSTOPB | CRTSCTS);
+	t->c_cflag |= CS8;
+	if (t->c_cflag & PARENB) {
+		ctrl |= PU_CTRL_PE;
+		if (!(t->c_cflag & PARODD))
+			ctrl |= PU_CTRL_EV;
+	}
+	baud = uart_get_baud_rate(p, t, old, 1200, 115200);
+
+	uart_port_lock_irqsave(p, &flags);
+	uart_update_timeout(p, t->c_cflag, baud);
+	p->read_status_mask = PU_STAT_OV | PU_STAT_DR;
+	if (t->c_iflag & INPCK)
+		p->read_status_mask |= PU_STAT_FE | PU_STAT_PE;
+	p->ignore_status_mask = 0;
+	if (t->c_iflag & IGNPAR)
+		p->ignore_status_mask |= PU_STAT_PE | PU_STAT_FE;
+	if (!(t->c_cflag & CREAD))
+		p->ignore_status_mask |= PU_STAT_DR;
+
+	pu_wait_tx(p);
+	pu_out(p, PU_CTRL, 0);
+	pu_out(p, PU_STAT, 0xff);
+	pu_out(p, PU_SCAL, PU_CLK / (baud * 8) - 1);
+	pu_out(p, PU_CTRL, ctrl);
+	uart_port_unlock_irqrestore(p, flags);
+}
+
+static const char *padre_type(struct uart_port *p)
+{
+	return "padre";
+}
+
+static void padre_release_port(struct uart_port *p) { }
+static int padre_request_port(struct uart_port *p) { return 0; }
+
+static void padre_config_port(struct uart_port *p, int flags)
+{
+	if (flags & UART_CONFIG_TYPE)
+		p->type = PORT_PADRE;
+}
+
+static int padre_verify_port(struct uart_port *p, struct serial_struct *s)
+{
+	return 0;
+}
+
+static const struct uart_ops padre_uart_ops = {
+	.tx_empty	= padre_tx_empty,
+	.set_mctrl	= padre_set_mctrl,
+	.get_mctrl	= padre_get_mctrl,
+	.stop_tx	= padre_stop_tx,
+	.start_tx	= padre_start_tx,
+	.stop_rx	= padre_stop_rx,
+	.startup	= padre_startup,
+	.shutdown	= padre_shutdown,
+	.set_termios	= padre_set_termios,
+	.type		= padre_type,
+	.release_port	= padre_release_port,
+	.request_port	= padre_request_port,
+	.config_port	= padre_config_port,
+	.verify_port	= padre_verify_port,
+};
+
+static void padre_init_port(int i)
+{
+	struct uart_port *p = &padre_ports[i];
+
+	if (p->membase)
+		return;
+	p->line = i;
+	p->membase = (void __iomem *)(i ? PADRE_UART0 : PADRE_UART1);
+	p->mapbase = (unsigned long)p->membase - 0x40000000UL;
+	p->iotype = UPIO_MEM32;
+	p->uartclk = PU_CLK;
+	p->fifosize = 1;
+	p->ops = &padre_uart_ops;
+	p->type = PORT_PADRE;
+	p->flags = UPF_BOOT_AUTOCONF;
+	p->has_sysrq = IS_ENABLED(CONFIG_SERIAL_PADRE_CONSOLE);
+}
+
+#ifdef CONFIG_SERIAL_PADRE_CONSOLE
+static void padre_console_putchar(struct uart_port *p, unsigned char ch)
+{
+	pu_wait_tx(p);
+	pu_out(p, PU_DATA, ch);
+}
+
+static void padre_console_write(struct console *co, const char *s,
+				unsigned int count)
+{
+	struct uart_port *p = &padre_ports[co->index];
+	u32 ctrl = pu_in(p, PU_CTRL);
+
+	pu_out(p, PU_CTRL, ctrl & ~PU_CTRL_RI);
+	uart_console_write(p, s, count, padre_console_putchar);
+	pu_wait_tx(p);
+	pu_out(p, PU_CTRL, ctrl);
+}
+
+static int __init padre_console_setup(struct console *co, char *options)
+{
+	int baud = 9600, bits = 8, parity = 'n', flow = 'n';
+
+	if (co->index < 0 || co->index >= PU_NR)
+		co->index = PU_CONSOLE;
+	padre_init_port(co->index);
+	if (options)
+		uart_parse_options(options, &baud, &parity, &bits, &flow);
+	return uart_set_options(&padre_ports[co->index], co, baud, parity,
+				bits, flow);
+}
+
+static struct uart_driver padre_uart_driver;
+
+static struct console padre_console = {
+	.name	= "ttyS",
+	.write	= padre_console_write,
+	.device	= uart_console_device,
+	.setup	= padre_console_setup,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+	.data	= &padre_uart_driver,
+};
+
+static int __init padre_console_init(void)
+{
+	register_console(&padre_console);
+	return 0;
+}
+console_initcall(padre_console_init);
+#define PADRE_CONSOLE	(&padre_console)
+#else
+#define PADRE_CONSOLE	NULL
+#endif
+
+static struct uart_driver padre_uart_driver = {
+	.owner		= THIS_MODULE,
+	.driver_name	= "padre-uart",
+	.dev_name	= "ttyS",
+	.major		= TTY_MAJOR,
+	.minor		= 64,
+	.nr		= PU_NR,
+	.cons		= PADRE_CONSOLE,
+};
+
+static int __init padre_uart_init(void)
+{
+	struct platform_device *pdev;
+	int i, ret;
+
+	ret = uart_register_driver(&padre_uart_driver);
+	if (ret)
+		return ret;
+	pdev = platform_device_register_simple("padre-uart", -1, NULL, 0);
+	if (IS_ERR(pdev))
+		return PTR_ERR(pdev);
+
+	/* ttyS1 only: the pins of UART 0x6000_0070 (ttyS0) drive the LEDs
+	 * (padre_led turns this UART off, like 2.6.17)
+	 */
+	for (i = PU_CONSOLE; i < PU_NR; i++) {
+		padre_init_port(i);
+		padre_ports[i].dev = &pdev->dev;
+		padre_ports[i].irq = padre_irq_virq(i ? PADRE_HWIRQ_UART0 :
+						    PADRE_HWIRQ_UART1);
+		ret = uart_add_one_port(&padre_uart_driver, &padre_ports[i]);
+		if (ret)
+			pr_err("padre-uart: ttyS%d: %d\n", i, ret);
+	}
+	return 0;
+}
+device_initcall(padre_uart_init);
+
+MODULE_DESCRIPTION("Infrant IT3107 (Padre) UART");
+
+MODULE_LICENSE("GPL");
