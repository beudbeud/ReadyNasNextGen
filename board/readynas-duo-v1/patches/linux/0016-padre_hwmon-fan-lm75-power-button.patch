 drivers/platform/padre/Makefile      |   1 +
 drivers/platform/padre/padre_hwmon.c | 593 +++++++++++++++++++++++++++
 3 files changed, 602 insertions(+)
 create mode 100644 drivers/platform/padre/padre_hwmon.c

