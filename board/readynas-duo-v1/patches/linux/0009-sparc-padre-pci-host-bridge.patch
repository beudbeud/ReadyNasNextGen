+++ b/arch/sparc/Kconfig
@@ -430,7 +430,7 @@ config SUN_LDOMS
 
 config PCIC_PCI
 	bool
-	depends on PCI && SPARC32 && !SPARC_LEON
+	depends on PCI && SPARC32 && !SPARC_LEON && !SPARC_PADRE
 	default y
 
 config LEON_PCI
