 /* raw console write by polling the UART, lockless (interrupt safe) */
 int padre_prom_write(int fd, const char *buf, int len);
+extern u32 padre_pciswap;	/* PCI_SWAP value set (0x4444, or 0 like iboot) */
 void padre_flush_dcache_all(void);
 void padre_handler_irq(unsigned int pil);
 void padre_clean_dcache_range(unsigned long start, unsigned long end);
diff --git a/arch/sparc/kernel/Makefile b/arch/sparc/kernel/Makefile
