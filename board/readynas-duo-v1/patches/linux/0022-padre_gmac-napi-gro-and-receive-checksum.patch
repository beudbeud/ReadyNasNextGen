+/* csum_verify: software check of an unfragmented TCP/UDP over IPv4 frame,
+ * 1 = good, 0 = bad, -1 = not checkable
+ */
+static int sw_csum(struct sk_buff *skb)
+{
+	const struct iphdr *iph = (const struct iphdr *)skb->data;
+	unsigned int ihl = iph->ihl * 4, len = ntohs(iph->tot_len);
+
+	if (skb->protocol != htons(ETH_P_IP) || ip_is_fragment(iph) ||
+	    (iph->protocol != IPPROTO_TCP && iph->protocol != IPPROTO_UDP) ||
+	    ihl < 20 || len < ihl + 8 || len > skb->len)
+		return -1;
+	if (iph->protocol == IPPROTO_UDP && !((const struct udphdr *)(skb->data + ihl))->check)
+		return -1;
+	return !csum_tcpudp_magic(iph->saddr, iph->daddr, len - ihl, iph->protocol,
+				  skb_checksum(skb, ihl, len - ihl, 0));
+}
+
+/* the engine checked the TCP/UDP checksum of an unfragmented IPv4 frame */
+static bool rx_csum(struct net_device *dev, struct sk_buff *skb, u32 ctl)
+{
+	const struct iphdr *iph = (const struct iphdr *)skb->data;
+	bool ok = !(ctl & D_CS_IPERR) && (ctl & D_CS_ST) == D_CS_OK && (ctl & D_CS_L4);
+
+	if (ok)
+		rx_csum_ok++;
+	else if (ctl & (D_CS_IPERR | D_CS_L4))
+		rx_csum_bad++;		/* the stack checks again and counts */
+	if (unlikely(csum_verify)) {
+		int sw = sw_csum(skb);
+
+		if (ok && sw == 0)
+			rx_csum_wrong++;
+		else if (!ok && sw == 1)
+			rx_csum_missed++;
+		return false;		/* the stack checks everything */
+	}
+	return ok && (dev->features & NETIF_F_RXCSUM) && skb->protocol == htons(ETH_P_IP) &&
+	       !ip_is_fragment(iph);
+}
