-		if (p & I_TX) {
-			spin_lock(&glock);
-			tx_clean(dev);
-			spin_unlock(&glock);
+	tx_clean(dev, budget);
+	done = rx_poll(dev, budget);
+	if (done < budget && napi_complete_done(napi, done)) {
+		M4_set(M_IMASK, I_RX | I_TX);
+		/* work that came while the interrupt was masked */
+		if ((!(rxd[rx_cur]->ctl & D_OWN) ||
+		     (tx_tail != tx_head && !(txd[tx_tail]->ctl & D_OWN))) &&
+		    napi_schedule_prep(napi)) {
