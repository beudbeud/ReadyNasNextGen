@@ -511,9 +577,11 @@ static void rx_poll(struct net_device *dev)
 			skb_reserve(skb, 2);
 			skb_put(skb, len - 4);	/* without the CRC */
 			skb->protocol = eth_type_trans(skb, dev);	/* also sets skb->dev */
+			if (rx_csum(dev, skb, ctl))
