+}
+
+static irqreturn_t gm_irq(int irq, void *dev_id)
+{
+	u32 p = M4_get(M_IPEND) & (I_RX | I_TX);
+
+	if (!p)
+		return IRQ_NONE;
+	M4_set(M_IMASK, 0);		/* until the poll is over */
+	M4_set(M_ICLR, p);
+	napi_schedule(&gnapi);
+	return IRQ_HANDLED;
 }
 
