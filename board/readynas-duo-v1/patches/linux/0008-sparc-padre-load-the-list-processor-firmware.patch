From: ReadyNAS NG <readynasng@build>
Subject: [PATCH 08/23] sparc: Padre: load the List Processor firmware

The IT3107 has a second core, the List Processor (LP), that runs a
small firmware used for DMA. As 2.6.17 did (head.S load_lp/init_lp),
head_32.S has the LP run init_lp, which copies lp_s_code/lp_s_data
(padre_lpram.c, taken as is from NETGEAR's GPL lpram.c) into its
internal memories, with a bounded wait; 'L' (ready) or 'l' (silent) is
printed on the console.
---
 arch/sparc/kernel/Makefile      |   2 +-
 arch/sparc/kernel/head_32.S     |  89 ++++
 arch/sparc/kernel/padre_lpram.c | 709 ++++++++++++++++++++++++++++++++
 3 files changed, 799 insertions(+), 1 deletion(-)
 create mode 100644 arch/sparc/kernel/padre_lpram.c

diff --git a/arch/sparc/kernel/Makefile b/arch/sparc/kernel/Makefile
index c717a775a52c30fa83fd8f968498d114728f8879..4ffd43c3dead82d62c71f396f2352556589f180b 100644
--- a/arch/sparc/kernel/Makefile
+++ b/arch/sparc/kernel/Makefile
@@ -27,7 +27,7 @@ obj-y                   += traps_$(BITS).o
 # IRQ
 obj-y                   += irq_$(BITS).o
 obj-$(CONFIG_SPARC32)   += sun4m_irq.o sun4d_irq.o
-obj-$(CONFIG_SPARC_PADRE) += padre_kernel.o padre_prom.o
+obj-$(CONFIG_SPARC_PADRE) += padre_kernel.o padre_prom.o padre_lpram.o
 
 obj-y                   += process_$(BITS).o
 obj-y                   += process.o
diff --git a/arch/sparc/kernel/head_32.S b/arch/sparc/kernel/head_32.S
index 9a0e9d207dd0d8beded01eaf0a25b541ac83f25e..50e1abd691afa5ba713dbdf8eeb8026d3e2d819c 100644
--- a/arch/sparc/kernel/head_32.S
+++ b/arch/sparc/kernel/head_32.S
@@ -167,6 +167,95 @@ gokernel:
 		WRITE_PAUSE
 		ld	[%g3], %g0
 
+		/* List Processor firmware (2.6.17: head.S, load_lp): the LP
+		 * runs init_lp (bus address in the SRAM mailbox), which copies
+		 * lp_s_code/lp_s_data into its internal memories and then
+		 * clears the mailbox. Bounded wait; marker 'L' (ready) or 'l'
+		 * (silent).
+		 */
+		set	0x60000090, %g1			! PADRE_SYS_ID
+		ld	[%g1], %g1
+		srl	%g1, 16, %g1
+		set	0x3107, %g3
+		cmp	%g1, %g3
+		bne	1f
+		 sethi	%hi(0x70000000), %g1		! IT1008 and default
+		set	0x70007ffc, %g1			! IT3107
+1:		set	padre_init_lp, %g2
+		sethi	%hi(0x40000000), %g3
+		sub	%g2, %g3, %g2
+		st	%g2, [%g1]
+		set	0x60000094, %g3			! PADRE_SYS_CTRL
+		set	0x2 << 12, %g4
+		st	%g4, [%g3]
+		set	50000000, %g4
+2:		ld	[%g1], %g2
+		cmp	%g2, %g0
+		be	3f
+		 subcc	%g4, 1, %g4
+		bne	2b
+		 nop
+		mov	'l', %g2
+		b	4f
+		 nop
+3:		mov	'L', %g2
+4:		set	0x60000060, %g3
+		st	%g2, [%g3]
+		b	5f
+		 nop
+
+		/* Run by the LP (second core), MMU off: bus addresses */
+		.globl	padre_init_lp
+padre_init_lp:
+		set	PADRE_ICMU_CTRL, %g1
+		set	PADRE_ICMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		set	PADRE_ICMU_IRD, %g1
+		set	PADRE_ICMU_IRD + PADRE_LP_IRD_SIZE, %g3
+		set	lp_s_code, %g4
+		sethi	%hi(0x40000000), %g5
+		sub	%g4, %g5, %g4
+6:		ld	[%g4], %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		add	%g4, 0x4, %g4
+		add	%g1, 0x4, %g1
+		cmp	%g1, %g3
+		bl	6b
+		 nop
+		set	PADRE_DCMU_CTRL, %g1
+		set	PADRE_DCMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		set	PADRE_DCMU_DRD, %g1
+		set	PADRE_DCMU_DRD + PADRE_LP_DRD_SIZE, %g3
+		set	lp_s_data, %g4
+		sethi	%hi(0x40000000), %g5
+		sub	%g4, %g5, %g4
+7:		ld	[%g4], %g2
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		add	%g4, 0x4, %g4
+		add	%g1, 0x4, %g1
+		cmp	%g1, %g3
+		bl	7b
+		 nop
+		set	0x10000, %g3			! INST_RAM_TOP
+		mov	%g3, %tbr
+		mov	%g0, %wim
+		WRITE_PAUSE
+		set	0x10e0, %g1
+		mov	%g1, %psr
+		WRITE_PAUSE
+		set	PADRE_ICMU_CTRL, %g3
+		set	(0x10000 & PADRE_CMU_CTRL_TAG) | PADRE_ICMU_CTRL_IC3 | PADRE_ICMU_CTRL_EN, %g4
+		sta	%g4, [%g3] ASI_PADRE_ICMU
+		set	PADRE_DCMU_CTRL, %g3
+		set	(0x0 & PADRE_CMU_CTRL_TAG) | PADRE_DCMU_CTRL_DC3 | PADRE_DCMU_CTRL_EN, %g4
+		sta	%g4, [%g3] ASI_PADRE_DCMU
+		set	0x0 + PADRE_LP_DRD_SIZE - 4, %sp	! DATA_RAM_TOP + size - 4
+		mov	%sp, %g3
+		set	0x10000 + 0x134, %g1
+		jmp	%g1
+		 nop
+5:
 		/* Marker 'P' on the console (UART 0x6000_0060): MMU and
 		 * caches set up, the kernel is running.
 		 */
