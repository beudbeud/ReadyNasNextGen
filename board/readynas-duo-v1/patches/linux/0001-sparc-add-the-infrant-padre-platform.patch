diff --git a/arch/sparc/Kconfig b/arch/sparc/Kconfig
index 454782ac54b26c5bbe6fe9c8b2311a093ecabf29..50c87d6955818d475b54aab1a00e2755161cf4b7 100644
--- a/arch/sparc/Kconfig
+++ b/arch/sparc/Kconfig
@@ -292,7 +292,7 @@ endif
 
 config CMDLINE_BOOL
 	bool "Default bootloader kernel arguments"
-	depends on SPARC64
+	depends on SPARC64 || SPARC_PADRE
 
 config CMDLINE
 	string "Initial kernel command string"
@@ -347,9 +347,23 @@ config SERIAL_CONSOLE
 
 	  If unsure, say N.
 
+config SPARC_PADRE
+	bool "Infrant IT3107 \"Padre\" (NETGEAR ReadyNAS Duo v1)"
+	depends on SPARC32 && !SMP
+	select ARCH_HAS_SYNC_DMA_FOR_DEVICE
+	select ARCH_HAS_DMA_PREP_COHERENT
+	select ARCH_HAS_DMA_ALLOC
+	select USB_EHCI_BIG_ENDIAN_MMIO if USB_EHCI_HCD
