 arch/sparc/kernel/ioport.c        |  45 ++++
 arch/sparc/kernel/irq_32.c        |  16 ++
 arch/sparc/kernel/padre_kernel.c  | 424 ++++++++++++++++++++++++++++++
 arch/sparc/kernel/padre_prom.c    | 302 +++++++++++++++++++++
 arch/sparc/kernel/process_32.c    |  15 ++
 arch/sparc/kernel/setup_32.c      |  10 +-
 arch/sparc/kernel/vmlinux.lds.S   |   5 +
 arch/sparc/prom/init_32.c         |   7 +
