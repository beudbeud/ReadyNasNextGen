--- a/arch/sparc/lib/padre_muldiv.S
+++ b/arch/sparc/lib/padre_muldiv.S
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * padre_muldiv.S: .mul .umul .div .udiv .rem .urem routines called by
+ * gcc -mcpu=v7, for the Infrant IT3107 "Padre".
+ *
+ * On this CPU the sdiv instruction (signed division) gives wrong
+ * results; udiv, umul and smul are correct (measured on the NAS).
+ * Signed division is therefore done unsigned, with signs handled apart.
+ * gcc convention: arguments in %o0/%o1, result in %o0 (64-bit product:
+ * high word in %o1), leaf routines without a register window.
+ *
+ * Limitation: kbuild cannot export a symbol whose name starts with a
+ * dot, so a module (.ko) that multiplies or divides will not load. The
+ * Padre drivers are built into the kernel (=y).
+ */
+
+#include <linux/linkage.h>
+
+	.text
+	.align	4
+
+/* signed product: %o1:%o0 = %o0 * %o1 */
+	.globl	.mul
+.mul:
+	smul	%o0, %o1, %o0
+	retl
+	 rd	%y, %o1
+
+/* unsigned product */
+	.globl	.umul
+.umul:
+	umul	%o0, %o1, %o0
+	retl
+	 rd	%y, %o1
+
+/* unsigned quotient: %o0 = %o0 / %o1 */
+	.globl	.udiv
+.udiv:
+	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	retl
+	 udiv	%o0, %o1, %o0
+
+/* unsigned remainder: %o0 = %o0 % %o1 */
+	.globl	.urem
+.urem:
+	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	udiv	%o0, %o1, %o2
+	umul	%o2, %o1, %o2
+	retl
+	 sub	%o0, %o2, %o0
+
+/* signed quotient, truncated towards zero (C) */
+	.globl	.div
+.div:
+	xor	%o0, %o1, %o3		! sign of the result in bit 31
+	tst	%o0
+	bge	1f
+	 tst	%o1
+	neg	%o0
+	tst	%o1
+1:	bge	2f
+	 nop
+	neg	%o1
+2:	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	udiv	%o0, %o1, %o0
+	tst	%o3
+	bl,a	3f
+	 neg	%o0
+3:	retl
+	 nop
+
+/* signed remainder, with the sign of the dividend (C) */
+	.globl	.rem
+.rem:
+	mov	%o0, %o3		! sign of the dividend
+
+	tst	%o0
+	bge	1f
+	 tst	%o1
+	neg	%o0
+	tst	%o1
+1:	bge	2f
+	 nop
+	neg	%o1
+2:	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	udiv	%o0, %o1, %o2
+	umul	%o2, %o1, %o2
+	sub	%o0, %o2, %o0
+	tst	%o3
+	bl,a	3f
+	 neg	%o0
+3:	retl
+	 nop
