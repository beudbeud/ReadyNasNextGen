diff --git a/arch/sparc/kernel/padre_kernel.c b/arch/sparc/kernel/padre_kernel.c
new file mode 100644
index 0000000000000000000000000000000000000000..9d3f597a95a48e803dd8c46256a40a8f83b8b475
--- /dev/null
+++ b/arch/sparc/kernel/padre_kernel.c
@@ -0,0 +1,424 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_kernel.c: interrupts and timer of the Infrant IT3107 "Padre".
+ *
+ * Behaviour taken from the GPL sources of NETGEAR's 2.6.17 kernel
+ * (arch/padre/kernel/irq.c and time.c), rewritten for irq_chip and the
+ * sparc_config framework of arch/sparc. Not verified on the hardware.
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/io.h>
+#include <linux/spinlock.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+#include <linux/kernel_stat.h>
+#include <linux/sched/stat.h>
+#include <linux/sched/task_stack.h>
+#include <linux/stdarg.h>
+#include <linux/sched.h>
+#include <linux/timekeeping.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <asm/irq_regs.h>
+
+#include <asm/padre.h>
+#include <asm/timer.h>
+#include <asm/oplib.h>
+
+#include "irq.h"
+#include "kernel.h"
+
+/* padre.disable=name1,name2...: Padre drivers not to start (debugging) */
+static char padre_disable_list[64];
+
+static int __init padre_disable_param(char *s)
+{
+	strscpy(padre_disable_list, s ? s : "", sizeof(padre_disable_list));
+	return 0;
+}
+early_param("padre.disable", padre_disable_param);
+
+bool padre_disabled(const char *name)
+{
+	const char *p = padre_disable_list;
+	size_t n = strlen(name);
+
+	while (*p) {
+		if (!strncmp(p, name, n) && (p[n] == ',' || p[n] == 0)) {
+			pr_info("padre: %s disabled (padre.disable=)\n", name);
+			return true;
+		}
+		p = strchrnul(p, ',');
+		if (*p)
+			p++;
+	}
+	return false;
+}
+EXPORT_SYMBOL(padre_disabled);
+
+static unsigned int padre_virq[PADRE_NR_HWIRQ];
+static u32 padre_mask_l, padre_mask_h;	/* copy of the mask registers */
+static DEFINE_RAW_SPINLOCK(padre_irq_lock);
+
+static void padre_write_masks(void)
+{
+	__raw_writel(padre_mask_h, (void __iomem *)PADRE_INTC0_MASK_H);
+	__raw_writel(padre_mask_l, (void __iomem *)PADRE_INTC0_MASK_L);
+	/* 2.6.17 "bug 505": dummy write after the mask */
+	__raw_writel(0, (void __iomem *)PADRE_BUG505_ADDR);
+}
+
+static void padre_irq_mask(struct irq_data *d)
+{
+	unsigned long hw = (unsigned long)irq_data_get_irq_chip_data(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&padre_irq_lock, flags);
+	if (hw > 31)
+		padre_mask_h &= ~(1U << (hw - 32));
+	else
+		padre_mask_l &= ~(1U << hw);
+	padre_write_masks();
+	raw_spin_unlock_irqrestore(&padre_irq_lock, flags);
+}
+
+static void padre_irq_unmask(struct irq_data *d)
+{
+	unsigned long hw = (unsigned long)irq_data_get_irq_chip_data(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&padre_irq_lock, flags);
+	/* sources 16-27 (GPIO, PCI): latched cause, cleared AFTER the
+	 * handler, just before unmasking (2.6.17: end_padre_irq_lv)
+	 */
+	if (hw >= PADRE_HWIRQ_LEVEL_FIRST && hw <= PADRE_HWIRQ_LEVEL_LAST)
+		__raw_writel(1U << hw, (void __iomem *)PADRE_INTC0_ICAUSE_L);
+	if (hw > 31)
+		padre_mask_h |= 1U << (hw - 32);
+	else
+		padre_mask_l |= 1U << hw;
+	padre_write_masks();
+	raw_spin_unlock_irqrestore(&padre_irq_lock, flags);
+}
+
+/* ack: nothing here, the cause of sources 16-27 is cleared on unmask
+ * (after the handler)
+ */
+static void padre_irq_ack(struct irq_data *d)
+{
+}
+
+static struct irq_chip padre_irq_chip = {
+	.name		= "padre",
+	.irq_mask	= padre_irq_mask,
+	.irq_unmask	= padre_irq_unmask,
+	.irq_ack	= padre_irq_ack,
+};
+
+unsigned int padre_irq_virq(unsigned int hwirq)
+{
+	return hwirq < PADRE_NR_HWIRQ ? padre_virq[hwirq] : 0;
+}
+EXPORT_SYMBOL(padre_irq_virq);
+
+static unsigned int padre_build_device_irq(struct platform_device *op,
+					   unsigned int real_irq)
+{
+	return padre_irq_virq(real_irq);
+}
+
+/* Called by handler_irq() for each level. 2.6.17 read the high word
+ * (sources 32-47) if level > 4, the low word otherwise; we read both every
+ * time: if that rule is wrong for some source, it still gets served instead
+ * of taking the same trap forever (silent hang).
+ */
+static unsigned long padre_irq_spurious;
+
+/* Storm guard: a source firing more than 20,000 times in one second is
+ * masked (with a message) instead of starving everything else.
+ * The timer (source 46) is excluded: masking it stops everything. Bug
+ * fixed: the window started at 0 while jiffies starts at INITIAL_JIFFIES
+ * (negative, -300 s); time_after() stayed false for 5 min, the counter
+ * never went back to zero and the timer was "masked for storm" at its
+ * 20,000th tick (~200 s, test 14:59).
+ */
+static unsigned long padre_storm_t[PADRE_NR_HWIRQ];
+static unsigned int padre_storm_n[PADRE_NR_HWIRQ];
+
+static void padre_dispatch(u32 cause, unsigned int base)
+{
+	while (cause) {
+		unsigned int bit = __ffs(cause), hw = base + bit;
+
+		cause &= ~(1U << bit);
+		if (hw >= PADRE_NR_HWIRQ)
+			continue;
+		if (hw == PADRE_HWIRQ_TIMER1) {
+			generic_handle_irq(padre_virq[hw]);
+			continue;
+		}
+		if (!padre_storm_n[hw] ||
+		    time_after(jiffies, padre_storm_t[hw] + HZ)) {
+			padre_storm_t[hw] = jiffies;
+			padre_storm_n[hw] = 0;
+		}
+		if (++padre_storm_n[hw] > 20000) {
+			pr_err("padre: interrupt storm on source %u, masked\n", hw);
+			disable_irq_nosync(padre_virq[hw]);
+			padre_storm_n[hw] = 0;
+			continue;
+		}
+		generic_handle_irq(padre_virq[hw]);
+	}
+}
+
+void padre_handler_irq(unsigned int pil)
+{
+	u32 h = __raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_H) & padre_mask_h;
+	u32 l = __raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_L) & padre_mask_l;
+
+	if (!h && !l) {
+		if (!(padre_irq_spurious++ & 0xffff))
+			pr_warn("padre: level %u interrupt without cause (H=%08x L=%08x, %lu times)\n",
+				pil, __raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_H),
+				__raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_L), padre_irq_spurious);
+		return;
+	}
+	padre_dispatch(h, 32);
+	padre_dispatch(l, 0);
+}
+
+/* --------------------------------------------------------------------
+ * Timer 1: 50,000 ticks/s, automatic reload on every tick
+ */
+#define PADRE_TICKS_PER_JIFFY	(PADRE_TIMER_HZ / HZ)
+
+static unsigned int padre_cycles_offset(void)
+{
+	u32 a, b = __raw_readl((void __iomem *)PADRE_TM_CNTDIAG);
+	int n = 8;
+
+	do {	/* stable read, like do_gettimeoffset() in 2.6.17 */
+		a = b;
+		b = __raw_readl((void __iomem *)PADRE_TM_CNTDIAG);
+	} while (a != b && --n);
+
+	/* counter counting down from PADRE_TICKS_PER_JIFFY - 1 to 0 */
+	if (b >= PADRE_TICKS_PER_JIFFY)
+		return 0;
+	return PADRE_TICKS_PER_JIFFY - 1 - b;
+}
+
+/* padre.trace_tick=1 (default 0, debugging): on every tick, snapshot of the
+ * state in padre_tick, read through /proc/padre_tick. NO printk or
+ * ktime_get() here: padre_clear_clock_irq() is called by timer_interrupt()
+ * UNDER write_seqlock(&timer_cs_lock), and timer_cs_read() (hence
+ * ktime_get) waits for that lock to be released: deadlock (7th test, hung
+ * after "Switched to clocksource timer_cs"). 0 = no snapshot.
+ */
+static unsigned int padre_trace_tick;
+
+static int __init padre_trace_tick_param(char *s)
+{
+	return kstrtouint(s, 0, &padre_trace_tick);
+}
+early_param("padre.trace_tick", padre_trace_tick_param);
+
+static struct {
+	unsigned long ticks, jiffies, pending, pc, psr;
+	unsigned int preempt, timer, hrtimer, rcu, sched;
+	int pid;
+	char comm[TASK_COMM_LEN];
+} padre_tick;
+
+/* Tick watchdog: if there was no context switch for 2 s, writes straight to
+ * the UART (padre_prom_write: polling, no lock, no printk) the interrupted
+ * task, pc/npc/psr/o7 and the fp chain. Then every 2 s while it lasts (tick
+ * number: proof that the tick is running), 30 times at most. No line during
+ * a hang = dead tick, hence a hang with interrupts masked.
+ */
+static void padre_raw(const char *fmt, ...)
+{
+	static char buf[160];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vscnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	padre_prom_write(0, buf, n);
+}
+
+static void padre_watchdog(struct pt_regs *regs)
+{
+	static unsigned long long last;
+	static unsigned int stuck, reports, pulses;
+	unsigned long long sw = nr_context_switches_cpu(0);
+	unsigned long base, fp;
+	int i;
+
+	/* Pulse (9th test: the watchdog never spoke): every 2 s from 8 to
+	 * 60 s of ticks, then every 10 s, 150 lines at most. The last pulse
+	 * printed dates when the tick stopped, to within 2 s.
+	 */
+	if (regs && pulses < 150 &&
+	    ((padre_tick.ticks >= 8 * HZ && padre_tick.ticks <= 60 * HZ &&
+	      !(padre_tick.ticks % (2 * HZ))) || !(padre_tick.ticks % (10 * HZ)))) {
+		pulses++;
+		padre_raw("[pulse] tick %lu sw %llu %.16s[%d] %c pc %08lx\n",
+			  padre_tick.ticks, sw, current->comm, current->pid,
+			  (regs->psr & PSR_PS) ? 'k' : 'u', regs->pc);
+	}
+
+	if (sw != last) {
+		last = sw;
+		stuck = 0;
+		return;
+	}
+	if (++stuck % (2 * HZ) || reports >= 30 || !regs)
+		return;
+	reports++;
+	padre_raw("\n[watchdog] tick %lu jiffies %lu: no context switch for %u s (%llu), %.16s[%d] %s pc %08lx npc %08lx psr %08lx o7 %08lx preempt %08x softirq %03lx\n",
+		  padre_tick.ticks, jiffies, stuck / HZ, sw, current->comm,
+		  current->pid, (regs->psr & PSR_PS) ? "kernel" : "user",
+		  regs->pc, regs->npc, regs->psr, regs->u_regs[UREG_RETPC],
+		  preempt_count(), (unsigned long)local_softirq_pending());
+	padre_raw("[watchdog] pc %pS o7 %pS\n", (void *)regs->pc,
+		  (void *)regs->u_regs[UREG_RETPC]);
+	if (!(regs->psr & PSR_PS))
+		return;
+	/* kernel stack: same bounds as show_stack() */
+	base = (unsigned long)task_stack_page(current);
+	fp = regs->u_regs[UREG_FP];
+	for (i = 0; i < 10; i++) {
+		struct reg_window32 *rw = (struct reg_window32 *)fp;
+
+		if (fp < base + sizeof(struct thread_info) ||
+		    fp >= base + (PAGE_SIZE << 1) || (fp & 7))
+			break;
+		padre_raw("[watchdog]   %08lx %pS\n", rw->ins[7], (void *)rw->ins[7]);
+		fp = rw->ins[6];
+	}
+}
+
+static void padre_clear_clock_irq(void)
+{
+	struct pt_regs *regs;
+
+	/* nothing to clear: 2.6.17 does not clear the timer cause */
+	if (!padre_trace_tick)
+		return;
+	regs = get_irq_regs();
+	padre_tick.ticks++;
+	padre_tick.jiffies = jiffies;
+	padre_tick.preempt = preempt_count();
+	padre_tick.pending = local_softirq_pending();
+	padre_tick.timer = kstat_softirqs_cpu(TIMER_SOFTIRQ, 0);
+	padre_tick.hrtimer = kstat_softirqs_cpu(HRTIMER_SOFTIRQ, 0);
+	padre_tick.rcu = kstat_softirqs_cpu(RCU_SOFTIRQ, 0);
+	padre_tick.sched = kstat_softirqs_cpu(SCHED_SOFTIRQ, 0);
+	padre_tick.pid = current->pid;
+	memcpy(padre_tick.comm, current->comm, TASK_COMM_LEN);
+	padre_tick.pc = regs ? regs->pc : 0;
+	padre_tick.psr = regs ? regs->psr : 0;
+	padre_watchdog(regs);
+}
+
+/* Read outside interrupt context: ktime_get() is safe here */
+static int padre_tick_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "now: jiffies %lu ktime_ns %llu\n",
+		   jiffies, ktime_get_ns());
+	seq_printf(m, "last tick #%lu: jiffies %lu preempt %08x softirq pending %03lx timer %u hrtimer %u rcu %u sched %u, %.16s[%d] pc %08lx psr %08lx\n",
+		   padre_tick.ticks, padre_tick.jiffies, padre_tick.preempt,
+		   padre_tick.pending, padre_tick.timer, padre_tick.hrtimer,
+		   padre_tick.rcu, padre_tick.sched, padre_tick.comm,
+		   padre_tick.pid, padre_tick.pc, padre_tick.psr);
+	return 0;
+}
+
+static int __init padre_tick_proc(void)
+{
+	proc_create_single("padre_tick", 0444, NULL, padre_tick_show);
+	return 0;
+}
+device_initcall(padre_tick_proc);
+
+static void padre_load_profile_irq(int cpu, unsigned int limit)
+{
+}
+
+static void __init padre_init_timers(void)
+{
+	const int t = 1;
+	int err;
+
+	sparc_config.get_cycles_offset = padre_cycles_offset;
+	sparc_config.cs_period = PADRE_TICKS_PER_JIFFY;
+	sparc_config.features |= FEAT_L10_CLOCKSOURCE | FEAT_L10_CLOCKEVENT;
+
+	__raw_writel(PADRE_TM_CTRL_STP, (void __iomem *)PADRE_TM_CTRL);
+	__raw_writel(PADRE_PRESCALE, (void __iomem *)PADRE_TM_PS);
+	__raw_writel(PADRE_TICKS_PER_JIFFY - 1, (void __iomem *)PADRE_TM_TIMER1);
+	__raw_writel(PADRE_TM_AUTO(t) | PADRE_TM_LOAD(t) | PADRE_TM_INTEN(t) |
+	       PADRE_TM_SEL(t), (void __iomem *)PADRE_TM_CTRL);
+
+	err = request_irq(padre_irq_virq(PADRE_HWIRQ_TIMER1), timer_interrupt,
+			  IRQF_TIMER, "timer", NULL);
+	if (err)
+		prom_printf("padre: timer: request_irq %d\n", err);
+}
+
+/* 2.6.17 setup.c (init_padre_fifo, P0 boards): FIFOs of the MC DMA channels
+ * in SRAM. The original kernel set them up itself (iboot does not do it for
+ * the disk channels): GMAC 0/1, disks 4-7 (0x8009 expected), CP0 12/13,
+ * RXA 16/17, AU 18/19. Size 9 = 512 bytes.
+ */
+static void __init padre_init_fifo(void)
+{
+	static const struct { u8 ch; u16 base; } f[] = {
+		{ 0, 0x0c00 }, { 1, 0x0c00 },
+		{ 4, 0x0400 }, { 5, 0x0600 }, { 6, 0x0800 }, { 7, 0x0a00 },
+		{ 16, 0 }, { 17, 0 }, { 18, 0x0e00 }, { 19, 0x0e00 },
+		{ 12, 0x0200 }, { 13, 0x0200 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(f); i++) {
+		void __iomem *r = (void __iomem *)(PADRE_APB + 0x2800 + (f[i].ch << 4));
+
+		__raw_writel(f[i].base, r + 4);		/* BASE */
+		__raw_writel(0x8000 | 9, r);		/* FFCTRL = EN | 512 bytes */
+	}
+}
+
+void __init padre_init_IRQ(void)
+{
+	unsigned int hw;
+
+	padre_init_fifo();
+
+	padre_mask_l = padre_mask_h = 0;
+	padre_write_masks();
+
+	for (hw = 0; hw < PADRE_NR_HWIRQ; hw++) {
+		unsigned int irq = irq_alloc(hw, hw > 31 ? 5 : 1);
+
+		if (!irq)
+			break;
+		padre_virq[hw] = irq;
+		irq_set_chip_and_handler_name(irq, &padre_irq_chip,
+					      handle_level_irq, "level");
+		irq_set_chip_data(irq, (void *)(unsigned long)hw);
+	}
+
+	sparc_config.init_timers      = padre_init_timers;
+	sparc_config.build_device_irq = padre_build_device_irq;
+	sparc_config.clock_rate       = PADRE_TIMER_HZ;
+	sparc_config.clear_clock_irq  = padre_clear_clock_irq;
+	sparc_config.load_profile_irq = padre_load_profile_irq;
+}
diff --git a/arch/sparc/kernel/padre_prom.c b/arch/sparc/kernel/padre_prom.c
new file mode 100644
index 0000000000000000000000000000000000000000..15032a3341301e14c9971de6027bbc7be68c8595
--- /dev/null
+++ b/arch/sparc/kernel/padre_prom.c
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_prom.c: minimal OpenBoot "PROM" emulated in the kernel.
+ *
+ * arch/sparc (sparc32) expects a PROM: romvec vector, device tree,
+ * console, command line. iboot provides none; as mklinuximg does for
+ * LEON, we provide one (version 2) reduced to what the kernel reads:
+ * root (idprom), cpu, memory, serial.
+ * The PROM console writes straight to the console UART (ttyS1,
+ * 0x6000_0060), by polling: it prints the very first messages
+ * (earlyprom), before the real driver.
+ *
+ * Not verified on the hardware.
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/string.h>
+#include <linux/io.h>
+#include <linux/of.h>
+
+#include <asm/openprom.h>
+#include <asm/oplib.h>
+#include <asm/idprom.h>
+#include <asm/padre.h>
+
+struct padre_boot_param padre_boot_param;
+EXPORT_SYMBOL(padre_boot_param);
+
+/* ------------------------------------------------------------------
+ * Console UART (registers: 0 data, 4 status, 8 control)
+ */
+#define PADRE_UART_STAT_TH	0x04	/* transmit register empty */
+
+static void padre_prom_putc(char c)
+{
+	void __iomem *u = (void __iomem *)PADRE_UART0;
+	unsigned int n = 1000000;
+
+	while (!(__raw_readl(u + 4) & PADRE_UART_STAT_TH) && --n)
+		;
+	__raw_writel(c, u);
+}
+
+int padre_prom_write(int fd, const char *buf, int len)
+{
+	int i;
+
+	for (i = 0; i < len; i++) {
+		if (buf[i] == '\n')
+			padre_prom_putc('\r');
+		padre_prom_putc(buf[i]);
+	}
+	return len;
+}
+
+/* ------------------------------------------------------------------
+ * Tree: 1 = root, 2 = cpu, 3 = memory, 4 = serial
+ */
+struct padre_prop {
+	const char *name;
+	const void *val;
+	int len;
+};
+
+#define PROP_STR(n, s)	{ n, s, sizeof(s) }
+#define PROP_VAL(n, v)	{ n, &(v), sizeof(v) }
+
+static struct idprom padre_idprom = { .id_format = 1, .id_machtype = 0x80 };
+static struct linux_prom_registers padre_mem_reg = { 0, PADRE_PHYS_DDR, 0 };
+static struct linux_prom_registers padre_uart_reg = { 0, PADRE_UART0 - 0x40000000, 16 };
+static const unsigned int padre_zero;
+static unsigned int padre_cpu_freq;	/* unknown: udelay is calibrated */
+
+static const struct padre_prop padre_root_props[] = {
+	PROP_STR("name", "padre"),
+	PROP_STR("compatible", "padre"),
+	PROP_STR("banner-name", "NETGEAR ReadyNAS Duo v1 (Infrant IT3107)"),
+	PROP_VAL("idprom", padre_idprom),
+	{ NULL }
+};
+
+static const struct padre_prop padre_cpu_props[] = {
+	PROP_STR("name", "cpu"),
+	PROP_STR("device_type", "cpu"),
+	PROP_VAL("mid", padre_zero),
+	PROP_VAL("clock-frequency", padre_cpu_freq),
+	{ NULL }
+};
+
+static const struct padre_prop padre_mem_props[] = {
+	PROP_STR("name", "memory"),
+	PROP_STR("device_type", "memory"),
+	PROP_VAL("reg", padre_mem_reg),
+	PROP_VAL("available", padre_mem_reg),
+	{ NULL }
+};
+
+static const struct padre_prop padre_serial_props[] = {
+	PROP_STR("name", "serial"),
+	PROP_STR("device_type", "serial"),
+	PROP_STR("compatible", "infrant,padre-uart"),
+	PROP_VAL("reg", padre_uart_reg),
+	{ NULL }
+};
+
+struct padre_node {
+	const struct padre_prop *props;
+	phandle sibling, child;
+};
+
+static const struct padre_node padre_nodes[] = {
+	[1] = { padre_root_props, 0, 2 },
+	[2] = { padre_cpu_props, 3, 0 },
+	[3] = { padre_mem_props, 4, 0 },
+	[4] = { padre_serial_props, 0, 0 },
+};
+#define PADRE_SERIAL_NODE	4
+
+static const struct padre_prop *padre_find(phandle node, const char *name)
+{
+	const struct padre_prop *p;
+
+	if (node < 1 || node >= ARRAY_SIZE(padre_nodes) || !name)
+		return NULL;
+	for (p = padre_nodes[node].props; p->name; p++)
+		if (!strcmp(p->name, name))
+			return p;
+	return NULL;
+}
+
+static phandle padre_nextnode(phandle node)
+{
+	if (node == 0)
+		return 1;
+	if (node >= ARRAY_SIZE(padre_nodes))
+		return 0;
+	return padre_nodes[node].sibling;
+}
+
+static phandle padre_child(phandle node)
+{
+	if (node < 1 || node >= ARRAY_SIZE(padre_nodes))
+		return 0;
+	return padre_nodes[node].child;
+}
+
+static int padre_proplen(phandle node, const char *name)
+{
+	const struct padre_prop *p = padre_find(node, name);
+
+	return p ? p->len : -1;
+}
+
+static int padre_getprop(phandle node, const char *name, char *val)
+{
+	const struct padre_prop *p = padre_find(node, name);
+
+	if (!p)
+		return -1;
+	memcpy(val, p->val, p->len);
+	return p->len;
+}
+
+static int padre_setprop(phandle node, const char *name, char *val, int len)
+{
+	return -1;
+}
+
+static char *padre_nextprop(phandle node, char *name)
+{
+	const struct padre_prop *p;
+
+	if (node < 1 || node >= ARRAY_SIZE(padre_nodes))
+		return "";
+	p = padre_nodes[node].props;
+	if (name && *name) {
+		p = padre_find(node, name);
+		if (!p)
+			return "";
+		p++;
+	}
+	return p->name ? (char *)p->name : "";
+}
+
+static struct linux_nodeops padre_nodeops = {
+	.no_nextnode	= padre_nextnode,
+	.no_child	= padre_child,
+	.no_proplen	= padre_proplen,
+	.no_getprop	= padre_getprop,
+	.no_setprop	= padre_setprop,
+	.no_nextprop	= padre_nextprop,
+};
+
+/* ------------------------------------------------------------------
+ * PROM vector
+ */
+static phandle padre_inst2pkg(int d)
+{
+	return PADRE_SERIAL_NODE;
+}
+
+static void __noreturn padre_reset(void)
+{
+	__raw_writel(1, (void __iomem *)PADRE_SYS_CTRL);	/* 2.6.17: machine_restart */
+	for (;;)
+		;
+}
+
+static void padre_reboot(char *bootstr)
+{
+	padre_reset();
+}
+
+static void padre_eval(char *str)
+{
+	if (str && !strcmp(str, "reset"))
+		padre_reset();
+}
+
+/* Halt = power cut through GPIO 2 (2.6.17: machine_halt, "P0" boards,
+ * including the Duo v1)
+ */
+static void padre_abort(void)
+{
+	local_irq_disable();
+	for (;;)
+		;
+}
+
+static void padre_halt(void)
+{
+	local_irq_disable();
+	__raw_writel(1 << 2, (void __iomem *)(PADRE_APB + 0xc4));	/* GPIO_DIR */
+	__raw_writel(1 << 2, (void __iomem *)(PADRE_APB + 0xc0));	/* GPIO_DATA */
+	for (;;)
+		;
+}
+
+#ifdef CONFIG_CMDLINE_BOOL
+static char padre_cmdline[] = CONFIG_CMDLINE;
+#else
+static char padre_cmdline[] = "console=ttyS1,9600";
+#endif
+static char *padre_bootargs = padre_cmdline;
+static char padre_bootpath[] = "";
+static char *padre_bootpathp = padre_bootpath;
+static int padre_fd_stdio = 1;
+static char padre_stdout_dev = PROMDEV_TTYA;
+static void (*padre_synchook)(void);
+
+struct linux_romvec padre_romvec = {
+	.pv_magic_cookie	= LINUX_OPPROM_MAGIC,
+	.pv_romvers		= 2,
+	.pv_plugin_revision	= 0,
+	.pv_printrev		= 0,
+	.pv_nodeops		= &padre_nodeops,
+	.pv_stdin		= &padre_stdout_dev,
+	.pv_stdout		= &padre_stdout_dev,
+	.pv_reboot		= padre_reboot,
+	.pv_abort		= padre_abort,
+	.pv_halt		= padre_halt,
+	.pv_synchook		= &padre_synchook,
+	.pv_fortheval.v2_eval	= padre_eval,
+	.pv_v2bootargs = {
+		.bootpath	= &padre_bootpathp,
+		.bootargs	= &padre_bootargs,
+		.fd_stdin	= &padre_fd_stdio,
+		.fd_stdout	= &padre_fd_stdio,
+	},
+	.pv_v2devops = {
+		.v2_inst2pkg	= padre_inst2pkg,
+		.v2_dev_write	= padre_prom_write,
+	},
+};
+
+/* Called by prom_init() (prom/init_32.c) before any read of the tree */
+void __init padre_prom_setup(void)
+{
+	unsigned long mem;
+
+	memcpy(&padre_boot_param, (void *)PADRE_BOOT_PARAM,
+	       sizeof(padre_boot_param));
+
+	mem = padre_boot_param.mem_size;
+	if (mem < (64UL << 20) || mem > (1UL << 30) || (mem & 0xffffff)) {
+		/* dubious value: 256 MB, the Duo v1 memory size */
+
+		mem = 256UL << 20;
+	}
+	padre_mem_reg.reg_size = mem;
+
+	memcpy(padre_idprom.id_ethaddr, padre_boot_param.mac, 6);
+	{
+		unsigned char *p = (unsigned char *)&padre_idprom, c = 0;
+		int i;
+
+		for (i = 0; i <= 0x0e; i++)
+			c ^= p[i];
+		padre_idprom.id_cksum = c;
+	}
+}
diff --git a/arch/sparc/kernel/process_32.c b/arch/sparc/kernel/process_32.c
index 5a28c0e91bf15f32161423a4cfe1b4f4c19688d9..0295a4e0bfa4ea19d19f8c685bb01c71ba3a4373 100644
--- a/arch/sparc/kernel/process_32.c
+++ b/arch/sparc/kernel/process_32.c
@@ -69,6 +69,21 @@ struct thread_info *current_set[NR_CPUS];
 /* Idle loop support. */
 void arch_cpu_idle(void)
 {
+#ifdef CONFIG_SPARC_PADRE
+	/*
+	 * Like the 2.6.17 cpu_idle: busy loop with interrupts enabled
+	 * (PIL 0) while nothing is ready. No sleep mode: the Padre has none.
+	 * Without this, the generic code only reopens interrupts for a few
+	 * instructions between two rounds.
+	 */
+	pr_info_once("padre: busy idle (PIL 0, no sleep mode)\n");
+
+	raw_local_irq_enable();
+	while (!need_resched())
+		cpu_relax();
+	raw_local_irq_disable();
+	return;
+#endif
 	if (sparc_idle)
 		(*sparc_idle)();
 }
