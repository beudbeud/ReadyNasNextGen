diff --git a/arch/sparc/include/asm/padre.h b/arch/sparc/include/asm/padre.h
new file mode 100644
index 0000000000000000000000000000000000000000..aede587a92383afeb2da51ba5ce80704105816be
--- /dev/null
+++ b/arch/sparc/include/asm/padre.h
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Infrant IT3107 "Padre" (ReadyNAS Duo v1): registers and constants.
+ *
+ * Values taken from the GPL sources NETGEAR published for the 2.6.17
+ * kernel (include/asm-padre/padre0.h, page.h, pgtable.h, timer.h,
+ * arch/padre/kernel/{head.S,irq.c,time.c}, arch/padre/mm/padre_cache.c).
+ *
+ * Address map seen by the kernel (MMU in "fixed map" mode, set up in
+ * head_32.S as the 2.6.17 kernel did):
+ *   0x0000_0000 - 0x3fff_ffff  user space (page tables)
+ *   0x4000_0000 - 0x7fff_ffff  I/O, fixed window onto bus 0x0000_0000
+ *   0x8000_0000 - ...          DDR, fixed window onto bus 0x4000_0000
+ *   0xf800_0000 - 0xffff_0000  vmalloc (page tables)
+ * The Linux "physical" address is the AHB bus address (DDR at
+ * 0x4000_0000): that is what the MMU table walker and the DMA engines
+ * read.
+ */
+/* Register access: __raw_readl()/__raw_writel() (native, like 2.6.17
+ * readl()). sparc32 readl()/writel() swap bytes (PCI). */
+#ifndef _ASM_SPARC_PADRE_H
+#define _ASM_SPARC_PADRE_H
+
+#define PADRE_PHYS_DDR		0x40000000UL	/* DDR on the bus */
+#define PADRE_IO_VIRT(bus)	((bus) + 0x40000000UL)	/* I/O */
+#define PADRE_IO_WINDOW_END	0x40000000UL	/* I/O: bus < 1 GB */
+#define PADRE_USER_TOP		0x40000000	/* = TASK_SIZE, usable from asm */
+
+/* Padre-specific ASIs (beware: 0x10/0x11 do not mean what they do on SRMMU) */
+#define ASI_PADRE_MMU		0x10
+#define ASI_PADRE_TLBPROBE	0x11
+#define ASI_PADRE_ICMU		0x14
+#define ASI_PADRE_DCMU		0x15
+
+/* MMU registers (ASI_PADRE_MMU) */
+#define PADRE_MMU_CONTROL	0x04
+#define  PADRE_MMU_CONTROL_FL	0x20	/* TLB flush */
+#define  PADRE_MMU_CONTROL_NF	0x04	/* no fault trap (stack probes) */
+#define  PADRE_MMU_CONTROL_DE	0x02	/* data translation */
+#define  PADRE_MMU_CONTROL_IE	0x01	/* instruction translation */
+#define  PADRE_MMU_ON		(PADRE_MMU_CONTROL_DE | PADRE_MMU_CONTROL_IE)
+#define PADRE_MMU_DFSR		0x10
+#define  PADRE_MMU_DFSR_V	0x01	/* a fault occurred */
+#define  PADRE_MMU_DFSR_WRITE_SHIFT 9	/* bit 9: write */
+#define PADRE_MMU_IFSR		0x14
+#define PADRE_MMU_DFADDR	0x18
+#define PADRE_MMU_CACHEABLE	0x1c	/* threshold (MB of DDR), uncached beyond */
+#define PADRE_MMU_PGT		0x24	/* bus address of the page directory */
+#define  PADRE_MMU_PGT_CACHE	0x04
+#define  PADRE_MMU_PGT_FL	0x02
+#define  PADRE_MMU_PGT_EN	0x01
+
+/* Caches (ASI_PADRE_ICMU / ASI_PADRE_DCMU) */
+#define PADRE_ICMU_ITAG		0x00010000
+#define PADRE_ICMU_CTRL		0x00030000
+#define  PADRE_ICMU_CTRL_TM	0x00000002
+#define  PADRE_ICMU_CTRL_EN	0x00000001
+#define PADRE_DCMU_DTAG		0x00010000
+#define PADRE_DCMU_CTRL		0x00030000
+#define  PADRE_DCMU_CTRL_FORCE	0x00000040
+#define  PADRE_DCMU_PROBE_CLEAN	(2 << 4)
+#define  PADRE_DCMU_PROBE_INVCLN (3 << 4)
+#define  PADRE_DCMU_CTRL_TM	0x00000002
+#define  PADRE_DCMU_CTRL_EN	0x00000001
+#define PADRE_DCACHE_LINE	16
+/* LP internal memories (through its ICMU/DCMU, test mode), see 2.6.17 head.S */
+#define PADRE_ICMU_IRD		0x00020000
+#define PADRE_DCMU_DRD		0x00020000
+#define  PADRE_ICMU_CTRL_IC3	0x00000004
+#define  PADRE_DCMU_CTRL_DC3	0x00000004
+#define  PADRE_CMU_CTRL_TAG	0xfffff800
+#define PADRE_LP_IRD_SIZE	16384
+#define PADRE_LP_DRD_SIZE	4096
+
+/* Hardware page table entries (4 KB hardware pages) */
+#define _PADRE_PAGE_U		0x200	/* user accessible */
+#define _PADRE_PAGE_R		0x100
+#define _PADRE_PAGE_W		0x080
+#define _PADRE_PAGE_X		0x040
+#define _PADRE_PAGE_C		0x020	/* cacheable */
+#define _PADRE_PAGE_T		0x010	/* write-through */
+#define _PADRE_PAGE_A		0x008	/* accessed */
+#define _PADRE_PAGE_D		0x004	/* dirty */
+#define _PADRE_PAGE_Z		0x002
+#define _PADRE_PAGE_V		0x001	/* valid */
+
+/* APB peripherals (addresses seen by the kernel) */
+#define PADRE_APB		0x60000000UL
+#define PADRE_INTC0_MASK_H	(PADRE_APB + 0x00)
+#define PADRE_INTC0_MASK_L	(PADRE_APB + 0x04)
+#define PADRE_INTC0_ICAUSE_H	(PADRE_APB + 0x18)	/* read: cause, write: clear */
+#define PADRE_INTC0_ICAUSE_L	(PADRE_APB + 0x1c)
+#define PADRE_TM_CTRL		(PADRE_APB + 0x40)
+#define  PADRE_TM_CTRL_STP	0x00001000
+#define PADRE_TM_PS		(PADRE_APB + 0x44)
+#define PADRE_TM_CNTDIAG	(PADRE_APB + 0x4c)
+#define PADRE_TM_TIMER1		(PADRE_APB + 0x54)
+#define PADRE_UART0		(PADRE_APB + 0x60)	/* console, ttyS1 */
+#define PADRE_UART1		(PADRE_APB + 0x70)	/* ttyS0 */
+#define PADRE_SYS_ID		(PADRE_APB + 0x90)
+#define PADRE_SYS_CTRL		(PADRE_APB + 0x94)
+#define PADRE_MBIST_MODE	(PADRE_APB + 0x80)
+#define PADRE_MBIST_ADDR	(PADRE_APB + 0x88)
+#define PADRE_MBIST_DATA	(PADRE_APB + 0x8c)
+#define  PADRE_MBIST_MODE_EN	(1 << 0)
+#define  PADRE_MBIST_MODE_DONE	(1 << 9)
+#define PADRE_BUG505_ADDR	0x66660000UL	/* dummy write after INTC */
+#define PADRE_S3_RAMTOP_CACHEABLE 0x74000000UL	/* S3 SRAM, cacheable view */
+
+/* Timer: 50,000 ticks per second (prescaler 24), timer 1 */
+#define PADRE_PRESCALE		24
+#define PADRE_TIMER_HZ		50000
+#define PADRE_TM_SEL(x)		((x) << 13)
+#define PADRE_TM_LOAD(x)	(0x100 << (x))
+#define PADRE_TM_AUTO(x)	(0x10 << (x))
+#define PADRE_TM_INTEN(x)	(0x1 << (x))
+
+/* Interrupt sources (INTC0: 0-31 low word, 32-47 high word) */
+#define PADRE_NR_HWIRQ		48
+#define PADRE_HWIRQ_UART1	7
+#define PADRE_HWIRQ_UART0	8
+#define PADRE_HWIRQ_LEVEL_FIRST	16	/* 16-27: latched, must be cleared */
+#define PADRE_HWIRQ_LEVEL_LAST	27
+#define PADRE_HWIRQ_TIMER1	46
+
+/* iboot parameters, at 0x8000_0000 (512 bytes) */
+#define PADRE_BOOT_PARAM	0x80000000
+#define PADRE_S3_RAMTOP		0x70000000	/* S3 SRAM (dummy read) */
+#ifndef __ASSEMBLER__
+struct padre_boot_param {
+	unsigned long mem_size;
+	unsigned long cpu_type;
+	unsigned char mac[6];
+	unsigned char bond_option;
+	unsigned char boot_reason;
+	unsigned char boot_version[128];
+	unsigned char vendor[32];
+	unsigned char model[32];
+	unsigned char serial[16];
+	unsigned long product_features;
+	unsigned char vpd_extend[128];
+};
+
+extern struct padre_boot_param padre_boot_param;
+extern unsigned long padre_nocache_phys;	/* start of the uncached area */
+
+unsigned int padre_irq_virq(unsigned int hwirq);
+void padre_init_IRQ(void);
+/* padre.disable=led,hwmon,gmac,sata,pci,i2c (command line) */
+bool padre_disabled(const char *name);
+/* raw console write by polling the UART, lockless (interrupt safe) */
+int padre_prom_write(int fd, const char *buf, int len);
+void padre_flush_dcache_all(void);
+void padre_handler_irq(unsigned int pil);
+void padre_clean_dcache_range(unsigned long start, unsigned long end);
+void padre_flush_dcache_range(unsigned long start, unsigned long end);
+void padre_flush_icache_all(void);
+#endif
+
+#endif /* _ASM_SPARC_PADRE_H */
diff --git a/arch/sparc/kernel/Makefile b/arch/sparc/kernel/Makefile
index 22170d4f8e06023eb9de917e91e94254afd9a6ae..c717a775a52c30fa83fd8f968498d114728f8879 100644
--- a/arch/sparc/kernel/Makefile
+++ b/arch/sparc/kernel/Makefile
@@ -27,6 +27,7 @@ obj-y                   += traps_$(BITS).o
 # IRQ
 obj-y                   += irq_$(BITS).o
 obj-$(CONFIG_SPARC32)   += sun4m_irq.o sun4d_irq.o
+obj-$(CONFIG_SPARC_PADRE) += padre_kernel.o padre_prom.o
 
 obj-y                   += process_$(BITS).o
 obj-y                   += process.o
@@ -52,8 +53,10 @@ obj-y                   += of_device_common.o
 obj-y                   += of_device_$(BITS).o
 obj-$(CONFIG_SPARC64)   += prom_irqtrans.o
 
+ifndef CONFIG_SPARC_PADRE
 obj-$(CONFIG_SPARC32)   += leon_kernel.o
 obj-$(CONFIG_SPARC32)   += leon_pmc.o
+endif
 
 obj-$(CONFIG_SPARC64)   += reboot.o
 obj-$(CONFIG_SPARC64)   += sysfs.o
diff --git a/arch/sparc/kernel/cpu.c b/arch/sparc/kernel/cpu.c
index 79cd6ccfeac06f8ad5dfdfea87d11d4d9c2df277..6a48ee319a3f1f2bb2e7908db7cfaefaf820a456 100644
--- a/arch/sparc/kernel/cpu.c
+++ b/arch/sparc/kernel/cpu.c
@@ -445,10 +445,16 @@ static int __init cpu_type_probe(void)
 	psr_impl = ((get_psr() >> PSR_IMPL_SHIFT) & PSR_IMPL_SHIFTED_MASK);
 	psr_vers = ((get_psr() >> PSR_VERS_SHIFT) & PSR_VERS_SHIFTED_MASK);
 
+#ifdef CONFIG_SPARC_PADRE
+	/* Padre: no FPU, but PSR.EF is writable; reading %fsr traps (fp_disabled) */
+
+	set_cpu_and_fpu(psr_impl, psr_vers, 7);
+	return 0;
+#endif
 	psr = get_psr();
 	put_psr(psr | PSR_EF);
 
-	if (psr_impl == PSR_IMPL_LEON)
+	if (psr_impl == PSR_IMPL_LEON || IS_ENABLED(CONFIG_SPARC_PADRE))
 		fpu_vers = get_psr() & PSR_EF ? ((get_fsr() >> 17) & 0x7) : 7;
 	else
 		fpu_vers = ((get_fsr() >> 17) & 0x7);
diff --git a/arch/sparc/kernel/head_32.S b/arch/sparc/kernel/head_32.S
index 38345460d5420a295e941d53015d72a8c8d50be1..9a0e9d207dd0d8beded01eaf0a25b541ac83f25e 100644
--- a/arch/sparc/kernel/head_32.S
+++ b/arch/sparc/kernel/head_32.S
@@ -26,6 +26,7 @@
 #include <asm/thread_info.h>	/* TI_UWINMASK */
 #include <asm/errno.h>
 #include <asm/pgtable.h>	/* PGDIR_SHIFT */
+#include <asm/padre.h>
 
 	.data
 /* The following are used with the prom_vector node-ops to figure out
@@ -96,6 +97,91 @@ sparc_ramdisk_size:
  * a v0, v2, or v3 prom.
  */
 gokernel:
+#ifdef CONFIG_SPARC_PADRE
+		/* Padre: iboot does "go 0x80004000", with no PROM and no
+		 * usable stack. Same bring-up as the GPL 2.6.17 kernel
+		 * (arch/padre/kernel/head.S), without the LP coprocessor or
+		 * the locked IC3/DC3 cache areas.
+		 */
+		set	PADRE_MMU_CONTROL, %g1
+		set	PADRE_MMU_CONTROL_FL, %g2
+		sta	%g2, [%g1] ASI_PADRE_MMU	! flush the TLB
+		set	PADRE_MMU_ON, %g2
+		sta	%g2, [%g1] ASI_PADRE_MMU	! I and D translation
+		WRITE_PAUSE
+		nop
+
+		sethi	%hi(PADRE_BOOT_PARAM), %g3
+		set	PADRE_ICMU_CTRL, %g1
+		sta	%g0, [%g1] ASI_PADRE_ICMU	! I-cache off
+		WRITE_PAUSE
+		set	PADRE_DCMU_CTRL, %g1
+		sta	%g0, [%g1] ASI_PADRE_DCMU	! D-cache off
+		WRITE_PAUSE
+		ld	[%g3], %g0
+
+		/* Cache threshold: the last 16 MB of DDR are not cached
+		 * (page tables, DMA), boot_param.mem_size at the start.
+		 */
+		ld	[%g3], %g2
+		srl	%g2, 24, %g2
+		sub	%g2, 1, %g2
+		sll	%g2, 24, %g2
+		set	PADRE_MMU_CACHEABLE, %g1
+		sta	%g2, [%g1] ASI_PADRE_MMU
+
+		/* I-cache: clear the tags (test mode), then enable */
+		set	PADRE_ICMU_CTRL, %g1
+		set	PADRE_ICMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		set	PADRE_ICMU_ITAG, %g1
+		set	PADRE_ICMU_ITAG + 0x3ffc, %g2
+1:		sta	%g0, [%g1] ASI_PADRE_ICMU
+		cmp	%g1, %g2
+		blu	1b
+		 add	%g1, 0x4, %g1
+		set	PADRE_ICMU_CTRL, %g1
+		sta	%g0, [%g1] ASI_PADRE_ICMU
+		WRITE_PAUSE
+		set	PADRE_ICMU_CTRL_EN, %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		WRITE_PAUSE
+
+		/* D-cache: same */
+		set	PADRE_DCMU_CTRL, %g1
+		set	PADRE_DCMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		set	PADRE_DCMU_DTAG, %g1
+		set	PADRE_DCMU_DTAG + 0x3ffc, %g2
+1:		sta	%g0, [%g1] ASI_PADRE_DCMU
+		cmp	%g1, %g2
+		blu	1b
+		 add	%g1, 0x4, %g1
+		set	PADRE_S3_RAMTOP, %g3
+		set	PADRE_DCMU_CTRL, %g1
+		set	PADRE_DCMU_CTRL_EN, %g2
+		sta	%g0, [%g1] ASI_PADRE_DCMU
+		WRITE_PAUSE
+		ld	[%g3], %g0
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		WRITE_PAUSE
+		ld	[%g3], %g0
+
+		/* Marker 'P' on the console (UART 0x6000_0060): MMU and
+		 * caches set up, the kernel is running.
+		 */
+		set	0x60000060, %g1
+		mov	'P', %g2
+		st	%g2, [%g1]
+
+		/* "PROM" emulated by the kernel (padre_prom.c) */
+		set	padre_romvec, %o0
+		sethi	%hi(prom_vector_p), %g1
+		st	%o0, [%g1 + %lo(prom_vector_p)]
+		set	continue_boot, %g1
+		jmpl	%g1, %g0
+		 nop
+#endif
 		/* Ok, it's nice to know, as early as possible, if we
 		 * are already mapped where we expect to be in virtual
 		 * memory.  The Solaris /boot elf format bootloader
@@ -516,7 +602,11 @@ continue_boot:
 		/* Turn on Supervisor, EnableFloating, and all the PIL bits.
 		 * Also puts us in register window zero with traps off.
 		 */
+#ifdef CONFIG_SPARC_PADRE
+		set	(PSR_PS | PSR_S | PSR_PIL), %g2	! no FPU
+#else
 		set	(PSR_PS | PSR_S | PSR_PIL | PSR_EF), %g2
+#endif
 		wr	%g2, 0x0, %psr
 		WRITE_PAUSE
 
@@ -667,6 +757,13 @@ continue_boot:
 		wr	%g3, PSR_ET, %psr
 		WRITE_PAUSE
 
+#ifdef CONFIG_SPARC_PADRE
+		/* Marker 'K': stack, BSS and trap table in place */
+
+		set	0x60000060, %g1
+		mov	'K', %g2
+		st	%g2, [%g1]
+#endif
 		/* Call sparc32_start_kernel(struct linux_romvec *rp) */
 		sethi	%hi(prom_vector_p), %g5
 		ld	[%g5 + %lo(prom_vector_p)], %o0
diff --git a/arch/sparc/kernel/ioport.c b/arch/sparc/kernel/ioport.c
index 5ebca5c7af1ead154956fb61fd68deb24e5c2108..50ddb65a5815e21e0062b41fe0d11baf93bcd15d 100644
--- a/arch/sparc/kernel/ioport.c
+++ b/arch/sparc/kernel/ioport.c
@@ -51,11 +51,14 @@
 #include <asm/iommu.h>
 #include <asm/io-unit.h>
 #include <asm/leon.h>
