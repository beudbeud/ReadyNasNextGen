@@ -164,6 +167,41 @@ int ksmbd_iov_pin_rsp_read(struct ksmbd_work *work, void *ib, int len,
 	return __ksmbd_iov_pin_rsp(work, ib, len, aux_buf, aux_size);
 }
 
+/* a read response whose data is n kvecs (page cache pages, zero-copy) */
+int ksmbd_iov_pin_rsp_pages(struct ksmbd_work *work, void *ib, int len,
+			    struct kvec *data, unsigned int n)
+{
+	unsigned int i, size = 0;
+
+	if (work->iov_alloc_cnt < work->iov_cnt + n + 2) {
+		int cnt = work->iov_cnt + n + 4;
+		struct kvec *new = krealloc(work->iov, sizeof(struct kvec) * cnt,
+					    KSMBD_DEFAULT_GFP | __GFP_ZERO);
+
+		if (!new)
+			return -ENOMEM;
+		work->iov = new;
+		work->iov_alloc_cnt = cnt;
+	}
+
+	if (!work->iov_idx) {
+		work->iov[work->iov_idx].iov_base = work->response_buf;
+		*(__be32 *)work->iov[0].iov_base = 0;
+		work->iov[work->iov_idx].iov_len = 4;
+		work->iov_cnt++;
+	}
+
+	__ksmbd_iov_pin(work, ib, len);
+	inc_rfc1001_len(work->iov[0].iov_base, len);
+	for (i = 0; i < n; i++) {
+		__ksmbd_iov_pin(work, data[i].iov_base, data[i].iov_len);
+		size += data[i].iov_len;
+	}
+	inc_rfc1001_len(work->iov[0].iov_base, size);
+	work->read_iov_n = n;
+	return 0;
+}
+
 int allocate_interim_rsp_buf(struct ksmbd_work *work)
 {
 	work->response_buf = kzalloc(MAX_CIFS_SMALL_BUFFER_SIZE, KSMBD_DEFAULT_GFP);
