+/* zero-copy read: one kvec per piece of page cache page, a reference held */
+struct ksmbd_zc {
+	struct kvec *vec;
+	struct page **pages;
+	unsigned int n, max;
+};
+
+static int ksmbd_zc_actor(struct pipe_inode_info *pipe, struct pipe_buffer *buf,
+			  struct splice_desc *sd)
+{
+	struct ksmbd_zc *zc = sd->u.data;
+	struct page *page = buf->page + buf->offset / PAGE_SIZE;	/* may be a compound one */
+	unsigned int off = buf->offset % PAGE_SIZE, left = sd->len;
+
+	if (PageHighMem(page))
+		return -EOPNOTSUPP;
+	while (left) {
+		unsigned int part = min_t(unsigned int, left, PAGE_SIZE - off);
+
+		if (zc->n == zc->max)
+			return sd->len - left ?: -ENOSPC;
+		get_page(page);
+		zc->pages[zc->n] = page;
+		zc->vec[zc->n].iov_base = page_address(page) + off;
+		zc->vec[zc->n].iov_len = part;
+		zc->n++;
+		left -= part;
+		off = 0;
+		page++;
+	}
+	return sd->len;
+}
+
+static int ksmbd_zc_direct_actor(struct pipe_inode_info *pipe,
+				 struct splice_desc *sd)
+{
+	return __splice_from_pipe(pipe, sd, ksmbd_zc_actor);
+}
+
+/**
+ * ksmbd_vfs_splice_read() - read without copying: the data stays in the page
+ * cache, *vec (kvfree it) points into its pages, whose references are kept in
+ * the work until it is freed. Same checks as ksmbd_vfs_read(); -EOPNOTSUPP:
+ * use ksmbd_vfs_read().
+ */
+ssize_t ksmbd_vfs_splice_read(struct ksmbd_work *work, struct ksmbd_file *fp,
+			      size_t count, loff_t *pos, struct kvec **vec,
+			      unsigned int *nvec)
+{
+	struct file *filp = fp->filp;
+	struct ksmbd_zc zc = { .max = count / PAGE_SIZE + 3 };
+	struct splice_desc sd = {
+		.total_len	= count,
+		.pos		= *pos,
+		.u.data		= &zc,
+	};
+	loff_t p = *pos;
+	ssize_t nbytes;
+
+	if (S_ISDIR(file_inode(filp)->i_mode) || ksmbd_stream_fd(fp) ||
+	    !filp->f_op->splice_read || work->zc_nr || !count)
+		return -EOPNOTSUPP;
+
+	if (work->conn->connection_type) {
+		if (!(fp->daccess & (FILE_READ_DATA_LE | FILE_EXECUTE_LE))) {
+			pr_err("no right to read(%pD)\n", fp->filp);
+			return -EACCES;
+		}
+	}
+
+	if (!work->tcon->posix_extensions) {
+		if (check_lock_range(filp, *pos, *pos + count - 1, READ)) {
+			pr_err("unable to read due to lock\n");
+			return -EAGAIN;
+		}
+	}
+
+	zc.vec = kvmalloc_array(zc.max, sizeof(*zc.vec), KSMBD_DEFAULT_GFP);
+	zc.pages = kvmalloc_array(zc.max, sizeof(*zc.pages), KSMBD_DEFAULT_GFP);
+	if (!zc.vec || !zc.pages) {
+		nbytes = -ENOMEM;
+		goto fail;
+	}
+
+	nbytes = rw_verify_area(READ, filp, &p, count);
+	if (!nbytes)
+		nbytes = splice_direct_to_actor(filp, &sd, ksmbd_zc_direct_actor);
+	if (nbytes < 0)
+		goto fail;
+
+	*pos += nbytes;
+	filp->f_pos = *pos;
+	work->zc_pages = zc.pages;
+	work->zc_nr = zc.n;
+	*vec = zc.vec;
+	*nvec = zc.n;
+	return nbytes;
+
+fail:
+	while (zc.n)
+		put_page(zc.pages[--zc.n]);
+	kvfree(zc.pages);
+	kvfree(zc.vec);
+	return nbytes == -ENOMEM ? nbytes : -EOPNOTSUPP;
+}
+
 static int ksmbd_vfs_stream_write(struct ksmbd_file *fp, char *buf, loff_t *pos,
 				  size_t count)
 {
