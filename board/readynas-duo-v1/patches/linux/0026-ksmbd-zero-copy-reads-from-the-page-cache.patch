 	return ksmbd_tcp_readv(TCP_TRANS(t), &iov, 1, to_read, max_retries);
 }
 
+/* a piece of a page cache page (zero-copy read), not slab or vmalloc memory */
+static bool ksmbd_tcp_page_cache(const struct kvec *v)
+{
+	struct folio *f;
+
+	if (!v->iov_len || !virt_addr_valid(v->iov_base))
+		return false;
+	f = virt_to_folio(v->iov_base);
+	return !folio_test_slab(f) && !folio_test_anon(f) && READ_ONCE(f->mapping) &&
+	       offset_in_page(v->iov_base) + v->iov_len <= PAGE_SIZE;
+}
+
 static int ksmbd_tcp_writev(struct ksmbd_transport *t, struct kvec *iov,
 			    int nvecs, int size, bool need_invalidate,
 			    unsigned int remote_key)
 
 {
-	struct msghdr smb_msg = {.msg_flags = MSG_NOSIGNAL};
+	struct socket *sock = TCP_TRANS(t)->sock;
+	int i = 0, sent = 0;
 
-	return kernel_sendmsg(TCP_TRANS(t)->sock, &smb_msg, iov, nvecs, size);
+	/* runs of kvecs: copied, or (page cache pages of a zero-copy read)
+	 * referenced by the socket buffers, MSG_SPLICE_PAGES
+	 */
+	while (i < nvecs) {
+		bool pc = ksmbd_tcp_page_cache(&iov[i]);
+		struct msghdr msg = {.msg_flags = MSG_NOSIGNAL};
+		int j = i, len = 0, r;
+
+		while (j < nvecs && ksmbd_tcp_page_cache(&iov[j]) == pc)
+			len += iov[j++].iov_len;
+		if (pc)
+			msg.msg_flags |= MSG_SPLICE_PAGES;
+		if (j < nvecs)
+			msg.msg_flags |= MSG_MORE;
+		iov_iter_kvec(&msg.msg_iter, ITER_SOURCE, &iov[i], j - i, len);
+		r = sock_sendmsg(sock, &msg);
+		if (r < 0)
+			return sent ?: r;
+		sent += r;
+		if (r < len)
+			return sent;
+		i = j;
+	}
+	return sent;
 }
 
