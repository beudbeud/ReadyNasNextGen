@@ -1450,6 +1705,7 @@ static const struct net_device_ops gm_ops = {
 	.ndo_set_mac_address	= gm_set_mac,
 	.ndo_tx_timeout		= gm_tx_timeout,
 	.ndo_set_features	= gm_set_features,
