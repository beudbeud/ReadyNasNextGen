@@ -1415,6 +1668,8 @@ static void gm_get_ethtool_stats(struct net_device *dev, struct ethtool_stats *s
 	v[6] = tx_meta;
 	v[7] = tx_und;
 	v[8] = tx_fallback;
+	v[9] = tx_tso;
