+/* GSO frames the engine segments as the stack wants: TCP over IPv4 without
+ * options, headers + gso_size = GMT0_MSS, at 1000 Mbit/s like 2.6.17; and
+ * buffers the engine takes as they are (gm_xmit would linearize the whole
+ * frame, up to 64 KiB, where the stack's segments copy 1.5 KiB at most:
+ * the 4-byte record marker of an NFS reply)
+ */
+static netdev_features_t gm_features_check(struct sk_buff *skb, struct net_device *dev,
+					   netdev_features_t f)
+{
+	if (skb_is_gso(skb) &&
+	    (!READ_ONCE(eng_ok) || gspeed != 1000 || skb->protocol != htons(ETH_P_IP) ||
+	     !(skb_shinfo(skb)->gso_type & SKB_GSO_TCPV4) || ip_hdr(skb)->ihl != 5 ||
+	     skb_transport_offset(skb) != ETH_HLEN + sizeof(struct iphdr) ||
+	     sizeof(struct iphdr) + tcp_hdrlen(skb) + skb_shinfo(skb)->gso_size != ETH_DATA_LEN ||
+	     !tx_sg_ok(skb)))
+		f &= ~NETIF_F_GSO_MASK;
+	return f;
+}
+
 static netdev_tx_t gm_xmit(struct sk_buff *skb, struct net_device *dev)
 {
 	bool eng = READ_ONCE(eng_ok);
 	int need = -1, meta = -1;
 
-	if (skb->len > RXBUF)
+	if (skb_is_gso(skb)) {
+		/* the engine was turned off after gm_features_check: TCP sends again */
+		if (!eng || !tx_hw_ok(skb)) {
