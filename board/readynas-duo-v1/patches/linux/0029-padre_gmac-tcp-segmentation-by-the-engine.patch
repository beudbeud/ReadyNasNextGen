 			goto drop;
 		tx_csum_sw++;
@@ -1227,6 +1277,176 @@ static int vt_set(const char *val, const struct kernel_param *kp)
 static const struct kernel_param_ops vt_ops = { .set = vt_set };
 module_param_cb(tx_csum_verify, &vt_ops, NULL, 0200);
 
+/* ---------- tso_verify: what the engine makes of a long TCP frame ----------
+ *
+ * echo 1 > /sys/module/padre_gmac/parameters/tso_verify (link up, the network
+ * stops for a few seconds). A TCP frame shaped like a GSO frame of the stack
+ * (IP total length and checksum of the whole frame, 12 bytes of timestamp
+ * option, ACK+PSH+FIN, pseudo-header sum of the whole length) goes out
+ * with the command 00->c0 in MAC loopback; every frame that comes back is
+ * checked: IP length, id and checksum, sequence, flags, TCP checksum, header
+ * fields and data. Seen on the NAS: segments of 1500 bytes of IP whatever
+ * the TCP header length, ids counting up, both checksums, sequence and
+ * flags right (PSH and FIN on the last one only); the engine computes the
+ * pseudo-header itself (a field of 0 or without the length gives the same).
+ */
+#define TV_HDR	(ETH_HLEN + 20 + 32)
+#define TV_SEQ	0x10000000u
+#define TV_MSS	(ETH_DATA_LEN - 20 - 32)
+
+static u8 tv_byte(unsigned int i)
+{
+	return i ^ (i >> 8) ^ 0x5a;
+}
+
+/* pay bytes of payload, hpay of them after the headers, the rest in two
+ * fragments of pg (the first one at an odd address)
+ */
+static struct sk_buff *tv_frame(struct net_device *dev, struct page *pg, unsigned int pay,
+				unsigned int hpay)
+{
+	struct sk_buff *skb = alloc_skb(NET_IP_ALIGN + TV_HDR + hpay, GFP_KERNEL);
+	unsigned int rest = pay - hpay, f1 = min(rest, 5001u), i;
+	u8 *p, *d = page_address(pg);
+	struct iphdr *iph;
+	struct tcphdr *th;
+
+	if (!skb)
+		return NULL;
+	skb_reserve(skb, NET_IP_ALIGN);
+	p = skb_put_zero(skb, TV_HDR + hpay);
+	memcpy(p, dev->dev_addr, ETH_ALEN);
+	memcpy(p + ETH_ALEN, dev->dev_addr, ETH_ALEN);
+	p[12] = 0x08;
+	iph = (struct iphdr *)(p + ETH_HLEN);
+	th = (struct tcphdr *)(iph + 1);
+	iph->version = 4;
+	iph->ihl = 5;
+	iph->tot_len = htons(20 + 32 + pay);
+	iph->id = htons(0x1234);
+	iph->frag_off = htons(IP_DF);
+	iph->ttl = 64;
+	iph->protocol = IPPROTO_TCP;
+	iph->saddr = htonl(0xc0000201);
+	iph->daddr = htonl(0xc0000202);
+	iph->check = ip_fast_csum(iph, 5);
+	th->source = htons(0x1111);
+	th->dest = htons(0x2222);
+	th->seq = htonl(TV_SEQ);
+	th->ack_seq = htonl(0x20000000);
+	th->doff = 8;
+	th->ack = th->psh = th->fin = 1;
+	th->window = htons(0x1000);
+	memcpy(th + 1, "\x01\x01\x08\x0a\x01\x02\x03\x04\x05\x06\x07\x08", 12);
+	th->check = ~csum_tcpudp_magic(iph->saddr, iph->daddr, 32 + pay, IPPROTO_TCP, 0);
+	for (i = 0; i < hpay; i++)
+		p[TV_HDR + i] = tv_byte(i);
+	for (i = 0; i < rest; i++)
+		d[3 + i + (i >= f1)] = tv_byte(hpay + i);
+	if (f1) {
+		get_page(pg);
+		skb_fill_page_desc(skb, 0, pg, 3, f1);
+	}
+	if (rest > f1) {
+		get_page(pg);
+		skb_fill_page_desc(skb, 1, pg, 4 + f1, rest - f1);
+	}
+	skb->len += rest;
+	skb->data_len = rest;
+	skb->truesize += rest;
+	return skb;
+}
+
+/* one frame: 0 if it came back as the stack expects the segments */
+static int tv_run(struct net_device *dev, struct page *pg, unsigned int pay,
+		  unsigned int hpay, bool detail)
+{
+	unsigned int n = 0, got = 0, bad = 0, nseg = DIV_ROUND_UP(pay, TV_MSS);
+	struct sk_buff *skb, *b;
+
+	hw_restart(dev, true);
+	skb = tv_frame(dev, pg, pay, hpay);
+	if (!skb)
+		return -ENOMEM;
+	skb_queue_purge(&tv_q);
+	local_bh_disable();
+	spin_lock(&glock);
+	tx_put(skb, 0x00c0);
+	spin_unlock(&glock);
+	local_bh_enable();
+	msleep(300);
+	while ((b = skb_dequeue(&tv_q))) {
+		const struct iphdr *iph = (const struct iphdr *)(b->data + ETH_HLEN);
+		const struct tcphdr *th = (const struct tcphdr *)(iph + 1);
+		unsigned int tot = ntohs(iph->tot_len), off = ntohl(th->seq) - TV_SEQ, i, dl;
+		bool last = off + TV_MSS >= pay, ipok, tcpok, dok = true, hok;
+		u8 fl = ((const u8 *)th)[13], want = last ? 0x19 : 0x10;
+
+		if (b->len < TV_HDR || tot < 52 || tot + ETH_HLEN > b->len) {
+			netdev_info(dev, "tso_verify seg %u: %u bytes, unreadable\n", n, b->len);
+			bad++;
+			goto next;
+		}
+		dl = tot - 52;
+		ipok = !ip_fast_csum(iph, 5);
+		tcpok = !csum_tcpudp_magic(iph->saddr, iph->daddr, tot - 20, IPPROTO_TCP,
+					   csum_partial(th, tot - 20, 0));
+		hok = th->source == htons(0x1111) && th->dest == htons(0x2222) &&
+		      th->ack_seq == htonl(0x20000000) && th->window == htons(0x1000) &&
+		      !memcmp(th + 1, "\x01\x01\x08\x0a\x01\x02\x03\x04\x05\x06\x07\x08", 12) &&
+		      th->doff == 8 && iph->ttl == 64 && iph->frag_off == htons(IP_DF);
+		for (i = 0; i < dl && dok; i++)
+			dok = b->data[TV_HDR + i] == tv_byte(off + i);
+		got += dl;
+		if (!ipok || !tcpok || !dok || !hok || fl != want || off != n * TV_MSS ||
+		    dl != min(TV_MSS, pay - off))
+			bad++;
+		if (detail || bad == 1)
+			netdev_info(dev, "tso_verify seg %2u: ip len %4u id %04x csum %s, seq +%5u flags %02x, tcp csum %s, header %s, data %s\n",
+				    n, tot, ntohs(iph->id), ipok ? "ok" : "BAD", off, fl,
+				    tcpok ? "ok" : "BAD", hok ? "ok" : "BAD", dok ? "ok" : "BAD");
+next:
+		n++;
+		kfree_skb(b);
+	}
+	netdev_info(dev, "tso_verify %u bytes (%u in the head): %u frames back for %u segments, %u data bytes, %u wrong: %s\n",
+		    pay, hpay, n, nseg, got, bad,
+		    n == nseg && got == pay && !bad ? "as the stack expects" : "NOT as expected");
+	return n == nseg && got == pay && !bad ? 0 : -EIO;
+}
+
+static int tv_set(const char *val, const struct kernel_param *kp)
+{
+	static const unsigned int pays[] = { 3 * TV_MSS + 101, 25000, 60000 };
+	struct page *pg;
+	int r = -ENETDOWN, i, bad = 0;
+
+	if (!gdev)
+		return r;
+	pg = alloc_pages(GFP_KERNEL | __GFP_COMP, get_order(65536));
+	if (!pg)
+		return -ENOMEM;
+	rtnl_lock();
+	if (netif_running(gdev) && glink) {
+		netdev_info(gdev, "tso_verify: MAC loopback, the network stops for a few seconds\n");
+		netif_device_detach(gdev);
+		gtest = 2;
+		for (i = 0; i < ARRAY_SIZE(pays); i++)
+			bad += !!tv_run(gdev, pg, pays[i], i ? 100 : 0, !i);
+		gtest = 0;
+		skb_queue_purge(&tv_q);
+		hw_restart(gdev, false);
+		netif_device_attach(gdev);
+		r = bad ? -EIO : 0;
+	}
+	rtnl_unlock();
+	put_page(pg);
+	return r;
+}
+
+static const struct kernel_param_ops tv_ops = { .set = tv_set };
+module_param_cb(tso_verify, &tv_ops, NULL, 0200);
+
 /* tx_csum: the feature without an ethtool binary (serial console) */
 static int tc_set(const char *val, const struct kernel_param *kp)
 {
@@ -1280,6 +1500,38 @@ static int sg_get(char *buf, const struct kernel_param *kp)
 static const struct kernel_param_ops sg_ops = { .set = sg_set, .get = sg_get };
 module_param_cb(sg, &sg_ops, NULL, 0644);
 
+/* tso: segmentation by the engine without an ethtool binary (needs tx_csum
+ * and sg, the stack drops it otherwise). Read back: the device features.
+ */
+static int tso_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+	int r = kstrtobool(val, &on);
+
+	if (r)
+		return r;
+	if (!gdev) {			/* on the command line: gm_init reads it */
+		tso_on = on;
+		return 0;
+	}
+	rtnl_lock();
+	if (on)
+		gdev->wanted_features |= NETIF_F_TSO;
+	else
+		gdev->wanted_features &= ~NETIF_F_TSO;
+	netdev_update_features(gdev);
+	rtnl_unlock();
+	return 0;
+}
+
+static int tso_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%c\n", gdev && (gdev->features & NETIF_F_TSO) ? 'Y' : 'N');
+}
+
+static const struct kernel_param_ops tso_ops = { .set = tso_set, .get = tso_get };
+module_param_cb(tso, &tso_ops, NULL, 0644);
+
 /* ---------- open / close ---------- */
 
