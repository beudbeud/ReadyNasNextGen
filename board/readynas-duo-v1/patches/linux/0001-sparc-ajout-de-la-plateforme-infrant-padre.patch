+++ b/arch/sparc/kernel/padre_pci.c	2026-11-16 23:47:56.615174693 +0100
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_pci.c : pont PCI de l'Infrant IT3107 « Padre » (USB VIA du
+ * ReadyNAS Duo v1 : UHCI 00:17.0/1, EHCI 00:17.2).
+ *
+ * D'après arch/padre/kernel/pcic.c et setup.c du noyau GPL 2.6.17 :
+ *   - configuration par CONFIG_ADDRESS/CONFIG_DATA (0x6… : bus 0x1000_0cf8/
+ *     0x1000_0cfc, vus en 0x5000_0cf8/cfc), mots de 32 bits lus tels quels ;
+ *   - réinitialisation du bus (SYS_CTRL bit 16) et PCI_FEATURE = 0x302c sur
+ *     les cartes « P0 » (le Duo) ; PCI_SWAP = 0x4444 : le pont permute les
+ *     accès du processeur, les registres des cartes se lisent donc sans
+ *     permutation logicielle (d'où big_endian_mmio pour l'EHCI) ;
+ *   - mémoire PCI 0x1001_0000… vue par le processeur en 0x5c01_0000…
+ *     (adresse « physique » Linux 0x1c01_0000…, soit PCI + 0x0c00_0000) ;
+ *     les E/S PCI ne sont pas reprises (pas d'UHCI) ;
+ *   - IRQ : broche INTA (source 27) pour l'USB VIA sur le Duo (FireDance).
+ *   - DMA : adresse PCI = adresse physique Linux (bus AHB, DDR 0x4…).
+ *
+ * Non vérifié sur le matériel.
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/pci.h>
+#include <linux/io.h>
+#include <linux/spinlock.h>
+#include <linux/delay.h>
+#include <linux/printk.h>
+#include <linux/dma-map-ops.h>
+#include <linux/dma-mapping.h>
+#include <linux/slab.h>
+
+#include <asm/padre.h>
+
+#define PCI_CFG_ADDR	((void __iomem *)0x50000cf8UL)
+#define PCI_CFG_DATA	((void __iomem *)0x50000cfcUL)
+#define PCI_CFG_EN	0x80000000
+#define PADRE_PCI_SWAP	((void __iomem *)(PADRE_APB + 0x104))
+#define PADRE_PCI_FEAT	((void __iomem *)(PADRE_APB + 0x10c))
+
+#define PCI_MEM_CPU	0x1c010000UL	/* adresse physique Linux */
+#define PCI_MEM_BUS	0x10010000UL	/* PCIBIOS_MIN_MEM du 2.6.17 */
+#define PCI_MEM_SIZE	0x00ff0000UL
+
+#define HWIRQ_PINTA	27
+#define HWIRQ_PINTB	26
+
+static DEFINE_RAW_SPINLOCK(padre_pci_lock);
+
+static u32 cfg_cmd(struct pci_bus *bus, unsigned int devfn, int where)
+{
+	return PCI_CFG_EN | (bus->number << 16) | (devfn << 8) | (where & 0xfc);
+}
+
+static int padre_pci_rd(struct pci_bus *bus, unsigned int devfn, int where,
+			int size, u32 *val)
+{
+	unsigned long flags;
+	u32 v;
+
+	if (bus->number != 0)
+		return PCIBIOS_DEVICE_NOT_FOUND;
+	raw_spin_lock_irqsave(&padre_pci_lock, flags);
+	__raw_writel(cfg_cmd(bus, devfn, where), PCI_CFG_ADDR);
+	v = __raw_readl(PCI_CFG_DATA);
+	__raw_writel(0, PCI_CFG_ADDR);
+	raw_spin_unlock_irqrestore(&padre_pci_lock, flags);
+
+	switch (size) {
+	case 1:
+		*val = (v >> (8 * (where & 3))) & 0xff;
+		break;
+	case 2:
+		*val = (v >> (8 * (where & 2))) & 0xffff;
+		break;
+	default:
+		*val = v;
+	}
+	return PCIBIOS_SUCCESSFUL;
+}
+
+static int padre_pci_wr(struct pci_bus *bus, unsigned int devfn, int where,
+			int size, u32 val)
+{
+	unsigned long flags;
+	u32 v = 0, shift = 8 * (where & 3);
+
+	if (bus->number != 0)
+		return PCIBIOS_DEVICE_NOT_FOUND;
+	if (size != 4)
+		padre_pci_rd(bus, devfn, where, 4, &v);
+	if (size == 1)
+		v = (v & ~(0xff << shift)) | ((val & 0xff) << shift);
+	else if (size == 2)
+		v = (v & ~(0xffff << shift)) | ((val & 0xffff) << shift);
+	else
+		v = val;
+
+	raw_spin_lock_irqsave(&padre_pci_lock, flags);
+	__raw_writel(cfg_cmd(bus, devfn, where), PCI_CFG_ADDR);
+	__raw_writel(v, PCI_CFG_DATA);
+	__raw_writel(0, PCI_CFG_ADDR);
+	raw_spin_unlock_irqrestore(&padre_pci_lock, flags);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+static struct pci_ops padre_pci_ops = {
+	.read	= padre_pci_rd,
+	.write	= padre_pci_wr,
+};
+
+/* pcibios_fixup_irqs du 2.6.17 : emplacements 21/22 = INTA/INTB ; ailleurs
+ * INTB va sur INTA pour la carte 1 (Duo), sur INTB pour les autres.
+ */
+static int padre_map_irq(const struct pci_dev *dev, u8 slot, u8 pin)
+{
+	unsigned int hw;
+
+	if (slot == 21)
+		hw = HWIRQ_PINTA;
+	else if (slot == 22)
+		hw = HWIRQ_PINTB;
+	else if (pin == 2 && padre_boot_param.vpd_extend[0] != 1)
+		hw = HWIRQ_PINTB;
+	else
+		hw = HWIRQ_PINTA;
+	return padre_irq_virq(hw);
+}
+
+/* padre.pcibus=<8 chiffres hex> : décalage ajouté (modulo 2^32) à l'adresse
+ * physique Linux de la DDR (0x4000_0000…) pour obtenir l'adresse vue du bus
+ * PCI par les maîtres (EHCI). 00000000 = adresse de bus = adresse AHB, comme
+ * virt_to_bus du 2.6.17 ; c0000000 = DDR vue en 0 sur le bus PCI.
+ * Essai 15:50 : « Received Master Abort » sur la 1re lecture d'un QH en
+ * 0x4f80_0000 : personne ne décode cette adresse côté PCI.
+ */
+static u32 padre_pcibus;
+
+static int __init padre_pcibus_param(char *s)
+{
+	return s ? kstrtou32(s, 16, &padre_pcibus) : 0;
+}
+early_param("padre.pcibus", padre_pcibus_param);
+
+/* padre.pcifeat=<4 hex> : valeur de PCI_FEATURE. 302c = comme le 2.6.17
+ * sur IT3107 (« PZERO ») : réinitialisation du bus PCI puis 0x302c ;
+ * toute autre valeur est écrite SANS réinitialisation (0128 = valeur laissée
+ * par iboot, qui lit la clé USB par DMA ; 002e = autre branche du 2.6.17).
+ */
+static u32 padre_pcifeat = 0x302c;
+
+static int __init padre_pcifeat_param(char *s)
+{
+	return s ? kstrtou32(s, 16, &padre_pcifeat) : 0;
+}
+early_param("padre.pcifeat", padre_pcifeat_param);
+
+/* padre.pciswap=<4 hex> : PCI_SWAP posé après l'énumération. 4444 = 2.6.17
+ * (registres EHCI lus sans permutation : big_endian_mmio) ; 0000 = comme
+ * iboot (accès petit-boutistes standard, readl permute). Lu par ehci-pci.
+ */
+u32 padre_pciswap = 0x4444;
+
+static int __init padre_pciswap_param(char *s)
+{
+	return s ? kstrtou32(s, 16, &padre_pciswap) : 0;
+}
+early_param("padre.pciswap", padre_pciswap_param);
+
+/* set_ahbarb() du 2.6.17 (setup.c) : arbitrage AHB, CONFIG_PADRE_AHBARB = 7
+ * (asm-padre/io.h), écrit tel quel : writel(7 << 16, SYS_STRAP). Le 6.18 ne
+ * le faisait pas (SYS_STRAP valait 0x76) ; sans arbitrage pour le maître
+ * PCI, ses accès à la DDR pourraient ne jamais être servis (Master Abort).
+ * padre.ahbarb=<0|1|3|7>, autre valeur = ne rien écrire.
+ */
+static u32 padre_ahbarb = 7;
+
+static int __init padre_ahbarb_param(char *s)
+{
+	return s ? kstrtou32(s, 16, &padre_ahbarb) : 0;
+}
+early_param("padre.ahbarb", padre_ahbarb_param);
+
+/* pcibios_set_master du 2.6.17 (pcic.c) : latence 128 */
+void pcibios_set_master(struct pci_dev *dev)
+{
+	pci_write_config_byte(dev, PCI_LATENCY_TIMER, 128);
+}
+
+/* Registres du pont PCI Padre (APB + 0x100…0x13c) et du système, pour
+ * comprendre la fenêtre d'entrée PCI→DDR (mise au point). */
+static void __init padre_pci_regs(const char *quand)
+{
+	void __iomem *r = (void __iomem *)(PADRE_APB + 0x100);
+	int i;
+
+	for (i = 0; i < 0x40; i += 0x10)
+		pr_info("padre_pci: %s : pont +%02x : %08x %08x %08x %08x\n", quand,
+			0x100 + i, __raw_readl(r + i), __raw_readl(r + i + 4),
+			__raw_readl(r + i + 8), __raw_readl(r + i + 12));
+	pr_info("padre_pci: %s : SYS_ID %08x SYS_CTRL %08x SYS_STRAP %08x\n", quand,
+		__raw_readl((void __iomem *)PADRE_SYS_ID),
+		__raw_readl((void __iomem *)PADRE_SYS_CTRL),
+		__raw_readl((void __iomem *)(PADRE_APB + 0x98)));
+}
+
+static struct resource padre_pci_mem = {
+	.name	= "PCI mémoire Padre",
+	.start	= PCI_MEM_CPU,
+	.end	= PCI_MEM_CPU + PCI_MEM_SIZE - 1,
+	.flags	= IORESOURCE_MEM,
+};
+
+static struct resource padre_pci_busn = {
+	.name	= "PCI bus Padre",
+	.start	= 0,
+	.end	= 0,
+	.flags	= IORESOURCE_BUS,
+};
+
+static int __init padre_pci_init(void)
+{
+	struct pci_host_bridge *bridge;
+	int ret;
+
+	u32 sys;
+
+	if (padre_desactive("pci"))
+		return 0;
+	padre_pci_regs("avant");
+	if (padre_ahbarb == 0 || padre_ahbarb == 1 || padre_ahbarb == 3 ||
+	    padre_ahbarb == 7) {
+		__raw_writel(padre_ahbarb << 16, (void __iomem *)(PADRE_APB + 0x98));
+		pr_info("padre_pci: arbitrage AHB %u (SYS_STRAP <- %08x, relu %08x)\n",
+			padre_ahbarb, padre_ahbarb << 16,
+			__raw_readl((void __iomem *)(PADRE_APB + 0x98)));
+	}
+	sys = __raw_readl((void __iomem *)PADRE_SYS_CTRL);
+	pr_info("padre_pci: début (SYS_CTRL=%08x PCI_FEATURE=%08x PCI_SWAP=%08x)\n", sys,
+		__raw_readl(PADRE_PCI_FEAT), __raw_readl(PADRE_PCI_SWAP));
+	/* setup.c 2.6.17, cartes P0 : mêmes écritures du registre entier
+	 * (0x10000 puis 0). Ne pas faire de lecture-modification-écriture : le
+	 * bit 13 (0x2000, mis par head_32.S) lance le LP, le réécrire pourrait le
+	 * relancer.
+	 */
+	if (padre_pcifeat == 0x302c) {
+		__raw_writel(0x10000, (void __iomem *)PADRE_SYS_CTRL);
+		__raw_writel(0x302c, PADRE_PCI_FEAT);
+		__raw_writel(0, (void __iomem *)PADRE_SYS_CTRL);
+		msleep(200);	/* PCI : >= 100 ms avant la 1re configuration */
+	} else {
+		__raw_writel(padre_pcifeat, PADRE_PCI_FEAT);
+		msleep(10);
+	}
+	pr_info("padre_pci: PCI_FEATURE=%04x (%s)\n", padre_pcifeat,
+		padre_pcifeat == 0x302c ? "avec réinitialisation du bus" :
+		"sans réinitialisation");
+	pr_info("padre_pci: bus réinitialisé, énumération\n");
+
+	bridge = pci_alloc_host_bridge(0);
+	if (!bridge)
+		return -ENOMEM;
+	if (request_resource(&iomem_resource, &padre_pci_mem))
+		pr_warn("padre_pci: fenêtre mémoire déjà prise\n");
+	pci_add_resource_offset(&bridge->windows, &padre_pci_mem,
+				PCI_MEM_CPU - PCI_MEM_BUS);
+	pci_add_resource(&bridge->windows, &padre_pci_busn);
+	bridge->busnr = 0;
+	bridge->ops = &padre_pci_ops;
+	bridge->map_irq = padre_map_irq;
+	bridge->swizzle_irq = pci_common_swizzle;
+
+	ret = pci_scan_root_bus_bridge(bridge);
+	if (ret) {
+		pci_free_host_bridge(bridge);
+		return ret;
+	}
+	pci_assign_unassigned_bus_resources(bridge->bus);
+	/* comme le 2.6.17 : permutation posée après énumération et adresses */
+	__raw_writel(padre_pciswap, PADRE_PCI_SWAP);
+	pr_info("padre_pci: PCI_SWAP=0x%04x, ajout des périphériques\n", padre_pciswap);
+	padre_pci_regs("après");
+	if (padre_pcibus) {
+		struct pci_dev *pdev;
+
+		/* adresse DMA = adresse physique + décalage, pour 1 Go de DDR */
+		list_for_each_entry(pdev, &bridge->bus->devices, bus_list)
+			if (dma_direct_set_offset(&pdev->dev, PADRE_PHYS_DDR,
+						  (u32)(PADRE_PHYS_DDR + padre_pcibus),
+						  0x40000000))
+				pci_warn(pdev, "padre : décalage DMA refusé\n");
+	}
+	pr_info("padre_pci: adresse DMA = physique + %08x (DDR vue en %08x sur le bus PCI)\n",
+		padre_pcibus, (u32)(PADRE_PHYS_DDR + padre_pcibus));
+	{
+		/* auto-test : mappage « streaming » et allocation cohérente pour
+		 * chaque périphérique (essai 16:08 : dma_map échouait en silence)
+		 */
+		struct pci_dev *pdev;
+
+		list_for_each_entry(pdev, &bridge->bus->devices, bus_list) {
+			void *b = kmalloc(64, GFP_KERNEL), *c;
+			dma_addr_t a = DMA_MAPPING_ERROR, h = 0;
+
+			if (b)
+				a = dma_map_single(&pdev->dev, b, 64, DMA_TO_DEVICE);
+			c = dma_alloc_coherent(&pdev->dev, 4096, &h, GFP_KERNEL);
+			pci_info(pdev, "padre : test DMA : kmalloc %08lx -> %s %08x ; cohérent %08lx -> %08x\n",
+				 b ? (unsigned long)__pa(b) : 0UL,
+				 dma_mapping_error(&pdev->dev, a) ? "ÉCHEC" : "dma",
+				 (u32)a, c ? (unsigned long)__pa(c) : 0UL, (u32)h);
+			if (b && !dma_mapping_error(&pdev->dev, a))
+				dma_unmap_single(&pdev->dev, a, 64, DMA_TO_DEVICE);
+			if (c)
+				dma_free_coherent(&pdev->dev, 4096, c, h);
+			kfree(b);
+		}
+	}
+	pci_bus_add_devices(bridge->bus);
+	pr_info("padre_pci: fin\n");
+	return 0;
+}
+subsys_initcall(padre_pci_init);
diff --color -urN a/linux/arch/sparc/kernel/padre_prom.c b/linux/arch/sparc/kernel/padre_prom.c
--- a/arch/sparc/kernel/padre_prom.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/sparc/kernel/padre_prom.c	2026-11-16 23:47:56.615289113 +0100
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_prom.c : « PROM » OpenBoot minimale émulée dans le noyau.
+ *
+ * arch/sparc (sparc32) attend une PROM : vecteur romvec, arbre de
+ * périphériques, console, ligne de commande. iboot n'en fournit pas ;
+ * comme le fait mklinuximg pour les LEON, on en donne une (version 2)
+ * réduite à ce que lit le noyau : racine (idprom), cpu, memory, serial.
+ * La console PROM écrit directement sur l'UART de la console (ttyS1,
+ * 0x6000_0060), en scrutation : c'est elle qui affiche les tout premiers
+ * messages (earlyprom), avant le vrai pilote.
+ *
+ * Non vérifié sur le matériel.
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/string.h>
+#include <linux/io.h>
+#include <linux/of.h>
+
+#include <asm/openprom.h>
+#include <asm/oplib.h>
+#include <asm/idprom.h>
+#include <asm/padre.h>
+
+struct padre_boot_param padre_boot_param;
+EXPORT_SYMBOL(padre_boot_param);
+
+/* ------------------------------------------------------------------
+ * UART de la console (registres : 0 données, 4 état, 8 contrôle)
+ */
+#define PADRE_UART_STAT_TH	0x04	/* registre d'émission vide */
+
+static void padre_prom_putc(char c)
+{
+	void __iomem *u = (void __iomem *)PADRE_UART0;
+	unsigned int n = 1000000;
+
+	while (!(__raw_readl(u + 4) & PADRE_UART_STAT_TH) && --n)
+		;
+	__raw_writel(c, u);
+}
+
+int padre_prom_write(int fd, const char *buf, int len)
+{
+	int i;
+
+	for (i = 0; i < len; i++) {
+		if (buf[i] == '\n')
+			padre_prom_putc('\r');
+		padre_prom_putc(buf[i]);
+	}
+	return len;
+}
+
+/* ------------------------------------------------------------------
+ * Arbre : 1 = racine, 2 = cpu, 3 = memory, 4 = serial
+ */
+struct padre_prop {
+	const char *name;
+	const void *val;
+	int len;
+};
+
+#define PROP_STR(n, s)	{ n, s, sizeof(s) }
+#define PROP_VAL(n, v)	{ n, &(v), sizeof(v) }
+
+static struct idprom padre_idprom = { .id_format = 1, .id_machtype = 0x80 };
+static struct linux_prom_registers padre_mem_reg = { 0, PADRE_PHYS_DDR, 0 };
+static struct linux_prom_registers padre_uart_reg = { 0, PADRE_UART0 - 0x40000000, 16 };
+static const unsigned int padre_zero;
+static unsigned int padre_cpu_freq;	/* inconnue : udelay est calibré */
+
+static const struct padre_prop padre_root_props[] = {
+	PROP_STR("name", "padre"),
+	PROP_STR("compatible", "padre"),
+	PROP_STR("banner-name", "NETGEAR ReadyNAS Duo v1 (Infrant IT3107)"),
+	PROP_VAL("idprom", padre_idprom),
+	{ NULL }
+};
+
+static const struct padre_prop padre_cpu_props[] = {
+	PROP_STR("name", "cpu"),
+	PROP_STR("device_type", "cpu"),
+	PROP_VAL("mid", padre_zero),
+	PROP_VAL("clock-frequency", padre_cpu_freq),
+	{ NULL }
+};
+
+static const struct padre_prop padre_mem_props[] = {
+	PROP_STR("name", "memory"),
+	PROP_STR("device_type", "memory"),
+	PROP_VAL("reg", padre_mem_reg),
+	PROP_VAL("available", padre_mem_reg),
+	{ NULL }
+};
+
+static const struct padre_prop padre_serial_props[] = {
+	PROP_STR("name", "serial"),
+	PROP_STR("device_type", "serial"),
+	PROP_STR("compatible", "infrant,padre-uart"),
+	PROP_VAL("reg", padre_uart_reg),
+	{ NULL }
+};
+
+struct padre_node {
+	const struct padre_prop *props;
+	phandle sibling, child;
+};
+
+static const struct padre_node padre_nodes[] = {
+	[1] = { padre_root_props, 0, 2 },
+	[2] = { padre_cpu_props, 3, 0 },
+	[3] = { padre_mem_props, 4, 0 },
+	[4] = { padre_serial_props, 0, 0 },
+};
+#define PADRE_SERIAL_NODE	4
+
+static const struct padre_prop *padre_find(phandle node, const char *name)
+{
+	const struct padre_prop *p;
+
+	if (node < 1 || node >= ARRAY_SIZE(padre_nodes) || !name)
+		return NULL;
+	for (p = padre_nodes[node].props; p->name; p++)
+		if (!strcmp(p->name, name))
+			return p;
+	return NULL;
+}
+
+static phandle padre_nextnode(phandle node)
+{
+	if (node == 0)
+		return 1;
+	if (node >= ARRAY_SIZE(padre_nodes))
+		return 0;
+	return padre_nodes[node].sibling;
+}
+
+static phandle padre_child(phandle node)
+{
+	if (node < 1 || node >= ARRAY_SIZE(padre_nodes))
+		return 0;
+	return padre_nodes[node].child;
+}
+
+static int padre_proplen(phandle node, const char *name)
+{
+	const struct padre_prop *p = padre_find(node, name);
+
+	return p ? p->len : -1;
+}
+
+static int padre_getprop(phandle node, const char *name, char *val)
+{
+	const struct padre_prop *p = padre_find(node, name);
+
+	if (!p)
+		return -1;
+	memcpy(val, p->val, p->len);
+	return p->len;
+}
+
+static int padre_setprop(phandle node, const char *name, char *val, int len)
+{
+	return -1;
+}
+
+static char *padre_nextprop(phandle node, char *name)
+{
+	const struct padre_prop *p;
+
+	if (node < 1 || node >= ARRAY_SIZE(padre_nodes))
+		return "";
+	p = padre_nodes[node].props;
+	if (name && *name) {
+		p = padre_find(node, name);
+		if (!p)
+			return "";
+		p++;
+	}
+	return p->name ? (char *)p->name : "";
+}
+
+static struct linux_nodeops padre_nodeops = {
+	.no_nextnode	= padre_nextnode,
+	.no_child	= padre_child,
+	.no_proplen	= padre_proplen,
+	.no_getprop	= padre_getprop,
+	.no_setprop	= padre_setprop,
+	.no_nextprop	= padre_nextprop,
+};
+
+/* ------------------------------------------------------------------
+ * Vecteur PROM
+ */
+static phandle padre_inst2pkg(int d)
+{
+	return PADRE_SERIAL_NODE;
+}
+
+static void __noreturn padre_reset(void)
+{
+	__raw_writel(1, (void __iomem *)PADRE_SYS_CTRL);	/* 2.6.17 : machine_restart */
+	for (;;)
+		;
+}
+
+static void padre_reboot(char *bootstr)
+{
+	padre_reset();
+}
+
+static void padre_eval(char *str)
+{
+	if (str && !strcmp(str, "reset"))
+		padre_reset();
+}
+
+/* Arrêt = coupure de l'alimentation par GPIO 2 (2.6.17 : machine_halt,
+ * cartes « P0 » dont le Duo v1)
+ */
+static void padre_abort(void)
+{
+	local_irq_disable();
+	for (;;)
+		;
+}
+
+static void padre_halt(void)
+{
+	local_irq_disable();
+	__raw_writel(1 << 2, (void __iomem *)(PADRE_APB + 0xc4));	/* GPIO_DIR */
+	__raw_writel(1 << 2, (void __iomem *)(PADRE_APB + 0xc0));	/* GPIO_DATA */
+	for (;;)
+		;
+}
+
+#ifdef CONFIG_CMDLINE_BOOL
+static char padre_cmdline[] = CONFIG_CMDLINE;
+#else
+static char padre_cmdline[] = "console=ttyS1,9600";
+#endif
+static char *padre_bootargs = padre_cmdline;
+static char padre_bootpath[] = "";
+static char *padre_bootpathp = padre_bootpath;
+static int padre_fd_stdio = 1;
+static char padre_stdout_dev = PROMDEV_TTYA;
+static void (*padre_synchook)(void);
+
+struct linux_romvec padre_romvec = {
+	.pv_magic_cookie	= LINUX_OPPROM_MAGIC,
+	.pv_romvers		= 2,
+	.pv_plugin_revision	= 0,
+	.pv_printrev		= 0,
+	.pv_nodeops		= &padre_nodeops,
+	.pv_stdin		= &padre_stdout_dev,
+	.pv_stdout		= &padre_stdout_dev,
+	.pv_reboot		= padre_reboot,
+	.pv_abort		= padre_abort,
+	.pv_halt		= padre_halt,
+	.pv_synchook		= &padre_synchook,
+	.pv_fortheval.v2_eval	= padre_eval,
+	.pv_v2bootargs = {
+		.bootpath	= &padre_bootpathp,
+		.bootargs	= &padre_bootargs,
+		.fd_stdin	= &padre_fd_stdio,
+		.fd_stdout	= &padre_fd_stdio,
+	},
+	.pv_v2devops = {
+		.v2_inst2pkg	= padre_inst2pkg,
+		.v2_dev_write	= padre_prom_write,
+	},
+};
+
+/* Appelé par prom_init() (prom/init_32.c) avant toute lecture de l'arbre */
+void __init padre_prom_setup(void)
+{
+	unsigned long mem;
+
+	memcpy(&padre_boot_param, (void *)PADRE_BOOT_PARAM,
+	       sizeof(padre_boot_param));
+
+	mem = padre_boot_param.mem_size;
+	if (mem < (64UL << 20) || mem > (1UL << 30) || (mem & 0xffffff)) {
+		/* valeur douteuse : 256 Mo, la mémoire du Duo v1 */
+		mem = 256UL << 20;
+	}
+	padre_mem_reg.reg_size = mem;
+
+	memcpy(padre_idprom.id_ethaddr, padre_boot_param.mac, 6);
+	{
+		unsigned char *p = (unsigned char *)&padre_idprom, c = 0;
+		int i;
+
+		for (i = 0; i <= 0x0e; i++)
+			c ^= p[i];
+		padre_idprom.id_cksum = c;
+	}
+}
