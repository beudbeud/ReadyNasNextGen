+#ifdef CONFIG_SPARC_PADRE
+		/* Jalon « K » : pile, BSS et table des pièges en place */
+		set	0x60000060, %g1
+		mov	'K', %g2
+		st	%g2, [%g1]
+#endif
 		/* Call sparc32_start_kernel(struct linux_romvec *rp) */
