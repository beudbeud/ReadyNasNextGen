--- a/arch/sparc/Makefile	2026-11-10 19:07:06.000000000 +0100
+++ b/arch/sparc/Makefile	2026-11-16 23:47:56.616137198 +0100
@@ -29,7 +29,15 @@
 # versions of gcc.  Some gcc versions won't pass -Av8 to binutils when you
 # give -mcpu=v8.  This silently worked with older bintutils versions but
 # does not any more.
+ifeq ($(CONFIG_SPARC_PADRE),y)
+# Infrant Padre : l'instruction sdiv donne des résultats faux. Le C est
+# compilé en v7 (gcc appelle .div/.udiv/.mul…, cf. lib/padre_muldiv.S, qui
+# utilisent udiv/umul/smul, justes sur ce processeur) ; l'assembleur
+# garde -Av8 pour les sources .S existantes (umul, udiv, swap…).
+KBUILD_CFLAGS  += -m32 -mcpu=v7 -pipe -mno-fpu $(call cc-option,-fcall-used-g5) $(call cc-option,-fcall-used-g7)
+else
 KBUILD_CFLAGS  += -m32 -mcpu=v8 -pipe -mno-fpu $(call cc-option,-fcall-used-g5) $(call cc-option,-fcall-used-g7)
+endif
 KBUILD_CFLAGS  += -Wa,-Av8
 
 KBUILD_AFLAGS  += -m32 -Wa,-Av8
