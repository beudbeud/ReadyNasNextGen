 {
+#ifdef CONFIG_SPARC_PADRE
+	/*
+	 * Comme le cpu_idle du 2.6.17 : boucle active, interruptions
+	 * autorisées (PIL 0) tant que rien n'est prêt. Pas de mise en veille :
+	 * le Padre n'en a pas. Sans cela, le générique ne rouvre les
+	 * interruptions que quelques instructions entre deux tours.
+	 */
+	pr_info_once("padre: idle actif (PIL 0, sans mise en veille)\n");
