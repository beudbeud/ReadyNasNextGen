+		unsigned long fsr = current->thread.fsr;
+		int code = FPE_FLTUNK;
+
+		if ((fsr & 0x1c000) == (1 << 14)) {
+			if (fsr & 0x10)
+				code = FPE_FLTINV;
+			else if (fsr & 0x08)
