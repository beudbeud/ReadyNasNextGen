+#ifdef CONFIG_SPARC_PADRE
+	/* Padre : pas de FPU. Comme le noyau 2.6.17 (arch/padre/kernel/traps.c),
+	 * PSR.EF n'est jamais mis et chaque instruction flottante est émulée
+	 * (math-emu/math_32.c) sur l'état gardé dans thread.float_regs/fsr.
