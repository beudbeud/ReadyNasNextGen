diff --color -urN a/linux/drivers/platform/padre/padre_gmac.c b/linux/drivers/platform/padre/padre_gmac.c
--- a/drivers/platform/padre/padre_gmac.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/platform/padre/padre_gmac.c	2026-11-16 23:47:56.616963004 +0100
@@ -0,0 +1,905 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_gmac.c : Ethernet Gigabit (port GM0) du ReadyNAS Duo v1
+ * (IT3107 « Padre », carte PZERO, PHY Marvell 88E1111).
+ *
+ * Porté de padre_gmac_libre.c (pilote libre pour 2.6.17) (validé sur le NAS sous
+ * 2.6.17 : copie Samba de 104 Mo identique, 0 erreur ; écrit d'après
+ * la description fonctionnelle GMAC et le pilote libre ag71xx pour le
+ * cœur MAC AR71xx) vers 6.18 : net_device_ops, MAC prise dans boot_param,
+ * descripteurs posés directement dans la SRAM S3 (0x7000_1000, non cachée,
+ * comme l'allocateur init_eth_desc du noyau 2.6.17 : 256 × 16 octets).
+ * Même fonctionnement sinon : pas de NAPI, pas de checksum matériel.
+ *
+ * Copyright (C) 2026 les auteurs de ReadyNasNextGen
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/skbuff.h>
+#include <linux/ethtool.h>
+#include <linux/mii.h>
+#include <linux/interrupt.h>
+#include <linux/workqueue.h>
+#include <linux/delay.h>
+#include <linux/kobject.h>
+#include <linux/umh.h>
+#include <linux/spinlock.h>
+#include <linux/io.h>
+
+#include <asm/padre.h>
+#include <asm/padre_i2c.h>
+
+#define R(o)		((void __iomem *)(PADRE_APB + (o)))
+#define GMR(o)		R(0x10000 + (o))	/* GM0 */
+#define M4R(o)		R(0x700 + (o))
+#define DJR(o)		R(0x5000 + (o))
+#define FFR(ch)		R(0x2800 + ((ch) << 4))	/* MC DMA FFCTRL */
+#define FFCTRL_EN	0x00008000
+
+#define GM_get(o)	__raw_readl(GMR(o))
+#define GM_set(o, v)	__raw_writel((v), GMR(o))
+#define M4_get(o)	__raw_readl(M4R(o))
+#define M4_set(o, v)	__raw_writel((v), M4R(o))
+#define DJ_get(o)	__raw_readl(DJR(o))
+#define DJ_set(o, v)	__raw_writel((v), DJR(o))
+
+/* enveloppe GMAC */
+#define G_CTRL		0x400
+#define   C_RESET	(1u << 31)
+#define   C_TXEN	(1u << 29)
+#define   C_RXEN	(1u << 28)
+#define   C_PROMISC	(1u << 27)
+#define   C_HASH	(1u << 25)
+#define   C_BIT14	(1u << 14)
+#define   C_BUSY	(1u << 12)
+#define   C_PHYRST	(1u << 10)
+#define   C_RXFLUSH	(1u << 6)
+#define   C_INIT	0x25000300	/* fin de réinitialisation, checksum matériel coupé */
+#define G_HASH_LO	0x404
+#define G_HASH_HI	0x408
+#define G_MCX_CMD	0x418		/* [31:16] registre, 2 = fini, 1 = lecture, 0 = go */
+#define G_MCX_DATA	0x41c
+#define G_428		0x428
+
+/* cœur PE-MCX (= MAC AR71xx), accès indirect */
+#define X_CFG1		0x00
+#define   CFG1_TXE	(1u << 0)
+#define   CFG1_RXE	(1u << 2)
+#define   CFG1_FRST	(3u << 16)
+#define   CFG1_SR	(1u << 31)
+#define X_CFG2		0x04
+#define   CFG2_INIT	0x7105
+#define   CFG2_FDX	(1u << 0)
+#define   CFG2_MII	(1u << 8)
+#define   CFG2_GMII	(1u << 9)
+#define X_MFL		0x10
+#define X_MII_CFG	0x20
+#define X_MII_CMD	0x24
+#define X_MII_ADDR	0x28
+#define X_MII_CTRL	0x2c
+#define X_MII_STATUS	0x30
+#define X_MII_IND	0x34
+#define X_STA1		0x40
+#define X_STA2		0x44
+#define X_CNT(n)	(0x80 + ((n) << 2))	/* compteurs, ordre AR71xx */
+#define   N_RMCA	10
+#define   N_RFCS	9
+#define   N_RALN	15
+#define   N_RFLR	16
+#define   N_RUND	19
+#define   N_ROVR	20
+#define   N_RFRG	21
+#define   N_TXCL	34
+#define   N_TNCL	35
+
+/* moteur M4, canaux du port 0 */
+#define M_RX_CTRL	0x00
+#define M_RX_HD		0x04
+#define M_RX_FILTH	0x08
+#define M_RX_FILTL	0x0c
+#define M_FLO_CFG	0x10
+#define M_FLO_CNT	0x14
+#define M_TX_CTRL	0x20
+#define M_TX_HD		0x24
+#define M_IPEND		0xe0
+#define M_IMASK		0xe4
+#define M_ICLR		0xe8
+#define   I_RX		0x1
+#define   I_TX		0x2
+
+#define GMT0		0x40		/* bloc GMT (dans DJ), mode */
+#define MC_RX		0		/* canaux MC DMA du port 0 */
+#define MC_TX		1
+
+/* descripteur M4 (16 octets, SRAM interne non cachée) */
+struct m4d {
+	u32 link;	/* adresse bus du suivant */
+	u32 buf;	/* adresse bus du tampon */
+	u32 ctl;	/* commande / état haut */
+	u32 stat;	/* état bas */
+};
+#define D_OWN		(1u << 31)	/* au matériel */
+#define D_ERR		(1u << 30)
+#define D_SOP		(1u << 29)
+#define D_INTR0		(1u << 27)	/* banc d'interruption 0 (GM0) */
+#define D_EOP		(1u << 25)
+#define D_RXOVR		(1u << 23)	/* ctl en RX : débordement FIFO */
+#define S_RXOK		(1u << 23)	/* stat en RX : trame reçue correctement */
+#define S_TXUND		(1u << 31)	/* stat en TX : sous-alimentation FIFO */
+
+#define PA(v)		((u32)(unsigned long)(v) - 0x40000000)	/* virtuelle -> bus */
+#define DESC_SRAM	0x70001000UL	/* SRAM S3, vue non cachée */
+
+#define RING		128
+#define RMASK		(RING - 1)
+#define RXBUF		1536
+#define RXALLOC		(RXBUF + 64)
+#define GM_HWIRQ	41
+#define ICS		0x69
+
+static int ics = 1;		/* bascule de l'horloge ICS 0x69 autour des écritures MDIO */
+static int ics_n = 0x3d;
+static int phy_cfg = 1;
+static int phy_addr = -1;
+
+static struct net_device *gdev;
+static volatile struct m4d *rxd[RING], *txd[RING];
+static struct sk_buff *rxs[RING], *txs[RING];
+static unsigned int rx_cur, tx_head, tx_tail;
+static int gphy = -1, glink, gspeed, gfdx, gbusy;
+static unsigned int gm_irq_nr;
+static DEFINE_SPINLOCK(glock);
+static struct delayed_work link_work;
+static struct work_struct reset_work;
+
+static void gctrl_set(u32 set, u32 clr)
+{
+	unsigned long f;
+
+	local_irq_save(f);
+	GM_set(G_CTRL, (GM_get(G_CTRL) & ~clr) | set);
+	local_irq_restore(f);
+}
+
+/* ---------- fenêtre indirecte PE-MCX ---------- */
+
+static void mcx_wait(void)
+{
+	int n = 100000;
+
+	while (!(GM_get(G_MCX_CMD) & 4) && --n)
+		;
+	if (!n)
+		pr_err("padre_gmac: fenêtre PE-MCX bloquée\n");
+}
+
+static u32 mcx_rd(u32 reg)
+{
+	unsigned long f;
+	u32 v;
+
+	local_irq_save(f);
+	GM_set(G_MCX_CMD, (reg << 16) | 3);
+	mcx_wait();
+	v = GM_get(G_MCX_DATA);
+	local_irq_restore(f);
+	return v;
+}
+
+static void mcx_wr(u32 reg, u32 v)
+{
+	unsigned long f;
+
+	local_irq_save(f);
+	GM_set(G_MCX_DATA, v);
+	GM_set(G_MCX_CMD, (reg << 16) | 1);
+	mcx_wait();
+	local_irq_restore(f);
+}
+
+/* ---------- MDIO ---------- */
+
+static int mdio_wait(void)
+{
+	int i;
+
+	for (i = 0; i < 200; i++) {
+		udelay(5);
+		if (!(mcx_rd(X_MII_IND) & 1))
+			return 0;
+	}
+	return -1;
+}
+
+static int mdio_rd(int phy, int reg)
+{
+	unsigned long f;
+	int r;
+	u32 v;
+
+	local_irq_save(f);
+	mcx_wr(X_MII_ADDR, ((phy & 31) << 8) | (reg & 31));
+	mcx_wr(X_MII_CMD, 1);
+	r = mdio_wait();
+	v = mcx_rd(X_MII_STATUS) & 0xffff;
+	mcx_wr(X_MII_CMD, 0);
+	local_irq_restore(f);
+	return r ? 0xffff : v;
+}
+
+/* Écriture MDIO : l'original change la PLL ICS (0x69, reg 0x0c) pendant
+ * chaque écriture, interruptions masquées (~200 ms, description GMAC §7.3).
+ */
+static void mdio_wr(int phy, int reg, int val)
+{
+	unsigned long f;
+	unsigned int r0c = 0, r00 = 0;
+	int err;
+
+	local_irq_save(f);
+	if (ics) {
+		r0c = i2c_readw_idx(ICS, 0x0c);
+		r00 = i2c_readw_idx(ICS, 0x00);
+		if (r00) {
+			i2c_writew_idx(ICS, 0x00, 0);
+			mdelay(80);
+		}
+		i2c_writew_idx(ICS, 0x0c, ics_n & 0xffff);
+		mdelay(20);
+	}
+	mcx_wr(X_MII_ADDR, ((phy & 31) << 8) | (reg & 31));
+	err = mdio_wait();
+	mcx_wr(X_MII_CTRL, val & 0xffff);
+	err |= mdio_wait();
+	if (err)
+		pr_err("padre_gmac: écriture MDIO %d.%d sans réponse\n", phy, reg);
+	if (ics) {
+		i2c_writew_idx(ICS, 0x0c, r0c);
+		mdelay(20);
+		if (r00) {
+			i2c_writew_idx(ICS, 0x00, r00);
+			mdelay(80);
+		}
+	}
+	local_irq_restore(f);
+}
+
+/* ---------- MAC ---------- */
+
+static void sta_write(const u8 *a)
+{
+	mcx_wr(X_STA1, (a[5] << 24) | (a[4] << 16) | (a[3] << 8) | a[2]);
+	mcx_wr(X_STA2, (a[1] << 24) | (a[0] << 16));
+}
+
+static void mac_reset(void)
+{
+	int n;
+
+	gctrl_set(C_RESET, 0);
+	msleep(100);
+	gctrl_set(0, C_RESET);
+	for (n = 1000; (GM_get(G_CTRL) & C_BUSY) && n; n--)
+		udelay(1);
+	gctrl_set(C_BIT14, 0);
+
+	mcx_wr(X_CFG1, CFG1_SR);
+	udelay(100);
+	mcx_wr(X_CFG1, 0);
+	udelay(100);
+	mcx_wr(X_MFL, RXBUF);
+	udelay(1);
+	mcx_wr(X_CFG1, mcx_rd(X_CFG1) | CFG1_TXE);
+	udelay(1);
+	mcx_wr(X_CFG2, CFG2_INIT);
+	udelay(1);
+	mcx_wr(X_MII_CFG, 7);			/* MDC le plus lent */
+	udelay(1);
+	GM_set(G_CTRL, C_INIT);
+	GM_set(G_428, GM_get(G_428) | 0x200);
+	GM_set(G_428, GM_get(G_428) | 1);
+	sta_write(gdev->dev_addr);
+}
+
+static void mac_speed(int speed, int fdx)
+{
+	u32 c2 = mcx_rd(X_CFG2) & ~(CFG2_MII | CFG2_GMII | CFG2_FDX);
+	u32 c1;
+
+	c2 |= (speed == 1000 ? CFG2_GMII : CFG2_MII) | (fdx ? CFG2_FDX : 0);
+	mcx_wr(X_CFG2, c2);
+	c1 = mcx_rd(X_CFG1);
+	mcx_wr(X_CFG1, c1 | CFG1_FRST);
+	udelay(1);
+	mcx_wr(X_CFG1, c1);
+}
+
+static void dma_stop(void)
+{
+	M4_set(M_IMASK, 0);
+	mcx_wr(X_CFG1, mcx_rd(X_CFG1) & ~CFG1_RXE);
+	gctrl_set(0, C_RXEN | C_TXEN);
+	mcx_wr(X_CFG1, mcx_rd(X_CFG1) & ~CFG1_TXE);
+}
+
+static void dma_start(void)
+{
+	int n;
+
+	M4_set(M_RX_CTRL, 1);
+	gctrl_set(C_RXEN, 0);
+	mcx_wr(X_CFG1, mcx_rd(X_CFG1) | CFG1_RXE);
+	mcx_wr(X_CFG1, mcx_rd(X_CFG1) | CFG1_TXE);
+	gctrl_set(C_TXEN, 0);
+	for (n = 1000; (GM_get(G_CTRL) & C_BUSY) && n; n--)
+		udelay(1);
+	M4_set(M_TX_CTRL, 1);
+	M4_set(M_IMASK, I_RX | I_TX);
+}
+
+/* CRC-32 Ethernet, bits de poids faible d'abord, non réfléchi (= ether_crc) */
+static u32 eth_crc(const u8 *p)
+{
+	u32 crc = ~0u;
+	int i, b;
+
+	for (i = 0; i < 6; i++)
+		for (b = 0; b < 8; b++)
+			crc = (crc << 1) ^ ((((crc >> 31) ^ (p[i] >> b)) & 1) ? 0x04c11db7 : 0);
+	return crc;
+}
+
+static void gm_hash_add(u32 *h, const u8 *a)
+{
+	u32 i = (eth_crc(a) >> 23) & 0x3f;	/* bits 28-23 (description GMAC §6.6) */
+
+	h[i >> 5] |= 1u << (i & 31);
+}
+
+static void set_multicast(struct net_device *dev)
+{
+	static const u8 toujours[4][6] = {
+		{ 0x01, 0x80, 0xc2, 0x00, 0x00, 0x01 },	/* PAUSE */
+		{ 0x01, 0x00, 0x0c, 0x00, 0x00, 0x01 },
+		{ 0x01, 0x00, 0x5e, 0x00, 0x00, 0x05 },
+		{ 0x01, 0x00, 0x5e, 0x00, 0x00, 0x16 },
+	};
+	struct netdev_hw_addr *ha;
+	u32 h[2] = { 0, 0 };
+	unsigned long f;
+	int i;
+
+	if ((dev->flags & IFF_ALLMULTI) || netdev_mc_count(dev) > 64) {
+		h[0] = h[1] = ~0u;
+	} else {
+		for (i = 0; i < 4; i++)
+			gm_hash_add(h, toujours[i]);
+		netdev_for_each_mc_addr(ha, dev)
+			gm_hash_add(h, ha->addr);
+	}
+	local_irq_save(f);
+	GM_set(G_HASH_LO, h[0]);
+	GM_set(G_HASH_HI, h[1]);
+	if (dev->flags & IFF_PROMISC)
+		GM_set(G_CTRL, GM_get(G_CTRL) | C_PROMISC);
+	else
+		GM_set(G_CTRL, (GM_get(G_CTRL) & ~C_PROMISC) | C_HASH);
+	local_irq_restore(f);
+}
+
+/* ---------- anneaux ---------- */
+
+static struct sk_buff *rx_alloc(void)
+{
+	struct sk_buff *skb = dev_alloc_skb(RXALLOC);
+	unsigned long d;
+
+	if (!skb)
+		return NULL;
+	skb_reserve(skb, (32 - ((unsigned long)skb->data & 31)) & 31);
+	d = (unsigned long)skb->data;
+	/* écrit et invalide : aucune ligne sale ne doit retomber sur le DMA */
+	padre_flush_dcache_range(d, d + RXBUF + 2);
+	return skb;
+}
+
+static void rx_arm(int i)
+{
+	rxd[i]->buf = PA(rxs[i]->data);
+	rxd[i]->stat = 0;
+	rxd[i]->ctl = D_OWN | D_SOP | D_INTR0 | RXBUF;	/* propriété en dernier */
+}
+
+static void rings_init(void)
+{
+	int i;
+
+	for (i = 0; i < RING; i++) {
+		rxd[i]->link = PA(rxd[(i + 1) & RMASK]);
+		rx_arm(i);
+		txd[i]->link = PA(txd[(i + 1) & RMASK]);
+		txd[i]->buf = 0;
+		txd[i]->stat = 0;
+		txd[i]->ctl = D_INTR0;
+	}
+	rx_cur = tx_head = tx_tail = 0;
+	M4_set(M_RX_FILTH, 0);
+	M4_set(M_RX_FILTL, 0);
+	M4_set(M_RX_HD, PA(rxd[0]));
+	M4_set(M_TX_HD, PA(txd[0]));
+}
+
+static void tx_drop(void)
+{
+	int i;
+
+	for (i = 0; i < RING; i++) {
+		txd[i]->ctl = D_INTR0;
+		if (txs[i]) {
+			dev_kfree_skb_any(txs[i]);
+			txs[i] = NULL;
+		}
+	}
+}
+
+static void ff_toggle(int ch)
+{
+	u32 v = __raw_readl(FFR(ch));
+
+	__raw_writel(v & ~FFCTRL_EN, FFR(ch));
+	__raw_writel(v | FFCTRL_EN, FFR(ch));
+}
+
+/* démarrage matériel (ouverture, récupération) : dort */
+static void hw_start(struct net_device *dev)
+{
+	u32 v;
+
+	gbusy = 1;
+	ff_toggle(MC_TX);
+	v = DJ_get(0);
+	DJ_set(0, v ^ 1);			/* impulsion de reset de l'interface GM0 */
+	udelay(1);
+	DJ_set(0, v);
+	DJ_set(4, DJ_get(4) | (1 << 5));	/* trame reçue écrite à tampon + 2 */
+
+	DJ_set(GMT0, 2);
+	mac_reset();
+	DJ_set(GMT0, 0);			/* pas de checksum matériel */
+
+	M4_set(M_TX_CTRL, 8);
+	M4_set(M_RX_CTRL, 8);
+	M4_set(M_FLO_CNT, 0x180);
+	M4_set(M_FLO_CFG, 0x131);
+	rings_init();
+	set_multicast(dev);
+	ff_toggle(MC_RX);
+	gbusy = 0;
+	dma_start();
+}
+
+/* ---------- réception et émission (interruption) ---------- */
+
+static void rx_poll(struct net_device *dev)
+{
+	int n;
+
+	for (n = 0; n < RING; n++) {
+		volatile struct m4d *d = rxd[rx_cur];
+		u32 ctl = d->ctl, st = d->stat, len = st & 0xffff;
+		struct sk_buff *skb = rxs[rx_cur], *nskb;
+
+		if (ctl & D_OWN)
+			break;
+		if (ctl & D_RXOVR) {
+			dev->stats.rx_fifo_errors++;
+			gctrl_set(C_RXFLUSH, 0);
+			udelay(1);
+			gctrl_set(C_RXEN, 0);
+		}
+		if ((ctl & (D_ERR | D_RXOVR)) || !(st & S_RXOK) || len < 60 || len > RXBUF - 2) {
+			dev->stats.rx_errors++;
+		} else if (!(nskb = rx_alloc())) {
+			dev->stats.rx_dropped++;
+		} else {
+			padre_flush_dcache_range((unsigned long)skb->data,
+						 (unsigned long)skb->data + len + 2);
+			skb_reserve(skb, 2);
+			skb_put(skb, len - 4);	/* sans le CRC */
+			skb->protocol = eth_type_trans(skb, dev);	/* pose aussi skb->dev */
+			dev->stats.rx_packets++;
+			dev->stats.rx_bytes += len - 4;
+			netif_rx(skb);
+			rxs[rx_cur] = nskb;
+		}
+		rx_arm(rx_cur);
+		rx_cur = (rx_cur + 1) & RMASK;
+	}
+	if (n)
+		M4_set(M_FLO_CNT, n);	/* crédits de réception (?) comme l'original */
+	if (M4_get(M_RX_CTRL) & 2)
+		M4_set(M_RX_CTRL, 1);
+}
+
+static void tx_clean(struct net_device *dev)
+{
+	while (tx_tail != tx_head && !(txd[tx_tail]->ctl & D_OWN)) {
+		struct sk_buff *skb = txs[tx_tail];
+
+		if (txd[tx_tail]->stat & S_TXUND) {
+			dev->stats.tx_errors++;
+			dev->stats.tx_fifo_errors++;
+			gctrl_set(C_TXEN, 0);
+		} else {
+			dev->stats.tx_packets++;
+			dev->stats.tx_bytes += skb->len;
+		}
+		dev_kfree_skb_any(skb);
+		txs[tx_tail] = NULL;
+		tx_tail = (tx_tail + 1) & RMASK;
+	}
+	if (netif_queue_stopped(dev) && ((tx_tail - tx_head - 1) & RMASK) > 16)
+		netif_wake_queue(dev);
+}
+
+static irqreturn_t gm_irq(int irq, void *dev_id)
+{
+	struct net_device *dev = dev_id;
+	int i, done = 0;
+	u32 p;
+
+	for (i = 0; i < 8; i++) {
+		p = M4_get(M_IPEND) & (I_RX | I_TX);
+		if (!p)
+			break;
+		done = 1;
+		M4_set(M_ICLR, p);		/* acquitter avant de traiter */
+		if (p & I_TX) {
+			spin_lock(&glock);
+			tx_clean(dev);
+			spin_unlock(&glock);
+		}
+		if (p & I_RX)
+			rx_poll(dev);
+	}
+	return IRQ_RETVAL(done);
+}
+
+static netdev_tx_t gm_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	volatile struct m4d *d;
+	unsigned long f, a;
+
+	if (skb->len > RXBUF || skb_linearize(skb)) {
+		dev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+	a = (unsigned long)skb->data;
+	spin_lock_irqsave(&glock, f);
+	if (((tx_tail - tx_head - 1) & RMASK) == 0) {
+		netif_stop_queue(dev);
+		spin_unlock_irqrestore(&glock, f);
+		return NETDEV_TX_BUSY;
+	}
+	padre_clean_dcache_range(a, a + skb->len);	/* le DMA lit la mémoire */
+	d = txd[tx_head];
+	txs[tx_head] = skb;
+	d->buf = PA(a);
+	d->stat = 0;
+	d->ctl = D_OWN | D_SOP | D_EOP | D_INTR0 | skb->len;
+	tx_head = (tx_head + 1) & RMASK;
+	if (((tx_tail - tx_head - 1) & RMASK) == 0)
+		netif_stop_queue(dev);
+	if (M4_get(M_TX_CTRL) & 2)
+		M4_set(M_TX_CTRL, 1);	/* relance d'un canal arrêté */
+	netif_trans_update(dev);
+	spin_unlock_irqrestore(&glock, f);
+	return NETDEV_TX_OK;
+}
+
+/* ---------- événements pour /etc/hotplug/gmac.agent (comme 2.6.17) ---------- */
+
+static void hotplug(const char *action, int up, int speed)
+{
+#ifdef CONFIG_UEVENT_HELPER
+	char a[24], d[24], s[16], *argv[3], *envp[7];
+
+	if (!uevent_helper[0] || in_interrupt())
+		return;
+	sprintf(a, "ACTION=%s", action);
+	sprintf(d, "DEVICE=%s", gdev->name);
+	sprintf(s, "SPEED=%d", speed);
+	argv[0] = uevent_helper;
+	argv[1] = "gmac";
+	argv[2] = NULL;
+	envp[0] = "HOME=/";
+	envp[1] = "PATH=/sbin:/bin:/usr/sbin:/usr/bin";
+	envp[2] = a;
+	envp[3] = up ? "STATE=up" : "STATE=down";
+	envp[4] = d;
+	envp[5] = s;
+	envp[6] = NULL;
+	call_usermodehelper(uevent_helper, argv, envp, UMH_WAIT_EXEC);
+#endif
+}
+
+/* ---------- lien (scrutation du 88E1111 toutes les secondes) ---------- */
+
+static void link_poll(struct work_struct *unused)
+{
+	int s, up, speed = 0, fdx = 0;
+
+	if (!netif_running(gdev))
+		return;
+	s = mdio_rd(gphy, 0x11);		/* état spécifique Marvell */
+	up = s != 0xffff && (s & 0x0400) && (s & 0x0800);	/* lien, résolu */
+	if (up) {
+		speed = (s & 0x8000) ? 1000 : (s & 0x4000) ? 100 : 10;
+		fdx = (s >> 13) & 1;
+	}
+	if (up && (!glink || speed != gspeed || fdx != gfdx)) {
+		int etait = glink;
+
+		dma_stop();
+		mac_speed(speed, fdx);
+		dma_start();
+		glink = 1;
+		gspeed = speed;
+		gfdx = fdx;
+		netif_carrier_on(gdev);
+		netdev_info(gdev, "lien %d Mbit/s, duplex %s\n", speed,
+			    fdx ? "intégral" : "moitié");
+		if (!etait)
+			hotplug("link", 1, speed);
+	} else if (!up && glink) {
+		glink = 0;
+		netif_carrier_off(gdev);
+		netdev_info(gdev, "lien perdu\n");
+		hotplug("link", 0, 0);
+	}
+	schedule_delayed_work(&link_work, HZ);
+}
+
+static void reset_task(struct work_struct *unused)
+{
+	if (!netif_running(gdev))
+		return;
+	netdev_warn(gdev, "délai d'émission dépassé, réinitialisation (ctrl=%08x tx=%u/%u)\n",
+		    GM_get(G_CTRL), tx_tail, tx_head);
+	disable_irq(gm_irq_nr);
+	netif_stop_queue(gdev);
+	dma_stop();
+	tx_drop();
+	hw_start(gdev);
+	glink = 0;			/* link_poll refait vitesse/duplex */
+	enable_irq(gm_irq_nr);
+	netif_wake_queue(gdev);
+}
+
+static void gm_tx_timeout(struct net_device *dev, unsigned int txqueue)
+{
+	dev->stats.tx_errors++;
+	schedule_work(&reset_work);
+}
+
+/* ---------- ouverture / fermeture ---------- */
+
+static void rx_free(void)
+{
+	int i;
+
+	for (i = 0; i < RING; i++) {
+		rxd[i]->ctl = 0;	/* le moteur ne doit plus rien y écrire */
+		if (rxs[i]) {
+			dev_kfree_skb_any(rxs[i]);
+			rxs[i] = NULL;
+		}
+	}
+}
+
+static int gm_open(struct net_device *dev)
+{
+	int i, r;
+
+	M4_set(M_IMASK, 0);
+	for (i = 0; i < RING; i++)
+		if (!(rxs[i] = rx_alloc())) {
+			rx_free();
+			return -ENOMEM;
+		}
+	r = request_irq(gm_irq_nr, gm_irq, 0, dev->name, dev);
+	if (r) {
+		rx_free();
+		return r;
+	}
+	glink = 0;
+	netif_carrier_off(dev);
+	hw_start(dev);
+	netif_start_queue(dev);
+	schedule_delayed_work(&link_work, 1);
+	return 0;
+}
+
+static int gm_close(struct net_device *dev)
+{
+	int n;
+
+	netif_stop_queue(dev);
+	cancel_delayed_work_sync(&link_work);
+	cancel_work_sync(&reset_work);
+	dma_stop();
+	free_irq(gm_irq_nr, dev);
+	for (n = 0; n < 10 && (M4_get(M_RX_CTRL) & 2); n++)
+		msleep(10);
+	msleep(10);
+	rx_free();
+	tx_drop();
+	glink = 0;
+	netif_carrier_off(dev);
+	hotplug("close", 0, 0);
+	return 0;
+}
+
+/* compteurs matériels cumulés à chaque lecture, comme l'original
+ * (remise à zéro par la lecture supposée, description GMAC §4.3)
+ */
+static void gm_get_stats64(struct net_device *dev, struct rtnl_link_stats64 *s)
+{
+	if (netif_running(dev) && !gbusy) {
+		dev->stats.rx_crc_errors += mcx_rd(X_CNT(N_RFCS));
+		dev->stats.rx_frame_errors += mcx_rd(X_CNT(N_RALN));
+		dev->stats.multicast += mcx_rd(X_CNT(N_RMCA));
+		dev->stats.rx_length_errors += mcx_rd(X_CNT(N_RFLR)) + mcx_rd(X_CNT(N_RUND)) +
+					       mcx_rd(X_CNT(N_ROVR)) + mcx_rd(X_CNT(N_RFRG));
+		dev->stats.tx_aborted_errors += mcx_rd(X_CNT(N_TXCL));
+		dev->stats.collisions += mcx_rd(X_CNT(N_TNCL));
+	}
+	netdev_stats_to_stats64(s, &dev->stats);
+}
+
+static int gm_set_mac(struct net_device *dev, void *p)
+{
+	struct sockaddr *sa = p;
+
+	if (!is_valid_ether_addr(sa->sa_data))
+		return -EADDRNOTAVAIL;
+	eth_hw_addr_set(dev, sa->sa_data);
+	sta_write(dev->dev_addr);
+	return 0;
+}
+
+static int gm_ioctl(struct net_device *dev, struct ifreq *rq, int cmd)
+{
+	struct mii_ioctl_data *m = if_mii(rq);
+
+	switch (cmd) {
+	case SIOCGMIIPHY:
+		m->phy_id = gphy;
+		fallthrough;
+	case SIOCGMIIREG:
+		m->val_out = mdio_rd(m->phy_id, m->reg_num);
+		return 0;
+	case SIOCSMIIREG:
+		if (!capable(CAP_NET_ADMIN))
+			return -EPERM;
+		mdio_wr(m->phy_id, m->reg_num, m->val_in);
+		return 0;
+	}
+	return -EOPNOTSUPP;
+}
+
+static const struct ethtool_ops gm_ethtool = {
+	.get_link = ethtool_op_get_link,
+};
+
+static const struct net_device_ops gm_ops = {
+	.ndo_open		= gm_open,
+	.ndo_stop		= gm_close,
+	.ndo_start_xmit		= gm_xmit,
+	.ndo_get_stats64	= gm_get_stats64,
+	.ndo_set_rx_mode	= set_multicast,
+	.ndo_set_mac_address	= gm_set_mac,
+	.ndo_tx_timeout		= gm_tx_timeout,
+	.ndo_eth_ioctl		= gm_ioctl,
+	.ndo_validate_addr	= eth_validate_addr,
+};
+
+/* ---------- PHY ---------- */
+
+static int phy_find(void)
+{
+	int a, id1, id2;
+
+	if (phy_addr >= 0)
+		return phy_addr & 31;
+	for (a = 0; a < 32; a++) {
+		id1 = mdio_rd(a, MII_PHYSID1);
+		id2 = mdio_rd(a, MII_PHYSID2);
+		if (id1 != 0xffff && id1 != 0 && id2 != 0xffff) {
+			pr_info("padre_gmac: PHY %04x:%04x à l'adresse %d%s\n", id1, id2, a,
+				(id1 == 0x0141 && ((id2 >> 4) & 0x3f) == 0x0c) ? " (88E1111)" : "");
+			return a;
+		}
+	}
+	return -1;
+}
+
+static void phy_setup(int p)
+{
+	int i;
+
+	mdio_wr(p, 0x18, mdio_rd(p, 0x18) | 0x4101);	/* LED, comme l'original */
+	mdio_wr(p, MII_ADVERTISE, ADVERTISE_ALL | ADVERTISE_CSMA);
+	mdio_wr(p, MII_CTRL1000, ADVERTISE_1000FULL | ADVERTISE_1000HALF);
+	mdio_wr(p, MII_BMCR, BMCR_RESET | BMCR_ANENABLE | BMCR_ANRESTART);
+	for (i = 0; i < 100 && (mdio_rd(p, MII_BMCR) & BMCR_RESET); i++)
+		msleep(10);
+}
+
+static int __init gm_init(void)
+{
+	struct net_device *dev;
+	int i, r;
+
+	if (padre_desactive("gmac"))
+		return 0;
+	pr_info("padre_gmac: début\n");
+	/* 256 descripteurs de 16 octets dans la SRAM S3 (2.6.17 : fast list) */
+	for (i = 0; i < RING; i++) {
+		rxd[i] = (volatile struct m4d *)(DESC_SRAM + i * sizeof(struct m4d));
+		txd[i] = (volatile struct m4d *)(DESC_SRAM + (RING + i) * sizeof(struct m4d));
+	}
+
+	dev = alloc_etherdev(0);
+	if (!dev)
+		return -ENOMEM;
+	gdev = dev;
+	if (is_valid_ether_addr(padre_boot_param.mac))
+		eth_hw_addr_set(dev, padre_boot_param.mac);
+	else
+		eth_hw_addr_random(dev);
+	gm_irq_nr = padre_irq_virq(GM_HWIRQ);
+	dev->irq = gm_irq_nr;
+	dev->netdev_ops = &gm_ops;
+	dev->ethtool_ops = &gm_ethtool;
+	dev->watchdog_timeo = 5 * HZ;
+	INIT_DELAYED_WORK(&link_work, link_poll);
+	INIT_WORK(&reset_work, reset_task);
+
+	/* reset matériel du PHY (carte PZERO : bit 10 de GMAC_CTRL, 10 µs) */
+	M4_set(M_IMASK, 0);
+	gctrl_set(0, C_RXEN | C_TXEN);
+	GM_set(G_CTRL, GM_get(G_CTRL) ^ C_PHYRST);
+	udelay(10);
+	GM_set(G_CTRL, GM_get(G_CTRL) ^ C_PHYRST);
+	msleep(50);
+	pr_info("padre_gmac: reset MAC\n");
+	mac_reset();			/* MDIO utilisable (MII_CFG) */
+	pr_info("padre_gmac: recherche du PHY\n");
+	gphy = phy_find();
+	if (gphy < 0) {
+		pr_err("padre_gmac: aucun PHY sur le MDIO\n");
+		r = -ENODEV;
+		goto err;
+	}
+	if (phy_cfg) {
+		pr_info("padre_gmac: programmation du PHY (MDIO + ICS)\n");
+		phy_setup(gphy);
+	}
+
+	r = register_netdev(dev);
+	if (r)
+		goto err;
+	netdev_info(dev, "padre_gmac, GM0 IRQ %d, PHY %d, %pM\n", GM_HWIRQ, gphy,
+		    dev->dev_addr);
+	return 0;
+err:
+	free_netdev(dev);
+	return r;
+}
+late_initcall(gm_init);	/* après padre_i2c (ICS) */
diff --color -urN a/linux/drivers/platform/padre/padre_hwmon.c b/linux/drivers/platform/padre/padre_hwmon.c
--- a/drivers/platform/padre/padre_hwmon.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/platform/padre/padre_hwmon.c	2026-11-16 23:47:56.617099814 +0100
@@ -0,0 +1,592 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_hwmon.c : ventilateur, température (LM75), bouton d'alimentation
+ * et /proc/sys/dev/boot/info du ReadyNAS Duo v1.
+ *
+ * Porté de padre_hwmon_libre.c (pilote libre pour 2.6.17) (validé sur le NAS sous
+ * 2.6.17, d'après la description fonctionnelle HWMON) vers 6.18,
+ * même interface /proc/sys/dev/hwmon/{temp_0,fan_0,fan_1,info,POWER_SWITCH,
+ * GPIO0,fan0_speed_control,fan1_speed_control,i2c_addr_lm75} et
+ * /proc/sys/dev/boot/info ; bouton : uevent_helper « powerdown »/« powersave ».
+ * Retiré : la « bascule à chaud » (park) qui neutralisait le module d'Infrant.
+ *
+ * Copyright (C) 2026 les auteurs de ReadyNasNextGen
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/sysctl.h>
+#include <linux/interrupt.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+#include <linux/kobject.h>
+#include <linux/umh.h>
+#include <linux/ctype.h>
+#include <linux/string.h>
+#include <linux/reboot.h>
+#include <linux/io.h>
+
+#include <asm/padre.h>
+#include <asm/padre_i2c.h>
+
+#define R(o)		((void __iomem *)(PADRE_APB + (o)))
+#define GPIO_DATA	R(0xc0)
+#define GPIO_DIR	R(0xc4)		/* 1 = sortie */
+#define SYS_CTRL	R(0x94)		/* bits 10-4 = cause */
+#define FAN_CFG		R(0x820)
+#define FAN_PWM		R(0x824)	/* voie 0 : 5-0, voie 1 : 21-16 */
+#define FAN_EN		R(0x82c)
+#define TACH_EN		R(0x840)
+#define TACH_CLK	R(0x844)	/* 2 bits par voie */
+#define TACH_CNT	R(0x84c)	/* 8 bits par voie */
+
+#define PWM_FIXED	0x01000100	/* bits 8 et 24, toujours à 1 */
+#define PWM_SAFE	(PWM_FIXED | (63 << 16) | 63)	/* 63/64 sur les deux voies */
+
+#define POWSW_HWIRQ	11
+#define POWSW_TICK	2		/* jiffies (HZ = 100) : 20 ms */
+#define POWSW_LONG	150		/* 150 x 20 ms = 3 s */
+#define FORCEDOWN_DELAY	(120 * HZ)
+#define MEASURE_PERIOD	(10 * HZ)
+
+#define rd(r)		__raw_readl(r)
+#define wr(r, v)	__raw_writel((v), (r))
+
+/* 30 x horloge du tachymètre (20000, 10000, 5000, 2500 Hz) : tr/min = 60 f / (2 compte) */
+static const u32 fan_clk_x30[4] = { 600000, 300000, 150000, 75000 };
+
+static u8 pcbid;
+static int temp_0, fan_rpm[2], power_switch, lm75_addr;
+static int fan_req[2] = { 255, 255 };
+
+/* Consigne de départ (0-255) : modérée, la régulation (service
+ * S45ventilateur, températures des disques par drivetemp) prend le relais.
+ * Filet : sans écriture de fan0_speed_control pendant GARDE_SANS_REGUL, on
+ * repasse à plein régime (pas de démon = pas de surveillance).
+ */
+static int consigne = 80;
+module_param(consigne, int, 0644);
+MODULE_PARM_DESC(consigne, "consigne du ventilateur au démarrage, 0-255 (défaut 80)");
+#define GARDE_SANS_REGUL	(300 * HZ)
+static unsigned long derniere_consigne;	/* jiffies de la dernière écriture utilisateur */
+static bool garde_declenchee;
+static int fan_idx[2];
+static int sensor_failed;
+static char info_text[128] = "";
+static char boot_text[512];
+static struct timer_list measure_tmr, powsw_tmr, forcedown_tmr;
+static unsigned int powsw_irq_nr;
+static int irq_ok, irq_masked;
+static int powsw_pressed, powsw_ttick, powsw_itick;
+
+/* ---------- ventilateur ---------- */
+
+static void tach_clk_write(void)
+{
+	wr(TACH_CLK, (fan_idx[1] << 2) | fan_idx[0]);
+}
+
+static void fan_apply(int ch, int v)
+{
+	u32 field = ((v >> 2) + 1) & 63;
+
+	if (v == 0) {
+		wr(FAN_EN, rd(FAN_EN) & ~(1u << ch));
+		return;
+	}
+	wr(FAN_EN, rd(FAN_EN) | (1u << ch));
+	if (ch == 0)
+		wr(FAN_PWM, (rd(FAN_PWM) & 0xffff0000) | field | PWM_FIXED);
+	else
+		wr(FAN_PWM, (rd(FAN_PWM) & 0x0000ffff) | (field << 16) | PWM_FIXED);
+	fan_idx[ch] = v > 192 ? 0 : v > 128 ? 1 : 2;
+	tach_clk_write();
+}
+
+static void fan_force_full(void)
+{
+	wr(FAN_PWM, PWM_SAFE);
+	wr(FAN_EN, rd(FAN_EN) | ((pcbid == 3) ? 3 : 1));
+}
+
+static void fan_set(int ch, int v)
+{
+	unsigned long flags;
+
+	v = clamp(v, 0, 255);
+	local_irq_save(flags);
+	fan_req[ch] = v;
+	if (!sensor_failed)
+		fan_apply(ch, v);
+	local_irq_restore(flags);
+}
+
+static void fan_hw_init(void)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	wr(FAN_PWM, PWM_SAFE);			/* plein régime dès le départ */
+	if (pcbid == 3) {
+		wr(FAN_EN, 3);
+		wr(FAN_CFG, 3);
+		wr(GPIO_DIR, rd(GPIO_DIR) | 0xc0);
+	} else {
+		wr(FAN_EN, 1);
+		wr(FAN_CFG, 1);
+		wr(GPIO_DIR, rd(GPIO_DIR) | 0x40);
+	}
+	if (pcbid == 1) {
+		wr(GPIO_DIR, rd(GPIO_DIR) & ~0x10);
+		wr(TACH_EN, 1);
+	} else {
+		wr(GPIO_DIR, rd(GPIO_DIR) & ~0x30);
+		wr(TACH_EN, 3);
+	}
+	fan_idx[0] = fan_idx[1] = 0;
+	wr(TACH_CLK, 0);
+	local_irq_restore(flags);
+}
+
+/* ---------- mesures (toutes les 10 s) ---------- */
+
+static int lm75_read(u16 *raw)
+{
+	s16 v;
+
+	if (!i2c_device_exist(lm75_addr))
+		return -1;
+	*raw = i2c_readw(lm75_addr);
+	v = (s16)*raw;
+	if ((*raw & 0x7f) || v > (125 << 8) || v < -(55 << 8))
+		return -1;
+	return 0;
+}
+
+static void measure_work_fn(struct work_struct *unused)
+{
+	unsigned long flags;
+	u32 cnt, c, en;
+	u16 raw = 0;
+	int ch, t2, fail = 0, changed = 0;
+	char *p = info_text;
+
+	local_irq_save(flags);
+	cnt = rd(TACH_CNT);
+	en = rd(TACH_EN);
+	wr(TACH_EN, 0);				/* relance du compteur */
+	wr(TACH_EN, en);
+	local_irq_restore(flags);
+
+	for (ch = 0; ch < 2; ch++) {
+		c = (cnt >> (ch << 3)) & 0xff;
+		fan_rpm[ch] = c ? fan_clk_x30[fan_idx[ch]] / c : 0;
+		if (c >= 1 && c <= 63 && fan_idx[ch] > 0) {
+			fan_idx[ch]--;
+			changed = 1;
+		} else if (c > 192 && fan_idx[ch] < 3) {
+			fan_idx[ch]++;
+			changed = 1;
+		}
+	}
+	if (changed)
+		tach_clk_write();
+
+	if (lm75_addr) {
+		fail = lm75_read(&raw);
+		if (fail)
+			raw = 0;
+	}
+	t2 = (s16)raw >> 7;			/* demi-degrés */
+	temp_0 = ((s16)raw + 0x80) >> 8;
+
+	local_irq_save(flags);
+	if (fail && !sensor_failed) {
+		sensor_failed = 1;
+		fan_force_full();
+	} else if (!fail && sensor_failed) {
+		sensor_failed = 0;
+		fan_apply(0, fan_req[0]);
+		fan_apply(1, fan_req[1]);
+	}
+	local_irq_restore(flags);
+	if (fail)
+		pr_warn("padre_hwmon: lecture LM75 0x%02x impossible, ventilateur à plein régime\n",
+			lm75_addr);
+
+	p += sprintf(p, "temp_0:%s%d.%d\n", t2 < 0 ? "-" : "",
+		     abs(t2) >> 1, (abs(t2) & 1) ? 5 : 0);
+	p += sprintf(p, "fan_0:%d\n", fan_rpm[0]);
+	if (pcbid != 1)
+		sprintf(p, "fan_1:%d\n", fan_rpm[1]);
+	if (!garde_declenchee && fan_req[0] < 255 &&
+	    time_after(jiffies, derniere_consigne + GARDE_SANS_REGUL)) {
+		garde_declenchee = true;
+		pr_warn("padre_hwmon: aucune régulation depuis 5 min, ventilateur à plein régime\n");
+		fan_set(0, 255);
+		if (pcbid != 1)
+			fan_set(1, 255);
+	}
+	mod_timer(&measure_tmr, jiffies + MEASURE_PERIOD);
+}
+static DECLARE_WORK(measure_work, measure_work_fn);
+
+/* l'I2C attend en boucle : la mesure se fait hors interruption */
+static void measure_timer_fn(struct timer_list *unused)
+{
+	schedule_work(&measure_work);
+}
+
+static void lm75_probe(void)
+{
+	u8 a;
+
+	for (a = 0x48; a <= 0x4b; a++)
+		if (i2c_device_exist(a))
+			break;
+	if (a > 0x4b) {
+		lm75_addr = 0;
+		pr_err("padre_hwmon: LM75 introuvable\n");
+		return;
+	}
+	lm75_addr = a;
+	pr_info("padre_hwmon: LM75 en 0x%02x\n", a);
+	i2c_writeb_idx(a, 1, 0);	/* configuration : fonctionnement normal */
+	i2c_writeb(a, 0);		/* pointeur sur la température */
+}
+
+/* ---------- bouton d'alimentation (IRQ 11) ---------- */
+
+static void powsw_helper(const char *what)
+{
+#ifdef CONFIG_UEVENT_HELPER
+	char *argv[3], *envp[3];
+	int r;
+
+	if (!uevent_helper[0])
+		return;
+	if (what[5] == 'd')		/* powerdown : filet de sécurité 120 s */
+		mod_timer(&forcedown_tmr, jiffies + FORCEDOWN_DELAY);
+	argv[0] = uevent_helper;
+	argv[1] = (char *)what;
+	argv[2] = NULL;
+	envp[0] = "HOME=/";
+	envp[1] = "PATH=/sbin:/bin:/usr/sbin:/usr/bin";
+	envp[2] = NULL;
+	r = call_usermodehelper(uevent_helper, argv, envp, UMH_WAIT_EXEC);
+	if (r)
+		pr_info("padre_hwmon: %s : %d\n", what, r);
+#endif
+}
+
+static void powerdown_fn(struct work_struct *unused)
+{
+	powsw_helper("powerdown");
+}
+
+static void powersave_fn(struct work_struct *unused)
+{
+	powsw_helper("powersave");
+}
+
+static DECLARE_WORK(powerdown_work, powerdown_fn);
+static DECLARE_WORK(powersave_work, powersave_fn);
+
+static void forcedown_fn(struct timer_list *unused)
+{
+	pr_emerg("padre_hwmon: pas d'arrêt par l'espace utilisateur, arrêt forcé\n");
+	kernel_power_off();
+}
+
+/* IRQ de niveau tant que le bouton est enfoncé : masquée à chaque fois,
+ * le minuteur de 20 ms la démasque ; pas d'IRQ entre deux tours = relâché.
+ */
+static irqreturn_t powsw_irq(int irq, void *dev)
+{
+	disable_irq_nosync(irq);
+	irq_masked = 1;
+	if (!power_switch)
+		return IRQ_HANDLED;
+	if (!powsw_pressed) {
+		powsw_pressed = 1;
+		powsw_ttick = POWSW_LONG;
+		powsw_itick = POWSW_LONG - 1;
+		mod_timer(&powsw_tmr, jiffies + POWSW_TICK);
+	} else if (powsw_itick <= 0) {
+		powsw_pressed = 0;
+		timer_delete(&powsw_tmr);
+		schedule_work(&powerdown_work);
+	} else
+		powsw_itick--;
+	return IRQ_HANDLED;
+}
+
+static void powsw_timer_fn(struct timer_list *unused)
+{
+	powsw_ttick--;
+	if (powsw_ttick != powsw_itick) {
+		powsw_pressed = 0;
+		schedule_work(&powersave_work);
+	} else
+		mod_timer(&powsw_tmr, jiffies + POWSW_TICK);
+	if (irq_masked) {
+		irq_masked = 0;
+		enable_irq(powsw_irq_nr);
+	}
+}
+
+/* ---------- /proc/sys/dev/boot/info ---------- */
+
+static const char *reason_name[16] = {
+	"normal", "factory", "bootp", "watchdog", "softfault", "diag", "skip_fsck",
+	"os_reinstall", "ecc", "tftp", "config", "rtc", "vpd", "bootdebug", "userdiag", "unknown"
+};
+
+static int has_nul(const u8 *s, int n)
+{
+	while (n--)
+		if (!*s++)
+			return 1;
+	return 0;
+}
+
+static int sn_val(u8 c)
+{
+	static const char let[] = "ABCDEFGH" "JKLMN" "P" "RSTUVWXY";
+
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'A' && c <= 'Z') {
+		const char *q = strchr(let, c);
+
+		return q ? 10 + (q - let) : 0;
+	}
+	return 0;
+}
+
+static int sn_ok(const u8 *s)
+{
+	int i, prefix = 0, sum = 0;
+
+	if (!has_nul(s, 16) || strlen((const char *)s) != 13)
+		return 0;
+	for (i = 0; i < 13; i++) {
+		if (i == 7)
+			continue;
+		prefix += sn_val(s[i]);
+		sum += prefix;
+	}
+	return (sum & 31) == sn_val(s[7]);
+}
+
+static u8 temp_lim(u8 v, u8 def)
+{
+	return (v >= 2 && v <= 80) ? v : def;
+}
+
+static void boot_info_init(void)
+{
+	struct padre_boot_param *bp = &padre_boot_param;
+	u8 *b = (u8 *)bp, *v = bp->vpd_extend;
+	u32 pf = bp->product_features, rcause = (rd(SYS_CTRL) >> 4) & 0x7f, ssh;
+	char raw_serial[17];
+	int i;
+
+	if (bp->boot_reason > 15)
+		bp->boot_reason = 15;
+	memcpy(raw_serial, bp->serial, 16);
+	raw_serial[16] = 0;
+	if (!has_nul(bp->vendor, 32))
+		bp->vendor[0] = 0;
+	if (!has_nul(bp->model, 32))
+		bp->model[0] = 0;
+	if (!has_nul(bp->boot_version, 128))
+		memcpy(bp->boot_version, "iboot 0.00a000", 15);
+	for (i = 0; i < 13; i++)
+		if (islower(bp->serial[i]))
+			bp->serial[i] -= 0x20;
+	if (!sn_ok(bp->serial))
+		sprintf((char *)bp->serial, "%02x%02x%02x%02x%02x%02x",
+			bp->mac[0], bp->mac[1], bp->mac[2], bp->mac[3], bp->mac[4], bp->mac[5]);
+	pr_info("Boot type/reason: %s/%x/%s\n", reason_name[bp->boot_reason], rcause, raw_serial);
+
+	ssh = (b[0x113] << 24) | (b[0x114] << 16) | (b[0x115] << 8) | b[0x116];
+	ssh = (ssh == 0 || ssh == 0x10000 || ssh == 0xffffffff) ? 0 : ssh - 0xba674080;
+
+	snprintf(boot_text, sizeof(boot_text),
+		 "cause:\t%s\nvendor:\t%s\nmodel:\t%s\nmodel_valid:\t%u\nserial:\t%s\nloader:\t%s\n"
+		 "max_chan:\t%u\nxraid:\t%u\nmode:\t%u\nfginit:\t%u\npcbid:\t%u\nboard_rev:\t%04x\n"
+		 "system_rev:\t%04x\nwatchdog:\t%u\njbod:\t%u\nauto:\t%u\nminrpm:\t%u\nminpwm:\t%u\n"
+		 "cftpwm:\t%u\nmaxtemp0:\t%u\nmintemp0:\t%u\nmaxtemp1:\t%u\nmintemp1:\t%u\n"
+		 "maxtemp2:\t%u\nmintemp2:\t%u\nrcause:\t%x\nnand_ecc:\t%u\nssh:\t%u",
+		 reason_name[bp->boot_reason], (char *)bp->vendor, (char *)bp->model, (pf >> 6) & 1,
+		 (char *)bp->serial, (char *)bp->boot_version,
+		 bp->bond_option == 0x20 ? 7 : bp->bond_option == 0x42 ? 2 : 4,
+		 pf & 1, (pf >> 1) & 1, (pf >> 2) & 1, v[0], (v[4] << 8) | v[5],
+		 (v[6] << 8) | v[7], (pf >> 26) & 1, (pf >> 3) & 1, (pf >> 4) & 1,
+		 (v[1] == 0 || v[1] == 0xff) ? 0 : v[1] << 6,
+		 (v[2] == 0 || v[2] == 0xff) ? 0 : v[2], v[3],
+		 temp_lim(b[0x139], 60), temp_lim(b[0x13a], 0), temp_lim(b[0x13b], 60),
+		 temp_lim(b[0x13c], 0), temp_lim(b[0x13d], 60), temp_lim(b[0x13e], 0),
+		 rcause, b[0xec] == 0xec, ssh);
+}
+
+/* ---------- /proc/sys (tampons noyau depuis 5.8) ---------- */
+
+static int dostr(const struct ctl_table *t, char *s, int max, int write,
+		 void *buf, size_t *lenp, loff_t *ppos)
+{
+	struct ctl_table tt = *t;
+
+	tt.data = s;
+	tt.maxlen = max;
+	return proc_dostring(&tt, write, buf, lenp, ppos);
+}
+
+static int int_io(const struct ctl_table *t, int write, void *buf, size_t *lenp,
+		  loff_t *ppos, int cur, long *val)
+{
+	char k[32], *e;
+	int r;
+
+	if (!write) {
+		sprintf(k, "%d", cur);
+		return dostr(t, k, sizeof(k), 0, buf, lenp, ppos);
+	}
+	k[0] = 0;
+	r = dostr(t, k, sizeof(k), 1, buf, lenp, ppos);
+	if (r)
+		return r;
+	*val = simple_strtol(k, &e, 0);
+	return e == k ? -EINVAL : 1;
+}
+
+static int proc_fan_ctl(const struct ctl_table *t, int write, void *buf,
+			size_t *lenp, loff_t *ppos)
+{
+	int ch = (long)t->extra1;
+	long v;
+	int r = int_io(t, write, buf, lenp, ppos, fan_req[ch], &v);
+
+	if (r == 1) {
+		fan_set(ch, v);
+		derniere_consigne = jiffies;
+		garde_declenchee = false;
+		r = 0;
+	}
+	return r;
+}
+
+static int proc_lm75(const struct ctl_table *t, int write, void *buf,
+		     size_t *lenp, loff_t *ppos)
+{
+	long v;
+	int r = int_io(t, write, buf, lenp, ppos, lm75_addr, &v);
+
+	if (r == -EINVAL) {
+		lm75_addr = 0;
+		r = 0;
+	} else if (r == 1) {
+		lm75_addr = v & 0x7f;
+		r = 0;
+	}
+	return r;
+}
+
+static int proc_gpio0(const struct ctl_table *t, int write, void *buf,
+		      size_t *lenp, loff_t *ppos)
+{
+	long v;
+
+	if (write)
+		return -EPERM;
+	return int_io(t, 0, buf, lenp, ppos, (rd(GPIO_DATA) >> 7) & 1, &v);
+}
+
+static int proc_power_switch(const struct ctl_table *t, int write, void *buf,
+			     size_t *lenp, loff_t *ppos)
+{
+	int old = power_switch, r = proc_dointvec(t, write, buf, lenp, ppos);
+
+	if (write && !r) {
+		if (power_switch)
+			power_switch = 1;
+		if (!old && power_switch && irq_ok && irq_masked) {
+			irq_masked = 0;
+			enable_irq(powsw_irq_nr);
+		}
+	}
+	return r;
+}
+
+static int proc_boot(const struct ctl_table *t, int write, void *buf,
+		     size_t *lenp, loff_t *ppos)
+{
+	return dostr(t, boot_text, sizeof(boot_text), write, buf, lenp, ppos);
+}
+
+static int proc_info(const struct ctl_table *t, int write, void *buf,
+		     size_t *lenp, loff_t *ppos)
+{
+	return dostr(t, info_text, sizeof(info_text), write, buf, lenp, ppos);
+}
+
+#define INT_RO(name, var) { .procname = name, .data = &var, \
+			    .maxlen = sizeof(int), .mode = 0444, .proc_handler = proc_dointvec }
+static const struct ctl_table hwmon_table[] = {
+	INT_RO("temp_0", temp_0),
+	INT_RO("fan_0", fan_rpm[0]),
+	{ .procname = "info", .mode = 0444, .proc_handler = proc_info },
+	{ .procname = "POWER_SWITCH", .data = &power_switch, .maxlen = sizeof(int),
+	  .mode = 0644, .proc_handler = proc_power_switch },
+	{ .procname = "GPIO0", .mode = 0400, .proc_handler = proc_gpio0 },
+	{ .procname = "fan0_speed_control", .mode = 0600, .proc_handler = proc_fan_ctl,
+	  .extra1 = (void *)0 },
+	{ .procname = "i2c_addr_lm75", .mode = 0600, .proc_handler = proc_lm75 },
+	INT_RO("fan_1", fan_rpm[1]),
+	/* doit rester la dernière : absente si pcbid == 1 */
+	{ .procname = "fan1_speed_control", .mode = 0600, .proc_handler = proc_fan_ctl,
+	  .extra1 = (void *)1 },
+};
+
+static const struct ctl_table boot_table[] = {
+	{ .procname = "info", .mode = 0444, .proc_handler = proc_boot },
+};
+
+static int __init padre_hwmon_init(void)
+{
+	if (padre_desactive("hwmon"))
+		return 0;
+	pr_info("padre_hwmon: début\n");
+	pcbid = padre_boot_param.vpd_extend[0];
+
+	boot_info_init();
+	fan_hw_init();			/* plein régime avant tout le reste */
+
+	timer_setup(&measure_tmr, measure_timer_fn, 0);
+	timer_setup(&powsw_tmr, powsw_timer_fn, 0);
+	timer_setup(&forcedown_tmr, forcedown_fn, 0);
+
+	powsw_irq_nr = padre_irq_virq(POWSW_HWIRQ);
+	irq_ok = !request_irq(powsw_irq_nr, powsw_irq, 0, "powsw", NULL);
+	if (!irq_ok)
+		pr_err("padre_hwmon: IRQ du bouton d'alimentation indisponible\n");
+
+	pr_info("padre_hwmon: IRQ bouton %s, recherche LM75\n", irq_ok ? "ok" : "absente");
+	lm75_probe();
+
+	register_sysctl_sz("dev/hwmon", hwmon_table,
+			   ARRAY_SIZE(hwmon_table) - (pcbid == 1));
+	register_sysctl("dev/boot", boot_table);
+	/* plein régime le temps du démarrage du ventilateur, puis la consigne */
+	derniere_consigne = jiffies;
+	fan_set(0, consigne);
+	if (pcbid != 1)
+		fan_set(1, consigne);
+	mod_timer(&measure_tmr, jiffies + HZ);
+	pr_info("padre_hwmon: fin, pcbid %u, LM75 0x%02x, consigne %d\n",
+		pcbid, lm75_addr, fan_req[0]);
+	return 0;
+}
+late_initcall(padre_hwmon_init);
diff --color -urN a/linux/drivers/platform/padre/padre_i2c.c b/linux/drivers/platform/padre/padre_i2c.c
--- a/drivers/platform/padre/padre_i2c.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/platform/padre/padre_i2c.c	2026-11-16 23:47:56.617185003 +0100
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_i2c.c : contrôleur I2C « TWSI » de l'IT3107 « Padre ».
+ *
+ * Porté de le pilote libre i pour 2.6.172c/padre_i2c_libre.c (pilote libre écrit pour
+ * le 2.6.17 d'après la description fonctionnelle I2C) vers 6.18 :
+ * mêmes fonctions d'accès (i2c_readb_idx…, CMOS_READ…), exportées pour les
+ * autres pilotes Padre (voyants, capteurs, Ethernet).
+ * Non repris : les fichiers /proc/sys/dev/{spd,ecc,ics,dbg} (ancienne API
+ * sysctl) ; la détection P0 (g_sys_type) n'existe plus, le pilote suppose
+ * un ReadyNAS Duo/NV+ v1.
+ *
+ * Copyright (C) 2026 les auteurs de ReadyNasNextGen
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/spinlock.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+
+#include <asm/padre.h>
+#include <asm/padre_i2c.h>
+
+#define TWSI(o)		((void __iomem *)(PADRE_APB + (o)))
+#define TWSI_CMD	TWSI(0xd0)
+#define TWSI_CLK	TWSI(0xd4)
+#define TWSI_DATA0	TWSI(0xd8)	/* octets 0-3, octet 0 en 31-24 */
+#define TWSI_DATA1	TWSI(0xdc)	/* octets 4-7 */
+#define TWSI_STAT	TWSI(0xe0)
+
+#define ST_BUSY		0x1
+#define ST_NODEV	0x2	/* adresse non acquittée */
+
+#define CMD_READ	0x0001
+#define CMD_GO		0x2800	/* bits 11 et 13, toujours à 1 */
+#define CMD_COMB	0x8000	/* index (DATA0[31:24]), START répété, lecture */
+#define CMD(addr, n)	(CMD_GO | (((n) - 1) << 8) | ((addr) << 1))
+
+#define TWSI_CLK_VAL	0x0c
+#define RTC_ADDR	0x68
+
+/* ponytail: ~20 ms au pire (8 octets à 100 kHz = 0,8 ms) ; à mesurer sur le NAS */
+#define BUSY_LOOPS	10000
+#define BUSY_STEP_US	2
+
+static DEFINE_SPINLOCK(twsi_lock);
+static unsigned long twsi_timeouts;
+
+/* attend STAT bit 0 = 0 ; renvoie STAT, ou -1 si délai dépassé. twsi_lock tenu. */
+static int twsi_wait(void)
+{
+	int i;
+	u32 s;
+
+	for (i = 0; i < BUSY_LOOPS; i++) {
+		s = __raw_readl(TWSI_STAT);
+		if (!(s & ST_BUSY))
+			return s;
+		udelay(BUSY_STEP_US);
+	}
+	twsi_timeouts++;
+	return -1;
+}
+
+/* Une transaction complète sous verrou, interruptions masquées */
+static int twsi_xfer(u32 cmd, u32 w0, u32 w1, u32 *d0, u32 *d1)
+{
+	unsigned long flags;
+	int s;
+
+	spin_lock_irqsave(&twsi_lock, flags);
+	s = twsi_wait();
+	if (s >= 0) {
+		__raw_writel(w0, TWSI_DATA0);
+		__raw_writel(w1, TWSI_DATA1);
+		__raw_writel(cmd, TWSI_CMD);
+		s = twsi_wait();
+		if (d0)
+			*d0 = __raw_readl(TWSI_DATA0);
+		if (d1)
+			*d1 = __raw_readl(TWSI_DATA1);
+	}
+	spin_unlock_irqrestore(&twsi_lock, flags);
+	return s;
+}
+
+static void twsi_write(u8 addr, int n, u32 w0)
+{
+	twsi_xfer(CMD(addr, n), w0, 0, NULL, NULL);
+}
+
+static u32 twsi_read(u8 addr, int n)
+{
+	u32 d0 = 0;
+
+	twsi_xfer(CMD(addr, n) | CMD_READ, 0, 0, &d0, NULL);
+	return d0;
+}
+
+static u32 twsi_read_idx(u8 addr, u8 idx, int n)
+{
+	u32 d0 = 0;
+
+	twsi_xfer(CMD(addr, n) | CMD_COMB, (u32)idx << 24, 0, &d0, NULL);
+	return d0;
+}
+
+int i2c_device_exist(u8 dev_id)
+{
+	int s = twsi_xfer(CMD(dev_id, 1) | CMD_READ, 0, 0, NULL, NULL);
+
+	return s >= 0 && !(s & ST_NODEV);
+}
+EXPORT_SYMBOL(i2c_device_exist);
+
+void i2c_writeb(u8 dev_id, u8 data)
+{
+	twsi_write(dev_id, 1, (u32)data << 24);
+}
+EXPORT_SYMBOL(i2c_writeb);
+
+u8 i2c_readb(u8 dev_id)
+{
+	return twsi_read(dev_id, 1) >> 24;
+}
+EXPORT_SYMBOL(i2c_readb);
+
+void i2c_writew(u8 dev_id, u16 data)
+{
+	twsi_write(dev_id, 2, (u32)data << 16);
+}
+EXPORT_SYMBOL(i2c_writew);
+
+u16 i2c_readw(u8 dev_id)
+{
+	return twsi_read(dev_id, 2) >> 16;
+}
+EXPORT_SYMBOL(i2c_readw);
+
+void i2c_writeb_idx(u8 dev_id, u8 idx, u8 data)
+{
+	twsi_write(dev_id, 2, ((u32)idx << 24) | ((u32)data << 16));
+}
+EXPORT_SYMBOL(i2c_writeb_idx);
+
+u8 i2c_readb_idx(u8 dev_id, u8 idx)
+{
+	return twsi_read_idx(dev_id, idx, 1) >> 24;
+}
+EXPORT_SYMBOL(i2c_readb_idx);
+
+void i2c_writew_idx(u8 dev_id, u8 idx, u16 data)
+{
+	twsi_write(dev_id, 3, ((u32)idx << 24) | ((u32)data << 8));
+}
+EXPORT_SYMBOL(i2c_writew_idx);
+
+u16 i2c_readw_idx(u8 dev_id, u8 idx)
+{
+	return twsi_read_idx(dev_id, idx, 2) >> 16;
+}
+EXPORT_SYMBOL(i2c_readw_idx);
+
+/* comme l'original : deux transactions (index, puis 4 octets) */
+u32 i2c_readl_idx(u8 dev_id, u8 idx)
+{
+	twsi_write(dev_id, 1, (u32)idx << 24);
+	return twsi_read(dev_id, 4);
+}
+EXPORT_SYMBOL(i2c_readl_idx);
+
+u8 CMOS_READ(u8 reg)
+{
+	return i2c_readb_idx(RTC_ADDR, reg);
+}
+EXPORT_SYMBOL(CMOS_READ);
+
+void CMOS_WRITE(u8 val, u8 reg)
+{
+	i2c_writeb_idx(RTC_ADDR, reg, val);
+}
+EXPORT_SYMBOL(CMOS_WRITE);
+
+static int __init padre_i2c_init(void)
+{
+	if (padre_desactive("i2c"))
+		return 0;
+	pr_info("padre_i2c: début\n");
+	__raw_writel(TWSI_CLK_VAL, TWSI_CLK);	/* avant toute transaction */
+	pr_info("padre_i2c: TWSI prêt (CLK=0x%02x), RTC %s\n", TWSI_CLK_VAL,
+		i2c_device_exist(RTC_ADDR) ? "présente" : "absente");
+	return 0;
+}
+arch_initcall(padre_i2c_init);
diff --color -urN a/linux/drivers/platform/padre/padre_led.c b/linux/drivers/platform/padre/padre_led.c
--- a/drivers/platform/padre/padre_led.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/platform/padre/padre_led.c	2026-11-16 23:47:56.617305203 +0100
@@ -0,0 +1,521 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_led.c : voyants (ASIO, GPIO 5) et bouton de sauvegarde (GPIO 0)
+ * du ReadyNAS Duo v1.
+ *
+ * Porté de padre_led_libre.c (pilote libre pour 2.6.17) (validé sur le NAS
+ * sous 2.6.17, écrit d'après la description fonctionnelle
+ * LED_BOUTON) vers 6.18, en gardant la même interface :
+ *   /proc/sys/dev/led/{disk_1_fault…disk_4_fault,disk_activity,power,
+ *                      backup_status,set_pwm,get_pwm,ata_led_off}
+ *   /proc/sys/dev/button/{emulate,status,backup}
+ * et l'appel de uevent_helper (« button », BUTTON=backup ACTION=down|up
+ * DUR=ms) à l'appui. Les crochets padre_led_handler du noyau 2.6.17 sont
+ * remplacés par padre_led_set() / padre_led_ata_activity() (asm/padre.h).
+ *
+ * Copyright (C) 2026 les auteurs de ReadyNasNextGen
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/sysctl.h>
+#include <linux/interrupt.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+#include <linux/kobject.h>
+#include <linux/umh.h>
+#include <linux/spinlock.h>
+#include <linux/io.h>
+
+#include <asm/padre.h>
+
+#define R(o)		((void __iomem *)(PADRE_APB + (o)))
+#define GPIO_DATA	R(0xc0)		/* niveau des broches */
+#define GPIO_DIR	R(0xc4)		/* 1 = sortie */
+#define GPIO_ICFG	R(0xc8)		/* IEN 0-9, IPOL 10-19, IMODE 20-29 */
+#define GPIO_ISTAT	R(0xcc)		/* en attente ; écrire 1 = acquitter */
+#define ASIO_CTRL	R(0x800)
+#define ASIO_PWM	R(0x804)	/* 4 bits/canal, (luminosité+1)&15 */
+#define ASIO_LFM	R(0x808)	/* 4 bits/canal, motif de clignotement */
+#define ASIO_OUT	R(0x80c)	/* bit c = canal allumé */
+#define UART1_CTRL	R(0x78)		/* UART 0x6000_0070 : broches partagées */
+
+#define IEN(n)		(1 << (n))
+#define IPOL(n)		(1 << (10 + (n)))
+#define IMODE(n)	(1 << (20 + (n)))
+
+#define NASIO		6
+#define CH_ACT		4	/* disk_activity */
+#define CH_POWER	5	/* power */
+#define BKLED_GPIO	5	/* voyant de sauvegarde, actif bas */
+#define BKLED_IDX	(30 + BKLED_GPIO)
+#define BTN_GPIO	0	/* bouton de sauvegarde, actif bas */
+#define BTN_HWIRQ	(16 + BTN_GPIO)
+#define BTN_INDEX	8	/* numéro du bouton « backup » pour emulate */
+
+#define ST_BREATH	0x13
+#define BREATH_TICK	7	/* jiffies (HZ = 100) */
+#define ACT_GAP		12
+
+struct led {
+	u8 state, pwm, pwmmax, up;
+	unsigned long expires;
+};
+
+static struct led asio[NASIO], bkled;
+static u32 asio_out;		/* copie de ASIO_OUT (l'éclat d'activité ne la modifie pas) */
+static unsigned long act_next = INITIAL_JIFFIES;	/* pas 0 : jiffies part de -300 s */
+static int ata_led_off;
+static int pwm_packed;		/* luminosité max, canal 0 en poids faible */
+static DEFINE_SPINLOCK(hw_lock);
+static struct timer_list led_timer;
+static bool led_ready;
+
+static int btn_state;		/* 1 = enfoncé */
+static unsigned long btn_last, btn_dur;
+static struct timer_list btn_timer;
+
+static inline u32 rd(void __iomem *r) { return __raw_readl(r); }
+static inline void wr(void __iomem *r, u32 v) { __raw_writel(v, r); }
+
+/* ---------- ASIO ---------- */
+
+static void nibble(void __iomem *r, int ch, u32 v)
+{
+	wr(r, (rd(r) & ~(0xfu << (ch << 2))) | ((v & 0xf) << (ch << 2)));
+}
+
+static void asio_on(int ch, int on)
+{
+	if (on)
+		asio_out |= 1 << ch;
+	else
+		asio_out &= ~(1 << ch);
+	wr(ASIO_OUT, asio_out);
+}
+
+static void led_timer_kick(unsigned long when)
+{
+	if (!timer_pending(&led_timer) || time_before(when, led_timer.expires))
+		mod_timer(&led_timer, when);
+}
+
+/* hw_lock tenu */
+static void asio_set(int ch, int st)
+{
+	struct led *l = &asio[ch];
+
+	if (st == 0 || st == 1) {
+		nibble(ASIO_LFM, ch, 0);
+		nibble(ASIO_PWM, ch, l->pwmmax + 1);
+		l->pwm = l->pwmmax;
+		asio_on(ch, st);
+	} else if (st == 2 || st == 3) {
+		nibble(ASIO_LFM, ch, st == 2 ? 10 : 12);
+		asio_on(ch, 1);
+	} else if (st > 0x40 && st < 0x50) {
+		nibble(ASIO_LFM, ch, st - 0x40);
+		asio_on(ch, 1);
+	} else if (st == 4 && ch >= CH_ACT) {
+		asio_on(ch, 0);		/* coup unique : l'éclat vient de padre_led_ata_activity */
+		nibble(ASIO_LFM, ch, 3);
+	} else if (st == ST_BREATH && ch >= CH_ACT) {
+		nibble(ASIO_LFM, ch, 0);
+		l->pwm = 0;
+		l->up = 1;
+		l->expires = jiffies + 1;
+		led_timer_kick(l->expires);
+	} else
+		return;
+	l->state = st;
+}
+
+static int asio_fault_state(int ch)
+{
+	u32 lfm = (rd(ASIO_LFM) >> (ch << 2)) & 0xf;
+
+	return lfm ? 0x40 + lfm : (asio_out >> ch) & 1;
+}
+
+static void breathe(int ch)
+{
+	struct led *l = &asio[ch];
+	int d = (l->pwm >> 1) + 1;
+
+	if (l->up) {
+		if (!(asio_out & (1 << ch)))
+			asio_on(ch, 1);
+		l->pwm += d;
+		if (l->pwm >= l->pwmmax) {
+			l->pwm = l->pwmmax;
+			l->up = 0;
+		}
+	} else if (l->pwm < d) {
+		l->pwm = 0;
+		l->up = 1;
+		asio_on(ch, 0);
+	} else
+		l->pwm -= d;
+	nibble(ASIO_PWM, ch, l->pwm + 1);
+	l->expires = jiffies + BREATH_TICK;
+}
+
+/* ---------- voyant GPIO (sauvegarde) ---------- */
+
+static void bkled_set(int st)
+{
+	if (st < 0 || st > 3)
+		return;
+	bkled.state = st;
+	if (st == 1)
+		wr(GPIO_DATA, rd(GPIO_DATA) & ~(1 << BKLED_GPIO));
+	else
+		wr(GPIO_DATA, rd(GPIO_DATA) | (1 << BKLED_GPIO));
+	if (st >= 2) {
+		bkled.expires = jiffies + 1;
+		led_timer_kick(bkled.expires);
+	}
+}
+
+static void led_timer_fn(struct timer_list *unused)
+{
+	unsigned long flags, now = jiffies, next = now + 3600 * HZ;
+	int ch, armed = 0;
+
+	spin_lock_irqsave(&hw_lock, flags);
+	for (ch = 0; ch < NASIO; ch++) {
+		if (asio[ch].state != ST_BREATH)
+			continue;
+		if (!time_before(now, asio[ch].expires))
+			breathe(ch);
+		if (time_before(asio[ch].expires, next))
+			next = asio[ch].expires;
+		armed = 1;
+	}
+	if (bkled.state >= 2) {
+		if (!time_before(now, bkled.expires)) {
+			wr(GPIO_DATA, rd(GPIO_DATA) ^ (1 << BKLED_GPIO));
+			bkled.expires = now + (bkled.state == 2 ? 50 : 25);
+		}
+		if (time_before(bkled.expires, next))
+			next = bkled.expires;
+		armed = 1;
+	}
+	if (armed)
+		mod_timer(&led_timer, next);
+	spin_unlock_irqrestore(&hw_lock, flags);
+}
+
+/* ---------- API pour les autres pilotes (ex-padre_led_handler) ---------- */
+
+void padre_led_set(int led, int st)
+{
+	unsigned long flags;
+
+	if (!led_ready)
+		return;
+	spin_lock_irqsave(&hw_lock, flags);
+	if (led >= 0 && led < NASIO)
+		asio_set(led, st);
+	else if (led == BKLED_IDX)	/* ponytail: seule GPIO 5 ; jamais GPIO 2 (extinction) */
+		bkled_set(st);
+	spin_unlock_irqrestore(&hw_lock, flags);
+}
+EXPORT_SYMBOL(padre_led_set);
+
+/* éclat du voyant d'activité, au plus un tous les ACT_GAP jiffies */
+void padre_led_ata_activity(int ch)
+{
+	if (!led_ready || ch < 0 || ch > 3 || ata_led_off ||
+	    time_before(jiffies, act_next))
+		return;
+	wr(ASIO_OUT, asio_out | (1 << CH_ACT));	/* la copie reste inchangée */
+	act_next = jiffies + ACT_GAP;
+}
+EXPORT_SYMBOL(padre_led_ata_activity);
+
+/* ---------- bouton de sauvegarde ---------- */
+
+static void btn_event(int down)
+{
+#ifdef CONFIG_UEVENT_HELPER
+	char dur[24], *argv[3], *envp[7];
+	int i = 0;
+
+	if (!uevent_helper[0])
+		return;
+	sprintf(dur, "DUR=%lu", btn_dur);
+	argv[0] = uevent_helper;
+	argv[1] = "button";
+	argv[2] = NULL;
+	envp[i++] = "HOME=/";
+	envp[i++] = "PATH=/sbin:/bin:/usr/sbin:/usr/bin";
+	envp[i++] = "BUTTON=backup";
+	envp[i++] = down ? "ACTION=down" : "ACTION=up";
+	envp[i++] = dur;
+	envp[i] = NULL;
+	/* UMH_WAIT_EXEC : argv/envp (pile) valables jusqu'à l'exec */
+	call_usermodehelper(uevent_helper, argv, envp, UMH_WAIT_EXEC);
+#endif
+}
+
+static void btn_work_fn(struct work_struct *unused)
+{
+	unsigned long flags;
+	int down = !(rd(GPIO_DATA) & (1 << BTN_GPIO));
+
+	if (down != btn_state) {
+		btn_state = down;
+		btn_last = jiffies;
+		if (down) {
+			btn_dur = 0;
+			mod_timer(&btn_timer, jiffies + HZ);
+		} else
+			timer_delete(&btn_timer);
+		btn_event(down);
+	}
+	spin_lock_irqsave(&hw_lock, flags);
+	/* polarité suivante = niveau actuel (IPOL 1 = déclenche à l'état bas) */
+	if (down)
+		wr(GPIO_ICFG, (rd(GPIO_ICFG) & ~IPOL(BTN_GPIO)) | IEN(BTN_GPIO));
+	else
+		wr(GPIO_ICFG, rd(GPIO_ICFG) | IPOL(BTN_GPIO) | IEN(BTN_GPIO));
+	spin_unlock_irqrestore(&hw_lock, flags);
+}
+static DECLARE_WORK(btn_work, btn_work_fn);
+
+static irqreturn_t btn_irq(int irq, void *dev)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hw_lock, flags);
+	wr(GPIO_ICFG, (rd(GPIO_ICFG) ^ IPOL(BTN_GPIO)) & ~IEN(BTN_GPIO));
+	wr(GPIO_ISTAT, 1 << BTN_GPIO);
+	spin_unlock_irqrestore(&hw_lock, flags);
+	schedule_work(&btn_work);
+	return IRQ_HANDLED;
+}
+
+/* appui long : +1000 ms par seconde, second « down » à 5000 ms */
+static void btn_long_fn(struct work_struct *unused)
+{
+	if (btn_state && btn_dur == 5000)
+		btn_event(1);
+}
+static DECLARE_WORK(btn_long_work, btn_long_fn);
+
+static void btn_timer_fn(struct timer_list *unused)
+{
+	if (!btn_state)
+		return;
+	btn_dur += 1000;
+	if (btn_dur == 5000)
+		schedule_work(&btn_long_work);
+	mod_timer(&btn_timer, jiffies + HZ);
+}
+
+/* ---------- /proc/sys (tampons noyau depuis 5.8) ---------- */
+
+static int out_str(const char *s, int len, void *buf, size_t *lenp, loff_t *ppos)
+{
+	if (!*lenp || *ppos) {
+		*lenp = 0;
+		return 0;
+	}
+	if (len > *lenp)
+		len = *lenp;
+	memcpy(buf, s, len);
+	*lenp = len;
+	*ppos += len;
+	return 0;
+}
+
+static void in_str(char *k, int size, const void *buf, size_t *lenp, loff_t *ppos)
+{
+	int len = *lenp < size - 1 ? *lenp : size - 1;
+
+	memcpy(k, buf, len);
+	k[len] = 0;
+	*ppos += *lenp;
+}
+
+static int proc_led(const struct ctl_table *t, int write, void *buf,
+		    size_t *lenp, loff_t *ppos)
+{
+	int idx = (long)t->extra1, len;
+	unsigned long flags;
+	char k[96];
+
+	if (write) {
+		int st;
+
+		in_str(k, sizeof(k), buf, lenp, ppos);
+		st = simple_strtoul(k, NULL, 0);
+		if (idx < 4) {
+			if (idx <= CH_ACT)
+				padre_led_set(idx, st);
+		} else
+			padre_led_set(idx, st);
+		return 0;
+	}
+	spin_lock_irqsave(&hw_lock, flags);
+	if (idx < 4)
+		len = sprintf(k, "0x%02x\n", asio_fault_state(idx));
+	else if (idx < NASIO)
+		len = sprintf(k, "state=0x%02x pwm=%x expired=%lu jiffies=%lu\n",
+			      asio[idx].state, asio[idx].pwm, asio[idx].expires, jiffies);
+	else
+		len = sprintf(k, "state=0x%02x expired=%lu jiffies=%lu\n",
+			      bkled.state, bkled.expires, jiffies);
+	spin_unlock_irqrestore(&hw_lock, flags);
+	return out_str(k, len, buf, lenp, ppos);
+}
+
+static void pwm_apply(void)
+{
+	int ch;
+
+	for (ch = 0; ch < NASIO; ch++) {
+		asio[ch].pwmmax = (pwm_packed >> (ch << 2)) & 0xf;
+		if (asio[ch].state != ST_BREATH) {
+			asio[ch].pwm = asio[ch].pwmmax;
+			nibble(ASIO_PWM, ch, asio[ch].pwmmax + 1);
+		}
+	}
+}
+
+static int proc_set_pwm(const struct ctl_table *t, int write, void *buf,
+			size_t *lenp, loff_t *ppos)
+{
+	unsigned long flags;
+	int r = proc_dointvec(t, write, buf, lenp, ppos);
+
+	if (write && !r) {
+		spin_lock_irqsave(&hw_lock, flags);
+		pwm_apply();
+		spin_unlock_irqrestore(&hw_lock, flags);
+	}
+	return r;
+}
+
+static int proc_btn(const struct ctl_table *t, int write, void *buf,
+		    size_t *lenp, loff_t *ppos)
+{
+	char k[96], *p;
+	int len;
+
+	if (!write) {
+		if (t->extra1)	/* status */
+			len = sprintf(k, "name=backup,pin=%d,state=%d,last_event_t=%lu,dur=%lu\n\n",
+				      BTN_GPIO, btn_state, btn_last, btn_dur);
+		else		/* backup */
+			len = sprintf(k, "%d\n", btn_state);
+		return out_str(k, len, buf, lenp, ppos);
+	}
+	in_str(k, sizeof(k), buf, lenp, ppos);
+	p = k;
+	if (t->extra1) {	/* emulate : « index état » */
+		if (simple_strtoul(p, &p, 0) != BTN_INDEX)
+			return 0;
+		while (*p == ' ')
+			p++;
+	}
+	btn_event(simple_strtoul(p, NULL, 0) != 0);
+	return 0;
+}
+
+#define LED(name, idx) { .procname = name, .mode = 0600, \
+			 .proc_handler = proc_led, .extra1 = (void *)(idx) }
+static const struct ctl_table led_table[] = {
+	LED("disk_1_fault", 0),
+	LED("disk_2_fault", 1),
+	LED("disk_3_fault", 2),
+	LED("disk_4_fault", 3),
+	LED("disk_activity", CH_ACT),
+	LED("power", CH_POWER),
+	LED("backup_status", BKLED_IDX),
+	{ .procname = "set_pwm", .data = &pwm_packed, .maxlen = sizeof(int),
+	  .mode = 0200, .proc_handler = proc_set_pwm },
+	{ .procname = "get_pwm", .data = &pwm_packed, .maxlen = sizeof(int),
+	  .mode = 0400, .proc_handler = proc_dointvec },
+	{ .procname = "ata_led_off", .data = &ata_led_off, .maxlen = sizeof(int),
+	  .mode = 0600, .proc_handler = proc_dointvec },
+};
+
+static const struct ctl_table btn_table[] = {
+	{ .procname = "emulate", .mode = 0200, .proc_handler = proc_btn, .extra1 = (void *)1 },
+	{ .procname = "status", .mode = 0400, .proc_handler = proc_btn, .extra1 = (void *)1 },
+	{ .procname = "backup", .mode = 0600, .proc_handler = proc_btn },
+};
+
+/* ---------- mise en route ---------- */
+
+static void hw_init(void)
+{
+	u8 *vpd = padre_boot_param.vpd_extend;
+	int ch;
+
+	/* luminosité max : VPD si product_features bit 18, sinon 15 */
+	pwm_packed = 0xffffff;
+	if (padre_boot_param.product_features & (1 << 18)) {
+		pwm_packed = 0;
+		for (ch = 0; ch < NASIO; ch++) {
+			u8 b = vpd[0x136 - 0xe4 + (ch >> 1)];
+
+			pwm_packed |= ((ch & 1) ? b & 0xf : b >> 4) << (ch << 2);
+		}
+	}
+
+	wr(UART1_CTRL, 0);
+	wr(GPIO_DIR, rd(GPIO_DIR) | 0x3f00 | (1 << BKLED_GPIO));
+	wr(GPIO_DATA, rd(GPIO_DATA) | (1 << BKLED_GPIO));	/* sauvegarde éteint */
+	wr(ASIO_CTRL, 0);
+	wr(ASIO_CTRL, 6);
+	wr(ASIO_LFM, 3 << (CH_ACT << 2));		/* activité en coup unique */
+	wr(ASIO_PWM, 0);
+	asio_out = rd(ASIO_OUT) & 0x3f;			/* état laissé par iboot */
+	for (ch = 0; ch < NASIO; ch++)
+		asio[ch].state = (asio_out >> ch) & 1;
+	pwm_apply();
+}
+
+static int __init padre_led_init(void)
+{
+	unsigned long flags;
+	int r;
+
+	if (padre_desactive("led"))
+		return 0;
+	pr_info("padre_led: début\n");
+	if (padre_boot_param.vpd_extend[0] != 1) {
+		pr_err("padre_led: pas un ReadyNAS Duo (BOARDID %u)\n",
+		       padre_boot_param.vpd_extend[0]);
+		return -ENODEV;
+	}
+	timer_setup(&led_timer, led_timer_fn, 0);
+	timer_setup(&btn_timer, btn_timer_fn, 0);
+
+	spin_lock_irqsave(&hw_lock, flags);
+	hw_init();
+	spin_unlock_irqrestore(&hw_lock, flags);
+
+	register_sysctl("dev/led", led_table);
+	register_sysctl("dev/button", btn_table);
+
+	pr_info("padre_led: IRQ du bouton (GPIO 0, source 16)\n");
+	wr(GPIO_ISTAT, 1 << BTN_GPIO);
+	r = request_irq(padre_irq_virq(BTN_HWIRQ), btn_irq, 0, "backup", NULL);
+	if (!r) {
+		btn_state = !(rd(GPIO_DATA) & (1 << BTN_GPIO));
+		btn_last = jiffies;
+		wr(GPIO_ICFG, (rd(GPIO_ICFG) & ~(IMODE(BTN_GPIO) | IPOL(BTN_GPIO)))
+		   | (btn_state ? 0 : IPOL(BTN_GPIO)) | IEN(BTN_GPIO));
+	}
+
+	led_ready = true;
+	padre_led_set(CH_POWER, ST_BREATH);
+	pr_info("padre_led: fin, voyants prêts, bouton %s\n", r ? "indisponible" : "sur IRQ GPIO 0");
+	return 0;
+}
+device_initcall(padre_led_init);
diff --color -urN a/linux/drivers/platform/padre/padre_sata.c b/linux/drivers/platform/padre/padre_sata.c
--- a/drivers/platform/padre/padre_sata.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/platform/padre/padre_sata.c	2026-11-16 23:47:56.617459592 +0100
@@ -0,0 +1,823 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_sata.c : disques SATA du ReadyNAS Duo v1 (IT3107 « Padre »), pilote
+ * libata SFF en PIO.
+ *
+ * Écrit d'après padre_ide_libre.c (pilote libre pour 2.6.17) (pilote IDE 2.6.17 en
+ * PIO, lecture validée sur le NAS : 7/7, données identiques au pilote
+ * d'Infrant) et la description fonctionnelle IO §4.2, §6.1 et §9 :
+ *   bloc SATA n en 0x6000_7000 + 0x100·n, registres « shadow » ATA en
+ *   +4·r (accès 32 bits, 8 bits utiles), SCR en +0x40/+0x44/+0x48 (ordre
+ *   libata), données en +0x00 (16 bits) en attendant +0x84 bit 4 (lecture)
+ *   ou bit 5 (écriture) avant chaque mot, IRQ 32 + n.
+ * Tous les accès restent en 32 bits (comme le pilote validé) : le pilote
+ * fournit ses propres opérations SFF au lieu des ioread8 de libata.
+ * DMA par le List Processor (padre_sata.dma=1, autotest DMA = PIO au
+ * démarrage, voir plus bas). Pas de X-RAID (md/RAID1 standard par-dessus).
+ *
+ * Paramètre : padre_sata.lecture_seule=1 (ligne de commande) refuse toute
+ * écriture, pour un premier essai.
+ *
+ * Copyright (C) 2026 les auteurs de ReadyNasNextGen
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/platform_device.h>
+#include <linux/libata.h>
+#include <linux/dma-mapping.h>
+#include <linux/scatterlist.h>
+#include <linux/gfp.h>
+#include <linux/io.h>
+#include <scsi/scsi_host.h>
+
+#include <asm/padre.h>
+
+#define DRV_NAME	"padre_sata"
+
+#define SATA_BASE(c)	((void __iomem *)(PADRE_APB + 0x7000 + ((c) << 8)))
+#define S_DATA		0x00
+#define S_REG(r)	((r) << 2)	/* 1 erreur/feature … 6 device, 7 état/commande */
+#define S_ALTSTAT	0x38		/* contrôle en écriture */
+#define S_SCR(r)	(0x40 + ((r) << 2))	/* SStatus, SError, SControl */
+#define S_CTRL		0x80
+#define S_ETAT		0x84
+#define S_X88		0x88
+#define ETAT_LIRE	(1 << 4)
+#define ETAT_ECRIRE	(1 << 5)
+#define FIFO_US		10000
+#define HWIRQ0		32
+#define NCHAN_MAX	4
+
+static bool lecture_seule;
+module_param(lecture_seule, bool, 0644);
+MODULE_PARM_DESC(lecture_seule, "1 = refuser toute écriture sur les disques");
+
+static inline void __iomem *pbase(struct ata_port *ap)
+{
+	return SATA_BASE(ap->port_no);
+}
+
+static inline u8 rd8(struct ata_port *ap, unsigned int off)
+{
+	return __raw_readl(pbase(ap) + off) & 0xff;
+}
+
+static inline void wr8(struct ata_port *ap, unsigned int off, u8 v)
+{
+	__raw_writel(v, pbase(ap) + off);
+}
+
+static u8 padre_check_status(struct ata_port *ap)
+{
+	return rd8(ap, S_REG(7));
+}
+
+static u8 padre_check_altstatus(struct ata_port *ap)
+{
+	return rd8(ap, S_ALTSTAT);
+}
+
+static void padre_set_devctl(struct ata_port *ap, u8 ctl)
+{
+	wr8(ap, S_ALTSTAT, ctl);
+}
+
+static void padre_dev_select(struct ata_port *ap, unsigned int device)
+{
+	wr8(ap, S_REG(6), device ? ATA_DEVICE_OBS | ATA_DEV1 : ATA_DEVICE_OBS);
+	ata_sff_pause(ap);
+}
+
+static void padre_tf_load(struct ata_port *ap, const struct ata_taskfile *tf)
+{
+	unsigned int is_addr = tf->flags & ATA_TFLAG_ISADDR;
+
+	if (tf->ctl != ap->last_ctl) {
+		wr8(ap, S_ALTSTAT, tf->ctl);
+		ap->last_ctl = tf->ctl;
+		ata_wait_idle(ap);
+	}
+	if (is_addr && (tf->flags & ATA_TFLAG_LBA48)) {
+		wr8(ap, S_REG(1), tf->hob_feature);
+		wr8(ap, S_REG(2), tf->hob_nsect);
+		wr8(ap, S_REG(3), tf->hob_lbal);
+		wr8(ap, S_REG(4), tf->hob_lbam);
+		wr8(ap, S_REG(5), tf->hob_lbah);
+	}
+	if (is_addr) {
+		wr8(ap, S_REG(1), tf->feature);
+		wr8(ap, S_REG(2), tf->nsect);
+		wr8(ap, S_REG(3), tf->lbal);
+		wr8(ap, S_REG(4), tf->lbam);
+		wr8(ap, S_REG(5), tf->lbah);
+	}
+	if (tf->flags & ATA_TFLAG_DEVICE)
+		wr8(ap, S_REG(6), tf->device);
+	ata_wait_idle(ap);
+}
+
+static void padre_tf_read(struct ata_port *ap, struct ata_taskfile *tf)
+{
+	tf->status = padre_check_status(ap);
+	tf->error = rd8(ap, S_REG(1));
+	tf->nsect = rd8(ap, S_REG(2));
+	tf->lbal = rd8(ap, S_REG(3));
+	tf->lbam = rd8(ap, S_REG(4));
+	tf->lbah = rd8(ap, S_REG(5));
+	tf->device = rd8(ap, S_REG(6));
+
+	if (tf->flags & ATA_TFLAG_LBA48) {
+		wr8(ap, S_ALTSTAT, tf->ctl | ATA_HOB);
+		tf->hob_feature = rd8(ap, S_REG(1));
+		tf->hob_nsect = rd8(ap, S_REG(2));
+		tf->hob_lbal = rd8(ap, S_REG(3));
+		tf->hob_lbam = rd8(ap, S_REG(4));
+		tf->hob_lbah = rd8(ap, S_REG(5));
+		wr8(ap, S_ALTSTAT, tf->ctl);
+		ap->last_ctl = tf->ctl;
+	}
+}
+
+static void padre_exec_command(struct ata_port *ap, const struct ata_taskfile *tf)
+{
+	wr8(ap, S_REG(7), tf->command);
+	ata_sff_pause(ap);
+}
+
+static int fifo_attendre(struct ata_port *ap, u32 bit)
+{
+	int t;
+
+	for (t = 0; !(__raw_readl(pbase(ap) + S_ETAT) & bit); t++) {
+		if (t >= FIFO_US)
+			return -1;
+		udelay(1);
+	}
+	return 0;
+}
+
+/* Mots de 16 bits recopiés sans permutation : la mémoire est l'image du
+ * disque (description IO §9) ; libata permute lui-même IDENTIFY (swap_buf_le16).
+ */
+static unsigned int padre_data_xfer(struct ata_queued_cmd *qc, unsigned char *buf,
+				    unsigned int buflen, int rw)
+{
+	struct ata_port *ap = qc->dev->link->ap;
+	void __iomem *d = pbase(ap) + S_DATA;
+	unsigned int n, words = buflen >> 1;
+	u16 *p = (u16 *)buf;
+
+	for (n = 0; n < words; n++, p++) {
+		if (fifo_attendre(ap, rw == READ ? ETAT_LIRE : ETAT_ECRIRE)) {
+			ata_port_err(ap, "FIFO PIO muette (+0x84 = %08x)\n",
+				     __raw_readl(pbase(ap) + S_ETAT));
+			return n << 1;
+		}
+		if (rw == READ)
+			*p = __raw_readl(d) & 0xffff;
+		else
+			__raw_writel(*p, d);
+	}
+	if (buflen & 1) {	/* octet final (ATAPI) : demi-mot */
+		u16 pad = 0;
+
+		if (rw == READ) {
+			if (!fifo_attendre(ap, ETAT_LIRE))
+				pad = __raw_readl(d) & 0xffff;
+			buf[buflen - 1] = pad >> 8;
+		} else {
+			pad = buf[buflen - 1] << 8;
+			if (!fifo_attendre(ap, ETAT_ECRIRE))
+				__raw_writel(pad, d);
+		}
+		words++;
+	}
+	return words << 1;
+}
+
+static void padre_drain_fifo(struct ata_queued_cmd *qc)
+{
+	struct ata_port *ap;
+	int count;
+
+	if (qc == NULL || qc->dma_dir == DMA_TO_DEVICE)
+		return;
+	ap = qc->ap;
+	for (count = 0; (padre_check_status(ap) & ATA_DRQ) && count < 65536; count += 2)
+		__raw_readl(pbase(ap) + S_DATA);
+}
+
+static int padre_scr_read(struct ata_link *link, unsigned int reg, u32 *val)
+{
+	if (reg > SCR_CONTROL)
+		return -EINVAL;
+	*val = __raw_readl(pbase(link->ap) + S_SCR(reg));
+	return 0;
+}
+
+static int padre_scr_write(struct ata_link *link, unsigned int reg, u32 val)
+{
+	if (reg > SCR_CONTROL)
+		return -EINVAL;
+	__raw_writel(val, pbase(link->ap) + S_SCR(reg));
+	return 0;
+}
+
+/* COMRESET tel que padre_ide_libre (description IO §6.1), limité à 1,5 Gbit/s */
+static int padre_hardreset(struct ata_link *link, unsigned int *class,
+			   unsigned long deadline)
+{
+	struct ata_port *ap = link->ap;
+	void __iomem *b = pbase(ap);
+	int t;
+
+	*class = ATA_DEV_NONE;
+	__raw_writel(0x80, b + S_X88);
+	__raw_writel(0x40000, b + S_CTRL);
+	__raw_writel(0x11, b + S_SCR(SCR_CONTROL));	/* COMRESET */
+	msleep(5);
+	__raw_writel(0x10, b + S_SCR(SCR_CONTROL));
+	msleep(5);
+	__raw_writel(0x48000, b + S_CTRL);
+	msleep(5);
+
+	for (t = 0; t < 150 && (__raw_readl(b + S_SCR(SCR_STATUS)) & 0xf) != 3; t++)
+		msleep(10);				/* 1,5 s */
+	if ((__raw_readl(b + S_SCR(SCR_STATUS)) & 0xf) != 3) {
+		ata_link_info(link, "pas de disque (SStatus %03x)\n",
+			      __raw_readl(b + S_SCR(SCR_STATUS)) & 0xfff);
+		return 0;
+	}
+	__raw_writel(0, b + S_SCR(SCR_ERROR));
+	if (ata_sff_wait_ready(link, deadline)) {
+		ata_link_warn(link, "lien établi mais disque pas prêt (état %02x)\n",
+			      padre_check_status(ap));
+		return -EBUSY;
+	}
+	*class = ata_sff_dev_classify(link->device, 1, NULL);
+	return 0;
+}
+
+
+/* ===================================================================
+ * DMA par le List Processor (LP), d'après padre_ide_libre.c (dma=1, validé
+ * sous 2.6.17 le 16/11 : lecture 24/24, écriture 34/34, 2-3 segments) et
+ * son README §9. Une commande = une liste : descripteur de tête (sop) avec
+ * READ/WRITE DMA EXT pour le TOTAL des secteurs + 1er segment, puis un
+ * descripteur par segment (mots 4-7 nuls), eop|intr0 sur le dernier. Fin :
+ * IRQ 44, acquittement LP+0x14 = LP+0x10. Le LP ne sert qu'un canal à la
+ * fois (qc_defer). Micrologiciel chargé par head_32.S (comme le 2.6.17).
+ */
+#define LP(o)		((void __iomem *)(PADRE_APB + 0x1000 + (o)))
+#define LP_STAT		0x000		/* octet bas : 1 = READY */
+#define LP_CH_ENABLE	0x004
+#define LP_CH_TRIG	0x00c
+#define LP_ISTAT	0x010
+#define LP_IACK		0x014
+#define LP_VERSION	0x028
+#define LP_LIST(c)	(0x100 + (((c) + 4) << 2))
+#define LP_BIT(c)	(1u << ((c) + 4))
+#define LP_HWIRQ	44
+#define MC_FFCTRL(c)	((void __iomem *)(PADRE_APB + 0x2800 + (((c) + 4) << 4)))
+
+#define LPD_LEN		32
+#define LPD_FLAGS	0x08
+#define LPD_SIZE	0x09
+#define LPD_CHMAP	0x0c
+#define LPD_CMD		0x0f
+#define LPD_DEVHEAD	0x10
+#define LPD_LBA		0x12
+#define LPD_NSECT_HI	0x1a
+#define LPD_NSECT_LO	0x1b
+#define LPF_OWNER	0x80
+#define LPF_SOP		0x20
+#define LPF_INTR0	0x08
+#define LPF_EOP		0x02
+#define LPF_DMAIN	0x01		/* le DMA écrit la mémoire (lecture disque) */
+#define LPD_TYPE_LBA48	3
+#define LP_MAX_SEG	64		/* 64 × 4 Kio = 256 Kio par commande */
+#define LP_MAX_SECT	512
+
+static int dma;
+module_param(dma, int, 0444);
+MODULE_PARM_DESC(dma, "1 = DMA par le List Processor après autotest (défaut 0 : PIO)");
+
+struct padre_port {
+	u8 *liste;			/* une page : jusqu'à 128 descripteurs */
+	struct ata_queued_cmd *dma_qc;	/* commande DMA en vol */
+	unsigned int irq;
+	bool irq_coupee;
+	u32 ffctrl0;
+};
+
+static struct ata_port *lp_proprio;	/* port qui occupe le LP */
+static u8 lp_chmap;			/* octet 0x0C : disques présents (0x03 sur le Duo) */
+static bool dma_canal[NCHAN_MAX];
+
+static inline u32 lp_rd(unsigned int o) { return __raw_readl(LP(o)); }
+static inline void lp_wr(unsigned int o, u32 v) { __raw_writel(v, LP(o)); }
+
+static void lp_segment(u8 *p, u32 suivant, u32 bus, u32 len, u8 drap, u8 cmd)
+{
+	memset(p, 0, LPD_LEN);
+	*(u32 *)p = suivant | LPD_TYPE_LBA48;
+	*(u32 *)(p + 4) = bus;
+	p[LPD_FLAGS] = drap;
+	p[LPD_SIZE + 0] = (len >> 16) & 0xff;
+	p[LPD_SIZE + 1] = (len >> 8) & 0xff;
+	p[LPD_SIZE + 2] = len & 0xff;
+	p[LPD_CHMAP] = lp_chmap;
+	p[LPD_CMD] = cmd;
+}
+
+static void lp_tete(u8 *p, u64 lba, u32 nsect)
+{
+	p[LPD_DEVHEAD] = 0xe0;
+	p[LPD_LBA + 0] = (lba >> 40) & 0xff;
+	p[LPD_LBA + 1] = (lba >> 32) & 0xff;
+	p[LPD_LBA + 2] = (lba >> 24) & 0xff;
+	p[LPD_LBA + 3] = (lba >> 16) & 0xff;
+	p[LPD_LBA + 4] = (lba >> 8) & 0xff;
+	p[LPD_LBA + 5] = lba & 0xff;
+	p[LPD_NSECT_HI] = (nsect >> 8) & 0xff;
+	p[LPD_NSECT_LO] = nsect & 0xff;
+}
+
+/* nettoie la liste du cache (le LP la lit en mémoire) et la lance */
+static void lp_lancer(int c, u8 *liste, int nseg)
+{
+	padre_clean_dcache_range((unsigned long)liste, (unsigned long)liste + nseg * LPD_LEN);
+	if (lp_rd(LP_ISTAT) & LP_BIT(c))
+		lp_wr(LP_IACK, LP_BIT(c));
+	lp_wr(LP_CH_ENABLE, lp_rd(LP_CH_ENABLE) | LP_BIT(c));
+	lp_wr(LP_LIST(c), __pa(liste));
+	lp_wr(LP_CH_TRIG, LP_BIT(c));
+}
+
+/* retire le canal au LP et remet sa FIFO MC à zéro (LP bloqué) */
+static void lp_arreter(int c, u32 ffctrl0)
+{
+	lp_wr(LP_CH_ENABLE, lp_rd(LP_CH_ENABLE) & ~LP_BIT(c));
+	__raw_writel(0, MC_FFCTRL(c));
+	__raw_writel(ffctrl0, MC_FFCTRL(c));
+	if (lp_rd(LP_ISTAT) & LP_BIT(c))
+		lp_wr(LP_IACK, LP_BIT(c));
+}
+
+static u64 tf_lba(const struct ata_taskfile *tf)
+{
+	u64 lba = ((u32)tf->lbah << 16) | ((u32)tf->lbam << 8) | tf->lbal;
+
+	if (tf->flags & ATA_TFLAG_LBA48)
+		lba |= ((u64)tf->hob_lbah << 40) | ((u64)tf->hob_lbam << 32) |
+		       ((u64)tf->hob_lbal << 24);
+	else
+		lba |= (u64)(tf->device & 0xf) << 24;
+	return lba;
+}
+
+static enum ata_completion_errors padre_qc_prep(struct ata_queued_cmd *qc)
+{
+	struct padre_port *pp = qc->ap->private_data;
+	bool ecrire = qc->tf.flags & ATA_TFLAG_WRITE;
+	struct scatterlist *sg;
+	unsigned int si, n = qc->n_elem;
+	u32 total = 0;
+	u8 *l = pp->liste;
+
+	if (qc->tf.protocol != ATA_PROT_DMA)
+		return AC_ERR_OK;
+	if (n < 1 || n > LP_MAX_SEG)
+		return AC_ERR_SYSTEM;
+	for_each_sg(qc->sg, sg, n, si) {
+		u32 len = sg_dma_len(sg);
+
+		if ((len & 511) || len > 0xffffff)
+			return AC_ERR_SYSTEM;
+		lp_segment(l + si * LPD_LEN, __pa(l + (si + 1 == n ? 0 : si + 1) * LPD_LEN),
+			   sg_dma_address(sg), len,
+			   LPF_OWNER | (si == 0 ? LPF_SOP : 0) |
+			   (si + 1 == n ? (LPF_EOP | LPF_INTR0) : 0) | (ecrire ? 0 : LPF_DMAIN),
+			   ecrire ? ATA_CMD_WRITE_EXT : ATA_CMD_READ_EXT);	/* 0x35 / 0x25 */
+		total += len >> 9;
+	}
+	if (total != qc->nbytes >> 9 || total > 0xffff)
+		return AC_ERR_SYSTEM;
+	lp_tete(l, tf_lba(&qc->tf), total);
+	return AC_ERR_OK;
+}
+
+static int padre_qc_defer(struct ata_queued_cmd *qc)
+{
+	int rc = ata_std_qc_defer(qc);
+
+	if (rc)
+		return rc;
+	/* le LP ne sert qu'un canal à la fois */
+	if (qc->tf.protocol == ATA_PROT_DMA && lp_proprio && lp_proprio != qc->ap)
+		return ATA_DEFER_PORT;
+	return 0;
+}
+
+static unsigned int padre_qc_issue(struct ata_queued_cmd *qc)
+{
+	struct ata_port *ap = qc->ap;
+	struct padre_port *pp = ap->private_data;
+
+	if (lecture_seule && (qc->tf.flags & ATA_TFLAG_WRITE)) {
+		ata_dev_err(qc->dev, "écriture refusée (lecture_seule=1)\n");
+		return AC_ERR_DEV;
+	}
+	padre_led_ata_activity(ap->port_no);
+	if (qc->tf.protocol != ATA_PROT_DMA) {
+		/* tout en scrutation : l'IRQ 32+n n'est pas utilisée (événements
+		 * de lien/énergie du pont SATA non acquittables par la lecture
+		 * de l'état : tempête possible, cf. padre_ide_libre « orage »)
+		 */
+		qc->tf.flags |= ATA_TFLAG_POLLING;
+		return ata_sff_qc_issue(qc);
+	}
+
+	if ((lp_rd(LP_STAT) & 0xff) != 1 || lp_proprio)
+		return AC_ERR_SYSTEM;
+	lp_proprio = ap;
+	pp->dma_qc = qc;
+	lp_lancer(ap->port_no, pp->liste, qc->n_elem);
+	return 0;
+}
+
+/* IRQ 44 : liste(s) terminée(s) */
+static irqreturn_t padre_lp_irq(int irq, void *dev)
+{
+	struct ata_host *host = dev;
+	u32 ist = lp_rd(LP_ISTAT);
+	unsigned long flags;
+	unsigned int i;
+
+	if (!ist)
+		return IRQ_NONE;
+	lp_wr(LP_IACK, ist);
+	spin_lock_irqsave(&host->lock, flags);
+	for (i = 0; i < host->n_ports; i++) {
+		struct ata_port *ap = host->ports[i];
+		struct padre_port *pp = ap->private_data;
+		struct ata_queued_cmd *qc = pp->dma_qc;
+		u8 st;
+
+		if (!(ist & LP_BIT(i)) || !qc)
+			continue;
+		pp->dma_qc = NULL;
+		lp_proprio = NULL;
+		st = padre_check_status(ap);	/* lit et baisse l'INTRQ du disque */
+		if (pp->irq_coupee) {
+			pp->irq_coupee = false;
+			enable_irq(pp->irq);
+		}
+		if (!(st & ATA_DRDY) || (st & (ATA_BUSY | ATA_ERR | ATA_DRQ)))
+			qc->err_mask |= AC_ERR_DEV;
+		ata_qc_complete(qc);
+	}
+	spin_unlock_irqrestore(&host->lock, flags);
+	return IRQ_HANDLED;
+}
+
+/* IRQ 32+n du disque. Pendant une liste du LP, on ne touche pas au disque
+ * (le LP le pilote) : l'IRQ est coupée jusqu'à la fin de la liste.
+ */
+static irqreturn_t padre_sata_irq(int irq, void *dev)
+{
+	struct ata_port *ap = dev;
+	struct padre_port *pp = ap->private_data;
+	struct ata_queued_cmd *qc;
+	unsigned long flags;
+
+	spin_lock_irqsave(ap->lock, flags);
+	if (pp->dma_qc) {
+		disable_irq_nosync(irq);
+		pp->irq_coupee = true;
+	} else {
+		qc = ata_qc_from_tag(ap, ap->link.active_tag);
+		if (qc && !(qc->tf.flags & ATA_TFLAG_POLLING))
+			ata_sff_port_intr(ap, qc);
+		else
+			padre_check_status(ap);	/* baisse l'INTRQ */
+	}
+	spin_unlock_irqrestore(ap->lock, flags);
+	return IRQ_HANDLED;
+}
+
+/* délai dépassé (EH de libata) : libérer le LP avant le COMRESET */
+static void padre_error_handler(struct ata_port *ap)
+{
+	struct padre_port *pp = ap->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(ap->lock, flags);
+	if (pp->dma_qc) {
+		ata_port_warn(ap, "liste DMA non terminée (LP STAT=%02x CH_EN=%08x ISTAT=%08x), LP arrêté\n",
+			      lp_rd(LP_STAT) & 0xff, lp_rd(LP_CH_ENABLE), lp_rd(LP_ISTAT));
+		lp_arreter(ap->port_no, pp->ffctrl0);
+		pp->dma_qc = NULL;
+		lp_proprio = NULL;
+		if (pp->irq_coupee) {
+			pp->irq_coupee = false;
+			enable_irq(pp->irq);
+		}
+	}
+	spin_unlock_irqrestore(ap->lock, flags);
+	ata_sff_error_handler(ap);
+}
+
+/* ---------- autotest au démarrage (avant libata) : DMA comparé au PIO ---------- */
+
+static int lien_pret(int c)
+{
+	void __iomem *b = SATA_BASE(c);
+	int t;
+
+	__raw_writel(0x80, b + S_X88);
+	__raw_writel(0x40000, b + S_CTRL);
+	__raw_writel(0x11, b + S_SCR(SCR_CONTROL));
+	msleep(5);
+	__raw_writel(0x10, b + S_SCR(SCR_CONTROL));
+	msleep(5);
+	__raw_writel(0x48000, b + S_CTRL);
+	msleep(5);
+	for (t = 0; t < 150 && (__raw_readl(b + S_SCR(SCR_STATUS)) & 0xf) != 3; t++)
+		msleep(10);
+	if ((__raw_readl(b + S_SCR(SCR_STATUS)) & 0xf) != 3)
+		return -1;
+	__raw_writel(0, b + S_SCR(SCR_ERROR));
+	for (t = 0; t < 3500; t++) {				/* 35 s */
+		if ((__raw_readl(b + S_REG(7)) & 0xc1) == 0x40)
+			return 0;
+		msleep(10);
+	}
+	return -1;
+}
+
+static int fifo_mot(int c, u32 bit)
+{
+	int t;
+
+	for (t = 0; !(__raw_readl(SATA_BASE(c) + S_ETAT) & bit); t++) {
+		if (t >= FIFO_US)
+			return -1;
+		udelay(1);
+	}
+	return 0;
+}
+
+/* READ SECTORS EXT en scrutation, hors libata */
+static int pio_lire(int c, u64 lba, int n, u16 *buf)
+{
+	void __iomem *b = SATA_BASE(c);
+	int s, w, t;
+	u8 st = 0;
+
+	__raw_writel(0, b + S_REG(1)); __raw_writel(0, b + S_REG(1));
+	__raw_writel(0, b + S_REG(2)); __raw_writel(n, b + S_REG(2));
+	__raw_writel((lba >> 24) & 0xff, b + S_REG(3));
+	__raw_writel((lba >> 32) & 0xff, b + S_REG(4));
+	__raw_writel((lba >> 40) & 0xff, b + S_REG(5));
+	__raw_writel(lba & 0xff, b + S_REG(3));
+	__raw_writel((lba >> 8) & 0xff, b + S_REG(4));
+	__raw_writel((lba >> 16) & 0xff, b + S_REG(5));
+	__raw_writel(0xe0, b + S_REG(6));
+	__raw_writel(ATA_CMD_PIO_READ_EXT, b + S_REG(7));
+	for (s = 0; s < n; s++) {
+		for (t = 0; t < 100000; t++) {			/* 1 s */
+			st = __raw_readl(b + S_ALTSTAT) & 0xff;
+			if (!(st & ATA_BUSY))
+				break;
+			udelay(10);
+		}
+		if ((st & (ATA_BUSY | ATA_DRQ | ATA_ERR)) != ATA_DRQ)
+			return -1;
+		for (w = 0; w < 256; w++) {
+			if (fifo_mot(c, ETAT_LIRE))
+				return -1;
+			*buf++ = __raw_readl(b + S_DATA) & 0xffff;
+		}
+	}
+	(void)__raw_readl(b + S_REG(7));
+	return 0;
+}
+
+/* lecture DMA de n secteurs en nseg (1 ou 2, dans le désordre) comparée au PIO */
+static int lp_essai(int c, u8 *liste, u64 lba, int n, int nseg, u8 *ref, u8 *buf)
+{
+	u32 len = n << 9, l0 = nseg == 2 ? len >> 1 : len;
+	u8 *a0 = buf + (nseg == 2 ? 4096 : 0), *a1 = buf;
+	int t;
+	u8 st;
+
+	memset(buf, 0xa5, 8192);
+	padre_flush_dcache_range((unsigned long)buf, (unsigned long)buf + 8192);
+	lp_segment(liste, __pa(nseg == 2 ? liste + LPD_LEN : liste), __pa(a0), l0,
+		   LPF_OWNER | LPF_SOP | LPF_DMAIN | (nseg == 2 ? 0 : (LPF_EOP | LPF_INTR0)),
+		   ATA_CMD_READ_EXT);
+	if (nseg == 2)
+		lp_segment(liste + LPD_LEN, __pa(liste), __pa(a1), len - l0,
+			   LPF_OWNER | LPF_DMAIN | LPF_EOP | LPF_INTR0, ATA_CMD_READ_EXT);
+	lp_tete(liste, lba, n);
+	lp_lancer(c, liste, nseg);
+	for (t = 0; t < 100 && !(lp_rd(LP_ISTAT) & LP_BIT(c)); t++)	/* 1 s */
+		msleep(10);
+	if (!(lp_rd(LP_ISTAT) & LP_BIT(c))) {
+		padre_flush_dcache_range((unsigned long)liste, (unsigned long)liste + 2 * LPD_LEN);
+		pr_err(DRV_NAME ": [dma] canal %d : délai dépassé (LP STAT=%02x CH_EN=%08x desc %08x %08x %08x %08x, SATA %02x)\n",
+		       c, lp_rd(LP_STAT) & 0xff, lp_rd(LP_CH_ENABLE), ((u32 *)liste)[0],
+		       ((u32 *)liste)[1], ((u32 *)liste)[2], ((u32 *)liste)[3],
+		       __raw_readl(SATA_BASE(c) + S_ALTSTAT) & 0xff);
+		return -1;
+	}
+	lp_wr(LP_IACK, LP_BIT(c));
+	padre_flush_dcache_range((unsigned long)buf, (unsigned long)buf + 8192);
+	st = __raw_readl(SATA_BASE(c) + S_REG(7)) & 0xff;
+	if (st & (ATA_BUSY | ATA_ERR | ATA_DRQ)) {
+		pr_err(DRV_NAME ": [dma] canal %d : état ATA %02x après la liste\n", c, st);
+		return -2;
+	}
+	if (memcmp(a0, ref, l0) || memcmp(a1, ref + l0, len - l0)) {
+		pr_err(DRV_NAME ": [dma] canal %d : DMA différent du PIO (DMA %*ph / PIO %*ph)\n",
+		       c, 4, a0, 4, ref);
+		return -3;
+	}
+	return 0;
+}
+
+/* MBR (LBA 0, 1 secteur), puis 16 secteurs en 2 segments (LBA 64) */
+static int lp_autotest(int c, u8 *liste, u32 ffctrl0)
+{
+	static const struct { u64 lba; int n, seg; } e[] = { { 0, 1, 1 }, { 64, 16, 2 } };
+	unsigned long page = __get_free_pages(GFP_KERNEL, 2);	/* 16 Kio */
+	u8 *ref = (u8 *)page, *buf = (u8 *)page + 8192;
+	int i, r = 0;
+
+	if (!page)
+		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(e) && !r; i++) {
+		if (pio_lire(c, e[i].lba, e[i].n, (u16 *)ref)) {
+			pr_err(DRV_NAME ": [dma] canal %d : lecture PIO de référence impossible\n", c);
+			r = -4;
+			break;
+		}
+		r = lp_essai(c, liste, e[i].lba, e[i].n, e[i].seg, ref, buf);
+	}
+	if (r && r != -4) {
+		lp_arreter(c, ffctrl0);
+		return r;	/* page gardée : le LP pourrait encore y écrire */
+	}
+	free_pages(page, 2);
+	return r;
+}
+
+static const struct scsi_host_template padre_sht = {
+	ATA_BASE_SHT(DRV_NAME),
+	.sg_tablesize	= LP_MAX_SEG,
+	.dma_boundary	= 0xffffffff,
+	.max_sectors	= LP_MAX_SECT,
+};
+
+static struct ata_port_operations padre_ops = {
+	.inherits		= &ata_sff_port_ops,
+	.qc_defer		= padre_qc_defer,
+	.qc_prep		= padre_qc_prep,
+	.qc_issue		= padre_qc_issue,
+	.error_handler		= padre_error_handler,
+	.reset.softreset	= NULL,
+	.reset.hardreset	= padre_hardreset,
+	.scr_read		= padre_scr_read,
+	.scr_write		= padre_scr_write,
+	.sff_dev_select		= padre_dev_select,
+	.sff_set_devctl		= padre_set_devctl,
+	.sff_check_status	= padre_check_status,
+	.sff_check_altstatus	= padre_check_altstatus,
+	.sff_tf_load		= padre_tf_load,
+	.sff_tf_read		= padre_tf_read,
+	.sff_exec_command	= padre_exec_command,
+	.sff_data_xfer		= padre_data_xfer,
+	.sff_drain_fifo		= padre_drain_fifo,
+};
+
+/* PIO en scrutation (ATA_FLAG_PIO_POLLING) ; UDMA annoncé seulement pour
+ * les canaux dont l'autotest DMA a réussi (libata choisit alors READ/WRITE
+ * DMA EXT, servis par le LP).
+ */
+static const struct ata_port_info padre_info_pio = {
+	.flags		= ATA_FLAG_SATA | ATA_FLAG_PIO_POLLING,
+	.pio_mask	= ATA_PIO4,
+	.port_ops	= &padre_ops,
+};
+
+static const struct ata_port_info padre_info_dma = {
+	.flags		= ATA_FLAG_SATA | ATA_FLAG_PIO_POLLING,
+	.pio_mask	= ATA_PIO4,
+	.udma_mask	= ATA_UDMA5,
+	.port_ops	= &padre_ops,
+};
+
+static int __init padre_sata_init(void)
+{
+	const struct ata_port_info *ppi[NCHAN_MAX + 1] = { };
+	struct platform_device_info pinfo = {
+		.name = DRV_NAME, .id = PLATFORM_DEVID_NONE,
+		.dma_mask = DMA_BIT_MASK(32),
+	};
+	struct platform_device *pdev;
+	struct ata_host *host;
+	struct padre_port *pps;
+	bool lp_ok;
+	int i, n, rc;
+
+	if (padre_desactive("sata"))
+		return 0;
+	pr_info("padre_sata: début\n");
+	switch (padre_boot_param.bond_option) {
+	case 0x42: n = 2; break;		/* Duo : « B » */
+	case 0x43: n = 1; break;
+	case 0x41: case 0x21: n = 4; break;
+	default:
+		pr_err(DRV_NAME ": bond_option %02x non géré\n",
+		       padre_boot_param.bond_option);
+		return -ENODEV;
+	}
+
+	pdev = platform_device_register_full(&pinfo);
+	if (IS_ERR(pdev))
+		return PTR_ERR(pdev);
+	pps = devm_kcalloc(&pdev->dev, n, sizeof(*pps), GFP_KERNEL);
+	if (!pps)
+		return -ENOMEM;
+
+	lp_ok = dma && !padre_desactive("dma") && (lp_rd(LP_STAT) & 0xff) == 1;
+	pr_info(DRV_NAME ": DMA %s (LP STAT=%02x version %04x)\n",
+		lp_ok ? "demandé, autotest" : "non (PIO)", lp_rd(LP_STAT) & 0xff,
+		lp_rd(LP_VERSION) & 0xffff);
+	for (i = 0; i < n; i++) {
+		pps[i].liste = (u8 *)devm_get_free_pages(&pdev->dev, GFP_KERNEL, 0);
+		if (!pps[i].liste)
+			return -ENOMEM;
+		pps[i].ffctrl0 = __raw_readl(MC_FFCTRL(i));
+		pps[i].irq = padre_irq_virq(HWIRQ0 + i);
+		ppi[i] = &padre_info_pio;
+		if (!lp_ok)
+			continue;
+		if (lien_pret(i)) {
+			pr_info(DRV_NAME ": canal %d : pas de disque prêt, pas d'autotest\n", i);
+			continue;
+		}
+		lp_chmap |= 1 << i;
+	}
+	for (i = 0; i < n && lp_ok; i++) {
+		if (!(lp_chmap & (1 << i)))
+			continue;
+		pr_info(DRV_NAME ": [dma] canal %d : FFCTRL=%08x, autotest\n", i, pps[i].ffctrl0);
+		rc = lp_autotest(i, pps[i].liste, pps[i].ffctrl0);
+		dma_canal[i] = !rc;
+		pr_info(DRV_NAME ": [dma] canal %d : autotest %s (%d)\n", i,
+			rc ? "ÉCHEC, canal en PIO" : "OK, DMA = PIO", rc);
+		if (!rc)
+			ppi[i] = &padre_info_dma;
+	}
+
+	host = ata_host_alloc_pinfo(&pdev->dev, ppi, n);
+	if (!host)
+		return -ENOMEM;
+	for (i = 0; i < n; i++) {
+		struct ata_port *ap = host->ports[i];
+
+		ap->private_data = &pps[i];
+		/* libata veut une adresse de commande non nulle ; jamais
+		 * utilisée directement (toutes les opérations SFF sont ici)
+		 */
+		ap->ioaddr.cmd_addr = SATA_BASE(i);
+		ata_port_desc(ap, "sata 0x%08lx irq %d%s", (unsigned long)SATA_BASE(i),
+			      HWIRQ0 + i, dma_canal[i] ? " dma LP" : "");
+	}
+	rc = ata_host_start(host);
+	if (rc)
+		return rc;
+	/* ponytail: IRQ 32+n non demandées (tout est scruté) ; padre_sata_irq
+	 * reste prête si un jour on veut les commandes sans données sur IRQ
+	 */
+	(void)padre_sata_irq;
+	if (lp_chmap) {
+		rc = devm_request_irq(&pdev->dev, padre_irq_virq(LP_HWIRQ), padre_lp_irq, 0,
+				      DRV_NAME "-lp", host);
+		if (rc)
+			return rc;
+	}
+	pr_info("padre_sata: %d canaux, IRQ demandées, enregistrement libata\n", n);
+	rc = ata_host_register(host, &padre_sht);
+	pr_info("padre_sata: fin (%d)\n", rc);
+	if (!rc && lecture_seule)
+		pr_warn(DRV_NAME ": lecture seule\n");
+	return rc;
+}
+late_initcall(padre_sata_init);
