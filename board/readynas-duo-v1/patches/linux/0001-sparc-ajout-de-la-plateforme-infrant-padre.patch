diff --color -urN a/linux/arch/sparc/lib/padre_muldiv.S b/linux/arch/sparc/lib/padre_muldiv.S
--- a/arch/sparc/lib/padre_muldiv.S	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/sparc/lib/padre_muldiv.S	2026-11-16 23:47:56.616076279 +0100
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * padre_muldiv.S : routines .mul .umul .div .udiv .rem .urem appelées par
+ * gcc -mcpu=v7, pour l'Infrant IT3107 « Padre ».
+ *
+ * Sur ce processeur l'instruction sdiv (division signée) donne des
+ * résultats faux ; udiv, umul et smul sont justes (mesuré sur le NAS).
+ * La division signée est donc faite en non signé, signes à part.
+ * Convention de gcc : arguments dans %o0/%o1, résultat dans %o0
+ * (produit 64 bits : poids fort dans %o1), feuilles sans fenêtre.
+ *
+ * Limite : kbuild ne sait pas exporter un symbole dont le nom commence
+ * par un point ; un module (.ko) qui multiplie ou divise ne se chargera
+ * donc pas. Les pilotes Padre sont compilés dans le noyau (=y).
+ */
+
+#include <linux/linkage.h>
+
+	.text
+	.align	4
+
+/* produit signé : %o1:%o0 = %o0 * %o1 */
+	.globl	.mul
+.mul:
+	smul	%o0, %o1, %o0
+	retl
+	 rd	%y, %o1
+
+/* produit non signé */
+	.globl	.umul
+.umul:
+	umul	%o0, %o1, %o0
+	retl
+	 rd	%y, %o1
+
+/* quotient non signé : %o0 = %o0 / %o1 */
+	.globl	.udiv
+.udiv:
+	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	retl
+	 udiv	%o0, %o1, %o0
+
+/* reste non signé : %o0 = %o0 % %o1 */
+	.globl	.urem
+.urem:
+	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	udiv	%o0, %o1, %o2
+	umul	%o2, %o1, %o2
+	retl
+	 sub	%o0, %o2, %o0
+
+/* quotient signé, tronqué vers zéro (C) */
+	.globl	.div
+.div:
+	xor	%o0, %o1, %o3		! signe du résultat dans le bit 31
+	tst	%o0
+	bge	1f
+	 tst	%o1
+	neg	%o0
+	tst	%o1
+1:	bge	2f
+	 nop
+	neg	%o1
+2:	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	udiv	%o0, %o1, %o0
+	tst	%o3
+	bl,a	3f
+	 neg	%o0
+3:	retl
+	 nop
+
+/* reste signé, du signe du dividende (C) */
+	.globl	.rem
+.rem:
+	mov	%o0, %o3		! signe du dividende
+	tst	%o0
+	bge	1f
+	 tst	%o1
+	neg	%o0
+	tst	%o1
+1:	bge	2f
+	 nop
+	neg	%o1
+2:	wr	%g0, 0, %y
+	nop
+	nop
+	nop
+	udiv	%o0, %o1, %o2
+	umul	%o2, %o1, %o2
+	sub	%o0, %o2, %o0
+	tst	%o3
+	bl,a	3f
+	 neg	%o0
+3:	retl
+	 nop
