 static int do_one_mathemu(u32 insn, unsigned long *fsr, unsigned long *fregs);
 
+#ifdef CONFIG_SPARC_PADRE
+/* Padre (pas de FPU) : émulation aussi des chargements/rangements et des
+ * branchements flottants, d'après arch/padre/math-emu/math.c du noyau GPL
+ * 2.6.17 (accès mémoire par get_user/put_user).
+ */
+unsigned long safe_compute_effective_address(struct pt_regs *, unsigned int);
+
+#define PADRE_LDF	0x20
+#define PADRE_LDFSR	0x21
+#define PADRE_LDDF	0x23
+#define PADRE_STF	0x24
+#define PADRE_STFSR	0x25
+#define PADRE_STDF	0x27
+#define PADRE_FBA	0x46
+
+#define F_E	0x1
+#define F_L	0x2
+#define F_G	0x4
+#define F_U	0x8
+
+static const unsigned long padre_fb_mask[] = {
+	0, F_L | F_G, F_L, F_G, 0x10, F_U | F_E, F_U | F_G | F_E, F_U | F_L | F_E,
+	F_G | F_L | F_U, F_U | F_L, F_U | F_G, F_U, F_E, F_G | F_E, F_L | F_E,
+	F_E | F_L | F_G
+};
+
+static int padre_ldst_mathemu(u32 insn, struct pt_regs *regs, unsigned long *fregs,
+			      unsigned long *fsr)
+{
+	unsigned long freg = (insn >> 25) & 0x1f;
+	u32 __user *addr = (u32 __user *)safe_compute_effective_address(regs, insn);
+	u32 v;
+
+	switch ((insn >> 19) & 0x3f) {
+	case PADRE_LDDF:
+		if (get_user(v, addr + 1))
+			return 0;
+		fregs[(freg + 1) & 31] = v;
+		fallthrough;
+	case PADRE_LDF:
+		if (get_user(v, addr))
+			return 0;
+		fregs[freg] = v;
+		break;
+	case PADRE_LDFSR:
+		if (get_user(v, addr))
+			return 0;
+		*fsr = v;
+		break;
+	case PADRE_STDF:
+		if (put_user((u32)fregs[(freg + 1) & 31], addr + 1))
+			return 0;
+		fallthrough;
+	case PADRE_STF:
+		if (put_user((u32)fregs[freg], addr))
+			return 0;
+		break;
+	case PADRE_STFSR:
+		if (put_user((u32)*fsr, addr))
+			return 0;
+		break;
+	default:
+		return 0;
+	}
+	regs->pc = regs->npc;
+	regs->npc += 4;
+	return 1;
+}
+
+static int padre_fbranch_mathemu(u32 insn, unsigned long fsr, struct pt_regs *regs)
+{
+	int disp22 = ((insn & 0x1fffff) - (insn & 0x200000)) << 2;
+	unsigned long annul = insn & 0x20000000;
+	unsigned long fcc = (fsr >> 10) & 0x3, temp;
+	unsigned long op = (insn >> 22) & 0x7f;
+
+	fcc = (1 << fcc) | 0x10;
+	temp = ((op & 0xf) == 0x6) ? 0 : 8;
+	temp += (op >> 4) & 0xf;
+
+	if (fcc & padre_fb_mask[temp & 15]) {
+		temp = regs->pc + disp22;
+		regs->pc = regs->npc;
+		if (op == PADRE_FBA && annul) {
+			regs->pc = temp;
+			temp += 4;
+		}
+		regs->npc = temp;
+	} else {
+		regs->pc = annul ? regs->npc + 4 : regs->npc;
+		regs->npc = regs->pc + 4;
+	}
+	return 1;
+}
