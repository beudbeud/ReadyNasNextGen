diff --color -urN a/linux/arch/sparc/include/asm/padre.h b/linux/arch/sparc/include/asm/padre.h
--- a/arch/sparc/include/asm/padre.h	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/sparc/include/asm/padre.h	2026-11-16 23:48:48.359551681 +0100
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Infrant IT3107 « Padre » (ReadyNAS Duo v1) : registres et constantes.
+ *
+ * Valeurs reprises des sources GPL publiées par NETGEAR pour le noyau
+ * 2.6.17 (include/asm-padre/padre0.h, page.h, pgtable.h, timer.h,
+ * arch/padre/kernel/{head.S,irq.c,time.c}, arch/padre/mm/padre_cache.c).
+ *
+ * Plan d'adressage vu par le noyau (MMU en « carte fixe », réglée dans
+ * head_32.S comme le faisait le noyau 2.6.17) :
+ *   0x0000_0000 - 0x3fff_ffff  espace utilisateur (tables de pages)
+ *   0x4000_0000 - 0x7fff_ffff  E/S, fenêtre fixe sur le bus 0x0000_0000
+ *   0x8000_0000 - ...          DDR, fenêtre fixe sur le bus 0x4000_0000
+ *   0xf800_0000 - 0xffff_0000  vmalloc (tables de pages)
+ * L'adresse « physique » de Linux est l'adresse du bus AHB (DDR en
+ * 0x4000_0000) : c'est celle que lisent le parcoureur de tables de la MMU
+ * et les moteurs DMA.
+ */
+/* Accès aux registres : __raw_readl()/__raw_writel() (natifs, comme readl()
+ * du 2.6.17). readl()/writel() de sparc32 permutent les octets (PCI). */
+#ifndef _ASM_SPARC_PADRE_H
+#define _ASM_SPARC_PADRE_H
+
+#define PADRE_PHYS_DDR		0x40000000UL	/* DDR sur le bus */
+#define PADRE_IO_VIRT(bus)	((bus) + 0x40000000UL)	/* E/S */
+#define PADRE_IO_WINDOW_END	0x40000000UL	/* E/S : bus < 1 Go */
+#define PADRE_USER_TOP		0x40000000	/* = TASK_SIZE, utilisable en asm */
+
+/* ASI propres à Padre (attention : 0x10/0x11 n'ont pas le sens SRMMU) */
+#define ASI_PADRE_MMU		0x10
+#define ASI_PADRE_TLBPROBE	0x11
+#define ASI_PADRE_ICMU		0x14
+#define ASI_PADRE_DCMU		0x15
+
+/* Registres MMU (ASI_PADRE_MMU) */
+#define PADRE_MMU_CONTROL	0x04
+#define  PADRE_MMU_CONTROL_FL	0x20	/* vidage de la TLB */
+#define  PADRE_MMU_CONTROL_NF	0x04	/* pas de trappe (sondes de pile) */
+#define  PADRE_MMU_CONTROL_DE	0x02	/* traduction des données */
+#define  PADRE_MMU_CONTROL_IE	0x01	/* traduction des instructions */
+#define  PADRE_MMU_ON		(PADRE_MMU_CONTROL_DE | PADRE_MMU_CONTROL_IE)
+#define PADRE_MMU_DFSR		0x10
+#define  PADRE_MMU_DFSR_V	0x01	/* une faute a eu lieu */
+#define  PADRE_MMU_DFSR_WRITE_SHIFT 9	/* bit 9 : écriture */
+#define PADRE_MMU_IFSR		0x14
+#define PADRE_MMU_DFADDR	0x18
+#define PADRE_MMU_CACHEABLE	0x1c	/* seuil (Mo de DDR) au-delà : non caché */
+#define PADRE_MMU_PGT		0x24	/* adresse bus du répertoire de pages */
+#define  PADRE_MMU_PGT_CACHE	0x04
+#define  PADRE_MMU_PGT_FL	0x02
+#define  PADRE_MMU_PGT_EN	0x01
+
+/* Antémémoires (ASI_PADRE_ICMU / ASI_PADRE_DCMU) */
+#define PADRE_ICMU_ITAG		0x00010000
+#define PADRE_ICMU_CTRL		0x00030000
+#define  PADRE_ICMU_CTRL_TM	0x00000002
+#define  PADRE_ICMU_CTRL_EN	0x00000001
+#define PADRE_DCMU_DTAG		0x00010000
+#define PADRE_DCMU_CTRL		0x00030000
+#define  PADRE_DCMU_CTRL_FORCE	0x00000040
+#define  PADRE_DCMU_PROBE_CLEAN	(2 << 4)
+#define  PADRE_DCMU_PROBE_INVCLN (3 << 4)
+#define  PADRE_DCMU_CTRL_TM	0x00000002
+#define  PADRE_DCMU_CTRL_EN	0x00000001
+#define PADRE_DCACHE_LINE	16
+/* Mémoires internes du LP (via son ICMU/DCMU, mode test), cf. head.S 2.6.17 */
+#define PADRE_ICMU_IRD		0x00020000
+#define PADRE_DCMU_DRD		0x00020000
+#define  PADRE_ICMU_CTRL_IC3	0x00000004
+#define  PADRE_DCMU_CTRL_DC3	0x00000004
+#define  PADRE_CMU_CTRL_TAG	0xfffff800
+#define PADRE_LP_IRD_SIZE	16384
+#define PADRE_LP_DRD_SIZE	4096
+
+/* Entrées de table de pages matérielle (pages matérielles de 4 Ko) */
+#define _PADRE_PAGE_U		0x200	/* accessible en mode utilisateur */
+#define _PADRE_PAGE_R		0x100
+#define _PADRE_PAGE_W		0x080
+#define _PADRE_PAGE_X		0x040
+#define _PADRE_PAGE_C		0x020	/* cachable */
+#define _PADRE_PAGE_T		0x010	/* écriture immédiate */
+#define _PADRE_PAGE_A		0x008	/* accédée */
+#define _PADRE_PAGE_D		0x004	/* modifiée */
+#define _PADRE_PAGE_Z		0x002
+#define _PADRE_PAGE_V		0x001	/* valide */
+
+/* Périphériques APB (adresses vues par le noyau) */
+#define PADRE_APB		0x60000000UL
+#define PADRE_INTC0_MASK_H	(PADRE_APB + 0x00)
+#define PADRE_INTC0_MASK_L	(PADRE_APB + 0x04)
+#define PADRE_INTC0_ICAUSE_H	(PADRE_APB + 0x18)	/* lu : cause, écrit : efface */
+#define PADRE_INTC0_ICAUSE_L	(PADRE_APB + 0x1c)
+#define PADRE_TM_CTRL		(PADRE_APB + 0x40)
+#define  PADRE_TM_CTRL_STP	0x00001000
+#define PADRE_TM_PS		(PADRE_APB + 0x44)
+#define PADRE_TM_CNTDIAG	(PADRE_APB + 0x4c)
+#define PADRE_TM_TIMER1		(PADRE_APB + 0x54)
+#define PADRE_UART0		(PADRE_APB + 0x60)	/* console, ttyS1 */
+#define PADRE_UART1		(PADRE_APB + 0x70)	/* ttyS0 */
+#define PADRE_SYS_ID		(PADRE_APB + 0x90)
+#define PADRE_SYS_CTRL		(PADRE_APB + 0x94)
+#define PADRE_MBIST_MODE	(PADRE_APB + 0x80)
+#define PADRE_MBIST_ADDR	(PADRE_APB + 0x88)
+#define PADRE_MBIST_DATA	(PADRE_APB + 0x8c)
+#define  PADRE_MBIST_MODE_EN	(1 << 0)
+#define  PADRE_MBIST_MODE_DONE	(1 << 9)
+#define PADRE_BUG505_ADDR	0x66660000UL	/* écriture factice après INTC */
+#define PADRE_S3_RAMTOP_CACHEABLE 0x74000000UL	/* SRAM S3, vue cachable */
+
+/* Minuterie : 50 000 tops par seconde (diviseur 24), minuterie 1 */
+#define PADRE_PRESCALE		24
+#define PADRE_TIMER_HZ		50000
+#define PADRE_TM_SEL(x)		((x) << 13)
+#define PADRE_TM_LOAD(x)	(0x100 << (x))
+#define PADRE_TM_AUTO(x)	(0x10 << (x))
+#define PADRE_TM_INTEN(x)	(0x1 << (x))
+
+/* Sources d'interruption (INTC0 : 0-31 mot bas, 32-47 mot haut) */
+#define PADRE_NR_HWIRQ		48
+#define PADRE_HWIRQ_UART1	7
+#define PADRE_HWIRQ_UART0	8
+#define PADRE_HWIRQ_LEVEL_FIRST	16	/* 16-27 : verrouillées, à effacer */
+#define PADRE_HWIRQ_LEVEL_LAST	27
+#define PADRE_HWIRQ_TIMER1	46
+
+/* Paramètres d'iboot, en 0x8000_0000 (512 octets) */
+#define PADRE_BOOT_PARAM	0x80000000
+#define PADRE_S3_RAMTOP		0x70000000	/* SRAM S3 (lecture factice) */
+#ifndef __ASSEMBLER__
+struct padre_boot_param {
+	unsigned long mem_size;
+	unsigned long cpu_type;
+	unsigned char mac[6];
+	unsigned char bond_option;
+	unsigned char boot_reason;
+	unsigned char boot_version[128];
+	unsigned char vendor[32];
+	unsigned char model[32];
+	unsigned char serial[16];
+	unsigned long product_features;
+	unsigned char vpd_extend[128];
+};
+
+extern struct padre_boot_param padre_boot_param;
+extern unsigned long padre_nocache_phys;	/* début de la zone non cachée */
+
+unsigned int padre_irq_virq(unsigned int hwirq);
+void padre_init_IRQ(void);
+/* padre.desactive=led,hwmon,gmac,sata,pci,i2c (ligne de commande) */
+bool padre_desactive(const char *nom);
+/* écriture console brute par scrutation de l'UART, sans verrou (sûre en interruption) */
+int padre_prom_write(int fd, const char *buf, int len);
+extern u32 padre_pciswap;	/* PCI_SWAP posé (0x4444 ou 0 comme iboot) */
+void padre_flush_dcache_all(void);
+void padre_handler_irq(unsigned int pil);
+void padre_clean_dcache_range(unsigned long start, unsigned long end);
+void padre_flush_dcache_range(unsigned long start, unsigned long end);
+void padre_flush_icache_all(void);
+
+/* drivers/platform/padre/padre_led.c (ex-crochets padre_led_handler) */
+#ifdef CONFIG_PADRE_LED
+void padre_led_set(int led, int st);
+void padre_led_ata_activity(int ch);
+#else
+static inline void padre_led_set(int led, int st) { }
+static inline void padre_led_ata_activity(int ch) { }
+#endif
+#endif
+
+#endif /* _ASM_SPARC_PADRE_H */
