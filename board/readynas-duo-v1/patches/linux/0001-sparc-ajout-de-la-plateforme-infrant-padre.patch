+		sta	%g2, [%g1] ASI_PADRE_MMU
+
+		/* Antémémoire I : étiquettes à zéro (mode test), puis marche */
+		set	PADRE_ICMU_CTRL, %g1
+		set	PADRE_ICMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		set	PADRE_ICMU_ITAG, %g1
+		set	PADRE_ICMU_ITAG + 0x3ffc, %g2
+1:		sta	%g0, [%g1] ASI_PADRE_ICMU
+		cmp	%g1, %g2
+		blu	1b
+		 add	%g1, 0x4, %g1
+		set	PADRE_ICMU_CTRL, %g1
+		sta	%g0, [%g1] ASI_PADRE_ICMU
+		WRITE_PAUSE
+		set	PADRE_ICMU_CTRL_EN, %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		WRITE_PAUSE
+
+		/* Antémémoire D : idem */
+		set	PADRE_DCMU_CTRL, %g1
+		set	PADRE_DCMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		set	PADRE_DCMU_DTAG, %g1
+		set	PADRE_DCMU_DTAG + 0x3ffc, %g2
+1:		sta	%g0, [%g1] ASI_PADRE_DCMU
+		cmp	%g1, %g2
+		blu	1b
+		 add	%g1, 0x4, %g1
+		set	PADRE_S3_RAMTOP, %g3
+		set	PADRE_DCMU_CTRL, %g1
+		set	PADRE_DCMU_CTRL_EN, %g2
+		sta	%g0, [%g1] ASI_PADRE_DCMU
+		WRITE_PAUSE
+		ld	[%g3], %g0
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		WRITE_PAUSE
+		ld	[%g3], %g0
+
+		/* Micrologiciel du List Processor (2.6.17 : head.S, load_lp) : le
+		 * LP exécute init_lp (adresse bus dans la boîte aux lettres SRAM),
+		 * qui recopie lp_s_code/lp_s_data dans ses mémoires internes puis
+		 * vide la boîte. Attente bornée ; jalon « L » (prêt) ou « l » (muet).
+		 */
+		set	0x60000090, %g1			! PADRE_SYS_ID
+		ld	[%g1], %g1
+		srl	%g1, 16, %g1
+		set	0x3107, %g3
+		cmp	%g1, %g3
+		bne	1f
+		 sethi	%hi(0x70000000), %g1		! IT1008 et défaut
+		set	0x70007ffc, %g1			! IT3107
+1:		set	padre_init_lp, %g2
+		sethi	%hi(0x40000000), %g3
+		sub	%g2, %g3, %g2
+		st	%g2, [%g1]
+		set	0x60000094, %g3			! PADRE_SYS_CTRL
+		set	0x2 << 12, %g4
+		st	%g4, [%g3]
+		set	50000000, %g4
+2:		ld	[%g1], %g2
+		cmp	%g2, %g0
+		be	3f
+		 subcc	%g4, 1, %g4
+		bne	2b
+		 nop
+		mov	'l', %g2
+		b	4f
+		 nop
+3:		mov	'L', %g2
+4:		set	0x60000060, %g3
+		st	%g2, [%g3]
+		b	5f
+		 nop
+
+		/* Exécuté par le LP (second cœur), MMU coupée : adresses bus */
+		.globl	padre_init_lp
+padre_init_lp:
+		set	PADRE_ICMU_CTRL, %g1
+		set	PADRE_ICMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		set	PADRE_ICMU_IRD, %g1
+		set	PADRE_ICMU_IRD + PADRE_LP_IRD_SIZE, %g3
+		set	lp_s_code, %g4
+		sethi	%hi(0x40000000), %g5
+		sub	%g4, %g5, %g4
+6:		ld	[%g4], %g2
+		sta	%g2, [%g1] ASI_PADRE_ICMU
+		add	%g4, 0x4, %g4
+		add	%g1, 0x4, %g1
+		cmp	%g1, %g3
+		bl	6b
+		 nop
+		set	PADRE_DCMU_CTRL, %g1
+		set	PADRE_DCMU_CTRL_TM, %g2
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		set	PADRE_DCMU_DRD, %g1
+		set	PADRE_DCMU_DRD + PADRE_LP_DRD_SIZE, %g3
+		set	lp_s_data, %g4
+		sethi	%hi(0x40000000), %g5
+		sub	%g4, %g5, %g4
+7:		ld	[%g4], %g2
+		sta	%g2, [%g1] ASI_PADRE_DCMU
+		add	%g4, 0x4, %g4
+		add	%g1, 0x4, %g1
+		cmp	%g1, %g3
+		bl	7b
+		 nop
+		set	0x10000, %g3			! INST_RAM_TOP
+		mov	%g3, %tbr
+		mov	%g0, %wim
+		WRITE_PAUSE
+		set	0x10e0, %g1
+		mov	%g1, %psr
+		WRITE_PAUSE
+		set	PADRE_ICMU_CTRL, %g3
+		set	(0x10000 & PADRE_CMU_CTRL_TAG) | PADRE_ICMU_CTRL_IC3 | PADRE_ICMU_CTRL_EN, %g4
+		sta	%g4, [%g3] ASI_PADRE_ICMU
+		set	PADRE_DCMU_CTRL, %g3
+		set	(0x0 & PADRE_CMU_CTRL_TAG) | PADRE_DCMU_CTRL_DC3 | PADRE_DCMU_CTRL_EN, %g4
+		sta	%g4, [%g3] ASI_PADRE_DCMU
+		set	0x0 + PADRE_LP_DRD_SIZE - 4, %sp	! DATA_RAM_TOP + taille - 4
+		mov	%sp, %g3
+		set	0x10000 + 0x134, %g1
+		jmp	%g1
+		 nop
+5:
+		/* Jalon « P » sur la console (UART 0x6000_0060) : MMU et
+		 * antémémoires réglées, le noyau tourne.
+		 */
+		set	0x60000060, %g1
+		mov	'P', %g2
+		st	%g2, [%g1]
+
+		/* « PROM » émulée par le noyau (padre_prom.c) */
+		set	padre_romvec, %o0
+		sethi	%hi(prom_vector_p), %g1
+		st	%o0, [%g1 + %lo(prom_vector_p)]
+		set	continue_boot, %g1
+		jmpl	%g1, %g0
+		 nop
+#endif
 		/* Ok, it's nice to know, as early as possible, if we
 		 * are already mapped where we expect to be in virtual
 		 * memory.  The Solaris /boot elf format bootloader
@@ -516,7 +690,11 @@
 		/* Turn on Supervisor, EnableFloating, and all the PIL bits.
 		 * Also puts us in register window zero with traps off.
 		 */
+#ifdef CONFIG_SPARC_PADRE
+		set	(PSR_PS | PSR_S | PSR_PIL), %g2	! pas de FPU
+#else
 		set	(PSR_PS | PSR_S | PSR_PIL | PSR_EF), %g2
+#endif
 		wr	%g2, 0x0, %psr
