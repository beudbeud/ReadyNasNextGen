diff --color -urN a/linux/arch/sparc/kernel/padre_kernel.c b/linux/arch/sparc/kernel/padre_kernel.c
--- a/arch/sparc/kernel/padre_kernel.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/sparc/kernel/padre_kernel.c	2026-11-16 23:48:48.363454632 +0100
@@ -0,0 +1,425 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_kernel.c : interruptions et minuterie de l'Infrant IT3107 « Padre ».
+ *
+ * Fonctionnement repris des sources GPL du noyau 2.6.17 de NETGEAR
+ * (arch/padre/kernel/irq.c et time.c), réécrit pour irq_chip et le cadre
+ * sparc_config de arch/sparc. Non vérifié sur le matériel.
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/io.h>
+#include <linux/spinlock.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+#include <linux/kernel_stat.h>
+#include <linux/sched/stat.h>
+#include <linux/sched/task_stack.h>
+#include <linux/stdarg.h>
+#include <linux/sched.h>
+#include <linux/timekeeping.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <asm/irq_regs.h>
+
+#include <asm/padre.h>
+#include <asm/timer.h>
+#include <asm/oplib.h>
+
+#include "irq.h"
+#include "kernel.h"
+
+/* padre.desactive=nom1,nom2… : pilotes Padre à ne pas lancer (mise au point) */
+static char padre_desactive_liste[64];
+
+static int __init padre_desactive_param(char *s)
+{
+	strscpy(padre_desactive_liste, s ? s : "", sizeof(padre_desactive_liste));
+	return 0;
+}
+early_param("padre.desactive", padre_desactive_param);
+
+bool padre_desactive(const char *nom)
+{
+	const char *p = padre_desactive_liste;
+	size_t n = strlen(nom);
+
+	while (*p) {
+		if (!strncmp(p, nom, n) && (p[n] == ',' || p[n] == 0)) {
+			pr_info("padre: %s désactivé (padre.desactive=)\n", nom);
+			return true;
+		}
+		p = strchrnul(p, ',');
+		if (*p)
+			p++;
+	}
+	return false;
+}
+EXPORT_SYMBOL(padre_desactive);
+
+static unsigned int padre_virq[PADRE_NR_HWIRQ];
+static u32 padre_mask_l, padre_mask_h;	/* copie des registres de masque */
+static DEFINE_RAW_SPINLOCK(padre_irq_lock);
+
+static void padre_write_masks(void)
+{
+	__raw_writel(padre_mask_h, (void __iomem *)PADRE_INTC0_MASK_H);
+	__raw_writel(padre_mask_l, (void __iomem *)PADRE_INTC0_MASK_L);
+	/* « bug 505 » du 2.6.17 : écriture factice après le masque */
+	__raw_writel(0, (void __iomem *)PADRE_BUG505_ADDR);
+}
+
+static void padre_irq_mask(struct irq_data *d)
+{
+	unsigned long hw = (unsigned long)irq_data_get_irq_chip_data(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&padre_irq_lock, flags);
+	if (hw > 31)
+		padre_mask_h &= ~(1U << (hw - 32));
+	else
+		padre_mask_l &= ~(1U << hw);
+	padre_write_masks();
+	raw_spin_unlock_irqrestore(&padre_irq_lock, flags);
+}
+
+static void padre_irq_unmask(struct irq_data *d)
+{
+	unsigned long hw = (unsigned long)irq_data_get_irq_chip_data(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&padre_irq_lock, flags);
+	/* sources 16-27 (GPIO, PCI) : cause verrouillée, effacée APRÈS le
+	 * gestionnaire, juste avant le démasquage (2.6.17 : end_padre_irq_lv)
+	 */
+	if (hw >= PADRE_HWIRQ_LEVEL_FIRST && hw <= PADRE_HWIRQ_LEVEL_LAST)
+		__raw_writel(1U << hw, (void __iomem *)PADRE_INTC0_ICAUSE_L);
+	if (hw > 31)
+		padre_mask_h |= 1U << (hw - 32);
+	else
+		padre_mask_l |= 1U << hw;
+	padre_write_masks();
+	raw_spin_unlock_irqrestore(&padre_irq_lock, flags);
+}
+
+/* acquittement : rien ici, la cause des sources 16-27 est effacée au
+ * démasquage (après le gestionnaire)
+ */
+static void padre_irq_ack(struct irq_data *d)
+{
+}
+
+static struct irq_chip padre_irq_chip = {
+	.name		= "padre",
+	.irq_mask	= padre_irq_mask,
+	.irq_unmask	= padre_irq_unmask,
+	.irq_ack	= padre_irq_ack,
+};
+
+unsigned int padre_irq_virq(unsigned int hwirq)
+{
+	return hwirq < PADRE_NR_HWIRQ ? padre_virq[hwirq] : 0;
+}
+EXPORT_SYMBOL(padre_irq_virq);
+
+static unsigned int padre_build_device_irq(struct platform_device *op,
+					   unsigned int real_irq)
+{
+	return padre_irq_virq(real_irq);
+}
+
+/* Appelé par handler_irq() pour chaque niveau. Le 2.6.17 lisait le mot haut
+ * (sources 32-47) si niveau > 4, le mot bas sinon ; on lit les deux à chaque
+ * fois : si cette règle est fausse pour une source, on la sert quand même
+ * au lieu de reprendre le même piège sans fin (blocage silencieux).
+ */
+static unsigned long padre_irq_vides;
+
+/* Garde anti-tempête : une source qui se déclenche plus de 20 000 fois en
+ * une seconde est masquée (message), au lieu d'affamer tout le reste.
+ * La minuterie (source 46) en est exclue : la masquer arrête tout. Bogue
+ * corrigé : la fenêtre partait de 0 alors que jiffies commence à
+ * INITIAL_JIFFIES (négatif, -300 s) ; time_after() restait faux pendant
+ * 5 min, le compteur ne repartait jamais à zéro et la minuterie était
+ * « masquée pour tempête » à son 20 000e tic (≈ 200 s, essai 14:59).
+ */
+static unsigned long padre_tempete_t[PADRE_NR_HWIRQ];
+static unsigned int padre_tempete_n[PADRE_NR_HWIRQ];
+
+static void padre_dispatch(u32 cause, unsigned int base)
+{
+	while (cause) {
+		unsigned int bit = __ffs(cause), hw = base + bit;
+
+		cause &= ~(1U << bit);
+		if (hw >= PADRE_NR_HWIRQ)
+			continue;
+		if (hw == PADRE_HWIRQ_TIMER1) {
+			generic_handle_irq(padre_virq[hw]);
+			continue;
+		}
+		if (!padre_tempete_n[hw] ||
+		    time_after(jiffies, padre_tempete_t[hw] + HZ)) {
+			padre_tempete_t[hw] = jiffies;
+			padre_tempete_n[hw] = 0;
+		}
+		if (++padre_tempete_n[hw] > 20000) {
+			pr_err("padre: tempête d'interruptions sur la source %u, masquée\n", hw);
+			disable_irq_nosync(padre_virq[hw]);
+			padre_tempete_n[hw] = 0;
+			continue;
+		}
+		generic_handle_irq(padre_virq[hw]);
+	}
+}
+
+void padre_handler_irq(unsigned int pil)
+{
+	u32 h = __raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_H) & padre_mask_h;
+	u32 l = __raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_L) & padre_mask_l;
+
+	if (!h && !l) {
+		if (!(padre_irq_vides++ & 0xffff))
+			pr_warn("padre: interruption niveau %u sans cause (H=%08x L=%08x, %lu fois)\n",
+				pil, __raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_H),
+				__raw_readl((void __iomem *)PADRE_INTC0_ICAUSE_L), padre_irq_vides);
+		return;
+	}
+	padre_dispatch(h, 32);
+	padre_dispatch(l, 0);
+}
+
+/* --------------------------------------------------------------------
+ * Minuterie 1 : 50 000 tops/s, rechargement automatique à chaque tic
+ */
+#define PADRE_TICKS_PER_JIFFY	(PADRE_TIMER_HZ / HZ)
+
+static unsigned int padre_cycles_offset(void)
+{
+	u32 a, b = __raw_readl((void __iomem *)PADRE_TM_CNTDIAG);
+	int n = 8;
+
+	do {	/* lecture stable, comme do_gettimeoffset() en 2.6.17 */
+		a = b;
+		b = __raw_readl((void __iomem *)PADRE_TM_CNTDIAG);
+	} while (a != b && --n);
+
+	/* compteur décroissant de PADRE_TICKS_PER_JIFFY - 1 à 0 */
+	if (b >= PADRE_TICKS_PER_JIFFY)
+		return 0;
+	return PADRE_TICKS_PER_JIFFY - 1 - b;
+}
+
+/* padre.trace_tick=1 (défaut 0, mise au point) : à chaque tic, photo de l'état dans
+ * padre_tic, lue par /proc/padre_tic. AUCUN printk ni ktime_get() ici :
+ * padre_clear_clock_irq() est appelé par timer_interrupt() SOUS
+ * write_seqlock(&timer_cs_lock), et timer_cs_read() (donc ktime_get) attend
+ * la fin de ce verrou : interblocage (7e essai, figé après « Switched to
+ * clocksource timer_cs »). 0 = pas de photo.
+ */
+static unsigned int padre_trace_tick;
+
+static int __init padre_trace_tick_param(char *s)
+{
+	return kstrtouint(s, 0, &padre_trace_tick);
+}
+early_param("padre.trace_tick", padre_trace_tick_param);
+
+static struct {
+	unsigned long tics, jiffies, pending, pc, psr;
+	unsigned int preempt, timer, hrtimer, rcu, sched;
+	int pid;
+	char comm[TASK_COMM_LEN];
+} padre_tic;
+
+/* Chien de garde du tic : si aucun changement de contexte depuis 2 s, écrit
+ * directement sur l'UART (padre_prom_write : scrutation, sans verrou ni
+ * printk) la tâche interrompue, pc/npc/psr/o7 et la chaîne des fp. Puis
+ * toutes les 2 s tant que ça dure (numéro de tic : preuve que le tic
+ * tourne), 30 fois au plus. Aucune ligne pendant un blocage = tic mort,
+ * donc blocage interruptions masquées.
+ */
+static void padre_brut(const char *fmt, ...)
+{
+	static char buf[160];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vscnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	padre_prom_write(0, buf, n);
+}
+
+static void padre_chien(struct pt_regs *regs)
+{
+	static unsigned long long dern;
+	static unsigned int fige, sorties, pouls;
+	unsigned long long sw = nr_context_switches_cpu(0);
+	unsigned long base, fp;
+	int i;
+
+	/* Pouls (9e essai : le chien n'a jamais parlé) : toutes les 2 s de 8 à
+	 * 60 s de tics, puis toutes les 10 s, 150 lignes au plus. Le dernier
+	 * pouls imprimé date l'arrêt du tic à 2 s près.
+	 */
+	if (regs && pouls < 150 &&
+	    ((padre_tic.tics >= 8 * HZ && padre_tic.tics <= 60 * HZ &&
+	      !(padre_tic.tics % (2 * HZ))) || !(padre_tic.tics % (10 * HZ)))) {
+		pouls++;
+		padre_brut("[pouls] tic %lu sw %llu %.16s[%d] %c pc %08lx\n",
+			   padre_tic.tics, sw, current->comm, current->pid,
+			   (regs->psr & PSR_PS) ? 'k' : 'u', regs->pc);
+	}
+
+	if (sw != dern) {
+		dern = sw;
+		fige = 0;
+		return;
+	}
+	if (++fige % (2 * HZ) || sorties >= 30 || !regs)
+		return;
+	sorties++;
+	padre_brut("\n[chien] tic %lu jiffies %lu : aucune commutation depuis %u s (%llu), %.16s[%d] %s pc %08lx npc %08lx psr %08lx o7 %08lx preempt %08x softirq %03lx\n",
+		   padre_tic.tics, jiffies, fige / HZ, sw, current->comm,
+		   current->pid, (regs->psr & PSR_PS) ? "noyau" : "user",
+		   regs->pc, regs->npc, regs->psr, regs->u_regs[UREG_RETPC],
+		   preempt_count(), (unsigned long)local_softirq_pending());
+	padre_brut("[chien] pc %pS o7 %pS\n", (void *)regs->pc,
+		   (void *)regs->u_regs[UREG_RETPC]);
+	if (!(regs->psr & PSR_PS))
+		return;
+	/* pile noyau : mêmes bornes que show_stack() */
+	base = (unsigned long)task_stack_page(current);
+	fp = regs->u_regs[UREG_FP];
+	for (i = 0; i < 10; i++) {
+		struct reg_window32 *rw = (struct reg_window32 *)fp;
+
+		if (fp < base + sizeof(struct thread_info) ||
+		    fp >= base + (PAGE_SIZE << 1) || (fp & 7))
+			break;
+		padre_brut("[chien]   %08lx %pS\n", rw->ins[7], (void *)rw->ins[7]);
+		fp = rw->ins[6];
+	}
+}
+
+static void padre_clear_clock_irq(void)
+{
+	struct pt_regs *regs;
+
+	/* rien à effacer : le 2.6.17 n'efface pas la cause de la minuterie */
+	if (!padre_trace_tick)
+		return;
+	regs = get_irq_regs();
+	padre_tic.tics++;
+	padre_tic.jiffies = jiffies;
+	padre_tic.preempt = preempt_count();
+	padre_tic.pending = local_softirq_pending();
+	padre_tic.timer = kstat_softirqs_cpu(TIMER_SOFTIRQ, 0);
+	padre_tic.hrtimer = kstat_softirqs_cpu(HRTIMER_SOFTIRQ, 0);
+	padre_tic.rcu = kstat_softirqs_cpu(RCU_SOFTIRQ, 0);
+	padre_tic.sched = kstat_softirqs_cpu(SCHED_SOFTIRQ, 0);
+	padre_tic.pid = current->pid;
+	memcpy(padre_tic.comm, current->comm, TASK_COMM_LEN);
+	padre_tic.pc = regs ? regs->pc : 0;
+	padre_tic.psr = regs ? regs->psr : 0;
+	padre_chien(regs);
+}
+
+/* Lecture hors interruption : ici ktime_get() est sans danger */
+static int padre_tic_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "maintenant : jiffies %lu ktime_ns %llu\n",
+		   jiffies, ktime_get_ns());
+	seq_printf(m, "dernier tic n°%lu : jiffies %lu preempt %08x softirq attente %03lx timer %u hrtimer %u rcu %u sched %u, %.16s[%d] pc %08lx psr %08lx\n",
+		   padre_tic.tics, padre_tic.jiffies, padre_tic.preempt,
+		   padre_tic.pending, padre_tic.timer, padre_tic.hrtimer,
+		   padre_tic.rcu, padre_tic.sched, padre_tic.comm,
+		   padre_tic.pid, padre_tic.pc, padre_tic.psr);
+	return 0;
+}
+
+static int __init padre_tic_proc(void)
+{
+	proc_create_single("padre_tic", 0444, NULL, padre_tic_show);
+	return 0;
+}
+device_initcall(padre_tic_proc);
+
+static void padre_load_profile_irq(int cpu, unsigned int limit)
+{
+}
+
+static void __init padre_init_timers(void)
+{
+	const int t = 1;
+	int err;
+
+	sparc_config.get_cycles_offset = padre_cycles_offset;
+	sparc_config.cs_period = PADRE_TICKS_PER_JIFFY;
+	sparc_config.features |= FEAT_L10_CLOCKSOURCE | FEAT_L10_CLOCKEVENT;
+
+	__raw_writel(PADRE_TM_CTRL_STP, (void __iomem *)PADRE_TM_CTRL);
+	__raw_writel(PADRE_PRESCALE, (void __iomem *)PADRE_TM_PS);
+	__raw_writel(PADRE_TICKS_PER_JIFFY - 1, (void __iomem *)PADRE_TM_TIMER1);
+	__raw_writel(PADRE_TM_AUTO(t) | PADRE_TM_LOAD(t) | PADRE_TM_INTEN(t) |
+	       PADRE_TM_SEL(t), (void __iomem *)PADRE_TM_CTRL);
+
+	err = request_irq(padre_irq_virq(PADRE_HWIRQ_TIMER1), timer_interrupt,
+			  IRQF_TIMER, "timer", NULL);
+	if (err)
+		prom_printf("padre: minuterie : request_irq %d\n", err);
+}
+
+/* setup.c 2.6.17 (init_padre_fifo, cartes P0) : FIFO des canaux MC DMA en
+ * SRAM. Le noyau d'origine les réglait lui-même (iboot ne le fait pas pour
+ * les canaux disque) : GMAC 0/1, disques 4-7 (0x8009 attendu), CP0 12/13,
+ * RXA 16/17, AU 18/19. Taille 9 = 512 octets.
+ */
+static void __init padre_init_fifo(void)
+{
+	static const struct { u8 ch; u16 base; } f[] = {
+		{ 0, 0x0c00 }, { 1, 0x0c00 },
+		{ 4, 0x0400 }, { 5, 0x0600 }, { 6, 0x0800 }, { 7, 0x0a00 },
+		{ 16, 0 }, { 17, 0 }, { 18, 0x0e00 }, { 19, 0x0e00 },
+		{ 12, 0x0200 }, { 13, 0x0200 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(f); i++) {
+		void __iomem *r = (void __iomem *)(PADRE_APB + 0x2800 + (f[i].ch << 4));
+
+		__raw_writel(f[i].base, r + 4);		/* BASE */
+		__raw_writel(0x8000 | 9, r);		/* FFCTRL = EN | 512 octets */
+	}
+}
+
+void __init padre_init_IRQ(void)
+{
+	unsigned int hw;
+
+	padre_init_fifo();
+
+	padre_mask_l = padre_mask_h = 0;
+	padre_write_masks();
+
+	for (hw = 0; hw < PADRE_NR_HWIRQ; hw++) {
+		unsigned int irq = irq_alloc(hw, hw > 31 ? 5 : 1);
+
+		if (!irq)
+			break;
+		padre_virq[hw] = irq;
+		irq_set_chip_and_handler_name(irq, &padre_irq_chip,
+					      handle_level_irq, "level");
+		irq_set_chip_data(irq, (void *)(unsigned long)hw);
+	}
+
+	sparc_config.init_timers      = padre_init_timers;
+	sparc_config.build_device_irq = padre_build_device_irq;
+	sparc_config.clock_rate       = PADRE_TIMER_HZ;
+	sparc_config.clear_clock_irq  = padre_clear_clock_irq;
+	sparc_config.load_profile_irq = padre_load_profile_irq;
+}
