 arch/sparc/include/asm/elf_32.h           |  5 ++
 arch/sparc/include/asm/page_32.h          | 39 ++++++++++++--
 arch/sparc/include/asm/pgtable_32_padre.h | 43 ++++++++++-----
 arch/sparc/include/asm/thread_info_32.h   |  8 +++
 arch/sparc/kernel/padre_kernel.c          |  2 +-
 arch/sparc/mm/fault_32.c                  |  2 +-
 arch/sparc/mm/padre_mm.c                  | 65 +++++++++++++----------
 8 files changed, 123 insertions(+), 47 deletions(-)

