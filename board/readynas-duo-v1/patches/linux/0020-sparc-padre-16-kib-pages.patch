+			     "sta %%g0, [%2] %4\n\t"
+			     "sta %%g0, [%3] %4"
+			     : : "r" (addr), "r" (addr + 0x1000),
+			       "r" (addr + 0x2000), "r" (addr + 0x3000),
+			       "i" (ASI_PADRE_TLBPROBE) : "memory");
