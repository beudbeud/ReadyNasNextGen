--- a/arch/sparc/Kconfig
+++ b/arch/sparc/Kconfig
@@ -61,7 +61,7 @@ config SPARC32
 	select GENERIC_LIB_CMPDI2
 	select GENERIC_LIB_UCMPDI2
 	select HAVE_UID16
-	select HAVE_PAGE_SIZE_4KB
+	select HAVE_PAGE_SIZE_4KB if !SPARC_PADRE
 	select LOCK_MM_AND_FIND_VMA
 	select OLD_SIGACTION
 	select ZONE_DMA
@@ -354,11 +354,15 @@ config SPARC_PADRE
 	select ARCH_HAS_SYNC_DMA_FOR_DEVICE
 	select ARCH_HAS_DMA_PREP_COHERENT
 	select ARCH_HAS_DMA_ALLOC
+	select HAVE_PAGE_SIZE_16KB
 	select USB_EHCI_BIG_ENDIAN_MMIO if USB_EHCI_HCD
 	help
 	  Kernel for the Infrant IT3107 SoC (ReadyNAS Duo v1, NV+ v1): two-level
 	  Infrant MMU (not SRMMU), no PROM (iboot), raw kernel linked at
 	  0x80004000, C code compiled as SPARC v7 (sdiv is broken).
+	  16 KiB pages (4 hardware entries of 4 KiB each, like the stock
+	  2.6.17 kernel): the kernel mounts the ext3 volumes with 16 KiB
+	  blocks made by RAIDiator.
 	  A Padre kernel does not boot on any other machine.
 
 
