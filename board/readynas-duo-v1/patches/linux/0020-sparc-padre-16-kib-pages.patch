 {
-	return (pmd_val(pmd) & ~PAGE_MASK) != _PADRE_PGD_TABLE;
+	return (pmd_val(pmd) & ~PADRE_HW_TABLE_MASK) != _PADRE_PGD_TABLE;
 }
 
