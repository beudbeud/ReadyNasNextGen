+ * CONFIG_PADRE_16K_PAGE). pte_val()/__pte() (pgtable_32_padre.h) give a
+ * single word: entry 0, plus the A/D bits the MMU set in entries 1-3.
+ */
+typedef struct { unsigned long hw[4]; } pte_t;
+#else
 typedef unsigned long pte_t;
+#endif
 typedef unsigned long iopte_t;
 #ifndef CONFIG_SPARC_PADRE	/* Padre: folded pmd (pgtable-nopmd.h) */
 typedef unsigned long pmd_t;
@@ -88,18 +96,18 @@ typedef unsigned long ctxd_t;
 typedef unsigned long pgprot_t;
 typedef unsigned long iopgprot_t;
 
-#define pte_val(x)	(x)
-#define iopte_val(x)	(x)
 #ifndef CONFIG_SPARC_PADRE
+#define pte_val(x)	(x)
 #define pmd_val(x)      (x)
 #endif
+#define iopte_val(x)	(x)
 #define pgd_val(x)	(x)
 #define ctxd_val(x)	(x)
 #define pgprot_val(x)	(x)
 #define iopgprot_val(x)	(x)
 
-#define __pte(x)	(x)
 #ifndef CONFIG_SPARC_PADRE
+#define __pte(x)	(x)
 #define __pmd(x)	(x)
 #endif
 #define __iopte(x)	(x)
@@ -112,6 +120,31 @@ typedef unsigned long iopgprot_t;
 
 typedef pte_t *pgtable_t;
 
+#ifdef CONFIG_SPARC_PADRE
+#include <asm/padre.h>
+
+/* Entry 0 + the accessed/dirty bits written by the MMU in entries 1-3 */
+static inline unsigned long pte_val(pte_t pte)
+{
+	unsigned long v = pte.hw[0];
+
+	if (v & _PADRE_PAGE_V)
+		v |= (pte.hw[1] | pte.hw[2] | pte.hw[3]) &
+		     (_PADRE_PAGE_A | _PADRE_PAGE_D);
+	return v;
+}
+
+/* Valid mapping: 4 entries for the 4 consecutive 4 KiB frames;
+ * otherwise (swap, PROT_NONE, empty) the same invalid word 4 times.
+ */
+static inline pte_t __pte(unsigned long v)
+{
+	unsigned long step = (v & _PADRE_PAGE_V) ? 0x1000 : 0;
+
+	return (pte_t) { { v, v + step, v + 2 * step, v + 3 * step } };
+}
+#endif
+
 #ifdef CONFIG_SPARC_PADRE
 #define TASK_UNMAPPED_BASE	0x20000000
 #else
diff --git a/arch/sparc/include/asm/pgtable_32_padre.h b/arch/sparc/include/asm/pgtable_32_padre.h
