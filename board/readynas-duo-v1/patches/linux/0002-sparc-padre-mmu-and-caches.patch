--- /dev/null
+++ b/arch/sparc/include/asm/pgalloc_32_padre.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Padre: page directories and page tables come from the uncached area
+ * (padre_mm.c), like the SRMMU "nocache" pool.
+ */
+#ifndef _SPARC_PGALLOC_32_PADRE_H
+#define _SPARC_PGALLOC_32_PADRE_H
+
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/pgtable.h>
+#include <asm/page.h>
+
+void *padre_get_nocache_page(void);
+void padre_free_nocache_page(void *addr);
+
+pgd_t *pgd_alloc(struct mm_struct *mm);
+void pgd_free(struct mm_struct *mm, pgd_t *pgd);
+
+static inline void pmd_populate_kernel(struct mm_struct *mm, pmd_t *pmdp,
+				       pte_t *ptep)
+{
+	WRITE_ONCE(*pmdp, __pmd(__pa(ptep) | _PADRE_PGD_TABLE));
+}
+#define pmd_populate(mm, pmdp, pte)	pmd_populate_kernel(mm, pmdp, pte)
+
+pgtable_t pte_alloc_one(struct mm_struct *mm);
+void pte_free(struct mm_struct *mm, pgtable_t pte);
+
+static inline pte_t *pte_alloc_one_kernel(struct mm_struct *mm)
+{
+	return padre_get_nocache_page();
+}
+
+static inline void pte_free_kernel(struct mm_struct *mm, pte_t *pte)
+{
+	padre_free_nocache_page(pte);
+}
+
+#define __pte_free_tlb(tlb, pte, addr)	pte_free((tlb)->mm, pte)
+
+#endif /* _SPARC_PGALLOC_32_PADRE_H */
