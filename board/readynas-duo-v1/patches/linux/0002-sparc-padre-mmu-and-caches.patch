+// SPDX-License-Identifier: GPL-2.0
+/*
+ * padre_mm.c: MMU and caches of the Infrant IT3107 "Padre".
+ *
+ * Replaces srmmu.c for CONFIG_SPARC_PADRE. The hardware behaviour comes
+ * from NETGEAR's GPL 2.6.17 kernel sources (include/asm-padre/
+ * {pgtable,tlbflush,mmu_context}.h, arch/padre/mm/{init,fault,
+ * padre_cache}.c); the code is rewritten for the 6.x kernel API.
+ *
