+#include <linux/dma-map-ops.h>
+#include <linux/dma-direct.h>
+#include <linux/pagemap.h>
+#include <linux/moduleparam.h>
+
+#include <asm/padre.h>
+#include <asm/page.h>
+#include <asm/pgtable.h>
+#include <asm/pgalloc.h>
+#include <asm/mmu_context.h>
+#include <asm/cacheflush.h>
+#include <asm/tlbflush.h>
+#include <asm/sections.h>
+#include <asm/setup.h>
+#include <asm/psr.h>
+
+#include "mm_32.h"
+
+extern unsigned long last_valid_pfn;
+extern unsigned long highstart_pfn, highend_pfn;
+
+const struct sparc32_cachetlb_ops *sparc32_cachetlb_ops;
+EXPORT_SYMBOL(sparc32_cachetlb_ops);
+
+/* Used by other arch/sparc files */
+char *srmmu_name = "Infrant Padre";
+int viking_mxcc_present;
+int flush_page_for_dma_global = 1;
+int vac_cache_size;
+EXPORT_SYMBOL(vac_cache_size);
+int vac_line_size;
+
+/* ---------------------------------------------------------------------
+ * Caches (2.6.17 padre_cache.c; padre_cachefix is set to 1 there by
+ * padre_i2c when boot_param.product_features has bit 5)
+ */
+static int padre_cachefix;
+static inline unsigned long padre_read_dcctrl(void)
+{
+	unsigned long val;
+
+	__asm__ __volatile__("lda [%1] %2, %0"
+			     : "=r" (val)
+			     : "r" (PADRE_DCMU_CTRL), "i" (ASI_PADRE_DCMU));
+	return val;
+}
+
+static inline void padre_write_dcctrl(unsigned long val)
+{
+	__asm__ __volatile__("sta %0, [%1] %2"
+			     : : "r" (val), "r" (PADRE_DCMU_CTRL),
+			       "i" (ASI_PADRE_DCMU) : "memory");
+}
+
+/* Probe each line of [start, end] in the requested mode */
+static void padre_dcache_probe(unsigned long start, unsigned long end,
+			       unsigned long mode)
+{
+	unsigned long flags, val;
+
+	if (end <= start)
+		return;
+	start &= ~(PADRE_DCACHE_LINE - 1UL);
+	end = (end - 1) & ~(PADRE_DCACHE_LINE - 1UL);
+
+	local_irq_save(flags);
+	val = padre_read_dcctrl();
+	padre_write_dcctrl(val | mode);
+	for (; start <= end; start += PADRE_DCACHE_LINE)
+		__asm__ __volatile__("ld [%0], %%g0" : : "r" (start) : "memory");
+	padre_write_dcctrl(val);
+	local_irq_restore(flags);
+}
+
+/* Write dirty lines back to memory (without invalidating) */
+void padre_clean_dcache_range(unsigned long start, unsigned long end)
+{
+	padre_dcache_probe(start, end, PADRE_DCMU_PROBE_CLEAN);
+}
+EXPORT_SYMBOL(padre_clean_dcache_range);
+
+/* Write back, then invalidate */
+void padre_flush_dcache_range(unsigned long start, unsigned long end)
+{
+	padre_dcache_probe(start, end, PADRE_DCMU_PROBE_INVCLN);
+}
+EXPORT_SYMBOL(padre_flush_dcache_range);
+
+/* Whole D-cache, by a forced sweep of the S3 SRAM (2.6.17) */
+void padre_flush_dcache_all(void)
+{
+	unsigned long flags, val, a;
+
+	local_irq_save(flags);
+	val = padre_read_dcctrl();
+	padre_write_dcctrl(val | PADRE_DCMU_PROBE_INVCLN |
+			   PADRE_DCMU_CTRL_FORCE | 0x80);
+	for (a = PADRE_S3_RAMTOP_CACHEABLE;
+	     a <= PADRE_S3_RAMTOP_CACHEABLE + 0x1000 - PADRE_DCACHE_LINE;
+	     a += PADRE_DCACHE_LINE)
+		__asm__ __volatile__("ld [%0], %%g0" : : "r" (a) : "memory");
+	padre_write_dcctrl(val);
+	local_irq_restore(flags);
+}
+
+/* Invalidate the whole I-cache: disabled, tags cleared by the MBIST
+ * engine, re-enabled (2.6.17: __flush_icache_workaround).
+ */
+void padre_flush_icache_all(void)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	__asm__ __volatile__("sta %%g0, [%0] %1\n\tnop; nop; nop"
+			     : : "r" (PADRE_ICMU_CTRL), "i" (ASI_PADRE_ICMU)
+			     : "memory");
+	/* 2.6.17: "cachefix" variant if product_features bit 5 (the case
+	 * for the Duo v1 studied, VPD 0x17b = 0x63)
+	 */
+	__raw_writel(padre_cachefix ? 0x0ff : 0x3ff, (void __iomem *)PADRE_MBIST_ADDR);
+	__raw_writel(0, (void __iomem *)PADRE_MBIST_DATA);
+	__raw_writel(PADRE_MBIST_MODE_EN | (1 << 20) | (padre_cachefix ? 1 << 10 : 0),
+	       (void __iomem *)PADRE_MBIST_MODE);
+	{
+		unsigned int n = 1000000;
+
+		while (!(__raw_readl((void __iomem *)PADRE_MBIST_MODE) & PADRE_MBIST_MODE_DONE) && --n)
+			;
+		if (!n)
+			pr_err("padre: MBIST (I-cache flush) never completes\n");
+	}
+	__raw_writel(0, (void __iomem *)PADRE_MBIST_MODE);
+	__asm__ __volatile__("sta %0, [%1] %2\n\tnop; nop; nop"
+			     : : "r" (PADRE_ICMU_CTRL_EN), "r" (PADRE_ICMU_CTRL),
+			       "i" (ASI_PADRE_ICMU) : "memory");
+	local_irq_restore(flags);
+}
+
+void padre_flush_icache_range(unsigned long start, unsigned long end)
+{
+	padre_clean_dcache_range(start, end);
+	padre_flush_icache_all();
+}
+EXPORT_SYMBOL(padre_flush_icache_range);
+
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long address, pte_t *ptep, unsigned int nr)
+{
+	unsigned long kaddr;
+
+	if (!(vma->vm_flags & VM_EXEC) || !pfn_valid(pte_pfn(*ptep)))
+		return;
+	kaddr = (unsigned long)__va(pte_pfn(*ptep) << PAGE_SHIFT);
+	padre_flush_icache_range(kaddr, kaddr + nr * PAGE_SIZE);
+}
+
+static void padre_nop_all(void) { }
+static void padre_nop_mm(struct mm_struct *mm) { }
+static void padre_nop_range(struct vm_area_struct *vma, unsigned long s,
+			    unsigned long e) { }
+static void padre_nop_page(struct vm_area_struct *vma, unsigned long a) { }
+
+static void padre_page_to_ram(unsigned long page)
+{
+	padre_clean_dcache_range(page, page + PAGE_SIZE);
+}
+
+static void padre_page_for_dma(unsigned long page)
+{
+	padre_flush_dcache_range(page, page + PAGE_SIZE);
+}
+
+static void padre_sig_insns(struct mm_struct *mm, unsigned long insn_addr)
+{
+	padre_flush_dcache_all();
+	padre_flush_icache_all();
+}
+
+/* ---------------------------------------------------------------------
+ * TLB (no contexts: flushed on every address space switch)
+ */
+static inline void padre_set_pgt(pgd_t *pgd)
+{
+	__asm__ __volatile__("sta %0, [%1] %2"
+			     : : "r" (__pa(pgd) | PADRE_MMU_PGT_EN | PADRE_MMU_PGT_FL),
+			       "r" (PADRE_MMU_PGT), "i" (ASI_PADRE_MMU) : "memory");
+}
+
+static void padre_tlb_all(void)
+{
+	__asm__ __volatile__("sta %0, [%1] %2"
+			     : : "r" (PADRE_MMU_CONTROL_FL | PADRE_MMU_ON),
+			       "r" (PADRE_MMU_CONTROL), "i" (ASI_PADRE_MMU)
+			     : "memory");
+}
+
+static void padre_tlb_mm(struct mm_struct *mm)
+{
+	if (mm == current->active_mm)
+		padre_tlb_all();
+}
+
+static void padre_tlb_range(struct vm_area_struct *vma, unsigned long start,
+			    unsigned long end)
+{
+	padre_tlb_mm(vma->vm_mm);
+}
+
+/* 2.6.17: the TLB probe may write the entry back to memory, so restore
+ * the value read before (flush_tlb_page in asm-padre/tlbflush.h).
+ */
+static void padre_tlb_page(struct vm_area_struct *vma, unsigned long addr)
+{
+	struct mm_struct *mm = vma->vm_mm;
+	unsigned long flags;
+	pmd_t *pmd;
+	pte_t *ptep, pte;
+
+	if (mm != current->active_mm)
+		return;
+	addr &= PAGE_MASK;
+	pmd = pmd_off(mm, addr);
+	local_irq_save(flags);
+	if (pmd_none(*pmd)) {
+		__asm__ __volatile__("sta %%g0, [%0] %1"
+				     : : "r" (addr), "i" (ASI_PADRE_TLBPROBE)
+				     : "memory");
+	} else {
+		ptep = (pte_t *)pmd_page_vaddr(*pmd) + pte_index(addr);
+		pte = READ_ONCE(*ptep);
+		__asm__ __volatile__("sta %%g0, [%0] %1"
+				     : : "r" (addr), "i" (ASI_PADRE_TLBPROBE)
+				     : "memory");
+		WRITE_ONCE(*ptep, pte);
+	}
+	local_irq_restore(flags);
+}
+
+static const struct sparc32_cachetlb_ops padre_ops = {
+	.cache_all	= padre_nop_all,	/* no aliasing: nothing to do */
+	.cache_mm	= padre_nop_mm,
+	.cache_range	= padre_nop_range,
+	.cache_page	= padre_nop_page,
+	.tlb_all	= padre_tlb_all,
+	.tlb_mm		= padre_tlb_mm,
+	.tlb_range	= padre_tlb_range,
+	.tlb_page	= padre_tlb_page,
+	.page_to_ram	= padre_page_to_ram,
+	.sig_insns	= padre_sig_insns,
+	.page_for_dma	= padre_page_for_dma,
+};
+
+void __init load_mmu(void)
+{
+	sparc32_cachetlb_ops = &padre_ops;
+}
+
+/* ---------------------------------------------------------------------
+ * Uncached area (last 16 MB of DDR, threshold set in head_32.S):
+ * first 8 MB (2048 pages) for page directories and page tables,
+ * last 8 MB for coherent DMA (arch_dma_alloc below).
+ * first-fit bitmap allocators; enough for EHCI and a few pools,
+ * revisit if a driver makes large allocations.
+ */
+#define PADRE_NOCACHE_SIZE	(16UL << 20)
+#define PADRE_PT_PAGES		2048
+
+unsigned long padre_nocache_phys;
+static void *padre_pt_pool;
+static DECLARE_BITMAP(padre_pt_map, PADRE_PT_PAGES);
+static unsigned int padre_pt_used;
+static DEFINE_SPINLOCK(padre_pt_lock);
+
+void *padre_get_nocache_page(void)
+{
+	unsigned long flags;
+	unsigned int i;
+	void *p = NULL;
+
+	spin_lock_irqsave(&padre_pt_lock, flags);
+	i = find_first_zero_bit(padre_pt_map, PADRE_PT_PAGES);
+	if (i < PADRE_PT_PAGES) {
+		__set_bit(i, padre_pt_map);
+		padre_pt_used++;
+		p = padre_pt_pool + i * PAGE_SIZE;
+	}
+	spin_unlock_irqrestore(&padre_pt_lock, flags);
+
+	if (p)
+		memset(p, 0, PAGE_SIZE);
+	else
+		pr_err("padre: out of uncached pages for page tables\n");
+	return p;
+}
+
+void padre_free_nocache_page(void *addr)
+{
+	unsigned long flags;
+	unsigned int i = (addr - padre_pt_pool) / PAGE_SIZE;
+
+	BUG_ON(addr < padre_pt_pool || i >= PADRE_PT_PAGES);
+	spin_lock_irqsave(&padre_pt_lock, flags);
+	__clear_bit(i, padre_pt_map);
+	padre_pt_used--;
+	spin_unlock_irqrestore(&padre_pt_lock, flags);
+}
+
+/* ---------------------------------------------------------------------
+ * Coherent DMA (dma_alloc_coherent: EHCI QH/qTD descriptors...) in the
+ * last 8 MB of the area that is uncached BY PHYSICAL ADDRESS (CACHEABLE
+ * threshold), like the page tables, which do work. Before: vmap with the
+ * PTE C bit cleared; nothing shows the Padre D-cache honours that bit
+ * (2.6.17 did not trust it: it flushed the whole cache on every URB), and
+ * EHCI never saw its descriptors (-60 on every control
+ * transfer).
+ * DMA address = Linux physical address (DDR at 0x4000_0000 on the bus,
+ * like 2.6.17 virt_to_bus).
+ */
+#define PADRE_DMA_PAGES		(PADRE_NOCACHE_SIZE / PAGE_SIZE - PADRE_PT_PAGES)
+
+static DECLARE_BITMAP(padre_dma_map, PADRE_DMA_PAGES);
+static DEFINE_SPINLOCK(padre_dma_lock);
+
+void *arch_dma_alloc(struct device *dev, size_t size, dma_addr_t *dma_handle,
+		     gfp_t gfp, unsigned long attrs)
+{
+	unsigned int n = PAGE_ALIGN(size) >> PAGE_SHIFT;
+	unsigned long flags, i;
+	void *va;
+
+	spin_lock_irqsave(&padre_dma_lock, flags);
+	i = bitmap_find_next_zero_area(padre_dma_map, PADRE_DMA_PAGES, 0, n, 0);
+	if (i < PADRE_DMA_PAGES)
+		bitmap_set(padre_dma_map, i, n);
+	spin_unlock_irqrestore(&padre_dma_lock, flags);
+	if (i >= PADRE_DMA_PAGES) {
+		pr_err_ratelimited("padre: coherent DMA exhausted (%zu bytes)\n", size);
+		return NULL;
+	}
+	va = padre_pt_pool + (PADRE_PT_PAGES + i) * PAGE_SIZE;
+	memset(va, 0, n * PAGE_SIZE);
+	*dma_handle = phys_to_dma(dev, __pa(va));
+	return va;
+}
+
+void arch_dma_free(struct device *dev, size_t size, void *cpu_addr,
+		   dma_addr_t dma_handle, unsigned long attrs)
+{
+	void *base = padre_pt_pool + PADRE_PT_PAGES * PAGE_SIZE;
+	unsigned int n = PAGE_ALIGN(size) >> PAGE_SHIFT;
+	unsigned long flags, i = (cpu_addr - base) >> PAGE_SHIFT;
+
+	if (WARN_ON(cpu_addr < base || i + n > PADRE_DMA_PAGES))
+		return;
+	spin_lock_irqsave(&padre_dma_lock, flags);
+	bitmap_clear(padre_dma_map, i, n);
+	spin_unlock_irqrestore(&padre_dma_lock, flags);
+}
+
+pgd_t *pgd_alloc(struct mm_struct *mm)
+{
+	pgd_t *pgd = padre_get_nocache_page();
+
+	if (pgd)	/* kernel part (vmalloc) shared by all */
+		memcpy(pgd + USER_PTRS_PER_PGD, init_mm.pgd + USER_PTRS_PER_PGD,
+		       (PTRS_PER_PGD - USER_PTRS_PER_PGD) * sizeof(pgd_t));
+	return pgd;
+}
+
+void pgd_free(struct mm_struct *mm, pgd_t *pgd)
+{
+	padre_free_nocache_page(pgd);
+}
+
+pgtable_t pte_alloc_one(struct mm_struct *mm)
+{
+	pte_t *ptep = padre_get_nocache_page();
+
+	if (ptep && !pagetable_pte_ctor(mm, virt_to_ptdesc(ptep))) {
+		padre_free_nocache_page(ptep);
+		ptep = NULL;
+	}
+	return ptep;
+}
+
+void pte_free(struct mm_struct *mm, pgtable_t ptep)
+{
+	pagetable_dtor(virt_to_ptdesc(ptep));
+	padre_free_nocache_page(ptep);
+}
+
+/* ---------------------------------------------------------------------
+ * Context: a single base register, TLB flushed on every switch
+ */
+int init_new_context(struct task_struct *tsk, struct mm_struct *mm)
+{
+	return 0;
+}
+
+void destroy_context(struct mm_struct *mm)
+{
+}
+
+void switch_mm(struct mm_struct *old_mm, struct mm_struct *mm,
+	       struct task_struct *tsk)
+{
+	if (old_mm != mm)
+		padre_set_pgt(mm->pgd);
+}
+
+void mmu_info(struct seq_file *m)
+{
+	seq_printf(m, "MMU type\t: %s\n"
+		      "pagetables\t: %u/%u pages\n",
+		   srmmu_name, padre_pt_used, PADRE_PT_PAGES);
+}
+
+/* Preallocated kernel tables: the directory entries never change again,
+ * pgd_alloc() only has to copy them.
+ */
+static void __init padre_kernel_ptables(unsigned long start, unsigned long end)
+{
+	for (start &= PGDIR_MASK; start < end && start; start += PGDIR_SIZE) {
+		pmd_t *pmd = pmd_off_k(start);
+		pte_t *pte;
+
+		if (!pmd_none(*pmd))
+			continue;
+		pte = padre_get_nocache_page();
+		if (!pte)
+			panic("padre: kernel page tables");
+		pmd_populate_kernel(&init_mm, pmd, pte);
+	}
+}
+
+void __init srmmu_paging_init(void)
+{
+	unsigned long pages_avail = 0;
+	unsigned long max_zone_pfn[MAX_NR_ZONES] = { 0 };
+
+	init_mm.context = 0;
+	padre_cachefix = !!(padre_boot_param.product_features & (1 << 5));
+	last_valid_pfn = bootmem_init(&pages_avail);
+	/* min_low_pfn is not set by sparc32 (stays 0): dma_capable()
+	 * translates it to a DMA address; with padre.pcibus, page 0 has no
+	 * translation and ALL mappings failed (test at 16:08, -EAGAIN).
+	 */
+	min_low_pfn = pfn_base;
+
+	padre_nocache_phys = (max_low_pfn << PAGE_SHIFT) - PADRE_NOCACHE_SIZE;
+	memblock_reserve(padre_nocache_phys, PADRE_NOCACHE_SIZE);
+	padre_pt_pool = __va(padre_nocache_phys);
+
+	init_mm.pgd = padre_get_nocache_page();
+	padre_kernel_ptables(VMALLOC_START, VMALLOC_END);
+
+	padre_set_pgt(init_mm.pgd);
+	padre_tlb_all();
+
+	max_zone_pfn[ZONE_DMA] = max_low_pfn;
+	max_zone_pfn[ZONE_NORMAL] = max_low_pfn;
+	free_area_init(max_zone_pfn);
+}
+
+/* ---------------------------------------------------------------------
+ * Non-coherent DMA
+ */
+void arch_sync_dma_for_device(phys_addr_t paddr, size_t size,
+			      enum dma_data_direction dir)
+{
+	unsigned long va = (unsigned long)__va(paddr);
+
+	if (dir == DMA_TO_DEVICE)
+		padre_clean_dcache_range(va, va + size);
+	else
+		padre_flush_dcache_range(va, va + size);
+}
+
+void arch_dma_prep_coherent(struct page *page, size_t size)
+{
+	unsigned long va = (unsigned long)page_address(page);
+
+	padre_flush_dcache_range(va, va + size);
+}
