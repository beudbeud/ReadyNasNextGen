diff --git a/arch/sparc/include/asm/pgtable_32_padre.h b/arch/sparc/include/asm/pgtable_32_padre.h
new file mode 100644
index 0000000000000000000000000000000000000000..b48b5bafe297f51ebd11aacb8d4a4b707213810d
--- /dev/null
+++ b/arch/sparc/include/asm/pgtable_32_padre.h
@@ -0,0 +1,305 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Page tables of the Infrant "Padre" (IT3107) MMU.
+ *
+ * From NETGEAR's GPL 2.6.17 kernel sources: the MMU walks a two-level
+ * table itself, like i386 without PAE:
+ *   - directory of 1024 entries of 4 MB (PGT register, bus address);
+ *   - tables of 1024 entries, 4 KB hardware pages;
+ *   - entry = bus address (bits 31-12) | U R W X C T A D Z V.
+ * The shipped 2.6.17 kernel uses 16 KB Linux pages (4 hardware entries
+ * per page); here we keep 4 KB pages, a mode supported by the same code
+ * (CONFIG_PADRE_4K_PAGE), so one entry per page.
+ * The kernel itself (0x8000_0000, I/O at 0x4000_0000) needs no tables:
+ * fixed windows. Only user space and vmalloc go through the
+ * tables.
+ * The tables come from the uncached area at the top of the DDR (like
+ * CONFIG_PADRE_RESERVE_DMA in 2.6.17): the MMU reads them from memory,
+ * the D-cache is not coherent.
+ */
+#ifndef _SPARC_PGTABLE_32_PADRE_H
+#define _SPARC_PGTABLE_32_PADRE_H
+
+#include <linux/const.h>
+#include <asm/padre.h>
+
+#define PGDIR_SHIFT		22
+#define PGDIR_SIZE		(1UL << PGDIR_SHIFT)
+#define PGDIR_MASK		(~(PGDIR_SIZE-1))
+
+#ifndef __ASSEMBLER__
+#include <asm-generic/pgtable-nopmd.h>
+
+#include <linux/spinlock.h>
+#include <linux/mm_types.h>
+#include <asm/types.h>
+#include <asm/vaddrs.h>
+#include <asm/oplib.h>
+#include <asm/cpu_type.h>
+
+struct vm_area_struct;
+struct page;
+
+void load_mmu(void);
+unsigned long calc_highpages(void);
+unsigned long __init bootmem_init(unsigned long *pages_avail);
+void paging_init(void);
+
+#define pte_ERROR(e)   __builtin_trap()
+#define pmd_ERROR(e)   __builtin_trap()
+#define pgd_ERROR(e)   __builtin_trap()
+
+#define PTRS_PER_PTE		1024
+#define PTRS_PER_PGD		1024
+#define USER_PTRS_PER_PGD	(TASK_SIZE / PGDIR_SIZE)
+#define PADRE_PGD_TABLE_SIZE	(PTRS_PER_PGD * 4)
+#define PADRE_PTE_TABLE_SIZE	(PTRS_PER_PTE * 4)
+
+/* Software bit, only when V = 0: PROT_NONE (page "present" for Linux,
+ * invalid for the MMU). Bits 10 and 11 are unused by the hardware
+ * (2.6.17 already used them for pte_file).
+ */
+#define _PAGE_PROTNONE		0x400
+#define _PAGE_SWP_EXCLUSIVE	_PADRE_PAGE_Z	/* V = 0: free */
+
+#define _PAGE_P			(_PADRE_PAGE_V | _PADRE_PAGE_C)
+#define _PAGE_CHG_MASK		(PAGE_MASK | _PADRE_PAGE_A | _PADRE_PAGE_D)
+#define _PADRE_PAGE_USER	(_PADRE_PAGE_U | _PADRE_PAGE_R | _PADRE_PAGE_X)
+
+#define PAGE_NONE	__pgprot(_PAGE_PROTNONE | _PADRE_PAGE_C)
+#define PAGE_SHARED	__pgprot(_PAGE_P | _PADRE_PAGE_USER | _PADRE_PAGE_W)
+#define PAGE_COPY	__pgprot(_PAGE_P | _PADRE_PAGE_USER)
+#define PAGE_READONLY	__pgprot(_PAGE_P | _PADRE_PAGE_USER)
+#define PAGE_KERNEL	__pgprot(_PAGE_P | _PADRE_PAGE_R | _PADRE_PAGE_W | \
+				 _PADRE_PAGE_X | _PADRE_PAGE_A | _PADRE_PAGE_D)
+/* Directory entry (2.6.17: _KERNPG_TABLE / _PAGE_TABLE) */
+#define _PADRE_PGD_TABLE	(_PADRE_PAGE_W | _PADRE_PAGE_D | _PADRE_PAGE_R | \
+				 _PADRE_PAGE_X | _PAGE_P | _PADRE_PAGE_U)
+
+#define swapper_pg_dir NULL	/* the real one is allocated by padre_mm.c */
+
+extern unsigned long phys_base;
+extern unsigned long pfn_base;
+
+extern unsigned long empty_zero_page[PAGE_SIZE / sizeof(unsigned long)];
+#define ZERO_PAGE(vaddr) (virt_to_page(empty_zero_page))
+
+/* Tables in uncached memory: a plain store is enough. */
+static inline void set_pte(pte_t *ptep, pte_t pteval)
+{
+	WRITE_ONCE(*ptep, pteval);
+}
+
+static inline int pte_present(pte_t pte)
+{
+	return pte_val(pte) & (_PADRE_PAGE_V | _PAGE_PROTNONE);
+}
+
+static inline int pte_none(pte_t pte)
+{
+	return !pte_val(pte);
+}
+
+static inline void pte_clear(struct mm_struct *mm, unsigned long addr,
+			     pte_t *ptep)
+{
+	set_pte(ptep, __pte(0));
+}
+
+/* Directory level (pmd folded into pgd) */
+static inline int pmd_none(pmd_t pmd)
+{
+	return !pmd_val(pmd);
+}
+
+static inline int pmd_bad(pmd_t pmd)
+{
+	return (pmd_val(pmd) & ~PAGE_MASK) != _PADRE_PGD_TABLE;
+}
+
+static inline int pmd_present(pmd_t pmd)
+{
+	return pmd_val(pmd) & _PADRE_PAGE_V;
+}
+
+static inline void pmd_clear(pmd_t *pmdp)
+{
+	WRITE_ONCE(*pmdp, __pmd(0));
+}
+
+static inline unsigned long pmd_pfn(pmd_t pmd)
+{
+	return pmd_val(pmd) >> PAGE_SHIFT;
+}
+
+static inline struct page *pmd_page(pmd_t pmd)
+{
+	return pfn_to_page(pmd_pfn(pmd));
+}
+
+static inline unsigned long pmd_page_vaddr(pmd_t pmd)
+{
+	return (unsigned long)__va(pmd_val(pmd) & PAGE_MASK);
+}
+
+#define __pmd_page(pmd)		pmd_page_vaddr(pmd)
+#define pmd_pgtable(pmd)	((pgtable_t)pmd_page_vaddr(pmd))
+
+static inline int pte_write(pte_t pte)
+{
+	return pte_val(pte) & _PADRE_PAGE_W;
+}
+
+static inline int pte_dirty(pte_t pte)
+{
+	return pte_val(pte) & _PADRE_PAGE_D;
+}
+
+static inline int pte_young(pte_t pte)
+{
+	return pte_val(pte) & _PADRE_PAGE_A;
+}
+
+static inline pte_t pte_wrprotect(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PADRE_PAGE_W);
+}
+
+static inline pte_t pte_mkclean(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PADRE_PAGE_D);
+}
+
+static inline pte_t pte_mkold(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PADRE_PAGE_A);
+}
+
+static inline pte_t pte_mkwrite_novma(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PADRE_PAGE_W);
+}
+
+static inline pte_t pte_mkdirty(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PADRE_PAGE_D);
+}
+
+static inline pte_t pte_mkyoung(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PADRE_PAGE_A);
+}
+
+#define PFN_PTE_SHIFT		PAGE_SHIFT
+
+static inline pte_t pfn_pte(unsigned long pfn, pgprot_t pgprot)
+{
+	return __pte((pfn << PFN_PTE_SHIFT) | pgprot_val(pgprot));
+}
+
+static inline unsigned long pte_pfn(pte_t pte)
+{
+	return pte_val(pte) >> PFN_PTE_SHIFT;
+}
+
+#define pte_page(pte)	pfn_to_page(pte_pfn(pte))
+
+static inline pte_t mk_pte_phys(unsigned long page, pgprot_t pgprot)
+{
+	return __pte((page & PAGE_MASK) | pgprot_val(pgprot));
+}
+
+#define pgprot_noncached pgprot_noncached
+static inline pgprot_t pgprot_noncached(pgprot_t prot)
+{
+	return __pgprot(pgprot_val(prot) & ~_PADRE_PAGE_C);
+}
+
+static pte_t pte_modify(pte_t pte, pgprot_t newprot) __attribute_const__;
+static inline pte_t pte_modify(pte_t pte, pgprot_t newprot)
+{
+	return __pte((pte_val(pte) & _PAGE_CHG_MASK) | pgprot_val(newprot));
+}
+
+struct seq_file;
+void mmu_info(struct seq_file *m);
+
+#define FAULT_CODE_PROT     0x1
+#define FAULT_CODE_WRITE    0x2
+#define FAULT_CODE_USER     0x4
+
+/* I-cache not coherent with the D-cache: needed for executable pages
+ * (2.6.17: flush_icache_page()).
+ */
+struct vm_fault;
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long address, pte_t *ptep, unsigned int nr);
+#define update_mmu_cache(vma, address, ptep) \
+	update_mmu_cache_range(NULL, vma, address, ptep, 1)
+
+/*
+ * Swap entries (V = 0, PROTNONE = 0):
+ *   31 ............ 11 | 10 | 9 8 7 | 6 .. 2 | 1 | 0
+ *        offset        |  0 |   0   |  type  | E | 0
+ */
+#define PADRE_SWP_TYPE_SHIFT	2
+#define PADRE_SWP_TYPE_MASK	0x1f
+#define PADRE_SWP_OFF_SHIFT	11
+
+static inline unsigned long __swp_type(swp_entry_t entry)
+{
+	return (entry.val >> PADRE_SWP_TYPE_SHIFT) & PADRE_SWP_TYPE_MASK;
+}
+
+static inline unsigned long __swp_offset(swp_entry_t entry)
+{
+	return entry.val >> PADRE_SWP_OFF_SHIFT;
+}
+
+static inline swp_entry_t __swp_entry(unsigned long type, unsigned long offset)
+{
+	return (swp_entry_t) {
+		(type & PADRE_SWP_TYPE_MASK) << PADRE_SWP_TYPE_SHIFT
+		| offset << PADRE_SWP_OFF_SHIFT };
+}
+
+#define __pte_to_swp_entry(pte)		((swp_entry_t) { pte_val(pte) })
+#define __swp_entry_to_pte(x)		((pte_t) { (x).val })
+
+static inline bool pte_swp_exclusive(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_SWP_EXCLUSIVE;
+}
+
+static inline pte_t pte_swp_mkexclusive(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PAGE_SWP_EXCLUSIVE);
+}
+
+static inline pte_t pte_swp_clear_exclusive(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PAGE_SWP_EXCLUSIVE);
+}
+
+#define __HAVE_ARCH_PTEP_SET_ACCESS_FLAGS
+#define ptep_set_access_flags(__vma, __address, __ptep, __entry, __dirty) \
+({									  \
+	int __changed = !pte_same(*(__ptep), __entry);			  \
+	if (__changed) {						  \
+		set_pte(__ptep, __entry);				  \
+		flush_tlb_page(__vma, __address);			  \
+	}								  \
+	__changed;							  \
+})
+
+#endif /* !(__ASSEMBLER__) */
+
+/* Same bounds as the 2.6.17 kernel (asm-padre/pgtable.h) */
+#define VMALLOC_START           _AC(0xf8000000,UL)
+#define VMALLOC_END             _AC(0xfc000000,UL)
+#define MODULES_VADDR           VMALLOC_START
+#define MODULES_END             VMALLOC_END
+
+#define HAVE_ARCH_UNMAPPED_AREA
+
+#endif /* _SPARC_PGTABLE_32_PADRE_H */
