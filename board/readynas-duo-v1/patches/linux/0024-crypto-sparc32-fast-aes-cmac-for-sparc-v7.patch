 obj-$(CONFIG_CRYPTO_DES_SPARC64) += des-sparc64.o
 obj-$(CONFIG_CRYPTO_CAMELLIA_SPARC64) += camellia-sparc64.o
+obj-$(CONFIG_CRYPTO_CMAC_AES_SPARC32) += cmac-aes-sparc32.o
 
