+#include <linux/pipe_fs_i.h>
+#include <net/tcp.h>
 
 #include "smb_common.h"
 #include "server.h"
@@ -455,6 +457,84 @@ static bool ksmbd_tcp_page_cache(const struct kvec *v)
 	       offset_in_page(v->iov_base) + v->iov_len <= PAGE_SIZE;
