+/* the first len bytes of a pipe (zero-copy write data) into a buffer */
+void ksmbd_zc_pipe_copy(struct pipe_inode_info *pipe, char *dst, size_t len)
+{
+	unsigned int tail = pipe->tail;
+
+	while (len && !pipe_empty(pipe->head, tail)) {
+		struct pipe_buffer *buf = pipe_buf(pipe, tail++);
+		size_t n = min_t(size_t, buf->len, len);
+
+		memcpy_from_page(dst, buf->page, buf->offset, n);
+		dst += n;
+		len -= n;
+	}
+}
+
+/**
+ * ksmbd_vfs_splice_write() - zero-copy write: the data of the WRITE, in
+ * work->zc_pipe (socket buffers), goes into the file through
+ * ->splice_write, which copies it once into the page cache. Same checks as
+ * ksmbd_vfs_write().
+ *
+ * Return:	-EOPNOTSUPP: use ksmbd_vfs_write() (stream, no
+ *		iter_file_splice_write); otherwise as ksmbd_vfs_write()
+ */
+int ksmbd_vfs_splice_write(struct ksmbd_work *work, struct ksmbd_file *fp,
+			   size_t count, loff_t *pos, bool sync,
+			   ssize_t *written)
+{
+	struct file *filp = fp->filp;
+	loff_t offset = *pos;
+	ssize_t w;
+	int err;
+
+	if (ksmbd_stream_fd(fp) || filp->f_op->splice_write != iter_file_splice_write)
+		return -EOPNOTSUPP;
+
+	if (work->conn->connection_type) {
+		if (!(fp->daccess & (FILE_WRITE_DATA_LE | FILE_APPEND_DATA_LE)) ||
+		    S_ISDIR(file_inode(filp)->i_mode)) {
+			pr_err("no right to write(%pD)\n", filp);
+			return -EACCES;
+		}
+	}
+
+	if (!work->tcon->posix_extensions &&
+	    check_lock_range(filp, *pos, *pos + count - 1, WRITE)) {
+		pr_err("unable to write due to lock\n");
+		return -EAGAIN;
+	}
+
+	err = rw_verify_area(WRITE, filp, pos, count);
+	if (err)
+		return err;
+
+	/* Reserve lease break for parent dir at closing time */
+	fp->reserve_lease_break = true;
+
+	/* Do we need to break any of a levelII oplock? */
+	smb_break_all_levII_oplock(work, fp, 1);
+
+	file_start_write(filp);
+	w = iter_file_splice_write(work->zc_pipe, filp, pos, count, 0);
+	file_end_write(filp);
+	if (w < 0) {
+		ksmbd_debug(VFS, "smb write failed, err = %zd\n", w);
+		return w;
+	}
+	fsnotify_modify(filp);
+	filp->f_pos = *pos;
+	*written = w;
+
+	if (sync) {
+		err = vfs_fsync_range(filp, offset, offset + *written, 0);
+		if (err < 0)
+			pr_err("fsync failed for filename = %pD, err = %d\n",
+			       filp, err);
+	}
+	return err;
+}
