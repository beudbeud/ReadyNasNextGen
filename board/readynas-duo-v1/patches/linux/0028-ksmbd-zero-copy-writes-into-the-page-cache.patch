diff --git a/fs/smb/server/connection.c b/fs/smb/server/connection.c
index e8739b4..ddee470 100644
--- a/fs/smb/server/connection.c
+++ b/fs/smb/server/connection.c
@@ -6,6 +6,7 @@
 
 #include <linux/mutex.h>
 #include <linux/freezer.h>
+#include <linux/pipe_fs_i.h>
 #include <linux/module.h>
 
 #include "server.h"
@@ -15,6 +16,7 @@
 #include "connection.h"
 #include "transport_tcp.h"
 #include "transport_rdma.h"
+#include "vfs.h"
 
 static DEFINE_MUTEX(init_lock);
 
@@ -444,6 +446,75 @@ bool ksmbd_conn_alive(struct ksmbd_conn *conn)
 #define SMB2_TRANSFORM_MIN_SUPPORTED_PDU_SIZE	\
 	(sizeof(struct smb2_transform_hdr) + sizeof(struct smb2_hdr))
 
+/*
+ * SMB2 WRITEs of KSMBD_ZC_WRITE_MIN bytes or more, alone in their PDU and not
+ * signed: the receive loop reads their headers into request_buf and moves
+ * their data into a pipe whose buffers reference the socket buffers (no
+ * copy); smb2_write() splices it into the file, the only copy of the data.
+ * /sys/module/ksmbd/parameters/zerocopy_write
+ */
+static bool zerocopy_write = true;
+module_param(zerocopy_write, bool, 0644);
+#define KSMBD_ZC_WRITE_MIN	(64 * 1024)
+
+/* a plain WRITE whose data, right after its headers, ends the PDU */
+static bool ksmbd_zc_write_hdr(char *buf, unsigned int pdu_size)
+{
+	struct smb2_write_req *req = smb_get_msg(buf);
+
+	BUILD_BUG_ON(KSMBD_ZC_WRITE_HDR != offsetof(struct smb2_write_req, Buffer));
+
+	return req->hdr.ProtocolId == SMB2_PROTO_NUMBER &&
+	       req->hdr.StructureSize == SMB2_HEADER_STRUCTURE_SIZE &&
+	       req->hdr.Command == SMB2_WRITE && !req->hdr.NextCommand &&
+	       !(req->hdr.Flags & (SMB2_FLAGS_SIGNED | SMB2_FLAGS_RELATED_OPERATIONS)) &&
+	       req->StructureSize == cpu_to_le16(49) &&
+	       le16_to_cpu(req->DataOffset) == KSMBD_ZC_WRITE_HDR &&
+	       le32_to_cpu(req->Length) == pdu_size - KSMBD_ZC_WRITE_HDR &&
+	       req->Channel == SMB2_CHANNEL_NONE && !req->WriteChannelInfoLength;
+}
+
+/*
+ * The data of a zero-copy WRITE from the socket into a pipe, *got bytes.
+ * NULL: no pipe; a pipe with *got < len: it filled up (pieces smaller than
+ * 1 KiB on average); ERR_PTR: the stream is lost.
+ */
+static struct pipe_inode_info *ksmbd_zc_write_recv(struct ksmbd_transport *t,
+						   unsigned int len,
+						   unsigned int *got)
+{
+	struct pipe_inode_info *pipe = alloc_pipe_info();
+	ssize_t n;
+
+	*got = 0;
+	if (!pipe)
+		return NULL;
+	pipe->readers = 1;
+	/*
+	 * One slot per piece of socket buffer (a TCP segment, ~1.4 KiB).
+	 * one pipe per WRITE, its slot array allocated each time
+	 * (96 KiB for 4 MiB); the socket pages it holds are no longer charged
+	 * to the socket (at most len / 1 KiB pieces, then the copying path).
+	 * A pipe kept per connection if the allocation ever shows up.
+	 */
+	if (pipe_resize_ring(pipe, roundup_pow_of_two(len / 1024))) {
+		free_pipe_info(pipe);
+		return NULL;
+	}
+	pipe->max_usage = pipe->ring_size;	/* pipe_resize_ring() only lowers it */
+	while (*got < len) {
+		n = t->ops->splice_read(t, pipe, len - *got);
+		if (n <= 0) {
+			free_pipe_info(pipe);
+			return ERR_PTR(n ?: -EIO);
+		}
+		*got += n;
+		if (pipe_full(pipe->head, pipe->tail, pipe->max_usage))
+			break;
+	}
+	return pipe;
+}
+
 /**
  * ksmbd_conn_handler_loop() - session thread to listen on new smb requests
  * @p:		connection instance
@@ -460,6 +531,7 @@ int ksmbd_conn_handler_loop(void *p)
 	__le32 proto;
 	char hdr_buf[4] = {0,};
 	int size;
+	bool zc;
 
 	mutex_init(&conn->srv_mutex);
 	__module_get(THIS_MODULE);
@@ -476,6 +548,10 @@ int ksmbd_conn_handler_loop(void *p)
 
 		kvfree(conn->request_buf);
 		conn->request_buf = NULL;
+		if (conn->zc_pipe) {
+			free_pipe_info(conn->zc_pipe);
+			conn->zc_pipe = NULL;
+		}
 
 recheck:
 		if (atomic_read(&conn->req_running) + 1 > max_req) {
@@ -515,24 +591,71 @@ recheck:
 
 		/* 4 for rfc1002 length field */
 		/* 1 for implied bcc[0] */
-		size = pdu_size + 4 + 1;
+		/* zero-copy write candidate: its headers first */
+		zc = READ_ONCE(zerocopy_write) && t->ops->splice_read &&
+		     ksmbd_conn_good(conn) && pdu_size >= KSMBD_ZC_WRITE_MIN;
+		size = (zc ? KSMBD_ZC_WRITE_HDR : pdu_size) + 4 + 1;
 		conn->request_buf = kvmalloc(size, KSMBD_DEFAULT_GFP);
 		if (!conn->request_buf)
 			break;
 
-		conn->request_buf[pdu_size + 4] = 0;
+		conn->request_buf[size - 1] = 0;
 		memcpy(conn->request_buf, hdr_buf, sizeof(hdr_buf));
 
 		/*
 		 * We already read 4 bytes to find out PDU size, now
 		 * read in PDU
 		 */
-		size = t->ops->read(t, conn->request_buf + 4, pdu_size, 2);
+		size = t->ops->read(t, conn->request_buf + 4, size - 5, 2);
 		if (size < 0) {
 			pr_err("sock_read failed: %d\n", size);
 			break;
 		}
 
+		if (zc && size == KSMBD_ZC_WRITE_HDR) {
+			unsigned int len = pdu_size - KSMBD_ZC_WRITE_HDR, got = 0;
+			struct pipe_inode_info *pipe = NULL;
+			char *buf;
+
+			if (ksmbd_zc_write_hdr(conn->request_buf, pdu_size))
+				pipe = ksmbd_zc_write_recv(t, len, &got);
+			if (IS_ERR(pipe)) {
+				pr_err("sock_read failed: %ld\n", PTR_ERR(pipe));
+				break;
+			}
+			if (pipe && got == len) {
+				conn->zc_pipe = pipe;
+				size = pdu_size;
+				goto read_done;
+			}
+
+			/* not one (or the pipe filled up): the whole PDU in a
+			 * buffer, as usual
+			 */
+			buf = kvmalloc(pdu_size + 4 + 1, KSMBD_DEFAULT_GFP);
+			if (!buf) {
+				if (pipe)
+					free_pipe_info(pipe);
+				break;
+			}
+			memcpy(buf, conn->request_buf, 4 + KSMBD_ZC_WRITE_HDR);
+			buf[pdu_size + 4] = 0;
+			kvfree(conn->request_buf);
+			conn->request_buf = buf;
+			buf += 4 + KSMBD_ZC_WRITE_HDR;
+			if (pipe) {
+				ksmbd_zc_pipe_copy(pipe, buf, got);
+				free_pipe_info(pipe);
+			}
+			size = t->ops->read(t, buf + got, len - got, 2);
+			if (size < 0) {
+				pr_err("sock_read failed: %d\n", size);
+				break;
+			}
+			size += KSMBD_ZC_WRITE_HDR + got;
+		}
+read_done:
+
 		if (size != pdu_size) {
 			pr_err("PDU error. Read: %d, Expected: %d\n",
 			       size, pdu_size);
@@ -574,6 +697,10 @@ out:
 	unload_nls(conn->local_nls);
 	if (default_conn_ops.terminate_fn)
 		default_conn_ops.terminate_fn(conn);
+	if (conn->zc_pipe) {
+		free_pipe_info(conn->zc_pipe);
+		conn->zc_pipe = NULL;
+	}
 	t->ops->disconnect(t);
 	module_put(THIS_MODULE);
 	return 0;
