+static int ksmbd_tcp_splice_actor(read_descriptor_t *desc, struct sk_buff *skb,
+				  unsigned int offset, size_t len)
+{
+	int ret = skb_splice_bits(skb, skb->sk, offset, desc->arg.data,
+				  min(desc->count, len), 0);
+
+	if (ret > 0)
+		desc->count -= ret;
+	return ret;
+}
+
+/**
+ * ksmbd_tcp_splice_read() - move up to @len bytes of the stream into @pipe:
+ * its buffers reference the socket buffers, nothing is copied. Waits for the
+ * data like ksmbd_tcp_read() (receive timeout, 2 retries); returns once
+ * @len bytes are in or the pipe is full.
+ * tcp_splice_read() cannot be used: it needs sock->file, which ksmbd
+ * sockets do not have. Same loop, on tcp_read_sock().
+ *
+ * Return:	bytes moved (> 0), otherwise error (0 never)
+ */
+static ssize_t ksmbd_tcp_splice_read(struct ksmbd_transport *t,
+				     struct pipe_inode_info *pipe, size_t len)
+{
+	struct sock *sk = TCP_TRANS(t)->sock->sk;
+	long timeo = READ_ONCE(sk->sk_rcvtimeo);
+	int retries = 2;
+	ssize_t got = 0;
+	int ret = 0;
+
+	lock_sock(sk);
+	while (got < len && !pipe_full(pipe->head, pipe->tail, pipe->max_usage)) {
+		read_descriptor_t desc = { .arg.data = pipe, .count = len - got };
+
+		if (!ksmbd_conn_alive(t->conn)) {
+			ret = -ESHUTDOWN;
+			break;
+		}
+		ret = tcp_read_sock(sk, &desc, ksmbd_tcp_splice_actor);
+		if (ret > 0) {
+			got += ret;
+			/* let the backlog in */
+			release_sock(sk);
+			lock_sock(sk);
+			continue;
+		}
+		if (ret < 0 && ret != -EAGAIN)
+			break;
+		if (sk->sk_err) {
+			ret = sock_error(sk);
+			break;
+		}
+		if (sock_flag(sk, SOCK_DONE) || (sk->sk_shutdown & RCV_SHUTDOWN) ||
+		    sk->sk_state == TCP_CLOSE) {
+			ret = -ECONNRESET;
+			break;
+		}
+		if (!skb_queue_empty(&sk->sk_receive_queue)) {
+			ret = -EIO;	/* data tcp_read_sock() does not take (urgent) */
+			break;
+		}
+		if (!timeo) {
+			if (retries-- <= 0) {
+				ret = -EAGAIN;
+				break;
+			}
+			timeo = READ_ONCE(sk->sk_rcvtimeo);
+		}
+		sk_wait_data(sk, &timeo, NULL);
+		if (signal_pending(current)) {
+			ret = -ESHUTDOWN;
+			break;
+		}
+	}
+	release_sock(sk);
+	return got ?: (ret ?: -EIO);
+}
+
 static int ksmbd_tcp_writev(struct ksmbd_transport *t, struct kvec *iov,
 			    int nvecs, int size, bool need_invalidate,
 			    unsigned int remote_key)
@@ -767,4 +847,5 @@ static const struct ksmbd_transport_ops ksmbd_tcp_transport_ops = {
