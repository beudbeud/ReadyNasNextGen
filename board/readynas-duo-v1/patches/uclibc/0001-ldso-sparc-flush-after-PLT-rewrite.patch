ldso/sparc: FLUSH after rewriting PLT instructions

SPARC V8 requires FLUSH after a write to code. On the Infrant Padre
(write-back D-cache, non-coherent I-cache), ld.so otherwise executed the
unpatched PLT entry -> _dl_linux_resolver with tpnt = %g1 -> segfault.

--- a/ldso/ldso/sparc/dl-startup.h
+++ b/ldso/ldso/sparc/dl-startup.h
@@ -67,6 +67,8 @@
 	case R_SPARC_JMP_SLOT: \
 		REL[1] = 0x03000000 | ((SYMBOL >> 10) & 0x3fffff); \
 		REL[2] = 0x81c06000 | (SYMBOL & 0x3ff); \
+		SPARC_IFLUSH(&REL[1]); \
+		SPARC_IFLUSH(&REL[2]); \
 		break; \
 	case R_SPARC_NONE: \
 	case R_SPARC_WDISP30: \
--- a/ldso/ldso/sparc/dl-sysdep.h
+++ b/ldso/ldso/sparc/dl-sysdep.h
@@ -17,12 +17,22 @@
  *		nop
  *		.word implementation_dependent
  */
+/* SPARC V8: FLUSH is required on every rewritten instruction doubleword
+ * (PLT, text relocations), otherwise the instruction cache may execute
+ * the old code (write-back D-cache not snooped by the I-cache, e.g. the
+ * Infrant Padre: unpatched PLT executed -> segfault in
+ * _dl_linux_resolver). Like sparc_fixup_plt in glibc. */
+#define SPARC_IFLUSH(ADDR) __asm__ __volatile__("flush %0" : : "r" (ADDR) : "memory")
+
 #define INIT_GOT(GOT_BASE,MODULE) \
 {				\
    GOT_BASE[0] = 0x9de3bfc0;  /* save %sp, -64, %sp */	\
    GOT_BASE[1] = 0x40000000 | (((unsigned int) _dl_linux_resolve - (unsigned int) GOT_BASE - 4) >> 2);	\
    GOT_BASE[2] = 0x01000000; /* nop */ 			\
    GOT_BASE[3] = (int) MODULE;					\
+   SPARC_IFLUSH(&GOT_BASE[0]);					\
+   SPARC_IFLUSH(&GOT_BASE[1]);					\
+   SPARC_IFLUSH(&GOT_BASE[2]);					\
 }
 
