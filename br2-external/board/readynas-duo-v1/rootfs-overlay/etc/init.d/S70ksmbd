#!/bin/sh
# Démarre ksmbd (serveur SMB du noyau) avec ksmbd-tools.
case "$1" in
start)
	mkdir -p /c /var/run
	printf "Démarrage de ksmbd : "
	ksmbd.mountd && echo OK || echo ÉCHEC
	;;
stop)
	ksmbd.control -s
	;;
restart)
	"$0" stop; "$0" start
	;;
*)
	echo "Usage : $0 {start|stop|restart}"; exit 1
	;;
esac
