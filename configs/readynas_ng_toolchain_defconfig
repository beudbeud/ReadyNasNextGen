# Toolchain only (for "make toolchain-sdk"): same options as
# readynas_ng_defconfig, without packages nor kernel. Result: relocatable
# SDK archive published in the GitHub releases and used by
# readynas_ng_rapide_defconfig.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_READYNAS_NG_PATH)/board/readynas-duo-v1/patches"
BR2_sparc=y
BR2_sparc_v7=y
BR2_DL_DIR="$(BR2_EXTERNAL_READYNAS_NG_PATH)/dl"
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"
# No per-package directories here: when merging host/ at the end, Buildroot
# kept the limits.h of host-gcc-initial instead of the host-gcc-final one
# (NAME_MAX, LONG_BIT missing in the SDK). Sequential install = safe.
# BR2_PER_PACKAGE_DIRECTORIES is not set

BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PTHREADS_NATIVE=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
# headers of the same version as the system kernel
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="6.18.63"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_SHARED_LIBS=y
BR2_OPTIMIZE_S=y

# nothing but the toolchain
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
