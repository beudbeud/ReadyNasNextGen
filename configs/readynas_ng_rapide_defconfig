# NETGEAR ReadyNAS Duo v1 (Infrant IT3107 "Padre", SPARC v8 without FPU,
# broken sdiv): ported Linux 6.18 kernel, in-kernel ksmbd and NFS.
# "rapide" (fast) variant: same system, downloaded prebuilt toolchain.
#   make rapide     (top Makefile, output in output-rapide/)

BR2_sparc=y
BR2_sparc_v7=y
BR2_DL_DIR="$(BR2_EXTERNAL_READYNAS_NG_PATH)/dl"
# Per-package patches: linux/ (Padre platform, 16 KiB pages), uclibc/,
# binutils/ (16 KiB default page size), lvm2/
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_READYNAS_NG_PATH)/board/readynas-duo-v1/patches"
# Compiler cache outside output/ (survives "make clean") and per-package
# directories (parallel build at the Buildroot level, make -jN)
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"
BR2_PER_PACKAGE_DIRECTORIES=y

# PREBUILT toolchain (GitHub release toolchain-v7-2026.08.1-r3, fixed ld.so;
# hash: board/readynas-duo-v1/patches/toolchain-external-custom/), built by
# "make toolchain-sdk" with readynas_ng_toolchain_defconfig: uClibc-ng,
# gcc 15, 6.18 headers, WCHAR, NPTL, no C++.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/beudbeud/ReadyNasNextGen/releases/download/toolchain-v7-2026.08.1-r3/sparc-v7-readynas-linux-uclibc_sdk-buildroot-2026.08.1.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="$(ARCH)-buildroot-linux-uclibc"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_18=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS=y
# BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG is not set
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_NPTL=y
# BR2_TOOLCHAIN_EXTERNAL_HAS_SSP is not set
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
# BR2_TOOLCHAIN_EXTERNAL_CXX is not set
BR2_SHARED_LIBS=y
BR2_OPTIMIZE_S=y

BR2_TARGET_GENERIC_HOSTNAME="readynas"
BR2_TARGET_GENERIC_ISSUE="ReadyNAS Duo v1 - Linux 6.18 (ReadyNasNextGen)"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_9600=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_READYNAS_NG_PATH)/board/readynas-duo-v1/rootfs-overlay"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.63"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_READYNAS_NG_PATH)/board/readynas-duo-v1/linux-padre.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_READYNAS_NG_PATH)/board/readynas-duo-v1/linux-padre-nas.fragment"
BR2_LINUX_KERNEL_VMLINUX=y

# Minimal initramfs built into the kernel (static busybox without floating point + tests)
BR2_PACKAGE_READYNAS_INITRAMFS=y
# port tests at the console (package/readynas-tests)
BR2_PACKAGE_READYNAS_TESTS=y

# File services
BR2_PACKAGE_KSMBD_TOOLS=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_NFS_UTILS_NFSV4=y
# Disks: md RAID1, ext4 (the kernel also mounts the X-RAID ext3 with
# 16 KiB blocks: 16 KiB pages)
BR2_PACKAGE_MDADM=y
BR2_PACKAGE_E2FSPROGS=y
# Existing X-RAID read/write (dm-linear + md without superblock, LVM,
# kernel ext4), switch to md: package/xraid-compat, docs/XRAID.md
# (selects lvm2, rsync, resize2fs)
BR2_PACKAGE_XRAID_COMPAT=y
BR2_PACKAGE_DROPBEAR=y
# DIET web dashboard (package/diet, docs/DIET.md): lighttpd over HTTPS
# with mbedTLS (gen_key/cert_write for the first-boot certificate)
BR2_PACKAGE_DIET=y
# SMART for DIET (smartmontools needs C++): package/smart-lite
BR2_PACKAGE_SMART_LITE=y
BR2_PACKAGE_LIGHTTPD=y
BR2_PACKAGE_LIGHTTPD_MBEDTLS=y
BR2_PACKAGE_LIGHTTPD_PCRE=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_MBEDTLS_PROGRAMS=y
# HTTPS client that checks certificates (Telegram, system updates)
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Root: rootfs.tar to extract into /rootfs-6.18 on an ext3/ext4 USB key;
# the kernel initramfs looks for that folder and switches to it (see README.md).
BR2_TARGET_ROOTFS_TAR=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_READYNAS_NG_PATH)/board/readynas-duo-v1/post-image.sh"
# DLNA/UPnP-AV server (ReadyMedia, formerly MiniDLNA by Netgear): shares /c/media
BR2_PACKAGE_MINIDLNA=y
# ffmpeg cut down to what minidlnad needs (libavformat, libavcodec, libavutil:
# metadata reading, no transcoding): no programs, encoders, filters, scaling,
# devices nor network; decoders limited to common formats.
# BR2_PACKAGE_FFMPEG_FFMPEG is not set
# BR2_PACKAGE_FFMPEG_SWSCALE is not set
BR2_PACKAGE_FFMPEG_ENCODERS=""
BR2_PACKAGE_FFMPEG_DECODERS="h264 hevc mpeg1video mpeg2video mpeg4 msmpeg4v3 vc1 wmv3 vp8 vp9 av1 mjpeg aac ac3 eac3 dca mp2 mp3 flac vorbis opus wmav2 alac pcm_s16le pcm_s16be pcm_s24le"
BR2_PACKAGE_FFMPEG_MUXERS=""
BR2_PACKAGE_FFMPEG_PROTOCOLS="file"
BR2_PACKAGE_FFMPEG_FILTERS=""
BR2_PACKAGE_FFMPEG_BSFS=""
# BR2_PACKAGE_FFMPEG_INDEVS is not set
# BR2_PACKAGE_FFMPEG_OUTDEVS is not set
BR2_PACKAGE_FFMPEG_EXTRACONF="--disable-avdevice --disable-avfilter --disable-network --disable-swresample"
# Local network announcement (mDNS/DNS-SD, "Bonjour"): <name>.local and services
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# rsync backup daemon (/etc/rsyncd.conf, S61rsyncd)
BR2_PACKAGE_RSYNC=y
# WebDAV through lighttpd (/webdav, see package/diet/src/etc/lighttpd/lighttpd.conf)
BR2_PACKAGE_LIGHTTPD_WEBDAV=y
# full hdparm (disk standby set by DIET)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_HDPARM=y
