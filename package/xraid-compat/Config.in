config BR2_PACKAGE_XRAID_COMPAT
	bool "xraid-compat (X-RAID du ReadyNAS en lecture/écriture, bascule md)"
	depends on BR2_USE_MMU # lvm2, rsync
	depends on BR2_TOOLCHAIN_HAS_THREADS # lvm2
	depends on !BR2_STATIC_LIBS # lvm2 standard install
	select BR2_PACKAGE_LVM2
	select BR2_PACKAGE_LVM2_STANDARD_INSTALL
	select BR2_PACKAGE_MDADM
	select BR2_PACKAGE_E2FSPROGS
	select BR2_PACKAGE_E2FSPROGS_FUSE2FS
	select BR2_PACKAGE_E2FSPROGS_RESIZE2FS
	select BR2_PACKAGE_RSYNC
	help
	  Couche de compatibilité X-RAID (ReadyNAS Duo v1, RAIDiator
	  4.x) pour Linux 6.18 : xraid-info (analyse en lecture seule
	  du superbloc « WGao », vérification du miroir, SMART),
	  nas-raid (assemblage dm-linear + md sans superbloc, LVM,
	  /c par fuse2fs ; migration vers md) et S35stockage.
	  Noyau : CONFIG_BLK_DEV_DM, CONFIG_MD_RAID1, CONFIG_FUSE_FS.
	  Voir docs/XRAID.md.

comment "xraid-compat needs a toolchain w/ threads, dynamic library"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
