#!/bin/sh
# Volume de données /c : X-RAID existant (compatibilité, rw ou ro selon les
# garde-fous) ou RAID md. Avant S60nfs et S70ksmbd. Voir docs/XRAID.md.
case "$1" in
start)
	printf "Stockage /c : "
	/usr/sbin/nas-raid monter 2>&1 | logger -t nas-raid
	read -r m r 2>/dev/null < /var/run/nas-raid.mode
	echo "${m:-?}${r:+ ($r)}"
	;;
stop)
	/usr/sbin/nas-raid demonter >/dev/null 2>&1
	;;
restart)
	"$0" stop; "$0" start
	;;
*)
	echo "Usage : $0 {start|stop|restart}"; exit 1
	;;
esac
