#!/bin/sh
# Data volume /c: existing X-RAID (compatibility, rw or ro depending on the
# safeguards) or RAIDiator md volumes (X-RAID off,
# "Flex-RAID", read-only). Before S60nfs and S70ksmbd. See
# docs/XRAID.md. While running, "nas-raid watch" every 30 s: a leg that fails
# under a read-write X-RAID is recorded in the superblock and /c goes read-only.
PID=/var/run/nas-raid.watch.pid
case "$1" in
start)
	printf "Mounting storage /c: "
	/usr/sbin/nas-raid mount 2>&1 | logger -t nas-raid
	read -r m r 2>/dev/null < /var/run/nas-raid.mode
	echo "${m:-?}${r:+ ($r)}"
	( while sleep 30; do /usr/sbin/nas-raid watch 2>&1 | logger -t nas-raid; done ) </dev/null >/dev/null 2>&1 &
	echo $! > "$PID"
	;;
stop)
	[ -r "$PID" ] && kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"
	# rw X-RAID: superblock back to "clean" only if both legs stayed healthy
	/usr/sbin/nas-raid unmount 2>&1 | logger -t nas-raid
	;;
restart)
	"$0" stop; "$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"; exit 1
	;;
esac
