#!/bin/sh
# nas-raid: ReadyNAS Duo v1 storage under Linux 6.18 (docs/XRAID.md).
#
# Reads and writes an existing X-RAID WITHOUT converting it (compatibility),
# then, on request, switches to md (Linux software RAID 1).
#
#   nas-raid status [--json] [--refresh]   mode, sections, consistency, migration
#   nas-raid mount | unmount               at boot / at shutdown (S35storage)
#   nas-raid remount                       X-RAID only: unmount then mount (after a
#                                          change of XRAID_RW); refused if /c is busy
#   nas-raid verify                        compares the two X-RAID disks (long)
#   nas-raid repair                        copies the base onto the mirror (md repair)
#   nas-raid migrate [--finalize]          X-RAID -> md in place (2 disks)
#   nas-raid create DISK [DISK2]           new md RAID 1 (ERASES the disks)
#   nas-raid add DISK                      adds a disk to the md (replacement)
#   nas-raid grow                          md, LVM and ext4 to the size of the disks
# Options: --dry-run (prints the commands without doing anything),
#          --confirm PHRASE and --yes (double confirmation of the actions that
#          write to the disks), --no-smart (migration without readable SMART).
#
# X-RAID compatibility: never an md superblock, never a write to the protected
# zone (end of disk, beyond V) nor to the X-RAID superblock. Each section
# becomes two dm-linear (base, mirror) assembled by "mdadm --build" (RAID 1
# without metadata); the partitions of the base disk are mapped by dm-linear
# onto these md; LVM (VG c) then /c through fuse2fs (ext3 with 16 KiB blocks).
#
# Tests on a PC: NAS_RAID_ROOT prefixes /proc, /var, /etc and puts
# $NAS_RAID_ROOT/bin first in PATH; NAS_RAID_DISKS replaces the list of
# SATA disks (disk images).
set -u
R=${NAS_RAID_ROOT:-}
export PATH=${R:+$R/bin:}/bin:/sbin:/usr/bin:/usr/sbin
STATE=$R/var/lib/nas-raid		# persistent (USB key): marks, migration
RUN=$R/var/run
LOG=$STATE/log
DATA=/c
MD_MOUNT=/mnt/md			# md mounted here during the migration
# on-disk names of the md volume, kept as created by earlier versions
MD=/dev/md/donnees
VG_MD=donnees
LV_MD=c
XRAID_VG=c				# LVM group created by RAIDiator, LV "c"
XRAID_LV=c
FUSE2FS_OPTS=allow_other
XRAID_RW=no				# "yes": X-RAID writable if all safeguards pass
SAMPLES=256				# 64 KiB blocks compared per section at mount time
VERIFY_MAX_DAYS=7			# maximum age of a verification before migrating
VERIFY_RSYNC=-c				# copy check by checksums (empty = size+date)
[ -r "$R/etc/nas-raid.conf" ] && . "$R/etc/nas-raid.conf"

LVM_XR="devices { filter = [ \"a|^/dev/mapper/xr-p|\", \"r|.*|\" ] use_devicesfile = 0 } global { metadata_read_only = 1 }"
LVM_XR_RO="$LVM_XR activation { read_only_volume_list = [ \"$XRAID_VG\" ] }"
LVM_MD="devices { filter = [ \"a|^/dev/md|\", \"r|.*|\" ] use_devicesfile = 0 }"

DRY_RUN=; JSON=; CONFIRM=; YES=; NO_SMART=; FINALIZE=; REFRESH=
CMD=${1:-help}; [ $# -gt 0 ] && shift
ARGS=
while [ $# -gt 0 ]; do
	case "$1" in
	--dry-run) DRY_RUN=1 ;;
	--json) JSON=1 ;;
	--yes) YES=1 ;;
	--no-smart) NO_SMART=1 ;;
	--finalize) FINALIZE=1 ;;
	--refresh) REFRESH=1 ;;
	--confirm) [ $# -ge 2 ] || { echo "--confirm: missing phrase" >&2; exit 2; }; CONFIRM=$2; shift ;;
	-*) echo "unknown option: $1" >&2; exit 2 ;;
	*) case "$1" in *[!A-Za-z0-9/._-]*) echo "disk name refused: $1" >&2; exit 2;; esac
	   ARGS="$ARGS $1" ;;
	esac
	shift
done

log() {
	echo "$*" >&2
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$STATE" && echo "[$(date '+%F %T')] $*" >> "$LOG"
}
die() { log "ERROR: $*"; exit 1; }
# x command...: printed (+ ...), run unless dry run, written to the log
x() {
	l="+"; for a in "$@"; do case "$a" in *[!A-Za-z0-9/._=,:+-]*|'') l="$l '$a'";; *) l="$l $a";; esac; done
	echo "$l"
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$STATE" && echo "[$(date '+%F %T')] $l" >> "$LOG"
	"$@"
}
# x_: like x, without stopping on failure (teardown)
x_() { x "$@" || log "(failure ignored: $*)"; }
write() { [ -n "$DRY_RUN" ] || { mkdir -p "${1%/*}" && printf '%s\n' "$2" > "$1"; }; }

# State files written by the earlier French version: renamed once, so that
# a dirty mark or a migration in progress is never forgotten.
legacy_state() {
	[ -n "$DRY_RUN" ] && return 0
	[ -d "$STATE" ] || return 0
	for p in journal:log xraid-sale:xraid-dirty xraid-verifie:xraid-verified \
		 verif.res:verify.res verif.prog:verify.progress ecarts:diffs; do
		[ -e "$STATE/${p%%:*}" ] && [ ! -e "$STATE/${p#*:}" ] && mv "$STATE/${p%%:*}" "$STATE/${p#*:}"
	done
	if [ -e "$STATE/verif.etat" ]; then
		sed 's/^en_cours /running /; s/^erreurs /errors /' "$STATE/verif.etat" > "$STATE/verify.state" && rm -f "$STATE/verif.etat"
	fi
	if [ -e "$STATE/migration.fin" ]; then echo done > "$STATE/migration.done" && rm -f "$STATE/migration.fin"; fi
	if grep -q '^etape=' "$STATE/migration" 2>/dev/null; then
		sed -i 's/^etape=casser$/step=break/; s/^etape=copier$/step=copy/; s/^etape=verifier$/step=verify/; s/^etape=copie_verifiee$/step=copy_verified/' "$STATE/migration"
	fi
	return 0
}

# SATA disks of the NAS (libata: /sys/block/sdX/device -> .../ataN/...), not the USB key
disks() {
	if [ -n "${NAS_RAID_DISKS:-}" ]; then echo $NAS_RAID_DISKS; return; fi
	for b in "$R"/sys/block/sd*; do
		[ -d "$b" ] || continue
		case "$(readlink -f "$b/device")" in */ata[0-9]*) echo "/dev/${b##*/}";; esac
	done
}
mounted() { awk -v m="$1" '$2 == m { f = 1 } END { exit !f }' "$R/proc/mounts" 2>/dev/null; }
# the disk must be one of the SATA disks (never the system USB key)
sata_disk() { for d in $(disks); do [ "$d" = "$1" ] && return 0; done; die "$1 is not a SATA disk of the NAS"; }
sectors() {	# sectors of a disk (XR_Dn from xraid-info, otherwise /sys)
	i=0
	while [ $i -lt "${XR_NR_DISKS_READ:-0}" ]; do
		eval "set -- \$XR_D$i"; [ "$1" = "$D" ] && { echo "$2"; return; }; i=$((i + 1))
	done
	cat "$R/sys/block/${D##*/}/size" 2>/dev/null || echo 0
}

# X-RAID analysis (XR_* variables); $SMP = number of samples
analyse() {
	XR_MODE=none; XR_REASONS=; XR_MD=; XR_BASE=; XR_MIRROR=; XR_READ_DISK=
	XR_NR_SECTIONS=0; XR_NR_PARTS=0; XR_NR_DISKS_READ=0; XR_ID=; XR_CTIME=0
	set -- $(disks)
	[ $# -gt 0 ] || return 0
	output=$(xraid-info --samples "${SMP:-0}" "$@") || die "xraid-info failed"
	eval "$output"
}

# Persistent marks: xraid-dirty = assembled rw (removed on clean shutdown,
# stays after a power loss); xraid-verified = "ID CTIME" of a successful full
# verification (then accepts a RAIDiator superblock marked unclean).
DIRTY=$STATE/xraid-dirty
VERIFIED=$STATE/xraid-verified

# decides rw/ro, adding our own safeguards to those of xraid-info
decide() {
	MODE=$XR_MODE; WHY=$XR_REASONS
	[ "$MODE" = rw ] || [ "$MODE" = ro ] || { MODE=none; return; }
	if [ "$MODE" = ro ] && [ "$XR_REASONS" = unclean_shutdown ] && [ "$(cat "$VERIFIED" 2>/dev/null)" = "$XR_ID $XR_CTIME" ]; then
		MODE=rw; WHY="unclean_shutdown_verified"
	fi
	if [ "$MODE" = rw ] && [ -e "$DIRTY" ]; then
		MODE=ro; WHY="${WHY:+$WHY }unclean_shutdown_linux"
	fi
	if [ "$MODE" = rw ] && [ -e "$STATE/migration" ]; then
		MODE=ro; WHY="${WHY:+$WHY }migration_in_progress"
	fi
}

# ---------- X-RAID assembly ----------
assemble_xraid() {	# $1 = rw | ro
	m=$1; i=0
	[ -n "$DRY_RUN" ] || mkdir -p "$MOUNTPOINT"
	if [ $m = rw ]; then
		write "$DIRTY" "$(date +%s)"; [ -n "$DRY_RUN" ] || sync
		while [ $i -lt "$XR_NR_SECTIONS" ]; do
			eval "set -- \$XR_S$i"
			x dmsetup create "xr-a-s$i" --table "0 $2 linear $XR_BASE $1" || return 1
			x dmsetup create "xr-b-s$i" --table "0 $2 linear $XR_MIRROR $1" || return 1
			# base first: source of a "repair"
			x mdadm --build "/dev/md1$i" --level=1 --raid-devices=2 --assume-clean \
				"/dev/mapper/xr-a-s$i" "/dev/mapper/xr-b-s$i" || return 1
			i=$((i + 1))
		done
	fi
	i=0
	while [ $i -lt "$XR_NR_PARTS" ]; do
		eval "set -- \$XR_P$i"	# num start size type section offset
		if [ $m = rw ]; then
			[ "$5" -ge 0 ] && x dmsetup create "xr-p$1" --table "0 $3 linear /dev/md1$5 $6"
		else
			x dmsetup create "xr-p$1" --readonly --table "0 $3 linear $XR_READ_DISK $2"
		fi || return 1
		i=$((i + 1))
	done
	if [ $m = rw ]; then
		x lvm vgchange -ay --config "$LVM_XR" "$XRAID_VG" || return 1
		x fuse2fs -o "$FUSE2FS_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" || return 1
	else
		x lvm vgchange -ay --config "$LVM_XR_RO" "$XRAID_VG" || return 1
		x fuse2fs -o "ro,$FUSE2FS_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" || return 1
	fi
}

disassemble_xraid() {
	mounted "$DATA" && x_ umount "$DATA"
	x_ lvm vgchange -an --config "$LVM_XR" "$XRAID_VG"
	i=0
	while [ $i -lt "$XR_NR_PARTS" ]; do
		eval "set -- \$XR_P$i"; x_ dmsetup remove "xr-p$1"; i=$((i + 1))
	done
	# a degraded X-RAID md ([U_]): the disks diverge, keep the "dirty" mark
	degraded=$(awk '/^md1[0-6] :/ { n = $1 } n && /\[[U_]*_[U_]*\]/ { print n; n = "" }' "$R/proc/mdstat" 2>/dev/null)
	i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		if [ "$CURRENT_MODE" = xraid-rw ]; then
			x_ mdadm --stop "/dev/md1$i"
			x_ dmsetup remove "xr-a-s$i"; x_ dmsetup remove "xr-b-s$i"
		fi
		i=$((i + 1))
	done
	if [ "$CURRENT_MODE" = xraid-rw ]; then
		if [ -n "$degraded" ]; then log "X-RAID md degraded ($degraded): the disks diverge, rw refused at next boot"
		elif [ -z "$DRY_RUN" ]; then rm -f "$DIRTY"; fi
	fi
}

mount_md() {	# $1 = mount point
	x mdadm --assemble --scan || [ -e "$MD" ] || return 1
	x lvm vgchange -ay --config "$LVM_MD" "$VG_MD" || return 1
	x mkdir -p "$1"
	x mount -t ext4 "/dev/mapper/$VG_MD-$LV_MD" "$1"
}

current_mode() { read -r CURRENT_MODE _ 2>/dev/null < "$RUN/nas-raid.mode" || CURRENT_MODE=none; }
step() { cat "$STATE/migration" 2>/dev/null | sed -n 's/^step=//p'; }

do_mount() {
	SMP=$SAMPLES; analyse
	write "$RUN/xraid.json" "$(xraid-info --json $(disks) 2>/dev/null || echo null)"
	if [ "${XR_MD:-}" = 1 ]; then
		if [ -e "$STATE/migration" ]; then
			log "migration in progress (step $(step)): md on $MD_MOUNT, X-RAID read-only on $DATA"
			mount_md "$MD_MOUNT" || log "md: cannot mount"
		else
			if mount_md "$DATA"; then write "$RUN/nas-raid.mode" "md"; else write "$RUN/nas-raid.mode" "none md_failed"; fi
			return 0
		fi
	fi
	decide
	if [ "$MODE" = rw ] && [ "$XRAID_RW" != yes ]; then
		MODE=ro; WHY="${WHY:+$WHY }rw_disabled"
	fi
	MOUNTPOINT=$DATA
	case "$MODE" in
	rw|ro)
		log "X-RAID: mounting $MODE${WHY:+ ($WHY)}"
		if assemble_xraid "$MODE"; then write "$RUN/nas-raid.mode" "xraid-$MODE $WHY"
		else
			log "X-RAID: $MODE assembly failed, everything undone"
			CURRENT_MODE=xraid-$MODE; disassemble_xraid
			write "$RUN/nas-raid.mode" "none assembly_failed $WHY"
		fi ;;
	*)	log "no usable X-RAID volume${WHY:+ ($WHY)}"
		write "$RUN/nas-raid.mode" "none $WHY" ;;
	esac
}

do_unmount() {
	current_mode
	case "$CURRENT_MODE" in
	md) mounted "$DATA" && x_ umount "$DATA"; x_ lvm vgchange -an --config "$LVM_MD" "$VG_MD" ;;
	xraid-*) analyse; disassemble_xraid ;;
	esac
	mounted "$MD_MOUNT" && x_ umount "$MD_MOUNT"
	write "$RUN/nas-raid.mode" "none stopped"
}

# X-RAID remount (DIET: "allow writing" switch). /c is unmounted first, on its
# own: if a file is still open there (umount refused), nothing is torn down and
# the volume stays mounted as it was. Then the usual mount, with all safeguards.
do_remount() {
	current_mode
	case "$CURRENT_MODE" in xraid-*) ;; *) die "remount: only for an X-RAID volume (mode $CURRENT_MODE)";; esac
	[ -e "$STATE/migration" ] && die "remount: migration in progress"
	if mounted "$DATA"; then x umount "$DATA" || die "$DATA is busy (open files): not remounted"; fi
	do_unmount
	do_mount
}

# ---------- full mirror verification (read-only) ----------
verify() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed ($XR_REASONS)"
	if [ -n "$DRY_RUN" ]; then x xraid-info verify "$XR_BASE" "$XR_MIRROR"; return 0; fi
	mkdir -p "$STATE"
	echo "running $(date +%s)" > "$STATE/verify.state"
	log "mirror verification: $XR_BASE / $XR_MIRROR"
	xraid-info verify "$XR_BASE" "$XR_MIRROR" > "$STATE/verify.res" 2> "$STATE/verify.progress"
	rc=$?
	case $rc in 0) r=ok;; 1) r=differences;; *) r=errors;; esac
	echo "$r $(date +%s)" > "$STATE/verify.state"
	log "verification: $r ($(grep -c '^# difference' "$STATE/verify.res") differing zones)"
	current_mode
	if [ $r = ok ] && [ "$CURRENT_MODE" != xraid-rw ]; then
		# consistent mirror, nothing assembled for writing: the mark can go
		rm -f "$DIRTY"; echo "$XR_ID $XR_CTIME" > "$VERIFIED"
		log "consistent mirror: writing allowed at next mount"
	fi
	return $rc
}

# ---------- confirmations, SMART ----------
confirm() {	# $1 = expected phrase, $2 = what is going to happen
	[ -n "$DRY_RUN" ] && { echo "(dry run: confirmation \"$1\" not asked)"; return 0; }
	if [ "$CONFIRM" != "$1" ] || [ -z "$YES" ]; then
		echo "$2" >&2
		die "confirmation required: --confirm '$1' --yes"
	fi
}

smart_ok() {	# $1 = disk; refuses: health FAILED, pending sectors, uncorrectable
	d=${1##*/}
	if [ -r "$RUN/smart.$d" ]; then s=$(cat "$RUN/smart.$d"); else s=$(xraid-info smart "$1" 2>/dev/null); fi
	health=; realloc=0; pending=0; uncorr=0
	case "$s" in health=*) eval "$s" ;; *)
		[ -n "$NO_SMART" ] && { log "$1: SMART unreadable (--no-smart)"; return 0; }
		[ -n "$DRY_RUN" ] && { log "$1: SMART unreadable (refused outside a dry run; --no-smart to override)"; return 0; }
		die "$1: SMART unreadable; --no-smart to override (not recommended)" ;;
	esac
	[ "$health" = FAILED ] && die "$1: SMART failed"
	[ "${pending:-0}" -gt 0 ] && die "$1: $pending sectors pending reallocation"
	[ "${uncorr:-0}" -gt 0 ] && die "$1: $uncorr uncorrectable sectors"
	[ "${realloc:-0}" -gt 0 ] && log "warning: $1 has $realloc reallocated sectors"
	log "$1: SMART ${health:-?}, $pending pending, $uncorr uncorrectable"
}

services() {	# stop|start the shares around a change of /c
	if [ "$1" = stop ]; then l="S70ksmbd S60nfs"; else l="S60nfs S70ksmbd"; fi
	for s in $l; do [ -x "$R/etc/init.d/$s" ] && x_ "$R/etc/init.d/$s" "$1"; done
	return 0
}

# erases the start of a disk (MBR, md/LVM superblocks) and the X-RAID end zone
wipe() {	# $1 = disk, $2 = sectors
	x dd if=/dev/zero of="$1" bs=1048576 count=1 conv=notrunc
	x dd if=/dev/zero of="$1" bs=512 seek=$(($2 - 4096)) count=4096 conv=notrunc
	[ -b "$1" ] && x_ partprobe "$1"	# forget the old partitions
	return 0
}

create_md() {	# disks... (only one: degraded md, the second will be added)
	n=$#; [ $n -eq 1 ] && set -- "$@" missing
	x mdadm --create "$MD" --run --metadata=1.2 --level=1 --raid-devices=2 \
		--bitmap=internal --name=donnees "$@" || return 1
	x sh -c "mdadm --detail --brief $MD > $R/etc/mdadm.conf"
	x lvm pvcreate --config "$LVM_MD" "$MD" || return 1
	x lvm vgcreate --config "$LVM_MD" "$VG_MD" "$MD" || return 1
	x lvm lvcreate --config "$LVM_MD" -l 100%FREE -n "$LV_MD" "$VG_MD" || return 1
	x mkfs.ext4 -b 4096 -L donnees "/dev/mapper/$VG_MD-$LV_MD"
}

# ---------- X-RAID -> md migration in place ----------
migrate() {
	E=$(step)
	if [ -n "$FINALIZE" ]; then finalize; return; fi
	if [ -z "$E" ]; then
		SMP=$SAMPLES; analyse; decide
		[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed ($XR_REASONS)"
		[ "$MODE" = rw ] || die "X-RAID not healthy ($WHY): verify or repair first"
		A=$XR_BASE; B=$XR_MIRROR
		r=$(cat "$STATE/verify.state" 2>/dev/null)
		case "$r" in
		ok\ *) age=$(( ($(date +%s) - ${r#ok }) / 86400 ))
		       [ $age -le $VERIFY_MAX_DAYS ] || { [ -n "$DRY_RUN" ] && log "(verification too old)" || die "full verification too old ($age days): nas-raid verify"; } ;;
		*) [ -n "$DRY_RUN" ] && log "(no successful full verification: refused outside a dry run)" \
			|| die "first run a successful full verification: nas-raid verify" ;;
		esac
		smart_ok "$A"; smart_ok "$B"
		if mounted "$DATA"; then
			u=$(df -Pk "$DATA" | awk 'NR == 2 { print $3 }')
			D=$B; t=$(sectors)
			[ "${u:-0}" -lt $((t / 2 * 95 / 100)) ] || die "the data of $DATA will not fit on the md"
		fi
		confirm MIGRATE "X-RAID -> md migration: $B (mirror) is removed from the X-RAID and reformatted as md; \
the data is copied from $A; then (--finalize) $A is erased and joins the md. \
After that, no way back to the X-RAID nor to RAIDiator."
		log "migration: start (A=$A keeps the X-RAID, B=$B becomes md)"
		write "$STATE/migration" "step=break
a=$A
b=$B"
		E=break
	else
		confirm MIGRATE "Resuming the migration (step $E)."
		A=$(sed -n 's/^a=//p' "$STATE/migration"); B=$(sed -n 's/^b=//p' "$STATE/migration")
		analyse
	fi
	if [ "$E" = break ]; then
		services stop
		current_mode
		[ -n "$DRY_RUN" ] && CURRENT_MODE=xraid-rw
		case "$CURRENT_MODE" in xraid-*) disassemble_xraid ;; esac
		D=$B; nb=$(sectors)
		if [ ! -e "$MD" ] || [ -n "$DRY_RUN" ]; then
			wipe "$B" "$nb" || die "erasing $B"
			create_md "$B" || die "creating the md on $B"
		fi
		# X-RAID read-only on A alone (B no longer has an X-RAID superblock)
		MOUNTPOINT=$DATA; XR_READ_DISK=$A
		assemble_xraid ro || die "X-RAID read-only on $A"
		write "$RUN/nas-raid.mode" "xraid-ro migration_in_progress"
		services start
		x mkdir -p "$MD_MOUNT"
		mounted "$MD_MOUNT" || x mount -t ext4 "/dev/mapper/$VG_MD-$LV_MD" "$MD_MOUNT" || die "mounting the md"
		write "$STATE/migration" "step=copy
a=$A
b=$B"
		E=copy
	fi
	if [ -z "$DRY_RUN" ] && [ "$E" != copy_verified ]; then
		mounted "$DATA" && mounted "$MD_MOUNT" || die "$DATA (X-RAID) and $MD_MOUNT (md) must be mounted: reboot then run nas-raid migrate again"
		awk -v m="$DATA" '$2 == m && $4 ~ /^ro(,|$)/ { f = 1 } END { exit !f }' "$R/proc/mounts" \
			|| die "$DATA is not the read-only X-RAID"
	fi
	if [ "$E" = copy ]; then
		log "migration: copying $DATA to $MD_MOUNT (resumable)"
		x rsync -aH --numeric-ids --delete "$DATA/" "$MD_MOUNT/" || die "copy interrupted (run nas-raid migrate again)"
		write "$STATE/migration" "step=verify
a=$A
b=$B"
		E=verify
	fi
	if [ "$E" = verify ]; then
		log "migration: checking the copy (rsync $VERIFY_RSYNC)"
		if [ -n "$DRY_RUN" ]; then x rsync -aHn $VERIFY_RSYNC --numeric-ids --delete --itemize-changes "$DATA/" "$MD_MOUNT/"
		else
			rsync -aHn $VERIFY_RSYNC --numeric-ids --delete --itemize-changes "$DATA/" "$MD_MOUNT/" > "$STATE/diffs" || die "check interrupted"
			[ -s "$STATE/diffs" ] && die "the copy differs ($(wc -l < "$STATE/diffs") lines, $STATE/diffs): run nas-raid migrate again"
		fi
		write "$STATE/migration" "step=copy_verified
a=$A
b=$B"
		log "migration: copy verified. Check $MD_MOUNT then: nas-raid migrate --finalize --confirm 'ERASE ${A##*/}' --yes"
	fi
	[ "$E" = copy_verified ] && log "copy already verified: nas-raid migrate --finalize --confirm 'ERASE ${A##*/}' --yes"
	return 0
}

finalize() {
	E=$(step); A=$(sed -n 's/^a=//p' "$STATE/migration" 2>/dev/null)
	[ -n "$DRY_RUN" ] && [ -z "$E" ] && { analyse; A=$XR_BASE; E=copy_verified; }
	[ "$E" = copy_verified ] || die "the copy is not verified (step: ${E:-none})"
	confirm "ERASE ${A##*/}" "Last step: $A (last X-RAID disk) is ERASED and joins the md. \
No way back to the X-RAID nor to RAIDiator."
	smart_ok "$A"
	analyse
	if [ -z "$DRY_RUN" ]; then	# last check before erasing the original
		mounted "$DATA" && mounted "$MD_MOUNT" || die "$DATA and $MD_MOUNT must be mounted"
		a=$(df -Pk "$DATA" | awk 'NR == 2 { print $3 }'); b=$(df -Pk "$MD_MOUNT" | awk 'NR == 2 { print $3 }')
		[ "${b:-0}" -ge $(( ${a:-0} / 2 )) ] || die "the md holds much less data than the X-RAID ($b / $a KiB): nothing erased"
	fi
	services stop
	CURRENT_MODE=xraid-ro; disassemble_xraid
	mounted "$MD_MOUNT" && x_ umount "$MD_MOUNT"
	D=$A; nb=$(sectors)
	wipe "$A" "$nb" || die "erasing $A"
	x mdadm "$MD" --add "$A" || die "adding $A to the md"
	x mount -t ext4 "/dev/mapper/$VG_MD-$LV_MD" "$DATA" || die "mounting $DATA"
	write "$RUN/nas-raid.mode" "md"
	services start
	[ -n "$DRY_RUN" ] || { rm -f "$STATE/migration" "$DIRTY"; echo done > "$STATE/migration.done"; }
	log "migration done: md resynchronisation in progress (cat /proc/mdstat)"
}

# ---------- new md, add, grow, X-RAID repair ----------
create() {
	set -- $ARGS
	[ $# -ge 1 ] && [ $# -le 2 ] || die "create: one or two disks"
	[ -e "$MD" ] && [ -z "$DRY_RUN" ] && die "$MD already exists"
	analyse
	names=; for D in "$@"; do sata_disk "$D"; names="$names ${D##*/}"; done
	confirm "ERASE${names}" "Creating a new md RAID 1: ALL the content of$names will be ERASED (including an X-RAID)."
	current_mode
	services stop
	case "$CURRENT_MODE" in xraid-*) disassemble_xraid ;; esac
	for D in "$@"; do wipe "$D" "$(sectors)" || die "erasing $D"; done
	create_md "$@" || die "creating the md"
	x mount -t ext4 "/dev/mapper/$VG_MD-$LV_MD" "$DATA" || die "mount"
	write "$RUN/nas-raid.mode" "md"
	[ -n "$DRY_RUN" ] || rm -f "$STATE/migration" "$DIRTY"
	services start
}

add() {
	set -- $ARGS
	[ $# -eq 1 ] || die "add: one disk"
	[ -e "$MD" ] || [ -n "$DRY_RUN" ] || die "no md $MD"
	analyse; D=$1; sata_disk "$D"
	confirm "ERASE ${D##*/}" "$D will be ERASED and added to the md RAID (resynchronisation)."
	smart_ok "$D"
	wipe "$D" "$(sectors)" || die "erasing $D"
	x mdadm "$MD" --add "$D"
}

grow() {
	[ -e "$MD" ] || [ -n "$DRY_RUN" ] || die "no md $MD"
	grep -q 'recovery\|resync' "$R/proc/mdstat" 2>/dev/null && die "resynchronisation in progress: wait for the end"
	confirm GROW "Growing $MD, the LVM and the ext4 to the size of the smallest disk."
	x mdadm --grow "$MD" --bitmap=none || die "removing the bitmap"
	x mdadm --grow "$MD" --size=max || die "growing the md"
	x mdadm --grow "$MD" --bitmap=internal
	x lvm pvresize --config "$LVM_MD" "$MD" || die "pvresize"
	x lvm lvextend --config "$LVM_MD" -l +100%FREE "$VG_MD/$LV_MD" || die "lvextend"
	x resize2fs "/dev/mapper/$VG_MD-$LV_MD"
}

repair() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed"
	for r in $XR_REASONS; do
		case "$r" in unclean_shutdown|mirror_differs) ;; *) die "repair impossible: $r";; esac
	done
	confirm REPAIR "The content of the sections of $XR_BASE (base) is copied onto $XR_MIRROR where they differ."
	current_mode
	[ -n "$DRY_RUN" ] && CURRENT_MODE=xraid-ro
	services stop
	case "$CURRENT_MODE" in xraid-*) disassemble_xraid ;; esac
	MOUNTPOINT=$DATA
	assemble_xraid rw || die "assembly"
	write "$RUN/nas-raid.mode" "xraid-rw repair"
	i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		x sh -c "echo repair > /sys/block/md1$i/md/sync_action"; i=$((i + 1))
	done
	services start
	log "repair started (cat /proc/mdstat); then: nas-raid verify"
}

# ---------- status ----------
status() {
	if [ -n "$REFRESH" ] || [ ! -r "$RUN/xraid.json" ]; then
		xr=$(xraid-info --json $(disks) 2>/dev/null) || xr=null
		[ -z "$DRY_RUN" ] && [ -d "$RUN" ] && printf '%s\n' "$xr" > "$RUN/xraid.json"
	else xr=$(cat "$RUN/xraid.json"); fi
	read -r m reasons 2>/dev/null < "$RUN/nas-raid.mode" || { m=unknown; reasons=; }
	read -r v vd 2>/dev/null < "$STATE/verify.state" || { v=never; vd=0; }
	prog=$(tail -n 1 "$STATE/verify.progress" 2>/dev/null | sed -n 's/progress \([0-9]*\)%/\1/p')
	zones=$(grep -c '^# difference' "$STATE/verify.res" 2>/dev/null); zones=${zones:-0}
	E=$(step); [ -e "$STATE/migration.done" ] && [ -z "$E" ] && E=done
	[ -e "$DIRTY" ] && dirty=1 || dirty=0
	# copy progress: space used on the md / on /c
	cp=
	if [ "$E" = copy ] && mounted "$MD_MOUNT" && mounted "$DATA"; then
		a=$(df -Pk "$DATA" | awk 'NR == 2 { print $3 }'); b=$(df -Pk "$MD_MOUNT" | awk 'NR == 2 { print $3 }')
		[ "${a:-0}" -gt 0 ] && cp=$(( ${b:-0} * 100 / a ))
	fi
	if [ -n "$JSON" ]; then
		case $XRAID_RW in yes) xrw=yes;; *) xrw=no;; esac
		printf '{"mode":"%s","reasons":"%s","xraid_rw":"%s","dirty":%d,"verify":{"state":"%s","date":%s,"progress":%s,"zones":%s},' \
			"$m" "$reasons" "$xrw" "$dirty" "$v" "${vd:-0}" "${prog:-null}" "$zones"
		a=$(sed -n 's/^a=//p' "$STATE/migration" 2>/dev/null)
		printf '"migration":{"step":"%s","a":"%s","copy":%s},"md":%s,"xraid":%s}\n' "$E" "${a##*/}" "${cp:-null}" "$([ -e "$MD" ] && echo 1 || echo 0)" "$xr"
	else
		echo "mode: $m${reasons:+ ($reasons)}"
		echo "unfinished write mark: $dirty"
		echo "verification: $v $( [ "$vd" != 0 ] && date -d "@$vd" '+%F %T' 2>/dev/null)${prog:+ ($prog %)} differing zones: $zones"
		[ -n "$E" ] && echo "migration: $E${cp:+ (copy ~$cp %)}"
		SMP=0; analyse
		echo "X-RAID: $XR_MODE${XR_REASONS:+ ($XR_REASONS)} base=${XR_BASE:--} mirror=${XR_MIRROR:--}"
	fi
}

# one action at a time (except status)
lock() {
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$RUN"
	exec 9> "$RUN/nas-raid.lock"
	flock -n 9 || die "another nas-raid action is in progress"
}

case "$CMD" in
status) legacy_state; status ;;
mount) lock; legacy_state; do_mount ;;
unmount) lock; legacy_state; do_unmount ;;
remount) lock; legacy_state; do_remount ;;
verify) lock; legacy_state; verify ;;
repair) lock; legacy_state; repair ;;
migrate) lock; legacy_state; migrate ;;
create) lock; legacy_state; create ;;
add) lock; legacy_state; add ;;
grow) lock; legacy_state; grow ;;
*) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
