#!/bin/sh
# nas-raid: ReadyNAS Duo v1 storage under Linux 6.18 (docs/XRAID.md).
#
# Reads and writes an existing X-RAID WITHOUT converting it (compatibility),
# keeping its superblock up to date the way RAIDiator does (xraid-sb,
# docs/XRAID-FORMAT.md). md (Linux software RAID) is disabled for now: an
# existing md volume is still mounted, nothing creates one.
#
#   nas-raid status [--json] [--refresh]   mode, sections, consistency, migration
#   nas-raid mount | unmount               at boot / at shutdown (S35storage)
#   nas-raid remount                       X-RAID only: unmount then mount (after a
#                                          change of XRAID_RW); refused if /c is busy
#   nas-raid verify                        compares the two X-RAID disks (long)
#   nas-raid quick-verify                  quick check (1-3 min): journals, file system
#                                          and LVM metadata, random samples; lifts the
#                                          xraid-dirty mark if the superblock is clean
#   nas-raid quick-accept                  after a quick check without difference on
#                                          an unclean superblock: accepted as a full
#                                          check would be (--confirm ACCEPT --yes)
#   nas-raid repair                        copies the base onto the mirror (md repair)
#   nas-raid watch                         read-write X-RAID: a failed leg is recorded
#                                          in the superblock, /c goes read-only (S35storage)
#   nas-raid migrate|create|add|grow       refused: md support is disabled for now
# Options: --dry-run (prints the commands without doing anything),
#          --confirm PHRASE and --yes (double confirmation of repair, quick-accept).
#
# X-RAID compatibility: never an md superblock; the protected zone (end of
# disk, beyond V) is only written by xraid-sb, superblock copies only: "dirty"
# before a read-write assembly, "clean" after a clean stop, "fail" when a leg
# fails (what RAIDiator writes in each case). Each section
# becomes two dm-linear (base, mirror) assembled by "mdadm --build" (RAID 1
# without metadata); the partitions of the base disk are mapped by dm-linear
# onto these md; LVM (VG c) then /c mounted by the kernel (ext3 with 16 KiB
# blocks: ext4 driver, 16 KiB pages since linux/0003).
#
# Tests on a PC: NAS_RAID_ROOT prefixes /proc, /var, /etc and puts
# $NAS_RAID_ROOT/bin first in PATH; NAS_RAID_DISKS replaces the list of
# SATA disks (disk images).
set -u
R=${NAS_RAID_ROOT:-}
export PATH=${R:+$R/bin:}/bin:/sbin:/usr/bin:/usr/sbin
STATE=$R/var/lib/nas-raid		# persistent (USB key): marks, migration
RUN=$R/var/run
LOG=$STATE/log
DATA=/c
# on-disk names of the md volume, kept as created by earlier versions
MD=/dev/md/donnees
VG_MD=donnees
LV_MD=c
XRAID_VG=c				# LVM group created by RAIDiator, LV "c"
XRAID_LV=c
EXT4_OPTS=noatime			# options of the kernel mount of /c
XRAID_RW=no				# "yes": X-RAID writable if all safeguards pass
SAMPLES=256				# 64 KiB blocks compared per section before a rw mount (0 = none)
QUICK_SAMPLES=512			# random 64 KiB blocks per section in quick-verify (~70 ms each on the NAS)
[ -r "$R/etc/nas-raid.conf" ] && . "$R/etc/nas-raid.conf"

LVM_XR="devices { filter = [ \"a|^/dev/mapper/xr-p|\", \"r|.*|\" ] use_devicesfile = 0 } global { metadata_read_only = 1 }"
LVM_XR_RO="$LVM_XR activation { read_only_volume_list = [ \"$XRAID_VG\" ] }"
LVM_MD="devices { filter = [ \"a|^/dev/md|\", \"r|.*|\" ] use_devicesfile = 0 }"

DRY_RUN=; JSON=; CONFIRM=; YES=; REFRESH=
CMD=${1:-help}; [ $# -gt 0 ] && shift
ARGS=
while [ $# -gt 0 ]; do
	case "$1" in
	--dry-run) DRY_RUN=1 ;;
	--json) JSON=1 ;;
	--yes) YES=1 ;;
	--refresh) REFRESH=1 ;;
	--confirm) [ $# -ge 2 ] || { echo "--confirm: missing phrase" >&2; exit 2; }; CONFIRM=$2; shift ;;
	-*) echo "unknown option: $1" >&2; exit 2 ;;
	*) case "$1" in *[!A-Za-z0-9/._-]*) echo "disk name refused: $1" >&2; exit 2;; esac
	   ARGS="$ARGS $1" ;;
	esac
	shift
done

log() {
	echo "$*" >&2
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$STATE" && echo "[$(date '+%F %T')] $*" >> "$LOG"
}
die() { log "ERROR: $*"; exit 1; }
# x command...: printed (+ ...), run unless dry run, written to the log
x() {
	l="+"; for a in "$@"; do case "$a" in *[!A-Za-z0-9/._=,:+-]*|'') l="$l '$a'";; *) l="$l $a";; esac; done
	echo "$l"
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$STATE" && echo "[$(date '+%F %T')] $l" >> "$LOG"
	# 9>&-: the lock must not leak into the commands (a daemon they start
	# would hold it).
	"$@" 9>&-
}
# x_: like x, without stopping on failure (teardown)
x_() { x "$@" || log "(failure ignored: $*)"; }
write() { [ -n "$DRY_RUN" ] || { mkdir -p "${1%/*}" && printf '%s\n' "$2" > "$1"; }; }

# State files written by the earlier French version: renamed once, so that
# a dirty mark or a migration in progress is never forgotten.
legacy_state() {
	[ -n "$DRY_RUN" ] && return 0
	[ -d "$STATE" ] || return 0
	for p in journal:log xraid-sale:xraid-dirty xraid-verifie:xraid-verified \
		 verif.res:verify.res verif.prog:verify.progress ecarts:diffs; do
		[ -e "$STATE/${p%%:*}" ] && [ ! -e "$STATE/${p#*:}" ] && mv "$STATE/${p%%:*}" "$STATE/${p#*:}"
	done
	if [ -e "$STATE/verif.etat" ]; then
		sed 's/^en_cours /running /; s/^erreurs /errors /' "$STATE/verif.etat" > "$STATE/verify.state" && rm -f "$STATE/verif.etat"
	fi
	if [ -e "$STATE/migration.fin" ]; then echo done > "$STATE/migration.done" && rm -f "$STATE/migration.fin"; fi
	if grep -q '^etape=' "$STATE/migration" 2>/dev/null; then
		sed -i 's/^etape=casser$/step=break/; s/^etape=copier$/step=copy/; s/^etape=verifier$/step=verify/; s/^etape=copie_verifiee$/step=copy_verified/' "$STATE/migration"
	fi
	return 0
}

# SATA disks of the NAS (libata: /sys/block/sdX/device -> .../ataN/...), not the USB key
disks() {
	if [ -n "${NAS_RAID_DISKS:-}" ]; then echo $NAS_RAID_DISKS; return; fi
	for b in "$R"/sys/block/sd*; do
		[ -d "$b" ] || continue
		case "$(readlink -f "$b/device")" in */ata[0-9]*) echo "/dev/${b##*/}";; esac
	done
}
mounted() { awk -v m="$1" '$2 == m { f = 1 } END { exit !f }' "$R/proc/mounts" 2>/dev/null; }
# the disk must be one of the SATA disks (never the system USB key)
sata_disk() { for d in $(disks); do [ "$d" = "$1" ] && return 0; done; die "$1 is not a SATA disk of the NAS"; }
sectors() {	# sectors of a disk (XR_Dn from xraid-info, otherwise /sys)
	i=0
	while [ $i -lt "${XR_NR_DISKS_READ:-0}" ]; do
		eval "set -- \$XR_D$i"; [ "$1" = "$D" ] && { echo "$2"; return; }; i=$((i + 1))
	done
	cat "$R/sys/block/${D##*/}/size" 2>/dev/null || echo 0
}

# X-RAID analysis (XR_* variables); $SMP = number of samples
analyse() {
	XR_MODE=none; XR_REASONS=; XR_MD=; XR_BASE=; XR_MIRROR=; XR_READ_DISK=
	XR_NR_SECTIONS=0; XR_NR_PARTS=0; XR_NR_DISKS_READ=0; XR_ID=; XR_CTIME=0
	set -- $(disks)
	[ $# -gt 0 ] || return 0
	output=$(xraid-info --samples "${SMP:-0}" "$@") || die "xraid-info failed"
	eval "$output"
}

# Persistent marks: xraid-dirty = assembled rw (removed on clean shutdown,
# stays after a power loss); xraid-verified = "ID CTIME" of a successful full
# verification (then accepts a RAIDiator superblock marked unclean).
DIRTY=$STATE/xraid-dirty
VERIFIED=$STATE/xraid-verified

# decides rw/ro, adding our own safeguards to those of xraid-info
decide() {
	MODE=$XR_MODE; WHY=$XR_REASONS
	[ "$MODE" = rw ] || [ "$MODE" = ro ] || { MODE=none; return; }
	if [ "$MODE" = ro ] && [ "$XR_REASONS" = unclean_shutdown ] && [ "$(cat "$VERIFIED" 2>/dev/null)" = "$XR_ID $XR_CTIME" ]; then
		MODE=rw; WHY="unclean_shutdown_verified"
	fi
	if [ "$MODE" = rw ] && [ -e "$DIRTY" ]; then
		MODE=ro; WHY="${WHY:+$WHY }unclean_shutdown_linux"
	fi
	if [ "$MODE" = rw ] && [ -e "$STATE/migration" ]; then
		MODE=ro; WHY="${WHY:+$WHY }migration_in_progress"
	fi
}

# ---------- X-RAID assembly ----------
assemble_xraid() {	# $1 = rw | ro
	m=$1; i=0
	[ -n "$DRY_RUN" ] || mkdir -p "$MOUNTPOINT"
	if [ $m = rw ]; then
		[ -n "$DRY_RUN" ] || rm -f "$QUICK_OK"
		write "$DIRTY" "$(date +%s)"; [ -n "$DRY_RUN" ] || sync
		while [ $i -lt "$XR_NR_SECTIONS" ]; do
			eval "set -- \$XR_S$i"
			x dmsetup create "xr-a-s$i" --table "0 $2 linear $XR_BASE $1" || return 1
			x dmsetup create "xr-b-s$i" --table "0 $2 linear $XR_MIRROR $1" || return 1
			# base first: source of a "repair"
			x mdadm --build "/dev/md1$i" --level=1 --raid-devices=2 --assume-clean \
				"/dev/mapper/xr-a-s$i" "/dev/mapper/xr-b-s$i" || return 1
			i=$((i + 1))
		done
	fi
	i=0
	while [ $i -lt "$XR_NR_PARTS" ]; do
		eval "set -- \$XR_P$i"	# num start size type section offset
		if [ $m = rw ]; then
			[ "$5" -ge 0 ] && x dmsetup create "xr-p$1" --table "0 $3 linear /dev/md1$5 $6"
		else
			x dmsetup create "xr-p$1" --readonly --table "0 $3 linear $XR_READ_DISK $2"
		fi || return 1
		i=$((i + 1))
	done
	if [ $m = rw ]; then
		x lvm vgchange -ay --config "$LVM_XR" "$XRAID_VG" || return 1
		x mount -t ext4 -o "$EXT4_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" || return 1
	else
		x lvm vgchange -ay --config "$LVM_XR_RO" "$XRAID_VG" || return 1
		# read-only device: a journal left to replay (RAIDiator cut off)
		# cannot be replayed, the volume is then read without it (noload)
		x mount -t ext4 -o "ro,$EXT4_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" ||
			x mount -t ext4 -o "ro,noload,$EXT4_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" || return 1
	fi
}

disassemble_xraid() {
	mounted "$DATA" && x_ umount "$DATA"
	x_ lvm vgchange -an --config "$LVM_XR" "$XRAID_VG"
	i=0
	while [ $i -lt "$XR_NR_PARTS" ]; do
		eval "set -- \$XR_P$i"; x_ dmsetup remove "xr-p$1"; i=$((i + 1))
	done
	[ "$CURRENT_MODE" = xraid-rw ] || return 0
	# state of the md before stopping them: "UU" each, nothing resyncing
	md_health
	i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		x_ mdadm --stop "/dev/md1$i"
		x_ dmsetup remove "xr-a-s$i"; x_ dmsetup remove "xr-b-s$i"
		i=$((i + 1))
	done
	sb_after_rw
}

# md_health: HEALTH = ok | busy (missing md, resync/repair running) | base_failed | mirror_failed | both_failed
md_health() {
	HEALTH=ok; i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		map=$(awk -v n="md1$i" '$1 == n { f = 1; next } f && /blocks/ { print $NF; exit }' "$R/proc/mdstat" 2>/dev/null)
		case "$map" in
		"[UU]") read -r act 2>/dev/null < "$R/sys/block/md1$i/md/sync_action" || act=unknown
			[ "$act" = idle ] || { [ $HEALTH = ok ] && HEALTH=busy; } ;;
		"[U_]") case $HEALTH in base_failed|both_failed) HEALTH=both_failed;; *) HEALTH=mirror_failed;; esac ;;
		"[_U]") case $HEALTH in mirror_failed|both_failed) HEALTH=both_failed;; *) HEALTH=base_failed;; esac ;;
		*) [ $HEALTH = ok ] && HEALTH=busy ;;
		esac
		i=$((i + 1))
	done
}

# After a read-write assembly (md stopped, everything flushed): the superblock
# goes back to "clean" only if both legs stayed healthy and nothing was left
# resyncing; a failed leg is recorded on the surviving disk as RAIDiator would.
# Otherwise it stays "dirty": RAIDiator would copy base -> mirror at its next
# start, and Linux stays read-only until a successful nas-raid verify.
sb_after_rw() {
	case "$HEALTH" in
	ok) if [ -z "$NOCLEAN" ] && x xraid-sb clean "$XR_BASE" "$XR_MIRROR"; then
		[ -n "$DRY_RUN" ] || rm -f "$DIRTY"
	    else log "X-RAID superblock left dirty: rw refused at next mount"; fi ;;
	mirror_failed) log "X-RAID: mirror leg failed, recorded on the base"; x_ xraid-sb fail "$XR_BASE" ;;
	base_failed) log "X-RAID: base leg failed, recorded on the mirror"; x_ xraid-sb fail "$XR_MIRROR" ;;
	*) log "X-RAID md $HEALTH at shutdown: superblock left dirty, rw refused at next mount" ;;
	esac
	return 0
}

# before the first write: superblock "dirty" (as RAIDiator while it runs)
sb_dirty() {
	command -v xraid-sb >/dev/null 2>&1 || { log "xraid-sb missing"; return 1; }
	x xraid-sb dirty "$XR_BASE" "$XR_MIRROR"
}

mount_md() {	# $1 = mount point
	x mdadm --assemble --scan || [ -e "$MD" ] || return 1
	x lvm vgchange -ay --config "$LVM_MD" "$VG_MD" || return 1
	x mkdir -p "$1"
	x mount -t ext4 "/dev/mapper/$VG_MD-$LV_MD" "$1"
}

current_mode() { read -r CURRENT_MODE _ 2>/dev/null < "$RUN/nas-raid.mode" || CURRENT_MODE=none; }

# Mount time: comparing SAMPLES blocks of the two disks takes ~35 s on the NAS
# (cold). It only matters for WRITING (read-only reads the base disk alone and
# cannot harm anything): first a fast analysis without samples; the comparison
# runs only if rw is still possible (all other safeguards passed, XRAID_RW=yes).
do_mount() {
	[ -n "$DRY_RUN" ] || rm -f "$QUICK_OK"
	SMP=0; analyse
	write "$RUN/xraid.json" "$(xraid-info --json $(disks) 2>/dev/null || echo null)"
	if [ "${XR_MD:-}" = 1 ]; then	# volume made by an earlier version: mounted as it is
		if mount_md "$DATA"; then write "$RUN/nas-raid.mode" "md"; else write "$RUN/nas-raid.mode" "none md_failed"; fi
		return 0
	fi
	decide
	if [ "$MODE" = rw ] && [ "$XRAID_RW" != yes ]; then
		MODE=ro; WHY="${WHY:+$WHY }rw_disabled"
	fi
	if [ "$MODE" = rw ] && ! command -v xraid-sb >/dev/null 2>&1; then
		MODE=ro; WHY="${WHY:+$WHY }no_sb_writer"
	fi
	if [ "$MODE" = rw ] && [ "$SAMPLES" -gt 0 ] 2>/dev/null; then
		log "X-RAID: comparing $SAMPLES samples per section before allowing writes"
		SMP=$SAMPLES; analyse; decide	# a difference gives ro, reason mirror_differs
	fi
	# superblock "dirty" before the first write; if it cannot be written: ro
	if [ "$MODE" = rw ] && ! sb_dirty; then
		MODE=ro; WHY="${WHY:+$WHY }sb_write_failed"
	fi
	MOUNTPOINT=$DATA
	case "$MODE" in
	rw|ro)
		log "X-RAID: mounting $MODE${WHY:+ ($WHY)}"
		if assemble_xraid "$MODE"; then write "$RUN/nas-raid.mode" "xraid-$MODE $WHY"
		else
			log "X-RAID: $MODE assembly failed, everything undone"
			CURRENT_MODE=xraid-$MODE; NOCLEAN=1; disassemble_xraid	# superblock stays dirty
			write "$RUN/nas-raid.mode" "none assembly_failed $WHY"
		fi ;;
	*)	log "no usable X-RAID volume${WHY:+ ($WHY)}"
		write "$RUN/nas-raid.mode" "none $WHY" ;;
	esac
}
NOCLEAN=

do_unmount() {
	current_mode
	case "$CURRENT_MODE" in
	md) mounted "$DATA" && x_ umount "$DATA"; x_ lvm vgchange -an --config "$LVM_MD" "$VG_MD" ;;
	xraid-*) analyse; disassemble_xraid ;;
	esac
	write "$RUN/nas-raid.mode" "none stopped"
}

# X-RAID remount (DIET: "allow writing" switch). /c is unmounted first, on its
# own: if a file is still open there (umount refused), nothing is torn down and
# the volume stays mounted as it was. Then the usual mount, with all safeguards.
do_remount() {
	current_mode
	case "$CURRENT_MODE" in xraid-*) ;; *) die "remount: only for an X-RAID volume (mode $CURRENT_MODE)";; esac
	if mounted "$DATA"; then x umount "$DATA" || die "$DATA is busy (open files): not remounted"; fi
	do_unmount
	do_mount
}

# Read-write X-RAID with a failed leg (md degraded: I/O error, disk pulled):
# the failure is written at once on the surviving disk, as RAIDiator would,
# then /c is remounted (read-only, the safeguards see the failed disk).
# Run every 30 s by S35storage; cheap when nothing happened.
watch() {
	current_mode
	[ "$CURRENT_MODE" = xraid-rw ] || return 0
	awk '/^md1[0-6] :/ { n = 1; next } n && /blocks/ { if ($NF ~ /_/) f = 1; n = 0 } END { exit !f }' "$R/proc/mdstat" 2>/dev/null || return 0
	lock
	analyse; md_health
	log "X-RAID: md degraded while writing ($HEALTH): going read-only"
	case "$HEALTH" in
	mirror_failed) x_ xraid-sb fail "$XR_BASE" ;;
	base_failed) x_ xraid-sb fail "$XR_MIRROR" ;;
	esac
	services stop
	if mounted "$DATA" && ! x umount "$DATA"; then
		log "$DATA is busy: stays mounted on the surviving disk until it can be unmounted"
	else
		do_unmount; do_mount
	fi
	services start
}

# consistent mirror, nothing assembled for writing: the marks can go; the
# superblock is put back "clean" (xraid-sb refuses unless both disks are online
# and their superblocks agree)
mark_consistent() {
	rm -f "$DIRTY"; echo "$XR_ID $XR_CTIME" > "$VERIFIED"
	x_ xraid-sb clean "$XR_BASE" "$XR_MIRROR"
}

# ---------- full mirror verification (read-only) ----------
verify() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed ($XR_REASONS)"
	if [ -n "$DRY_RUN" ]; then x xraid-info verify "$XR_BASE" "$XR_MIRROR"; return 0; fi
	mkdir -p "$STATE"
	echo "running $(date +%s)" > "$STATE/verify.state"
	log "mirror verification: $XR_BASE / $XR_MIRROR"
	xraid-info verify "$XR_BASE" "$XR_MIRROR" > "$STATE/verify.res" 2> "$STATE/verify.progress"
	rc=$?
	case $rc in 0) r=ok;; 1) r=differences;; *) r=errors;; esac
	echo "$r $(date +%s)" > "$STATE/verify.state"
	log "verification: $r ($(grep -c '^# difference' "$STATE/verify.res") differing zones)"
	current_mode
	if [ $r = ok ] && [ "$CURRENT_MODE" != xraid-rw ]; then
		mark_consistent
		log "consistent mirror: writing allowed at next mount"
	fi
	return $rc
}

# ---------- quick check (read-only, docs/XRAID.md "Quick check") ----------
# xraid-info quick compares the ext3 journals and metadata, the LVM metadata,
# the EBRs and QUICK_SAMPLES random blocks per section. Decision when nothing
# differs and nothing is assembled for writing:
# - superblock clean (only the Linux xraid-dirty mark left): the mark goes;
# - superblock unclean (real crash): nothing is lifted; state "confirm" and a
#   token for this boot ($QUICK_OK, in /var/run): "quick-accept" can then do
#   what a successful full verify does, with an explicit confirmation.
QUICK_OK=$RUN/quick.ok
quick_verify() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed ($XR_REASONS)"
	if [ -n "$DRY_RUN" ]; then x xraid-info quick --json --samples "$QUICK_SAMPLES" "$XR_BASE" "$XR_MIRROR"; return 0; fi
	mkdir -p "$STATE" "$RUN"; rm -f "$QUICK_OK"
	echo "running $(date +%s)" > "$STATE/quick.state"
	log "quick mirror check: $XR_BASE / $XR_MIRROR ($QUICK_SAMPLES samples per section)"
	xraid-info quick --json --samples "$QUICK_SAMPLES" "$XR_BASE" "$XR_MIRROR" > "$STATE/quick.tmp" 2> "$STATE/quick.progress"
	rc=$?
	mv "$STATE/quick.tmp" "$STATE/quick.res"
	current_mode
	case $rc in
	0)	if [ "$CURRENT_MODE" = xraid-rw ]; then r=ok	# writes in progress: nothing lifted
		elif [ "$XR_CLEAN" = 1 ] && [ "${XR_REASONS#*sync_in_progress}" = "$XR_REASONS" ]; then
			r=ok
			[ -e "$DIRTY" ] && { rm -f "$DIRTY"; log "quick check: clean superblock, xraid-dirty mark removed: writing allowed at next mount"; }
		else
			r=confirm; echo "$XR_ID $XR_CTIME" > "$QUICK_OK"
			log "quick check: no difference, but the superblock records an unclean shutdown: nothing lifted (nas-raid quick-accept, or a full verify)"
		fi ;;
	1) r=differences ;;
	3) r=incomplete ;;
	*) r=errors ;;
	esac
	echo "$r $(date +%s)" > "$STATE/quick.state"
	log "quick check: $r ($(sed -n 's/.*"bytes":\([0-9]*\),"differences":\([0-9]*\),.*/\1 bytes compared, \2 differences/p' "$STATE/quick.res"))"
	return $rc
}

quick_accept() {
	analyse
	read -r st _ 2>/dev/null < "$STATE/quick.state" || st=none
	[ "$st" = confirm ] && [ -r "$QUICK_OK" ] || die "quick-accept: only after a quick check, during this boot, that found no difference on an unclean superblock (state: $st)"
	[ "$(cat "$QUICK_OK")" = "$XR_ID $XR_CTIME" ] || die "the superblock changed since the quick check: run it again"
	for r in $XR_REASONS; do
		case "$r" in unclean_shutdown|sync_in_progress) ;; *) die "quick-accept impossible: $r";; esac
	done
	current_mode
	[ "$CURRENT_MODE" != xraid-rw ] || die "quick-accept: the X-RAID is assembled for writing"
	confirm ACCEPT "The quick check compared only the journals, the metadata and samples: file data written at the time of the crash may still differ between the disks (residual risk). The superblock is put back clean as after a full check."
	[ -n "$DRY_RUN" ] && return 0
	mark_consistent; rm -f "$QUICK_OK"
	echo "accepted $(date +%s)" > "$STATE/quick.state"
	log "quick check accepted by the administrator (residual risk): writing allowed at next mount"
}

confirm() {	# $1 = expected phrase, $2 = what is going to happen
	[ -n "$DRY_RUN" ] && { echo "(dry run: confirmation \"$1\" not asked)"; return 0; }
	if [ "$CONFIRM" != "$1" ] || [ -z "$YES" ]; then
		echo "$2" >&2
		die "confirmation required: --confirm '$1' --yes"
	fi
}

services() {	# stop|start the shares around a change of /c
	if [ "$1" = stop ]; then l="S70ksmbd S60nfs"; else l="S60nfs S70ksmbd"; fi
	for s in $l; do [ -x "$R/etc/init.d/$s" ] && x_ "$R/etc/init.d/$s" "$1"; done
	return 0
}

repair() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed"
	for r in $XR_REASONS; do
		case "$r" in unclean_shutdown|sync_in_progress|mirror_differs) ;; *) die "repair impossible: $r";; esac
	done
	confirm REPAIR "The content of the sections of $XR_BASE (base) is copied onto $XR_MIRROR where they differ."
	current_mode
	[ -n "$DRY_RUN" ] && CURRENT_MODE=xraid-ro
	services stop
	case "$CURRENT_MODE" in xraid-*) disassemble_xraid ;; esac
	sb_dirty || die "cannot mark the X-RAID superblock dirty"
	MOUNTPOINT=$DATA
	assemble_xraid rw || die "assembly"
	write "$RUN/nas-raid.mode" "xraid-rw repair"
	i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		x sh -c "echo repair > /sys/block/md1$i/md/sync_action"; i=$((i + 1))
	done
	services start
	log "repair started (cat /proc/mdstat); then: nas-raid verify"
}

# md support is disabled for now (docs/XRAID-MIGRATION.md)
md_disabled() {
	die "md support is disabled for now: X-RAID only. ($CMD refused: the former migrate/create erased the end of the disks, \"WGam\" mark included, after which RAIDiator's linuxrc reinstalls the NAS; see docs/XRAID-MIGRATION.md)"
}

# ---------- status ----------
status() {
	if [ -n "$REFRESH" ] || [ ! -r "$RUN/xraid.json" ]; then
		xr=$(xraid-info --json $(disks) 2>/dev/null) || xr=null
		[ -z "$DRY_RUN" ] && [ -d "$RUN" ] && printf '%s\n' "$xr" > "$RUN/xraid.json"
	else xr=$(cat "$RUN/xraid.json"); fi
	read -r m reasons 2>/dev/null < "$RUN/nas-raid.mode" || { m=unknown; reasons=; }
	read -r v vd 2>/dev/null < "$STATE/verify.state" || { v=never; vd=0; }
	prog=$(tail -n 1 "$STATE/verify.progress" 2>/dev/null | sed -n 's/progress \([0-9]*\)%/\1/p')
	zones=$(grep -c '^# difference' "$STATE/verify.res" 2>/dev/null); zones=${zones:-0}
	read -r q qd 2>/dev/null < "$STATE/quick.state" || { q=never; qd=0; }
	qprog=$(tail -n 1 "$STATE/quick.progress" 2>/dev/null | sed -n 's/progress \([0-9]*\)%/\1/p')
	qres=null; [ "$q" != running ] && [ -s "$STATE/quick.res" ] && qres=$(cat "$STATE/quick.res")
	[ "$q" = confirm ] && [ -e "$QUICK_OK" ] && qok=1 || qok=0
	[ -e "$DIRTY" ] && dirty=1 || dirty=0
	command -v xraid-sb >/dev/null 2>&1 && sbw=yes || sbw=no
	if [ -n "$JSON" ]; then
		case $XRAID_RW in yes) xrw=yes;; *) xrw=no;; esac
		printf '{"mode":"%s","reasons":"%s","xraid_rw":"%s","sb_writer":"%s","dirty":%d,"verify":{"state":"%s","date":%s,"progress":%s,"zones":%s},' \
			"$m" "$reasons" "$xrw" "$sbw" "$dirty" "$v" "${vd:-0}" "${prog:-null}" "$zones"
		printf '"quick":{"state":"%s","date":%s,"progress":%s,"accept":%d,"result":%s},' "$q" "${qd:-0}" "${qprog:-null}" "$qok" "$qres"
		printf '"md":%s,"xraid":%s}\n' "$([ -e "$MD" ] && echo 1 || echo 0)" "$xr"
	else
		echo "mode: $m${reasons:+ ($reasons)}"
		echo "unfinished write mark: $dirty; superblock writer: $sbw"
		echo "verification: $v $( [ "$vd" != 0 ] && date -d "@$vd" '+%F %T' 2>/dev/null)${prog:+ ($prog %)} differing zones: $zones"
		echo "quick check: $q $( [ "$qd" != 0 ] && date -d "@$qd" '+%F %T' 2>/dev/null)${qprog:+ ($qprog %)}"
		SMP=0; analyse
		echo "X-RAID: $XR_MODE${XR_REASONS:+ ($XR_REASONS)} base=${XR_BASE:--} mirror=${XR_MIRROR:--} clean=${XR_CLEAN:-?}"
	fi
}

# one action at a time (except status)
lock() {
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$RUN"
	exec 9> "$RUN/nas-raid.lock"
	flock -n 9 || die "another nas-raid action is in progress"
}

case "$CMD" in
status) legacy_state; status ;;
mount) lock; legacy_state; do_mount ;;
unmount) lock; legacy_state; do_unmount ;;
remount) lock; legacy_state; do_remount ;;
verify) lock; legacy_state; verify ;;
quick-verify) lock; legacy_state; quick_verify ;;
quick-accept) lock; legacy_state; quick_accept ;;
repair) lock; legacy_state; repair ;;
watch) watch ;;
migrate|create|add|grow) md_disabled ;;
*) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
