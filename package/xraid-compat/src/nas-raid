#!/bin/sh
# nas-raid: ReadyNAS Duo v1 storage under Linux 6.18 (docs/XRAID.md).
#
# Reads and writes an existing X-RAID WITHOUT converting it (compatibility),
# keeping its superblock up to date the way RAIDiator does (xraid-sb,
# docs/XRAID-FORMAT.md). md (Linux software RAID) is disabled for now: nothing
# creates one. The md volumes of a RAIDiator with X-RAID off ("Flex-RAID",
# RAID 0/1) are mounted read-only, or read-write with FLEXRAID_RW=yes
# (flexraid_mount).
#
#   nas-raid status [--json] [--refresh]   mode, sections, consistency, migration
#   nas-raid mount | unmount               at boot / at shutdown (S35storage)
#   nas-raid remount                       X-RAID only: unmount then mount (after a
#                                          change of XRAID_RW); refused if /c is busy
#   nas-raid verify                        compares the two X-RAID disks (long)
#   nas-raid quick-verify                  quick check (1-3 min): journals, file system
#                                          and LVM metadata, random samples; lifts the
#                                          xraid-dirty mark if the superblock is clean
#   nas-raid quick-accept                  after a quick check without difference on
#                                          an unclean superblock: accepted as a full
#                                          check would be (--confirm ACCEPT --yes)
#   nas-raid decide                        mode a mount would give now ("rw" or "ro"
#                                          + reasons), read-only (the web API remounts
#                                          /c read-write once a check lifts a safeguard)
#   nas-raid repair                        copies the base onto the mirror (md repair)
#   nas-raid watch                         read-write X-RAID or Flex-RAID RAID 1: a failed
#                                          leg is recorded in the superblock, the volume
#                                          goes read-only (S35storage)
#   nas-raid migrate|create|add|grow       refused: md support is disabled for now
# Options: --dry-run (prints the commands without doing anything),
#          --confirm PHRASE and --yes (double confirmation of repair, quick-accept).
#
# X-RAID compatibility: never an md superblock; the protected zone (end of
# disk, beyond V) is only written by xraid-sb, superblock copies only: "dirty"
# before a read-write assembly, "clean" after a clean stop, "fail" when a leg
# fails (what RAIDiator writes in each case). Each section
# becomes two dm-linear (base, mirror) assembled by "mdadm --build" (RAID 1
# without metadata); the partitions of the base disk are mapped by dm-linear
# onto these md; LVM (VG c) then /c mounted by the kernel (ext3 with 16 KiB
# blocks: ext4 driver, 16 KiB pages since linux/0020).
#
# Tests on a PC: NAS_RAID_ROOT prefixes /proc, /var, /etc and puts
# $NAS_RAID_ROOT/bin first in PATH; NAS_RAID_DISKS replaces the list of
# SATA disks (disk images).
# Tests on the NAS next to its own volume (tools/raidiator-bench/on-618.sh):
# NAS_RAID_BIN first in PATH, NAS_RAID_RUN / NAS_RAID_STATE / NAS_RAID_CONF
# for the state, log and settings, NAS_RAID_MNT where the Flex-RAID volumes
# are mounted and NAS_RAID_VG_PATTERN the VG names accepted there (only with
# NAS_RAID_MNT: never a test volume at the root). Unset: the NAS's own paths.
set -u
R=${NAS_RAID_ROOT:-}
export PATH=${NAS_RAID_BIN:+$NAS_RAID_BIN:}${R:+$R/bin:}/bin:/sbin:/usr/bin:/usr/sbin
STATE=${NAS_RAID_STATE:-$R/var/lib/nas-raid}	# persistent (USB key): marks, migration
RUN=${NAS_RAID_RUN:-$R/var/run}
LOG=$STATE/log
DATA=/c
XRAID_VG=c				# LVM group created by RAIDiator, LV "c"
XRAID_LV=c
EXT4_OPTS=noatime			# options of the kernel mount of /c
XRAID_RW=no				# "yes": X-RAID writable if all safeguards pass
FLEXRAID_RW=no				# "yes": RAIDiator RAID 0 and RAID 1 volumes writable (docs/XRAID.md §10)
SAMPLES=256				# 64 KiB blocks compared per section before a rw mount (0 = none)
QUICK_SAMPLES=512			# random 64 KiB blocks per section in quick-verify (~70 ms each on the NAS)
CONF=${NAS_RAID_CONF:-$R/etc/nas-raid.conf}
[ -r "$CONF" ] && . "$CONF"
FR_MNT=${NAS_RAID_MNT:-}		# Flex-RAID mount points under it (tests)
FR_VG_PATTERN=${NAS_RAID_VG_PATTERN:-}
if [ -n "$FR_VG_PATTERN" ] && [ -z "$FR_MNT" ]; then
	echo "NAS_RAID_VG_PATTERN needs NAS_RAID_MNT" >&2; exit 2
fi

LVM_XR="devices { filter = [ \"a|^/dev/mapper/xr-p|\", \"r|.*|\" ] use_devicesfile = 0 } global { metadata_read_only = 1 }"
LVM_XR_RO="$LVM_XR activation { read_only_volume_list = [ \"$XRAID_VG\" ] }"

DRY_RUN=; JSON=; CONFIRM=; YES=; REFRESH=
CMD=${1:-help}; [ $# -gt 0 ] && shift
ARGS=
while [ $# -gt 0 ]; do
	case "$1" in
	--dry-run) DRY_RUN=1 ;;
	--json) JSON=1 ;;
	--yes) YES=1 ;;
	--refresh) REFRESH=1 ;;
	--confirm) [ $# -ge 2 ] || { echo "--confirm: missing phrase" >&2; exit 2; }; CONFIRM=$2; shift ;;
	-*) echo "unknown option: $1" >&2; exit 2 ;;
	*) case "$1" in *[!A-Za-z0-9/._-]*) echo "disk name refused: $1" >&2; exit 2;; esac
	   ARGS="$ARGS $1" ;;
	esac
	shift
done

log() {
	echo "$*" >&2
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$STATE" && echo "[$(date '+%F %T')] $*" >> "$LOG"
}
die() { log "ERROR: $*"; exit 1; }
# x command...: printed (+ ...), run unless dry run, written to the log
x() {
	l="+"; for a in "$@"; do case "$a" in *[!A-Za-z0-9/._=,:+-]*|'') l="$l '$a'";; *) l="$l $a";; esac; done
	echo "$l"
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$STATE" && echo "[$(date '+%F %T')] $l" >> "$LOG"
	# 9>&-: the lock must not leak into the commands (a daemon they start
	# would hold it).
	"$@" 9>&-
}
# x_: like x, without stopping on failure (teardown)
x_() { x "$@" || log "(failure ignored: $*)"; }
write() { [ -n "$DRY_RUN" ] || { mkdir -p "${1%/*}" && printf '%s\n' "$2" > "$1"; }; }

# State files written by the earlier French version: renamed once, so that
# a dirty mark or a migration in progress is never forgotten.
legacy_state() {
	[ -n "$DRY_RUN" ] && return 0
	[ -d "$STATE" ] || return 0
	for p in journal:log xraid-sale:xraid-dirty xraid-verifie:xraid-verified \
		 verif.res:verify.res verif.prog:verify.progress ecarts:diffs; do
		[ -e "$STATE/${p%%:*}" ] && [ ! -e "$STATE/${p#*:}" ] && mv "$STATE/${p%%:*}" "$STATE/${p#*:}"
	done
	if [ -e "$STATE/verif.etat" ]; then
		sed 's/^en_cours /running /; s/^erreurs /errors /' "$STATE/verif.etat" > "$STATE/verify.state" && rm -f "$STATE/verif.etat"
	fi
	if [ -e "$STATE/migration.fin" ]; then echo done > "$STATE/migration.done" && rm -f "$STATE/migration.fin"; fi
	if grep -q '^etape=' "$STATE/migration" 2>/dev/null; then
		sed -i 's/^etape=casser$/step=break/; s/^etape=copier$/step=copy/; s/^etape=verifier$/step=verify/; s/^etape=copie_verifiee$/step=copy_verified/' "$STATE/migration"
	fi
	return 0
}

# SATA disks of the NAS (libata: /sys/block/sdX/device -> .../ataN/...), not the USB key
disks() {
	if [ -n "${NAS_RAID_DISKS:-}" ]; then echo $NAS_RAID_DISKS; return; fi
	for b in "$R"/sys/block/sd*; do
		[ -d "$b" ] || continue
		case "$(readlink -f "$b/device")" in */ata[0-9]*) echo "/dev/${b##*/}";; esac
	done
}
mounted() { awk -v m="$1" '$2 == m { f = 1 } END { exit !f }' "$R/proc/mounts" 2>/dev/null; }
# the disk must be one of the SATA disks (never the system USB key)
sata_disk() { for d in $(disks); do [ "$d" = "$1" ] && return 0; done; die "$1 is not a SATA disk of the NAS"; }
sectors() {	# sectors of a disk (XR_Dn from xraid-info, otherwise /sys)
	i=0
	while [ $i -lt "${XR_NR_DISKS_READ:-0}" ]; do
		eval "set -- \$XR_D$i"; [ "$1" = "$D" ] && { echo "$2"; return; }; i=$((i + 1))
	done
	cat "$R/sys/block/${D##*/}/size" 2>/dev/null || echo 0
}

# X-RAID analysis (XR_* variables); $SMP = number of samples
analyse() {
	XR_MODE=none; XR_REASONS=; XR_BASE=; XR_MIRROR=; XR_READ_DISK=
	XR_NR_SECTIONS=0; XR_NR_PARTS=0; XR_NR_DISKS_READ=0; XR_ID=; XR_CTIME=0
	set -- $(disks)
	[ $# -gt 0 ] || return 0
	output=$(xraid-info --samples "${SMP:-0}" "$@") || die "xraid-info failed"
	eval "$output"
}

# Persistent marks: xraid-dirty = assembled rw (removed on clean shutdown,
# stays after a power loss); xraid-verified = "ID CTIME" of a successful full
# verification (then accepts a RAIDiator superblock marked unclean).
DIRTY=$STATE/xraid-dirty
VERIFIED=$STATE/xraid-verified

# decides rw/ro, adding our own safeguards to those of xraid-info
decide() {
	MODE=$XR_MODE; WHY=$XR_REASONS
	[ "$MODE" = rw ] || [ "$MODE" = ro ] || { MODE=none; return; }
	if [ "$MODE" = ro ] && [ "$XR_REASONS" = unclean_shutdown ] && [ "$(cat "$VERIFIED" 2>/dev/null)" = "$XR_ID $XR_CTIME" ]; then
		MODE=rw; WHY="unclean_shutdown_verified"
	fi
	if [ "$MODE" = rw ] && [ -e "$DIRTY" ]; then
		MODE=ro; WHY="${WHY:+$WHY }unclean_shutdown_linux"
	fi
	if [ "$MODE" = rw ] && [ -e "$STATE/migration" ]; then
		MODE=ro; WHY="${WHY:+$WHY }migration_in_progress"
	fi
}

# ---------- X-RAID assembly ----------
assemble_xraid() {	# $1 = rw | ro
	m=$1; i=0
	[ -n "$DRY_RUN" ] || mkdir -p "$MOUNTPOINT"
	if [ $m = rw ]; then
		[ -n "$DRY_RUN" ] || rm -f "$QUICK_OK"
		write "$DIRTY" "$(date +%s)"; [ -n "$DRY_RUN" ] || sync
		while [ $i -lt "$XR_NR_SECTIONS" ]; do
			eval "set -- \$XR_S$i"
			x dmsetup create "xr-a-s$i" --table "0 $2 linear $XR_BASE $1" || return 1
			x dmsetup create "xr-b-s$i" --table "0 $2 linear $XR_MIRROR $1" || return 1
			# base first: source of a "repair"
			x mdadm --build "/dev/md1$i" --level=1 --raid-devices=2 --assume-clean \
				"/dev/mapper/xr-a-s$i" "/dev/mapper/xr-b-s$i" || return 1
			i=$((i + 1))
		done
	fi
	i=0
	while [ $i -lt "$XR_NR_PARTS" ]; do
		eval "set -- \$XR_P$i"	# num start size type section offset
		if [ $m = rw ]; then
			[ "$5" -ge 0 ] && x dmsetup create "xr-p$1" --table "0 $3 linear /dev/md1$5 $6"
		else
			x dmsetup create "xr-p$1" --readonly --table "0 $3 linear $XR_READ_DISK $2"
		fi || return 1
		i=$((i + 1))
	done
	if [ $m = rw ]; then
		x lvm vgchange -ay --config "$LVM_XR" "$XRAID_VG" || return 1
		x mount -t ext4 -o "$EXT4_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" || return 1
	else
		x lvm vgchange -ay --config "$LVM_XR_RO" "$XRAID_VG" || return 1
		# read-only device: a journal left to replay (RAIDiator cut off)
		# cannot be replayed, the volume is then read without it (noload)
		x mount -t ext4 -o "ro,$EXT4_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" ||
			x mount -t ext4 -o "ro,noload,$EXT4_OPTS" "/dev/mapper/$XRAID_VG-$XRAID_LV" "$MOUNTPOINT" || return 1
	fi
}

disassemble_xraid() {
	mounted "$DATA" && x_ umount "$DATA"
	x_ lvm vgchange -an --config "$LVM_XR" "$XRAID_VG"
	i=0
	while [ $i -lt "$XR_NR_PARTS" ]; do
		eval "set -- \$XR_P$i"; x_ dmsetup remove "xr-p$1"; i=$((i + 1))
	done
	[ "$CURRENT_MODE" = xraid-rw ] || return 0
	# state of the md before stopping them: "UU" each, nothing resyncing
	md_health
	i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		x_ mdadm --stop "/dev/md1$i"
		x_ dmsetup remove "xr-a-s$i"; x_ dmsetup remove "xr-b-s$i"
		i=$((i + 1))
	done
	sb_after_rw
}

# md_one mdN: ok | busy (missing, resync/repair running) | base_failed (first
# leg) | mirror_failed (second leg) | both_failed
md_one() {
	map=$(awk -v n="$1" '$1 == n { f = 1; next } f && /blocks/ { print $NF; exit }' "$R/proc/mdstat" 2>/dev/null)
	case "$map" in
	"[UU]") read -r act 2>/dev/null < "$R/sys/block/$1/md/sync_action" || act=unknown
		if [ "$act" = idle ]; then echo ok; else echo busy; fi ;;
	"[U_]") echo mirror_failed ;;
	"[_U]") echo base_failed ;;
	"[__]") echo both_failed ;;
	*) echo busy ;;
	esac
}

# md_health: HEALTH = the worst md_one of the X-RAID sections
md_health() {
	HEALTH=ok; i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		h=$(md_one "md1$i")
		case $h in
		ok) ;;
		busy) [ $HEALTH = ok ] && HEALTH=busy ;;
		*) case $HEALTH in ok|busy|"$h") HEALTH=$h ;; *) HEALTH=both_failed ;; esac ;;
		esac
		i=$((i + 1))
	done
}

# After a read-write assembly (md stopped, everything flushed): the superblock
# goes back to "clean" only if both legs stayed healthy and nothing was left
# resyncing; a failed leg is recorded on the surviving disk as RAIDiator would.
# Otherwise it stays "dirty": RAIDiator would copy base -> mirror at its next
# start, and Linux stays read-only until a successful nas-raid verify.
sb_after_rw() {
	case "$HEALTH" in
	ok) if [ -z "$NOCLEAN" ] && x xraid-sb clean "$XR_BASE" "$XR_MIRROR"; then
		[ -n "$DRY_RUN" ] || rm -f "$DIRTY"
	    else log "X-RAID superblock left dirty: rw refused at next mount"; fi ;;
	mirror_failed) log "X-RAID: mirror leg failed, recorded on the base"; x_ xraid-sb fail "$XR_BASE" ;;
	base_failed) log "X-RAID: base leg failed, recorded on the mirror"; x_ xraid-sb fail "$XR_MIRROR" ;;
	*) log "X-RAID md $HEALTH at shutdown: superblock left dirty, rw refused at next mount" ;;
	esac
	return 0
}

# before the first write: superblock "dirty" (as RAIDiator while it runs)
sb_dirty() {
	command -v xraid-sb >/dev/null 2>&1 || { log "xraid-sb missing"; return 1; }
	x xraid-sb dirty "$XR_BASE" "$XR_MIRROR"
}

# ---------- RAIDiator md volumes (X-RAID off, "Flex-RAID") ----------
# RAIDiator stores its md 0.90 superblocks in a mixed byte order (docs/XRAID.md
# §10, docs/XRAID-FORMAT.md §6): the big-endian kernel does not take them, and
# rewriting them would make them unreadable for RAIDiator, so md assembles
# nothing. xraid-info flexraid reads them and gives a dm table per usable array
# (fr-md<minor>); LVM is activated on top, VG c is mounted on /c and any other
# one-letter VG x on /x (RAIDiator: one VG and LV per volume).
# Read-only by default. With FLEXRAID_RW=yes, a volume is writable only if its
# VG lies on arrays that are complete and up to date (no reason at all), hold
# LVM2 and carry no snapshot. Nothing is written outside the file system (no md
# superblock, LVM metadata read-only): RAIDiator finds its arrays as they were.
# A RAID 5 is dm-raid without metadata over legs (FR_A<a>_LEGS from
# xraid-info), removed after it at the unmount; read-only (legs too) unless
# writable as above. Written, it has the same crash mark as a RAID 1: while it
# is there, the next read-write mount asks for sync and md recomputes the parity
# of the whole array (a cut mid-stripe leaves a parity that no longer matches:
# the write hole); its health comes from dm-raid's status (dmsetup status).
# A RAID 0 has nothing to keep in sync. A RAID 1 is a mirror without metadata
# ("mdadm --build", role 0 first) of its members' data areas (legs frl-md<m>-0,
# -1..., outside the LVM filter), fr-md<m> on top. RAIDiator never marks a
# mirror in use (docs/XRAID-FORMAT.md §6), so the crash safeguard is ours: the
# mark flexraid-dirty-md<m> is set before the first write and removed after a
# clean stop with every leg healthy; while it is there, the next assembly
# resynchronises the other roles from role 0 (no --assume-clean). A leg that
# fails is recorded on the survivors (flexraid-sb fail, as RAIDiator writes it).
LVM_FR="devices { filter = [ \"a|^/dev/mapper/fr-md|\", \"r|.*|\" ] use_devicesfile = 0 } global { metadata_read_only = 1 }"
FR_STATE=$RUN/flexraid.state	# what flexraid_unmount undoes

# fr_mirror MINOR SECTORS MEMBER0 MEMBER1...: the read-write RAID 1 /dev/md(100+MINOR)
fr_mirror() {
	m=$1; n=$2; md=/dev/md$((100 + $1)); shift 2
	[ $# -ge 2 ] || return 1
	command -v flexraid-sb >/dev/null 2>&1 || { why="${why:+$why }no_sb_writer"; return 1; }
	# a failure would have to be recordable on any member
	for s in "$@"; do x flexraid-sb --dry-run fail "$s" >/dev/null 2>&1 || { why="${why:+$why }sb_not_writable"; return 1; }; done
	mk=$STATE/flexraid-dirty-md$m; clean=--assume-clean
	if grep -q '^failed' "$mk" 2>/dev/null; then	# never resync over the newer leg
		log "Flex-RAID md$m: a failed member could not be recorded on the disks ($(cat "$mk")): read-only; delete $mk once the disks are checked"
		why="${why:+$why }failure_unrecorded"; return 1
	fi
	if [ -e "$mk" ]; then
		clean=; log "Flex-RAID md$m: Linux stopped without a clean unmount, the other roles resynchronised from role 0"
	fi
	k=0; legs=
	for s in "$@"; do
		p=${s%%:*}; st=${s#*:}; st=${st%%:*}
		x dmsetup create "frl-md$m-$k" --table "0 $n linear $p $st" || { fr_mirror_undo "$m" $#; return 1; }
		legs="$legs /dev/mapper/frl-md$m-$k"; k=$((k + 1))
	done
	x mdadm --build "$md" --level=1 --raid-devices=$# $clean $legs || { fr_mirror_undo "$m" $#; return 1; }
	if ! write "$mk" "$(date +%s)"; then
		fr_mirror_undo "$m" $#; why="${why:+$why }mark_write_failed"; return 1
	fi
	[ -n "$DRY_RUN" ] || sync
	FR_R1="$FR_R1${FR_R1:+ }$m=$(echo "$@" | tr ' ' ,)"
}
# fr_raid5 MINOR MEMBER0 MEMBER1...: RAID 5 read-write; sets r5 (MINOR=MEMBERS)
# and turns nosync into sync in t after a crash. A failure must be recordable on the
# survivors of any member (flexraid-sb --dry-run, every member but one).
fr_raid5() {
	m=$1; shift
	command -v flexraid-sb >/dev/null 2>&1 || { why="${why:+$why }no_sb_writer"; return 1; }
	for o in "$@"; do
		sv=; for s in "$@"; do [ "$s" = "$o" ] || sv="$sv $s"; done
		x flexraid-sb --dry-run fail $sv >/dev/null 2>&1 || { why="${why:+$why }sb_not_writable"; return 1; }
	done
	mk=$STATE/flexraid-dirty-md$m
	if grep -q '^failed' "$mk" 2>/dev/null; then
		log "Flex-RAID md$m: a failed member could not be recorded on the disks ($(cat "$mk")): read-only; delete $mk once the disks are checked"
		why="${why:+$why }failure_unrecorded"; return 1
	fi
	if [ -e "$mk" ]; then
		t=$(echo "$t" | sed 's/ nosync / sync /')	# dm-raid without metadata resyncs only when told (seen on the NAS)
		log "Flex-RAID md$m: Linux stopped without a clean unmount, the parity of the whole array recomputed"
	fi
	write "$mk" "$(date +%s)" || { why="${why:+$why }mark_write_failed"; return 1; }
	[ -n "$DRY_RUN" ] || sync
	r5="$m=$(echo "$@" | tr ' ' ,)"
}
# fr_health5 MINOR: fr_health's answers for the dm-raid fr-md<MINOR>, from its
# status "0 LEN raid TYPE N HEALTH RATIO ACTION ...": HEALTH one letter per
# role (A in sync, a not yet, D dead)
fr_health5() {
	set -- $(dmsetup status "fr-md$1" 2>/dev/null)
	[ "$3" = raid ] || { echo busy; return; }
	case $6 in
	*D*) echo "failed $(echo "$6" | awk '{ for (i = 1; i <= length($0); i++) if (substr($0, i, 1) == "D") o = o (o == "" ? "" : ",") (i - 1); print o }')" ;;
	*a*) echo busy ;;
	*) if [ "$8" = idle ]; then echo ok; else echo busy; fi ;;
	esac
}
fr_mirror_undo() {	# fr_mirror_undo MINOR LEGS; 1 = the md could not be stopped
	if grep -q "^md$((100 + $1)) :" "$R/proc/mdstat" 2>/dev/null; then x mdadm --stop "/dev/md$((100 + $1))" || return 1; fi
	k=0; while [ $k -lt "$2" ]; do dmsetup info "frl-md$1-$k" >/dev/null 2>&1 && x_ dmsetup remove "frl-md$1-$k"; k=$((k + 1)); done
	return 0
}

flexraid_mount() {	# 1 = no RAIDiator md array at all
	FR_NR_ARRAYS=0
	set -- $(disks); [ $# -gt 0 ] || return 1
	output=$(xraid-info flexraid "$@") || { log "xraid-info flexraid failed"; return 1; }
	eval "$output"
	[ "$FR_NR_ARRAYS" -gt 0 ] || return 1
	dms=; why=; rwmd=; FR_R1=; FR_R5=; r5=; frlegs=; i=0
	while [ $i -lt "$FR_NR_ARRAYS" ]; do
		eval "set -- \$FR_A$i; t=\$FR_A${i}_TABLE; r=\$FR_A${i}_REASONS; c=\$FR_A${i}_CONTENT; mem=\$FR_A${i}_MEMBERS; l5=\$FR_A${i}_LEGS"	# minor level usable sectors
		for w in $r; do case " $why " in *" $w "*) ;; *) why="$why${why:+ }$w";; esac; done
		ro=--readonly
		if [ "$FLEXRAID_RW" = yes ] && [ "$3" = 1 ] && [ -z "$r" ] && [ "$c" = lvm2 ]; then
			case $2 in
			raid0) ro=; rwmd="$rwmd fr-md$1" ;;
			raid1) if fr_mirror "$1" "$4" $mem; then
					t="0 $4 linear /dev/md$((100 + $1)) 0"; ro=; rwmd="$rwmd fr-md$1"
				fi ;;
			raid5) rw0=$rwmd; if fr_raid5 "$1" $mem; then ro=; rwmd="$rwmd fr-md$1"; fi ;;
			esac
		fi
		if [ "$3" = 1 ] && [ -n "$l5" ]; then	# RAID 5: legs under dm-raid (role:path:start:sectors)
			for g in $l5; do
				k=${g%%:*}; g=${g#*:}; p=${g%%:*}; g=${g#*:}
				x dmsetup create "frl-md$1-$k" $ro --table "0 ${g#*:} linear $p ${g%%:*}" && frlegs="$frlegs${frlegs:+ }frl-md$1-$k"
			done
		fi
		if [ "$3" = 1 ] && x dmsetup create "fr-md$1" $ro --table "$t"; then
			dms="$dms${dms:+ }fr-md$1"
			[ -n "$r5" ] && FR_R5="$FR_R5${FR_R5:+ }$r5"
		elif [ -n "$r5" ]; then	# a written RAID 5 never mapped: nothing written
			[ -n "$DRY_RUN" ] || rm -f "$STATE/flexraid-dirty-md$1"
			rwmd=$rw0
		fi
		r5=
		i=$((i + 1))
	done
	log "Flex-RAID: arrays mapped: ${dms:-none}${rwmd:+ (writable:$rwmd)}${why:+ ($why)}"
	# volumes: "VG LV attributes" (a query, nothing activated yet), PVs of each VG
	lvs=$(lvm lvs --noheadings -o vg_name,lv_name,lv_attr --config "$LVM_FR" 2>/dev/null)
	pvs=$(lvm pvs --noheadings -o pv_name,vg_name --config "$LVM_FR" 2>/dev/null)
	vgs=; rovgs=; rwvgs=; l=
	for v in $(printf '%s\n' "$lvs" | awk 'NF >= 2 { print $1 }' | sort -u); do
		case "$v" in *[!A-Za-z0-9_.+-]*) continue;; esac
		vgs="$vgs${vgs:+ }$v"
		# writable only with at least one PV, and every PV on a writable array
		w=; n=0
		for pv in $(printf '%s\n' "$pvs" | awk -v v="$v" '$2 == v { print $1 }'); do
			case " $rwmd " in *" ${pv##*/} "*) n=$((n + 1)) ;; *) n=-1000 ;; esac
		done
		[ "$n" -gt 0 ] && w=1
		# a snapshot (lv_attr s) or an origin (o) in the VG: read-only
		if printf '%s\n' "$lvs" | awk -v v="$v" '$1 == v && $3 ~ /^[so]/ { f = 1 } END { exit !f }'; then
			[ -n "$w" ] && why="${why:+$why }snapshot"; w=
		fi
		if [ -n "$w" ]; then rwvgs="$rwvgs${rwvgs:+ }$v"; else rovgs="$rovgs${rovgs:+ }$v"; l="$l${l:+, }\"$v\""; fi
	done
	if [ -n "$vgs" ]; then
		x lvm vgchange -ay --config "$LVM_FR activation { read_only_volume_list = [ $l ] }" $vgs || vgs=
	fi
	mnts=; rwm=
	set -f; set -- $lvs; set +f
	while [ $# -ge 3 ]; do
		v=$1; lv=$2; shift 3
		if [ -n "$FR_VG_PATTERN" ]; then		# tests: their own names, under FR_MNT
			case "$v" in $FR_VG_PATTERN) ;; *) continue;; esac
			m=$FR_MNT/$v
		else
			case "$v" in [c-z]) ;; *) continue;; esac	# RAIDiator volume letters; never /usr...
			m=$FR_MNT/$v; [ "$v" = c ] && m=$FR_MNT$DATA
		fi
		[ "$lv" = "$v" ] || continue			# snapshots and other LVs: not mounted
		case " $vgs " in *" $v "*) ;; *) continue;; esac
		[ -n "$DRY_RUN" ] || mkdir -p "$m" 2>/dev/null
		case " $rwvgs " in
		*" $v "*)	# writable: a journal left by RAIDiator is replayed; errors make it read-only
			if x mount -t ext4 -o "errors=remount-ro,$EXT4_OPTS" "/dev/mapper/$v-$lv" "$m"; then
				mnts="$mnts${mnts:+ }$m"; rwm="$rwm${rwm:+ }$m"; continue
			fi
			log "Flex-RAID: $m not mountable read-write, trying read-only" ;;
		esac
		# a journal left to replay (RAIDiator cut off) cannot be replayed read-only: noload
		if x mount -t ext4 -o "ro,$EXT4_OPTS" "/dev/mapper/$v-$lv" "$m" ||
		   x mount -t ext4 -o "ro,noload,$EXT4_OPTS" "/dev/mapper/$v-$lv" "$m"; then
			mnts="$mnts${mnts:+ }$m"
		fi
	done
	write "$FR_STATE" "FR_DMS='$dms' FR_VGS='$vgs' FR_MNTS='$mnts' FR_RW='$rwm' FR_R1='$FR_R1' FR_R5='$FR_R5' FR_LEGS='$frlegs'"
	fr_sync_note
	if [ -n "$mnts" ]; then
		log "Flex-RAID: mounted: $mnts${rwm:+ (read-write: $rwm)}"
		if [ -n "$rwm" ]; then write "$RUN/nas-raid.mode" "flexraid-rw $why"
		else write "$RUN/nas-raid.mode" "flexraid-ro $why"; fi
	else
		log "Flex-RAID: no volume could be mounted, everything undone"
		flexraid_unmount
		write "$RUN/nas-raid.mode" "none flexraid_failed $why"
	fi
	return 0
}

flexraid_unmount() {
	FR_DMS=; FR_VGS=; FR_MNTS=; FR_RW=; FR_R1=; FR_R5=; FR_LEGS=
	[ -r "$FR_STATE" ] && . "$FR_STATE"
	[ -n "$FR_RW" ] && [ -z "$DRY_RUN" ] && sync
	stopped=1
	for m in $FR_MNTS; do mounted "$m" && { x umount "$m" || { log "(failure ignored: umount $m)"; stopped=; }; }; done
	[ -n "$FR_VGS" ] && x_ lvm vgchange -an --config "$LVM_FR" $FR_VGS
	# written RAID 5: health read while dm-raid runs; one not removed is still in use
	h5=; b5=
	for e in $FR_R5; do h5="$h5 ${e%%=*}=$(fr_health5 "${e%%=*}" | tr ' ' :)"; done
	for d in $FR_DMS; do
		case " $FR_R5" in
		*" ${d#fr-md}="*) x dmsetup remove "$d" || { log "(failure: dmsetup remove $d)"; b5="$b5 ${d#fr-md}"; } ;;
		*) x_ dmsetup remove "$d" ;;
		esac
	done
	for d in $FR_LEGS; do x_ dmsetup remove "$d"; done	# RAID 5 legs after the arrays on them
	for e in $FR_R5; do
		m=${e%%=*}; h=busy
		for v in $h5; do [ "${v%%=*}" = "$m" ] && h=$(echo "${v#*=}" | tr : ' '); done
		case " $b5 " in *" $m "*) [ "$h" = ok ] && h=busy ;; esac
		[ -n "$stopped" ] || [ "$h" != ok ] || h=busy	# still in use: the mark stays
		fr_sb_after "$m" "$h" "${e#*=}"
	done
	# read-write mirrors: health read before the stop, then the crash mark
	# removed (every leg healthy) or the failed legs recorded on the survivors
	for e in $FR_R1; do
		m=${e%%=*}; mem=${e#*=}
		h=$(fr_health "md$((100 + m))")
		fr_mirror_undo "$m" $(echo "$mem" | tr , " " | wc -w) || stopped=
		[ -n "$stopped" ] || [ "$h" != ok ] || h=busy	# still in use: the mark stays
		fr_sb_after "$m" "$h" "$mem"
	done
	[ -n "$DRY_RUN" ] || rm -f "$FR_STATE" "$FR_SYNC"
}

# fr_health mdN: ok | busy (missing, resync running) | failed ROLES (the
# failed legs, comma-separated, role order as built) | all_failed
fr_health() {
	map=$(awk -v n="$1" '$1 == n { f = 1; next } f && /blocks/ { print $NF; exit }' "$R/proc/mdstat" 2>/dev/null)
	case "$map" in
	\[*U*_*\]|\[*_*U*\]) echo "failed $(echo "$map" | awk '{ for (i = 2; i < length($0); i++) if (substr($0, i, 1) == "_") o = o (o == "" ? "" : ",") (i - 2); print o }')" ;;
	\[_*\]) echo all_failed ;;
	\[U*\]) read -r act 2>/dev/null < "$R/sys/block/$1/md/sync_action" || act=unknown
		if [ "$act" = idle ]; then echo ok; else echo busy; fi ;;
	*) echo busy ;;
	esac
}

# fr_sb_after MINOR HEALTH MEMBER0,MEMBER1[,...]. The failed roles go in the
# mark first: if flexraid-sb cannot record them, the mark keeps them (read-only
# from then on, never a resync over the newer legs); recorded, the mark goes
# (the failed members are stale on the disks, until RAIDiator rebuilds them).
fr_sb_after() {
	mk=$STATE/flexraid-dirty-md$1
	case $2 in
	ok) [ -n "$DRY_RUN" ] || rm -f "$mk" ;;
	failed\ *)
		f=${2#failed }; sv=; sr=; k=0
		for p in $(echo "$3" | tr , ' '); do
			case ",$f," in *",$k,"*) ;; *) sv="$sv $p"; sr="$sr${sr:+,}$k" ;; esac
			k=$((k + 1))
		done
		write "$mk" "failed role $f $(date +%s)"; [ -n "$DRY_RUN" ] || sync
		log "Flex-RAID md$1: role $f failed, recording it on role $sr"
		if x flexraid-sb fail $sv; then
			[ -n "$DRY_RUN" ] || rm -f "$mk"
		else
			log "Flex-RAID md$1: failure NOT recorded on the disks: read-only until $mk is deleted"
		fi ;;
	*) log "Flex-RAID md$1 $2 at stop: crash mark kept, resynchronised at the next read-write mount" ;;
	esac
}

current_mode() { read -r CURRENT_MODE _ 2>/dev/null < "$RUN/nas-raid.mode" || CURRENT_MODE=none; }

# Mount time: comparing SAMPLES blocks of the two disks takes ~35 s on the NAS
# (cold). It only matters for WRITING (read-only reads the base disk alone and
# cannot harm anything): first a fast analysis without samples; the comparison
# runs only if rw is still possible (all other safeguards passed, XRAID_RW=yes).
do_mount() {
	[ -n "$DRY_RUN" ] || rm -f "$QUICK_OK"
	SMP=0; analyse
	write "$RUN/xraid.json" "$(xraid-info --json $(disks) 2>/dev/null || echo null)"
	# cached for status --json (no disk access there), X-RAID or not
	write "$RUN/flexraid.json" "$(xraid-info flexraid --json $(disks) 2>/dev/null || echo null)"
	# md 0.90 arrays in the partitions = RAIDiator with X-RAID off: read-only.
	# Checked BEFORE X-RAID: RAIDiator's md install erases only the start of the
	# disks, so an X-RAID superblock of an earlier install can stay at the end;
	# X-RAID disks never hold md 0.90 superblocks in their partitions.
	if flexraid_mount; then
		[ "$XR_MODE" = none ] || log "Flex-RAID: X-RAID superblock of an earlier install ignored"
		return 0
	fi
	decide
	if [ "$MODE" = rw ] && [ "$XRAID_RW" != yes ]; then
		MODE=ro; WHY="${WHY:+$WHY }rw_disabled"
	fi
	if [ "$MODE" = rw ] && ! command -v xraid-sb >/dev/null 2>&1; then
		MODE=ro; WHY="${WHY:+$WHY }no_sb_writer"
	fi
	if [ "$MODE" = rw ] && [ "$SAMPLES" -gt 0 ] 2>/dev/null; then
		log "X-RAID: comparing $SAMPLES samples per section before allowing writes"
		SMP=$SAMPLES; analyse; decide	# a difference gives ro, reason mirror_differs
	fi
	# superblock "dirty" before the first write; if it cannot be written: ro
	if [ "$MODE" = rw ] && ! sb_dirty; then
		MODE=ro; WHY="${WHY:+$WHY }sb_write_failed"
	fi
	MOUNTPOINT=$DATA
	case "$MODE" in
	rw|ro)
		log "X-RAID: mounting $MODE${WHY:+ ($WHY)}"
		if assemble_xraid "$MODE"; then write "$RUN/nas-raid.mode" "xraid-$MODE $WHY"
		else
			log "X-RAID: $MODE assembly failed, everything undone"
			CURRENT_MODE=xraid-$MODE; NOCLEAN=1; disassemble_xraid	# superblock stays dirty
			write "$RUN/nas-raid.mode" "none assembly_failed $WHY"
		fi ;;
	*)	log "no usable X-RAID volume${WHY:+ ($WHY)}"
		write "$RUN/nas-raid.mode" "none $WHY" ;;
	esac
}
NOCLEAN=

do_unmount() {
	current_mode
	case "$CURRENT_MODE" in
	xraid-*) analyse; disassemble_xraid ;;
	flexraid-*|none) flexraid_unmount ;;	# none: a failed mount left nothing, or a leftover state
	esac
	write "$RUN/nas-raid.mode" "none stopped"
}

# X-RAID remount (DIET: "allow writing" switch). /c is unmounted first, on its
# own: if a file is still open there (umount refused), nothing is torn down and
# the volume stays mounted as it was. Then the usual mount, with all safeguards.
do_remount() {
	current_mode
	case "$CURRENT_MODE" in
	xraid-*) if mounted "$DATA"; then x umount "$DATA" || die "$DATA is busy (open files): not remounted"; fi ;;
	flexraid-*)	# every volume unmounted first: one busy, nothing torn down
		FR_MNTS=; [ -r "$FR_STATE" ] && . "$FR_STATE"
		for m in $FR_MNTS; do if mounted "$m"; then x umount "$m" || die "$m is busy (open files): not remounted"; fi; done ;;
	*) die "remount: only for an X-RAID or Flex-RAID volume (mode $CURRENT_MODE)" ;;
	esac
	do_unmount
	do_mount
}

# Read-write X-RAID with a failed leg (md degraded: I/O error, disk pulled):
# the failure is written at once on the surviving disk, as RAIDiator would,
# then /c is remounted (read-only, the safeguards see the failed disk).
# Run every 30 s by S35storage; cheap when nothing happened.
watch() {
	current_mode
	[ "$CURRENT_MODE" = flexraid-rw ] && { fr_watch; return 0; }
	[ "$CURRENT_MODE" = xraid-rw ] || return 0
	awk '/^md1[0-6] :/ { n = 1; next } n && /blocks/ { if ($NF ~ /_/) f = 1; n = 0 } END { exit !f }' "$R/proc/mdstat" 2>/dev/null || return 0
	lock
	analyse; md_health
	log "X-RAID: md degraded while writing ($HEALTH): going read-only"
	case "$HEALTH" in
	mirror_failed) x_ xraid-sb fail "$XR_BASE" ;;
	base_failed) x_ xraid-sb fail "$XR_MIRROR" ;;
	esac
	services stop
	if mounted "$DATA" && ! x umount "$DATA"; then
		log "$DATA is busy: stays mounted on the surviving disk until it can be unmounted"
	else
		do_unmount; do_mount
	fi
	services start
}

# Read-write Flex-RAID RAID 1 with a failed leg: recorded at once on the
# survivor (the legs end before the superblock: md never writes there), then
# every volume remounted (the failed member is now stale: read-only).
# fr_sync_note: the written RAID 5 as dm-raid sees them now, for the page and
# the API's protections (dm-raid arrays are not in /proc/mdstat): one line
# "MINOR HEALTH ACTION PERCENT" each in $FR_SYNC, at the mount and every watch
FR_SYNC=$RUN/flexraid.sync
fr_sync_note() {
	o=
	for e in $FR_R5; do
		set -- $(dmsetup status "fr-md${e%%=*}" 2>/dev/null)
		[ "$3" = raid ] || continue
		o="$o${o:+
}${e%%=*} $6 $8 $(echo "$7" | awk -F/ '{ print ($2 > 0 ? int($1 * 100 / $2) : 0) }')"
	done
	if [ -n "$o" ]; then write "$FR_SYNC" "$o"; else [ -n "$DRY_RUN" ] || rm -f "$FR_SYNC"; fi
}
fr_watch() {
	FR_R5=; [ -r "$FR_STATE" ] && . "$FR_STATE"
	fr_sync_note
	n=; for e in $FR_R5; do case $(fr_health5 "${e%%=*}") in failed*) n=1 ;; esac; done
	[ -n "$n" ] || awk '/^md1[0-9][0-9] :/ { n = 1; next } n && /blocks/ { if ($NF ~ /_/) f = 1; n = 0 } END { exit !f }' "$R/proc/mdstat" 2>/dev/null || return 0
	lock
	FR_R1=; FR_R5=; FR_MNTS=; [ -r "$FR_STATE" ] && . "$FR_STATE"
	for e in $FR_R1; do
		h=$(fr_health "md$((100 + ${e%%=*}))")
		case $h in ok|busy) continue ;; esac
		log "Flex-RAID: md$((100 + ${e%%=*})) degraded while writing ($h): going read-only"
		fr_sb_after "${e%%=*}" "$h" "${e#*=}"
	done
	for e in $FR_R5; do
		h=$(fr_health5 "${e%%=*}")
		case $h in failed*) ;; *) continue ;; esac
		log "Flex-RAID: md${e%%=*} (RAID 5) degraded while writing ($h): going read-only"
		fr_sb_after "${e%%=*}" "$h" "${e#*=}"
	done
	services stop
	for m in $FR_MNTS; do
		if mounted "$m" && ! x umount "$m"; then
			log "$m is busy: stays mounted on the surviving disk until it can be unmounted"
			services start; return 0
		fi
	done
	do_unmount; do_mount
	services start
}

# consistent mirror, nothing assembled for writing: the marks can go; the
# superblock is put back "clean" (xraid-sb refuses unless both disks are online
# and their superblocks agree)
mark_consistent() {
	rm -f "$DIRTY"; echo "$XR_ID $XR_CTIME" > "$VERIFIED"
	x_ xraid-sb clean "$XR_BASE" "$XR_MIRROR"
}

# ---------- full mirror verification (read-only) ----------
verify() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed ($XR_REASONS)"
	if [ -n "$DRY_RUN" ]; then x xraid-info verify "$XR_BASE" "$XR_MIRROR"; return 0; fi
	mkdir -p "$STATE"
	echo "running $(date +%s)" > "$STATE/verify.state"
	log "mirror verification: $XR_BASE / $XR_MIRROR"
	xraid-info verify "$XR_BASE" "$XR_MIRROR" > "$STATE/verify.res" 2> "$STATE/verify.progress"
	rc=$?
	case $rc in 0) r=ok;; 1) r=differences;; *) r=errors;; esac
	echo "$r $(date +%s)" > "$STATE/verify.state"
	log "verification: $r ($(grep -c '^# difference' "$STATE/verify.res") differing zones)"
	current_mode
	if [ $r = ok ] && [ "$CURRENT_MODE" != xraid-rw ]; then
		mark_consistent
		log "consistent mirror: writing allowed at next mount"
	fi
	return $rc
}

# ---------- quick check (read-only, docs/XRAID.md "Quick check") ----------
# xraid-info quick compares the ext3 journals and metadata, the LVM metadata,
# the EBRs and QUICK_SAMPLES random blocks per section. Decision when nothing
# differs and nothing is assembled for writing:
# - superblock clean (only the Linux xraid-dirty mark left): the mark goes;
# - superblock unclean (real crash): nothing is lifted; state "confirm" and a
#   token for this boot ($QUICK_OK, in /var/run): "quick-accept" can then do
#   what a successful full verify does, with an explicit confirmation.
QUICK_OK=$RUN/quick.ok
quick_verify() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed ($XR_REASONS)"
	if [ -n "$DRY_RUN" ]; then x xraid-info quick --json --samples "$QUICK_SAMPLES" "$XR_BASE" "$XR_MIRROR"; return 0; fi
	mkdir -p "$STATE" "$RUN"; rm -f "$QUICK_OK"
	echo "running $(date +%s)" > "$STATE/quick.state"
	log "quick mirror check: $XR_BASE / $XR_MIRROR ($QUICK_SAMPLES samples per section)"
	xraid-info quick --json --samples "$QUICK_SAMPLES" "$XR_BASE" "$XR_MIRROR" > "$STATE/quick.tmp" 2> "$STATE/quick.progress"
	rc=$?
	mv "$STATE/quick.tmp" "$STATE/quick.res"
	current_mode
	case $rc in
	0)	if [ "$CURRENT_MODE" = xraid-rw ]; then r=ok	# writes in progress: nothing lifted
		elif [ "$XR_CLEAN" = 1 ] && [ "${XR_REASONS#*sync_in_progress}" = "$XR_REASONS" ]; then
			r=ok
			[ -e "$DIRTY" ] && { rm -f "$DIRTY"; log "quick check: clean superblock, xraid-dirty mark removed: writing allowed at next mount"; }
		else
			r=confirm; echo "$XR_ID $XR_CTIME" > "$QUICK_OK"
			log "quick check: no difference, but the superblock records an unclean shutdown: nothing lifted (nas-raid quick-accept, or a full verify)"
		fi ;;
	1) r=differences ;;
	3) r=incomplete ;;
	*) r=errors ;;
	esac
	echo "$r $(date +%s)" > "$STATE/quick.state"
	log "quick check: $r ($(sed -n 's/.*"bytes":\([0-9]*\),"differences":\([0-9]*\),.*/\1 bytes compared, \2 differences/p' "$STATE/quick.res"))"
	return $rc
}

quick_accept() {
	analyse
	read -r st _ 2>/dev/null < "$STATE/quick.state" || st=none
	[ "$st" = confirm ] && [ -r "$QUICK_OK" ] || die "quick-accept: only after a quick check, during this boot, that found no difference on an unclean superblock (state: $st)"
	[ "$(cat "$QUICK_OK")" = "$XR_ID $XR_CTIME" ] || die "the superblock changed since the quick check: run it again"
	for r in $XR_REASONS; do
		case "$r" in unclean_shutdown|sync_in_progress) ;; *) die "quick-accept impossible: $r";; esac
	done
	current_mode
	[ "$CURRENT_MODE" != xraid-rw ] || die "quick-accept: the X-RAID is assembled for writing"
	confirm ACCEPT "The quick check compared only the journals, the metadata and samples: file data written at the time of the crash may still differ between the disks (residual risk). The superblock is put back clean as after a full check."
	[ -n "$DRY_RUN" ] && return 0
	mark_consistent; rm -f "$QUICK_OK"
	echo "accepted $(date +%s)" > "$STATE/quick.state"
	log "quick check accepted by the administrator (residual risk): writing allowed at next mount"
}

confirm() {	# $1 = expected phrase, $2 = what is going to happen
	[ -n "$DRY_RUN" ] && { echo "(dry run: confirmation \"$1\" not asked)"; return 0; }
	if [ "$CONFIRM" != "$1" ] || [ -z "$YES" ]; then
		echo "$2" >&2
		die "confirmation required: --confirm '$1' --yes"
	fi
}

services() {	# stop|start the shares around a change of /c
	if [ "$1" = stop ]; then l="S70ksmbd S60nfs"; else l="S60nfs S70ksmbd"; fi
	for s in $l; do [ -x "$R/etc/init.d/$s" ] && x_ "$R/etc/init.d/$s" "$1"; done
	return 0
}

repair() {
	analyse
	[ -n "$XR_BASE" ] && [ -n "$XR_MIRROR" ] || die "both X-RAID disks are needed"
	for r in $XR_REASONS; do
		case "$r" in unclean_shutdown|sync_in_progress|mirror_differs) ;; *) die "repair impossible: $r";; esac
	done
	confirm REPAIR "The content of the sections of $XR_BASE (base) is copied onto $XR_MIRROR where they differ."
	current_mode
	[ -n "$DRY_RUN" ] && CURRENT_MODE=xraid-ro
	services stop
	case "$CURRENT_MODE" in xraid-*) disassemble_xraid ;; esac
	sb_dirty || die "cannot mark the X-RAID superblock dirty"
	MOUNTPOINT=$DATA
	assemble_xraid rw || die "assembly"
	write "$RUN/nas-raid.mode" "xraid-rw repair"
	i=0
	while [ $i -lt "$XR_NR_SECTIONS" ]; do
		x sh -c "echo repair > /sys/block/md1$i/md/sync_action"; i=$((i + 1))
	done
	services start
	log "repair started (cat /proc/mdstat); then: nas-raid verify"
}

# md support is disabled for now (docs/XRAID-MIGRATION.md)
md_disabled() {
	die "md support is disabled for now: X-RAID only. ($CMD refused: the former migrate/create erased the end of the disks, \"WGam\" mark included, after which RAIDiator's linuxrc reinstalls the NAS; see docs/XRAID-MIGRATION.md)"
}

# ---------- status ----------
status() {
	if [ -n "$REFRESH" ] || [ ! -r "$RUN/xraid.json" ]; then
		xr=$(xraid-info --json $(disks) 2>/dev/null) || xr=null
		[ -z "$DRY_RUN" ] && [ -d "$RUN" ] && printf '%s\n' "$xr" > "$RUN/xraid.json"
	else xr=$(cat "$RUN/xraid.json"); fi
	if [ -n "$REFRESH" ] || [ ! -r "$RUN/flexraid.json" ]; then
		fr=$(xraid-info flexraid --json $(disks) 2>/dev/null) || fr=null
		[ -z "$DRY_RUN" ] && [ -d "$RUN" ] && printf '%s\n' "$fr" > "$RUN/flexraid.json"
	else fr=$(cat "$RUN/flexraid.json"); fi
	read -r m reasons 2>/dev/null < "$RUN/nas-raid.mode" || { m=unknown; reasons=; }
	read -r v vd 2>/dev/null < "$STATE/verify.state" || { v=never; vd=0; }
	prog=$(tail -n 1 "$STATE/verify.progress" 2>/dev/null | sed -n 's/progress \([0-9]*\)%/\1/p')
	zones=$(grep -c '^# difference' "$STATE/verify.res" 2>/dev/null); zones=${zones:-0}
	read -r q qd 2>/dev/null < "$STATE/quick.state" || { q=never; qd=0; }
	qprog=$(tail -n 1 "$STATE/quick.progress" 2>/dev/null | sed -n 's/progress \([0-9]*\)%/\1/p')
	qres=null; [ "$q" != running ] && [ -s "$STATE/quick.res" ] && qres=$(cat "$STATE/quick.res")
	[ "$q" = confirm ] && [ -e "$QUICK_OK" ] && qok=1 || qok=0
	[ -e "$DIRTY" ] && dirty=1 || dirty=0
	command -v xraid-sb >/dev/null 2>&1 && sbw=yes || sbw=no
	FR_DMS=; FR_MNTS=; FR_RW=; [ -r "$FR_STATE" ] && . "$FR_STATE"
	if [ -n "$JSON" ]; then
		case $XRAID_RW in yes) xrw=yes;; *) xrw=no;; esac
		printf '{"mode":"%s","reasons":"%s","xraid_rw":"%s","sb_writer":"%s","dirty":%d,"verify":{"state":"%s","date":%s,"progress":%s,"zones":%s},' \
			"$m" "$reasons" "$xrw" "$sbw" "$dirty" "$v" "${vd:-0}" "${prog:-null}" "$zones"
		printf '"quick":{"state":"%s","date":%s,"progress":%s,"accept":%d,"result":%s},' "$q" "${qd:-0}" "${qprog:-null}" "$qok" "$qres"
		case $FLEXRAID_RW in yes) frw=yes;; *) frw=no;; esac
		fs=$(awk 'NF == 4 { printf "%s{\"minor\":%d,\"health\":\"%s\",\"action\":\"%s\",\"percent\":%d}", n++ ? "," : "", $1, $2, $3, $4 }' "$FR_SYNC" 2>/dev/null)
		printf '"flexraid_rw":"%s","flexraid_mounts":"%s","flexraid_rw_mounts":"%s","flexraid_sync":[%s],"flexraid":%s,"xraid":%s}\n' "$frw" "$FR_MNTS" "$FR_RW" "$fs" "$fr" "$xr"
	else
		echo "mode: $m${reasons:+ ($reasons)}"
		echo "unfinished write mark: $dirty; superblock writer: $sbw"
		echo "verification: $v $( [ "$vd" != 0 ] && date -d "@$vd" '+%F %T' 2>/dev/null)${prog:+ ($prog %)} differing zones: $zones"
		echo "quick check: $q $( [ "$qd" != 0 ] && date -d "@$qd" '+%F %T' 2>/dev/null)${qprog:+ ($qprog %)}"
		SMP=0; analyse
		echo "X-RAID: $XR_MODE${XR_REASONS:+ ($XR_REASONS)} base=${XR_BASE:--} mirror=${XR_MIRROR:--} clean=${XR_CLEAN:-?}"
		if [ -r "$FR_STATE" ]; then echo "Flex-RAID: mounted ${FR_MNTS:-none}, read-write ${FR_RW:-none}, arrays ${FR_DMS:-none}"; fi
	fi
}

# one action at a time (except status)
lock() {
	[ -n "$DRY_RUN" ] && return 0
	mkdir -p "$RUN"
	exec 9> "$RUN/nas-raid.lock"
	flock -n 9 || die "another nas-raid action is in progress"
}

case "$CMD" in
status) legacy_state; status ;;
mount) lock; legacy_state; do_mount ;;
unmount) lock; legacy_state; do_unmount ;;
remount) lock; legacy_state; do_remount ;;
verify) lock; legacy_state; verify ;;
quick-verify) lock; legacy_state; quick_verify ;;
quick-accept) lock; legacy_state; quick_accept ;;
decide) legacy_state; analyse; decide; echo "$MODE${WHY:+ $WHY}" ;;
repair) lock; legacy_state; repair ;;
watch) watch ;;
migrate|create|add|grow) md_disabled ;;
*) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
