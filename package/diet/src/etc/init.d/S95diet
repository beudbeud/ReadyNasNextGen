#!/bin/sh
# DIET: power button (/sbin/hotplug helper), disk spin-down, LEDs, time
# sync (ntpd), monitoring (diet-hwmon) and the interface collector (the API in
# the background, ready answers in /var/run/diet). Fan control is S03fan, the
# shares S60nfs and S70ksmbd, the web interface S50lighttpd.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
[ -r /etc/diet-lang.sh ] && . /etc/diet-lang.sh || tx() { printf "%s" "$1"; }
LOG=/var/log/diet.log
PID=/var/run/diet-hwmon.pid
log() { echo "[$(date '+%F %T')] $*" >> $LOG; }
SPINDOWN_MIN=0; [ -r /etc/diet.conf ] && . /etc/diet.conf

hwmon_start() {
	start-stop-daemon -S -b -m -p $PID -x /usr/sbin/diet-hwmon
}
hwmon_stop() {
	start-stop-daemon -K -q -p $PID && rm -f $PID
}
# collector: /www/cgi-bin/api with DIET_COLLECT=1 (pid in /var/run/diet/pid)
collector_start() {
	DIET_COLLECT=1 start-stop-daemon -S -b -x /www/cgi-bin/api
}
collector_stop() {
	start-stop-daemon -K -q -p /var/run/diet/pid
}

start() {
	log "$(tx "==== DIET $(cat /etc/diet-version) starting ====" "==== DIET $(cat /etc/diet-version) démarre ====" "==== DIET $(cat /etc/diet-version) startet ====")"
	# button: padre_hwmon calls the uevent helper; the kernel boots with none
	# (empty CONFIG_UEVENT_HELPER_PATH: no shell per boot uevent), set it here
	echo /sbin/hotplug > /proc/sys/kernel/hotplug 2>/dev/null
	[ -e /proc/sys/dev/hwmon/POWER_SWITCH ] && echo 1 > /proc/sys/dev/hwmon/POWER_SWITCH
	if [ "$SPINDOWN_MIN" -gt 0 ]; then
		if [ $SPINDOWN_MIN -le 20 ]; then S=$((SPINDOWN_MIN * 12)); else S=$((240 + SPINDOWN_MIN / 30)); fi
		for b in /sys/block/sd*; do [ -d "$b" ] && hdparm -S $S /dev/${b##*/} >/dev/null 2>&1; done
		log "$(tx "Disk spin-down after $SPINDOWN_MIN min" "Veille des disques après $SPINDOWN_MIN min" "Platten-Standby nach $SPINDOWN_MIN min")"
	fi
	# LEDs: disk present = bay LED on; power LED steady
	for b in /sys/block/sd*; do
		n=$(readlink -f $b/device 2>/dev/null | sed -n 's#.*/ata\([0-9]*\)/.*#\1#p')
		[ -n "$n" ] && echo 1 > /proc/sys/dev/led/disk_${n}_fault 2>/dev/null
	done
	echo 1 > /proc/sys/dev/led/power 2>/dev/null
	# time: first sync, then ntpd keeps running in the background
	start-stop-daemon -S -b -x /usr/sbin/ntpd -- -p pool.ntp.org
	hwmon_start
	collector_start
	log "$(tx "ready" "prêt" "bereit")"
}

stop() {
	collector_stop
	hwmon_stop
	killall ntpd 2>/dev/null
	echo 2 > /proc/sys/dev/led/power 2>/dev/null	# blinks during shutdown
	[ -f /var/run/poweroff ] && M=poweroff || M=reboot
	log "$(tx "Shutting down ($M)" "Arrêt du système ($M)" "Herunterfahren ($M)")"
}

case "$1" in
	start) printf "Starting DIET: "; start; echo OK ;;
	stop) stop ;;
	restart) stop; start ;;
	restart-hwmon) hwmon_stop; hwmon_start ;;
	restart-collector) collector_stop; sleep 1; collector_start ;;
	*) echo "Usage: $0 {start|stop|restart|restart-hwmon|restart-collector}"; exit 1 ;;
esac
exit 0
