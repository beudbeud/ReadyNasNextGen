#!/bin/sh
# Users' WebDAV: second lighttpd instance as user nas (files never created as
# root), on 127.0.0.1:8081, behind the main lighttpd (https://<nas>/webdav/,
# mod_proxy). /etc/lighttpd/webdav.conf is generated by the DIET API; passwords
# in /etc/lighttpd/htpasswd-users. Not started if SVC_WEBDAV=0 in /etc/diet.conf.
PID=/var/run/lighttpd-webdav.pid
start() {
	grep -qs '^SVC_WEBDAV=0' /etc/diet.conf && { echo "webdav: disabled (/etc/diet.conf)"; return 0; }
	# WebDAV lock and property database, passwords readable by nas
	mkdir -p /var/lib/lighttpd-webdav && chown -R nas:nas /var/lib/lighttpd-webdav	# database also opened by lighttpd -tt (root)
	[ -e /etc/lighttpd/htpasswd-users ] || ( umask 077; : > /etc/lighttpd/htpasswd-users )
	chown root:nas /etc/lighttpd/htpasswd-users && chmod 640 /etc/lighttpd/htpasswd-users
	printf "Starting lighttpd (WebDAV): "
	umask 002	# files and folders writable by the group (personal group, users)
	start-stop-daemon -S -q -p $PID -x /usr/sbin/lighttpd -- -f /etc/lighttpd/webdav.conf && echo OK || echo FAIL
}
stop() {
	printf "Stopping lighttpd (WebDAV): "
	start-stop-daemon -K -q -p $PID && echo OK || echo FAIL
	rm -f $PID	# lighttpd (nas) cannot remove it itself
}
case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
