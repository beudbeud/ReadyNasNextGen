:root{--bg:#eef0ec;--panel:#fff;--ink:#1d2321;--mute:#68716d;--line:#d9ddd8;--accent:#2f6fd0;--bad:#d23c3c;--ok:#2f9e5b}
@media (prefers-color-scheme:dark){:root{--bg:#131615;--panel:#1c201f;--ink:#e4e8e5;--mute:#8e9893;--line:#2c3230;--accent:#6aa1ff}}
