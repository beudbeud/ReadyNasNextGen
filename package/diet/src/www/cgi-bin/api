first_setup() {
  qp l; [ -n "$QP" ] || case ${HTTP_ACCEPT_LANGUAGE:-} in fr*) L=fr;; de*) L=de;; esac
  if [ -e "$HTP" ]; then
    printf 'Status: 403 Forbidden\r\n'; hdr 'text/html; charset=utf-8'
    echo "<!doctype html><meta charset=utf-8><p>$(tx "This NAS is already set up." "Ce NAS est déjà configuré." "Dieses NAS ist schon eingerichtet.") <a href=\"/\">$(tx "Open the interface" "Ouvrir l’interface" "Oberfläche öffnen")</a></p>"
    exit 0
  fi
  case $REQUEST_METHOD in
    GET|HEAD) setup_page; exit 0 ;;
    POST) ;;
    *) fail "405 Method Not Allowed" "GET, POST" ;;
  esac
  [ "$HTTP_X_DIET" = "1" ] || fail "403 Forbidden" "$(tx "Action only through the web interface" "Action réservée à l’interface" "Aktion nur über die Oberfläche")"
  read_body
  set -f; BODY=$(echo "$BODY" | tr '&' ' ')
  field pw; pw=$FV; field host; host=$FV; field rootpw; rp=$FV; field key; k=$(printf '%s' "$FV" | tr -d '\r'); set +f
  # everything is checked before anything is written
  pw_ok "$pw"; [ -z "$host" ] || host_ok "$host"; ssh_check "$rp" "$k"
  pwhash "$pw"
  mkdir -p "$ETC/lighttpd"
  ( umask 077; echo "admin:$H" > "$HTP.$$" ) || fail "500 Internal Server Error" "$(tx "Cannot write" "Écriture impossible" "Schreiben nicht möglich")"
  if ! ln "$HTP.$$" "$HTP" 2>/dev/null; then
    rm -f "$HTP.$$"
    fail "409 Conflict" "$(tx "This NAS has just been set up from another browser" "Ce NAS vient d’être configuré depuis un autre navigateur" "Dieses NAS wurde gerade von einem anderen Browser eingerichtet")"
  fi
  rm -f "$HTP.$$"
  note "First setup: web administrator account created"
  [ -z "$host" ] || host_set "$host"
  ssh_apply "$rp" "$k"
  invalidate
  bg "sleep 2; $INITD/S50lighttpd restart"   # drops the redirection of / to this page
  ok "$(tx "Saved. The interface now asks for the administrator password (user admin)." "Enregistré. L’interface demande maintenant le mot de passe administrateur (utilisateur admin)." "Gespeichert. Die Oberfläche fragt jetzt nach dem Administratorpasswort (Benutzer admin).")${SMSG:+ ($SMSG)}"
}

notify_test() {
  out=$(diet-notify "$(tx "test message sent from the web interface" "message de test envoyé depuis l’interface web" "Testnachricht aus der Web-Oberfläche")" 2>&1); rc=$?
  [ $rc -eq 0 ] && { ok "$(tx "Notification sent" "Notification envoyée" "Nachricht gesendet")"; return; }
  [ $rc -eq 2 ] && fail "400 Bad Request" "$(tx "Telegram is not set up: save the token and chat ID first" "Telegram n’est pas configuré : enregistrer d’abord le jeton et l’identifiant" "Telegram ist nicht eingerichtet: zuerst Token und Chat-ID speichern")"
  fail "502 Bad Gateway" "$(tx "Sending failed" "Échec de l’envoi" "Senden fehlgeschlagen") : $(echo "$out" | tr -d '\r' | cut -c1-200)"
}

# --- Services: MiniDLNA, Avahi, rsync, WebDAV, NFS ------------------------------
# On/off in diet.conf (SVC_<NAME>=0|1, missing = on): S50avahi-daemon, S51webdav,
# S60minidlnad, S60nfs and S61rsyncd do not start a service set to 0.
DLNACONF=$ETC/minidlna.conf
AVSVC=$ETC/avahi/services
svc_on() { ! grep -qs "^SVC_$1=0" "$CONF"; }
# b command...: 1 if the command succeeds, otherwise 0, in $B (no subshell)
b() { if "$@"; then B=1; else B=0; fi; }

services_get() {
  # minidlna.conf, diet.conf and rsyncd.secrets read by the shell (last value wins)
  DBD=; PORT=; DNAME=; DIRS=
  [ -r "$DLNACONF" ] && while IFS= read -r l; do
    case $l in
      db_dir=*) DBD=${l#*=} ;; port=*) PORT=${l#*=} ;; friendly_name=*) DNAME=${l#*=} ;;
      media_dir=*) jstr "${l#*=}"; DIRS="$DIRS${DIRS:+,}\"$J\"" ;;
    esac
  done < "$DLNACONF"
  case "$PORT" in ''|*[!0-9]*) PORT=8200;; esac
  om=1; oa=1; or=1; ow=1; onf=1; osm=1; rc=0
  [ -r "$CONF" ] && while IFS= read -r l; do
    case $l in
      SVC_MINIDLNA=0*) om=0 ;; SVC_AVAHI=0*) oa=0 ;; SVC_RSYNC=0*) or=0 ;; SVC_WEBDAV=0*) ow=0 ;; SVC_NFS=0*) onf=0 ;; SVC_SMB=0*) osm=0 ;;
      RSYNC_C=*) case ${l#RSYNC_C=} in 1|1[!0-9]*) rc=1;; *) rc=0;; esac ;;
    esac
  done < "$CONF"
  pw=0; [ -r "$SECRETS" ] && while IFS= read -r l; do case $l in sauvegarde:*) pw=1; break;; esac; done < "$SECRETS"
  DB=null; f=$R${DBD:-/var/lib/minidlna}/files.db
  if [ -r "$f" ]; then set -- $(wc -c < "$f"); DB=${1:-0}; int0 DB; fi
  # no sqlite3 on the NAS: file counts read from the minidlnad status page
  FILES=null; b alive "$RUN/minidlna/minidlna.pid"; RUNDLNA=$B
  if [ "$RUNDLNA" = 1 ]; then
    W=$(wget -q -T 3 -O - "http://127.0.0.1:$PORT/status" 2>/dev/null)
    case $W in *"Audio files</td><td>"*"Video files</td><td>"*"Image files</td><td>"*)
      fa=${W#*Audio files</td><td>}; fa=${fa%%<*}; fv=${W#*Video files</td><td>}; fv=${fv%%<*}; fim=${W#*Image files</td><td>}; fim=${fim%%<*}
      case "$fa$fv$fim" in *[!0-9]*) ;; *) [ -n "$fa" ] && [ -n "$fv" ] && [ -n "$fim" ] && FILES="[$fa,$fv,$fim]";; esac ;;
    esac
  fi
  HN=; read -r HN 2>/dev/null < "$ETC/hostname"; jstr "$HN"; HN=$J; jstr "$DNAME"
  b alive "$RUN/avahi-daemon/pid"; ra=$B; b alive "$RUN/rsyncd.pid"; rr=$B; b alive "$RUN/lighttpd-webdav.pid"; rw=$B
  # NFS: running = nfsd threads in the kernel
  rn=0; read -r rn 2>/dev/null < "$R/proc/fs/nfsd/threads"; int0 rn; [ "$rn" -gt 0 ] && rn=1
  # SMB: running = ksmbd.mountd alive
  rs=0; for p in "$R"/proc/[0-9]*; do c=; read -r c 2>/dev/null < "$p/comm" && [ "$c" = ksmbd.mountd ] && { rs=1; break; }; done
  printf '{"host":"%s","minidlna":{"on":%d,"run":%d,"name":"%s","dirs":[%s],"db":%s,"files":%s},' \
    "$HN" "$om" "$RUNDLNA" "$J" "$DIRS" "$DB" "$FILES"
  printf '"avahi":{"on":%d,"run":%d},"rsync":{"on":%d,"run":%d,"c":%d,"pw":%d},"webdav":{"on":%d,"run":%d},"nfs":{"on":%d,"run":%d},"smb":{"on":%d,"run":%d}}\n' \
    "$oa" "$ra" "$or" "$rr" "$rc" "$pw" "$ow" "$rw" "$onf" "$rn" "$osm" "$rs"
}

svc_set() {
  s=""; on=""
  for kv in $(echo "$BODY" | tr '&' ' '); do case "${kv%%=*}" in s) s=${kv#*=};; on) on=${kv#*=};; esac; done
  case "$on" in 0|1) ;; *) fail "400 Bad Request" "$(tx "Invalid setting" "Réglage invalide" "Ungültige Einstellung")";; esac
  # diet.conf key, init script, Avahi announcement of the service
  case "$s" in
    minidlna) K=MINIDLNA; INIT=S60minidlnad; ANN="" ;;
    avahi)    K=AVAHI; INIT=S50avahi-daemon; ANN="" ;;
    rsync)    K=RSYNC; INIT=S61rsyncd; ANN=rsync ;;
    webdav)   K=WEBDAV; INIT=S51webdav; ANN=webdav ;;
    nfs)      K=NFS; INIT=S60nfs; ANN="" ;;
    smb)      K=SMB; INIT=S70ksmbd; ANN=smb ;;
    *) fail "400 Bad Request" "$(tx "unknown service" "service inconnu" "unbekannter Dienst")" ;;
  esac
  [ -f "$CONF" ] || : > "$CONF"
  setkey "$CONF" SVC_$K "$on"
  if [ "$on" = 1 ]; then "$INITD/$INIT" start </dev/null >/dev/null 2>&1
  else "$INITD/$INIT" stop </dev/null >/dev/null 2>&1; fi
  # the Avahi announcement (*.service) of a stopped service is set aside (*.service.off)
  if [ -n "$ANN" ]; then
    if [ "$on" = 1 ]; then [ -f "$AVSVC/$ANN.service.off" ] && mv "$AVSVC/$ANN.service.off" "$AVSVC/$ANN.service"
    else [ -f "$AVSVC/$ANN.service" ] && mv "$AVSVC/$ANN.service" "$AVSVC/$ANN.service.off"; fi
    "$INITD/S50avahi-daemon" reload </dev/null >/dev/null 2>&1
  fi
  [ "$on" = 1 ] && MSG="$(tx "$s enabled" "$s activé" "$s eingeschaltet")" || MSG="$(tx "$s stopped (also at the next boot)" "$s arrêté (aussi au prochain démarrage)" "$s gestoppt (auch beim nächsten Start)")"
  note "$MSG"; ok "$MSG"
}

# MiniDLNA: displayed name and folders (media_dir=[A|V|P,]/c/..., existing folders under /c)
dlna_set() {
  set -f
  name=""; dirs=""
  for kv in $(echo "$BODY" | tr '&' ' '); do
    case "${kv%%=*}" in name) name=$(urldec "${kv#*=}");; dirs) dirs=$(urldec "${kv#*=}" | tr -d '\r');; esac
  done
  case "$name" in ''|*[!A-Za-z0-9\ ._-]*) fail "400 Bad Request" "$(tx "Invalid name: letters, digits, space, . - and _" "Nom invalide : lettres, chiffres, espace, . - et _" "Ungültiger Name: Buchstaben, Ziffern, Leerzeichen, . - und _")";; esac
  [ ${#name} -le 40 ] || fail "400 Bad Request" "$(tx "Name too long (40 characters max.)" "Nom trop long (40 caractères au plus)" "Name zu lang (höchstens 40 Zeichen)")"
  RC=$(readlink -f "$R$DATA"); LINES=""; n=0
  BAD="$(tx "Invalid folder: [A|V|P,]/c/name, letters, digits, space, - and _" "Dossier invalide : [A|V|P,]/c/nom, lettres, chiffres, espace, - et _" "Ungültiger Ordner: [A|V|P,]/c/name, Buchstaben, Ziffern, Leerzeichen, - und _")"
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    case "$l" in
      [AVP],/*|[AVP][AVP],/*|[AVP][AVP][AVP],/*) typ=${l%%,*},; p=${l#*,} ;;
      /*) typ=""; p=$l ;;
      *) fail "400 Bad Request" "$BAD" ;;
    esac
    case "$p" in /c|/c/*) ;; *) fail "400 Bad Request" "$BAD";; esac
    case "${p#/c}" in *[!A-Za-z0-9\ /_-]*|*//*|*/) fail "400 Bad Request" "$BAD";; esac
    [ -d "$R$p" ] || fail "404 Not Found" "$(tx "Folder $p not found" "Dossier $p introuvable" "Ordner $p nicht gefunden")"
    # no symbolic link leading out of /c
    case "$(readlink -f "$R$p")/" in "$RC"/*) ;; *) fail "400 Bad Request" "$BAD";; esac
    n=$((n + 1)); LINES="${LINES}media_dir=$typ$p
"
  done <<EOF
$dirs
EOF
  [ $n -ge 1 ] && [ $n -le 10 ] || fail "400 Bad Request" "$(tx "1 to 10 folders" "De 1 à 10 dossiers" "1 bis 10 Ordner")"
  [ -f "$DLNACONF" ] || fail "404 Not Found" "minidlna.conf ?"
  DIRS=$LINES NAME=$name awk '
    /^media_dir=/ { if (!d++) printf "%s", ENVIRON["DIRS"]; next }
    /^friendly_name=/ { if (!f++) print "friendly_name=" ENVIRON["NAME"]; next }
    { print }
    END { if (!d) printf "%s", ENVIRON["DIRS"]; if (!f) print "friendly_name=" ENVIRON["NAME"] }' "$DLNACONF" > "$DLNACONF.tmp" \
    || fail "500 Internal Server Error" "$(tx "Cannot write" "Écriture impossible" "Schreiben nicht möglich")"
  cp "$DLNACONF" "$DLNACONF.bak"; mv "$DLNACONF.tmp" "$DLNACONF"
  # minidlnad rereads its config at startup and rescans if it sees new folders
  svc_on MINIDLNA && "$INITD/S60minidlnad" restart </dev/null >/dev/null 2>&1
  note "MiniDLNA: name and folders changed"
  ok "$(tx "Saved" "Enregistré" "Gespeichert")"
}

# rsync: password of the administrator's "sauvegarde" account (module [c],
# all of /c as root, present only if RSYNC_C=1); /etc/rsyncd.secrets (600)
rsync_pw() {
  set -f; pw=""
  for kv in $(echo "$BODY" | tr '&' ' '); do [ "${kv%%=*}" = pw ] && pw=$(urldec "${kv#*=}"); done
  [ ${#pw} -ge 6 ] || fail "400 Bad Request" "$(tx "Password too short (6 characters min.)" "Mot de passe trop court (6 caractères au moins)" "Passwort zu kurz (mindestens 6 Zeichen)")"
  case "$pw" in *"$(printf '\r')"*) pw="";; esac
  [ -n "$pw" ] && [ ${#pw} -le 128 ] && [ "$(printf '%s' "$pw" | wc -l)" -eq 0 ] || fail "400 Bad Request" "$(tx "Invalid password" "Mot de passe invalide" "Ungültiges Passwort")"
  setline "$SECRETS" sauvegarde "$pw" 600 || fail "500 Internal Server Error" "$(tx "Cannot write" "Écriture impossible" "Schreiben nicht möglich")"
  note "rsync: password of the sauvegarde account changed"
  ok "$(tx "rsync password saved" "Mot de passe rsync enregistré" "rsync-Passwort gespeichert")"
}

# --- Storage: X-RAID, through nas-raid (xraid-compat package); md disabled for now ---
[ -n "$R" ] && export NAS_RAID_ROOT="$R"
storage_get() {
  command -v nas-raid >/dev/null 2>&1 || { echo '{"mode":"absent"}'; return; }
  J=$(nas-raid status --json 2>/dev/null) || { echo '{"mode":"error"}'; return; }
  case $J in '{"mode":"flexraid-ro"'*'}') L2=null;; '{'*'}') L2=$(printf '%s\n' "$J" | layout_json);; *) echo '{"mode":"error"}'; return;; esac
  [ -n "$L2" ] || L2=null	# never an empty value: it would break the whole answer
  printf '%s,"layout":%s}\n' "${J%\}}" "$L2"
}
# layout: the volume as the page draws it, whatever the number of bays
# (docs/API.md): {"level":"raid1","members":[{"bay":1,"dev":"sda","role":"base",
# "state":"online"}],"rebuild":null|percent}; null without an X-RAID superblock
# and in Flex-RAID mode (its arrays are in storage.flexraid).
# Read from the "xraid" object of nas-raid status (xraid-info, its last key):
# bay = channel + 1; states online, failed (faulty or unknown), rebuilding
# (spare, ready), missing (a channel below nr_disks without a disk). rebuild =
# percentage of an md resync/recovery in /proc/mdstat, otherwise null.
layout_json() {
  rb=null
  [ -r "$R/proc/mdstat" ] && while read -r l; do
    case $l in *resync*%*|*recovery*%*|*reshape*%*) set -f
      for w in $l; do case $w in [0-9]*%) rb=${w%%[.%]*}; break;; esac; done; set +f; break;; esac
  done < "$R/proc/mdstat"
  case $rb in ''|*[!0-9]*) rb=null;; esac
  awk -v rb="$rb" '
    function str(o, k) { return match(o, "\"" k "\":\"[^\"]*\"") ? substr(o, RSTART + length(k) + 4, RLENGTH - length(k) - 5) : "" }
    function num(o, k) { return match(o, "\"" k "\":-?[0-9]+") ? substr(o, RSTART + length(k) + 3, RLENGTH - length(k) - 3) + 0 : -1 }
    { s = s $0 }
    END {
      i = index(s, "\"xraid\":{"); if (!i) { print "null"; exit }
      s = substr(s, i + 8); lv = num(s, "raid")
      if (lv < 0) { print "null"; exit }
      nr = num(s, "nr_disks"); i = index(s, "\"disks\":[")
      d = i ? substr(s, i + 9) : ""; d = substr(d, 1, index(d, "]") - 1)
      n = split(d, a, "[}],[{]"); max = nr - 1	# bracketed: busybox awk reads a bare { as a repeat
      for (k = 1; k <= n; k++) {
        st = str(a[k], "state"); ch = num(a[k], "channel")
        if (st == "" || ch < 0 || (ch in M)) continue	# no X-RAID superblock: not a member
        p = str(a[k], "path"); sub(/.*\//, "", p)
        M[ch] = sprintf("{\"bay\":%d,\"dev\":\"%s\",\"role\":\"%s\",\"state\":\"%s\"}", ch + 1, p, str(a[k], "role"),
          st == "online" ? "online" : (st == "spare" || st == "ready") ? "rebuilding" : "failed")
        if (ch > max) max = ch
      }
      o = ""
      for (ch = 0; ch <= max; ch++)
        o = o (o == "" ? "" : ",") ((ch in M) ? M[ch] : sprintf("{\"bay\":%d,\"dev\":\"\",\"role\":\"\",\"state\":\"missing\"}", ch + 1))
      printf "{\"level\":\"raid%d\",\"members\":[%s],\"rebuild\":%s}\n", lv, o, rb
    }'
}

# --- Protections (docs/DIET.md "Protections"): what a restart, a power-off or a
# switch of system version would cut short. busyops sets BUSY to codes:
#   update  nas-update job running (state busy and its process alive, as nas-update status)
#   verify  full mirror check (nas-raid verify), quick  quick check (quick-verify);
#           a "running" state older than this boot is a leftover, ignored
#   sync    md resync/recovery/check/repair in /proc/mdstat (nas-raid repair)
# Shell builtins only: also called by status() for the page.
busyops() {
  BUSY=
  x=; read -r x _ 2>/dev/null < "$RUN/nas-update/state"
  [ "$x" = busy ] && alive "$RUN/nas-update/pid" && BUSY=update
  bt=; [ -r "$R/proc/stat" ] && while read -r k v _; do [ "$k" = btime ] && { bt=$v; break; }; done < "$R/proc/stat"
  for k in verify quick; do
    x=; d=; read -r x d 2>/dev/null < "$R/var/lib/nas-raid/$k.state"
    [ "$x" = running ] || continue
    case "$bt:$d" in *[!0-9:]*|:*|*:) ;; *) [ "$d" -lt "$bt" ] && continue;; esac
    BUSY="$BUSY${BUSY:+ }$k"
  done
  [ -r "$R/proc/mdstat" ] && while read -r l; do
    case $l in *resync*%*|*recovery*%*|*reshape*%*|*check*%*|*repair*%*) BUSY="$BUSY${BUSY:+ }sync"; break;; esac
  done < "$R/proc/mdstat"
  :
}
# guard: reboot, poweroff, update_switch refused (409) while busyops finds
# something, unless force=1&confirm=FORCE (docs/API.md)
guard() {
  busyops; [ -z "$BUSY" ] && return 0
  force=; confirm=
  for kv in $(echo "$BODY" | tr '&' ' '); do case "${kv%%=*}" in force) force=${kv#*=};; confirm) confirm=$(urldec "${kv#*=}");; esac; done
  if [ "$force" = 1 ] && [ "$confirm" = FORCE ]; then note "$A forced while running: $BUSY"; return 0; fi
  W=
  for b in $BUSY; do
    case $b in
      update) w=$(tx "a system update is being installed" "une mise à jour du système s’installe" "ein Systemupdate wird installiert");;
      verify) w=$(tx "a full mirror check is running" "une vérification complète du miroir est en cours" "eine vollständige Spiegelprüfung läuft");;
      quick) w=$(tx "a quick mirror check is running" "une vérification rapide du miroir est en cours" "eine Schnellprüfung des Spiegels läuft");;
      *) w=$(tx "a RAID resync or repair is running" "une resynchronisation ou réparation RAID est en cours" "eine RAID-Synchronisation oder -Reparatur läuft");;
    esac
    W="$W${W:+, }$w"
  done
  fail "409 Conflict" "$(tx "Refused: $W. Wait until it ends (or force it: force=1&confirm=FORCE)" "Refusé : $W. Attendre la fin (ou forcer : force=1&confirm=FORCE)" "Abgelehnt: $W. Das Ende abwarten (oder erzwingen: force=1&confirm=FORCE)")"
}

# xraid_rw: "allow writing on the X-RAID" switch. on=1 needs the typed word
# (confirm=WRITE) AND the ticked box (yes=1); on=0 needs nothing. XRAID_RW is
# written to /etc/nas-raid.conf (other keys kept, temporary file then mv), the
# services that use /c are stopped, "nas-raid remount" unmounts and mounts again
# (it refuses if a file is still open on /c: the old configuration is then put
# back), the services are started again. The safeguards of nas-raid decide: the
# mode obtained (rw or ro with its reasons) is in nas-raid.mode.
NRCONF=$ETC/nas-raid.conf
XRSVC="S51webdav S61rsyncd S60minidlnad S60nfs S70ksmbd"
# The same switch for RAIDiator's Flex-RAID volumes: FLEXRAID_RW (RAID 1 and 0,
# nas-raid decides which volume is writable, docs/XRAID.md §10).
xraid_rw() { storage_rw XRAID_RW xraid X-RAID; }
flexraid_rw() { storage_rw FLEXRAID_RW flexraid Flex-RAID; }
storage_rw() {	# storage_rw VARIABLE MODE_PREFIX NAME
  var=$1; kind=$2; name=$3
  set -f
  on=""; confirm=""; yes=""
  for kv in $(echo "$BODY" | tr '&' ' '); do
    k=${kv%%=*}; v=$(urldec "${kv#*=}")
    case "$k" in on) on=$v;; confirm) confirm=$v;; yes) yes=$v;; esac
  done
  case "$on" in 0) val=no;; 1) val=yes;; *) fail "400 Bad Request" "$(tx "Invalid setting" "Réglage invalide" "Ungültige Einstellung")";; esac
  if [ "$on" = 1 ]; then
    [ "$confirm" = WRITE ] || fail "400 Bad Request" "$(tx "confirmation word missing or wrong (WRITE)" "mot de confirmation manquant ou faux (WRITE)" "Bestätigungswort fehlt oder falsch (WRITE)")"
    [ "$yes" = 1 ] || fail "400 Bad Request" "$(tx "second confirmation missing" "seconde confirmation manquante" "zweite Bestätigung fehlt")"
  fi
  command -v nas-raid >/dev/null 2>&1 || fail "404 Not Found" "nas-raid ?"
  m=; read -r m _ 2>/dev/null < "$RUN/nas-raid.mode"
  case "$m" in "$kind"-rw|"$kind"-ro) ;; *) fail "409 Conflict" "$(tx "Only for an $name volume" "Seulement pour un volume $name" "Nur für ein $name-Volume")";; esac
  # new configuration: every line kept except the variable, written once
  {
    if [ -r "$NRCONF" ]; then while IFS= read -r l; do case $l in "$var"=*) ;; *) printf '%s\n' "$l";; esac; done < "$NRCONF"; fi
    echo "$var=$val"
  } > "$NRCONF.tmp" || fail "500 Internal Server Error" "$(tx "Cannot write" "Écriture impossible" "Schreiben nicht möglich")"
  [ -f "$NRCONF" ] && cp "$NRCONF" "$NRCONF.bak"
  mv "$NRCONF.tmp" "$NRCONF"
  note "Storage: $var=$val from the interface, remounting"
  for s in $XRSVC; do "$INITD/$s" stop </dev/null >/dev/null 2>&1; done
  if OUTR=$(nas-raid remount 2>&1); then rc=0; else rc=1; fi
  if [ $rc != 0 ]; then
    # refused (busy) or failed: old configuration back, volume mounted again if needed
    if [ -f "$NRCONF.bak" ]; then mv "$NRCONF.bak" "$NRCONF"; else rm -f "$NRCONF"; fi
    m=; read -r m _ 2>/dev/null < "$RUN/nas-raid.mode"
    case "$m" in xraid-*|flexraid-*) ;; *) nas-raid mount >/dev/null 2>&1;; esac
  fi
  for s in S70ksmbd S60nfs S60minidlnad S61rsyncd S51webdav; do "$INITD/$s" start </dev/null >/dev/null 2>&1; done
  invalidate
  if [ $rc != 0 ]; then
    note "Storage: remount refused or failed, $var unchanged"
    fail "409 Conflict" "$(tx "Volume not remounted (open files on /c?), setting unchanged" "Volume non remonté (fichiers ouverts sur /c ?), réglage inchangé" "Volume nicht neu eingehängt (offene Dateien auf /c?), Einstellung unverändert") : $(printf '%s' "$OUTR" | grep 'ERROR' | tail -n 1 | cut -c1-200)"
  fi
  m=; r=; read -r m r 2>/dev/null < "$RUN/nas-raid.mode"
  if [ "$on" = 0 ]; then ok "$(tx "$name remounted read-only" "$name remonté en lecture seule" "$name schreibgeschützt neu eingehängt")"
  elif [ "$m" = "$kind"-rw ]; then ok "$(tx "Writing on the $name enabled" "Écriture sur le $name activée" "Schreiben auf das $name eingeschaltet")"
  else ok "$(tx "$var=yes saved, but the safeguards keep it read-only" "$var=yes enregistré, mais les garde-fous gardent la lecture seule" "$var=yes gespeichert, aber die Schutzregeln lassen nur Lesen zu") ($m${r:+ : $r})"
  fi
}

# auto_rw: after a check or an acceptance lifted the last safeguard, /c is remounted
# read-write at once (when XRAID_RW=yes) instead of "at the next mount". Only when
# /c is read-only now and "nas-raid decide" says a mount would give rw; services
# that use /c stopped around the remount, as for xraid_rw.
auto_rw() {
  grep -qx 'XRAID_RW=yes' "$NRCONF" 2>/dev/null || return 1
  m=; read -r m _ 2>/dev/null < "$RUN/nas-raid.mode"; [ "$m" = xraid-ro ] || return 1
  case "$(nas-raid decide 2>/dev/null)" in rw|"rw "*) ;; *) return 1;; esac
  note "Storage: safeguards lifted, remounting /c read-write"
  for s in $XRSVC; do "$INITD/$s" stop </dev/null >/dev/null 2>&1; done
  nas-raid remount >/dev/null 2>&1
  m=; read -r m _ 2>/dev/null < "$RUN/nas-raid.mode"
  case "$m" in xraid-*|flexraid-*) ;; *) nas-raid mount >/dev/null 2>&1;; esac	# refused (busy): mounted again
  for s in S70ksmbd S60nfs S60minidlnad S61rsyncd S51webdav; do "$INITD/$s" start </dev/null >/dev/null 2>&1; done
  invalidate
  m=; read -r m _ 2>/dev/null < "$RUN/nas-raid.mode"; [ "$m" = xraid-rw ]
}

# --- Prometheus metrics (docs/DIET.md "Prometheus") ---------------------------------
# Text exposition format 0.0.4, written by the collector to $C/metrics.prom when
# METRICS is not 0 (Settings). Called right after status(), in the same shell: it
# reuses the values status() read (load, memory, fan, services, /c). Shell only,
# integer arithmetic (no awk, no printf %f): CPU seconds from jiffies (USER_HZ 100)
# printed as N.NN, kB and sectors converted to bytes.
mh() { printf '# HELP readynas_%s %s\n# TYPE readynas_%s %s\n' "$1" "$3" "$1" "$2"; }
# mf name type help lines: one family, only if it has samples
mf() { [ -n "$4" ] && { mh "$1" "$2" "$3"; printf '%s' "$4"; }; }
metrics() {
  mh info gauge "DIET version and NAS model (always 1)."
  printf 'readynas_info{version="%s",model="%s"} 1\n' "$VER" "$MODEL"
  mh time_seconds gauge "When the collector wrote these values (Unix time)."
  echo "readynas_time_seconds $now"
  mh uptime_seconds gauge "Time since boot."
  echo "readynas_uptime_seconds $up"
  mh load1 gauge "Load average over 1 minute."; echo "readynas_load1 ${L1:-0}"
  mh load5 gauge "Load average over 5 minutes."; echo "readynas_load5 ${L5:-0}"
  mh load15 gauge "Load average over 15 minutes."; echo "readynas_load15 ${L15:-0}"
  mh cpu_seconds_total counter "CPU time spent in each mode."
  while read -r k a1 a2 a3 a4 a5 a6 a7 _; do [ "$k" = cpu ] && break; done < "$R/proc/stat"
  int0 a1 a2 a3 a4 a5 a6 a7; set -- $a1 $a2 $a3 $a4 $a5 $a6 $a7
  for m in user nice system idle iowait irq softirq; do
    printf 'readynas_cpu_seconds_total{mode="%s"} %d.%d%d\n' "$m" $(($1 / 100)) $(($1 % 100 / 10)) $(($1 % 10)); shift
  done
  mh memory_total_bytes gauge "Total memory."; echo "readynas_memory_total_bytes $((mt * 1024))"
  mh memory_free_bytes gauge "Unused memory."; echo "readynas_memory_free_bytes $((mf * 1024))"
  mh memory_available_bytes gauge "Memory available without swapping (MemAvailable)."; echo "readynas_memory_available_bytes $((ma * 1024))"
  mh memory_buffers_bytes gauge "Block device buffers."; echo "readynas_memory_buffers_bytes $((mb * 1024))"
  mh memory_cached_bytes gauge "Page cache."; echo "readynas_memory_cached_bytes $((mc * 1024))"
  mh swap_used_bytes gauge "Swap in use."; echo "readynas_swap_used_bytes $(((swt - swf) * 1024))"
  # disks: temperature (drivetemp), I/O (/proc/diskstats), SMART if diet-hwmon read it
  T=; [ -n "$temp" ] && T="readynas_temperature_celsius{sensor=\"board\"} $temp$NL"
  IORB=; IOWB=; IORO=; IOWO=; SP=; SR=; SPE=; SU=; SH=; SY=; SC=
  while read -r _ _ dv rc _ rs _ wc _ ws _; do
    case $dv in sd[a-z]|sd[a-z][a-z]) ;; *) continue;; esac
    int0 rc rs wc ws; l="{device=\"$dv\"}"
    IORB="${IORB}readynas_disk_read_bytes_total$l $((rs * 512))$NL"; IOWB="${IOWB}readynas_disk_written_bytes_total$l $((ws * 512))$NL"
    IORO="${IORO}readynas_disk_reads_completed_total$l $rc$NL"; IOWO="${IOWO}readynas_disk_writes_completed_total$l $wc$NL"
  done < "$R/proc/diskstats"
  for d in $(disks); do
    l="{device=\"$d\"}"
    dtemp "$d"; [ -n "$DT" ] && T="${T}readynas_temperature_celsius{sensor=\"$d\"} $DT$NL"
    if [ -r "$RUN/smart.$d" ]; then
      health=""; realloc=0; pending=0; uncorr=0; hours=0; cycles=; celsius=; . "$RUN/smart.$d"; int0 realloc pending uncorr hours
      case $health in '') ;; PASSED) SP="${SP}readynas_disk_smart_passed$l 1$NL";; *) SP="${SP}readynas_disk_smart_passed$l 0$NL";; esac
      SR="${SR}readynas_disk_reallocated_sectors$l $realloc$NL"; SPE="${SPE}readynas_disk_pending_sectors$l $pending$NL"
      SU="${SU}readynas_disk_offline_uncorrectable_sectors$l $uncorr$NL"; SH="${SH}readynas_disk_power_on_seconds$l $((hours * 3600))$NL"
      case $cycles in ''|*[!0-9]*) ;; *) SY="${SY}readynas_disk_power_cycles$l $cycles$NL";; esac
      case $celsius in ''|*[!0-9]*) ;; *) SC="${SC}readynas_disk_smart_temperature_celsius$l $celsius$NL";; esac
    fi
  done
  mf temperature_celsius gauge "Temperature: board (fan controller) and disks (drivetemp)." "$T"
  mf disk_read_bytes_total counter "Bytes read from the disk." "$IORB"
  mf disk_written_bytes_total counter "Bytes written to the disk." "$IOWB"
  mf disk_reads_completed_total counter "Read operations completed." "$IORO"
  mf disk_writes_completed_total counter "Write operations completed." "$IOWO"
  mf disk_smart_passed gauge "SMART overall health self-assessment passed (1) or not (0)." "$SP"
  mf disk_reallocated_sectors gauge "SMART reallocated sectors (attribute 5)." "$SR"
  mf disk_pending_sectors gauge "SMART current pending sectors (attribute 197)." "$SPE"
  mf disk_offline_uncorrectable_sectors gauge "SMART offline uncorrectable sectors (attribute 198)." "$SU"
  mf disk_power_on_seconds gauge "SMART power-on time (attribute 9)." "$SH"
  mf disk_power_cycles gauge "SMART power cycle count (attribute 12)." "$SY"
  mf disk_smart_temperature_celsius gauge "SMART temperature (attribute 194, else 190)." "$SC"
  mf fan_pwm gauge "Fan setpoint (PWM, 0-255)." "${pwm:+readynas_fan_pwm $pwm$NL}"
  mf fan_speed_rpm gauge "Fan speed (revolutions per minute)." "${fan:+readynas_fan_speed_rpm $fan$NL}"
  # network eth0: bytes, packets, errors
  set --; while read -r l; do case $l in eth0:*) set -- ${l#eth0:}; break;; esac; done < "$R/proc/net/dev"
  if [ $# -ge 11 ]; then
    for kv in receive_bytes:1 receive_packets:2 receive_errors:3 transmit_bytes:9 transmit_packets:10 transmit_errors:11; do
      eval "nv=\${${kv#*:}}"; int0 nv; k=${kv%:*}
      mh "network_${k}_total" counter "eth0 ${k%_*} ${k#*_}."
      printf 'readynas_network_%s_total{device="eth0"} %s\n' "$k" "$nv"
    done
  fi
  # data volume /c (size and free space for the shares, from status)
  if [ "$cs" != 0 ]; then
    mh filesystem_size_bytes gauge "Size of the data volume."; echo "readynas_filesystem_size_bytes{mountpoint=\"$DATA\"} $((cs * 1024))"
    mh filesystem_free_bytes gauge "Free space of the data volume (available to the shares)."; echo "readynas_filesystem_free_bytes{mountpoint=\"$DATA\"} $((cf * 1024))"
  fi
  # services: the "svc" object of status, "name":0|1
  mh service_up gauge "Service running (1) or not (0)."
  s=$SVC,; while [ -n "${s#,}" ]; do kv=${s%%,*}; s=${s#*,}; k=${kv#\"}; printf 'readynas_service_up{service="%s"} %s\n' "${k%%\"*}" "${kv##*:}"; done
  # storage: nas-raid mode, X-RAID superblock (xraid.json written by nas-raid), checks
  m=; rs=; read -r m rs 2>/dev/null < "$RUN/nas-raid.mode"
  case $m in ''|*[!a-z0-9-]*) return 0;; esac
  case $rs in *[!a-z0-9_\ ]*) rs=;; esac
  mh storage_mode_info gauge "Storage mode of the data volume (nas-raid) and the reasons for read-only (always 1)."
  printf 'readynas_storage_mode_info{mode="%s",reasons="%s"} 1\n' "$m" "$rs"
  case $m in xraid-*) ;; *) return 0;; esac
  [ "$m" = xraid-rw ] && v=1 || v=0
  mh xraid_writable gauge "X-RAID mounted read-write (1) or read-only (0)."; echo "readynas_xraid_writable $v"
  XJ=; read -r XJ 2>/dev/null < "$RUN/xraid.json"
  case $XJ in '{'*'"clean":'*) 
    x=${XJ#*\"clean\":}; x=${x%%[!0-9]*}; int0 x
    mh xraid_superblock_clean gauge "X-RAID superblock marked clean (1) or dirty (0)."; echo "readynas_xraid_superblock_clean $x"
    x=${XJ#*\"failed_disks\":}; x=${x%%[!0-9]*}; int0 x
    mh xraid_disks_failed gauge "Failed disks counted by the X-RAID superblock."; echo "readynas_xraid_disks_failed $x"
    n=0; s=$XJ; while :; do case $s in *'"state":"online"'*) s=${s#*\"state\":\"online\"}; n=$((n + 1));; *) break;; esac; done
    mh xraid_disks_online gauge "X-RAID disks present and online."; echo "readynas_xraid_disks_online $n"
    n=0; y=0; s=$XJ; while :; do case $s in *'"init":'*) s=${s#*\"init\":}; n=$((n + 1)); case $s in 1[!0-9]*) y=$((y + 1));; esac;; *) break;; esac; done
    mh xraid_sections gauge "X-RAID sections."; echo "readynas_xraid_sections $n"
    mh xraid_sections_synced gauge "X-RAID sections whose mirror is synchronised (initialised)."; echo "readynas_xraid_sections_synced $y" ;;
  esac
  CT=; CR=
  for k in full:verify quick:quick; do
    x=; d=; read -r x d 2>/dev/null < "$R/var/lib/nas-raid/${k#*:}.state" || continue
    case $x in ''|*[!a-z]*) continue;; esac; int0 d
    CR="${CR}readynas_xraid_check_result{check=\"${k%:*}\",result=\"$x\"} 1$NL"; CT="${CT}readynas_xraid_check_timestamp_seconds{check=\"${k%:*}\"} $d$NL"
  done
  mf xraid_check_result gauge "Last mirror check (full: nas-raid verify, quick: quick-verify) and its result: ok, differences, errors, incomplete, confirm, accepted or running (always 1)." "$CR"
  mf xraid_check_timestamp_seconds gauge "End of the last mirror check (start while running), Unix time." "$CT"
}
write_metrics() {
  metrics_mode
  if [ "$M" = 0 ]; then rm -f "$C/metrics.prom"; return 0; fi
  if metrics > "$C/.metrics.tmp" 2>/dev/null; then mv -f "$C/.metrics.tmp" "$C/metrics.prom"; else rm -f "$C/.metrics.tmp"; fi
}
metrics_set() {
  on=; open=
  for kv in $(echo "$BODY" | tr '&' ' '); do case "${kv%%=*}" in on) on=${kv#*=};; open) open=${kv#*=};; esac; done
  case "$on:$open" in 0:|0:0|0:1) v=0;; 1:|1:0) v=1;; 1:1) v=2;; *) fail "400 Bad Request" "$(tx "Invalid setting" "Réglage invalide" "Ungültige Einstellung")";; esac
  metrics_mode; old=$M
  [ -f "$CONF" ] || : > "$CONF"
  setkey "$CONF" METRICS "$v"
  [ "$v" = 0 ] && rm -f "$C/metrics.prom"
  # the /metrics rule of lighttpd.conf (S50lighttpd metricsconf) is read at start
  [ "$v" = "$old" ] || bg "sleep 2; $INITD/S50lighttpd restart"
  note "Prometheus metrics: METRICS=$v"
  case $v in
    0) ok "$(tx "Metrics off" "Métriques désactivées" "Metriken aus")" ;;
    1) ok "$(tx "Metrics on /metrics, with an access token" "Métriques sur /metrics, avec un jeton d’accès" "Metriken unter /metrics, mit Zugriffstoken")" ;;
    2) ok "$(tx "Metrics on /metrics, without authentication (local network)" "Métriques sur /metrics, sans authentification (réseau local)" "Metriken unter /metrics, ohne Anmeldung (lokales Netz)")" ;;
  esac
}

# --- API access tokens (Settings, docs/API.md) -------------------------------------
# Created here (interface only), shown once, stored hashed in $TOKENS (tokauth).
tokens_get() {
  O=; set -f
  [ -r "$TOKENS" ] && while IFS=: read -r i n p _ _ c; do
    int0 c; jstr "$n"; O="$O${O:+,}{\"id\":\"$i\",\"name\":\"$J\",\"perm\":\"$p\",\"created\":$c}"
  done < "$TOKENS"
  set +f; printf '[%s]\n' "$O"
}
rnd() { head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c "$1"; }
token_add() {
  set -f; name=; perm=
  for kv in $(echo "$BODY" | tr '&' ' '); do case "${kv%%=*}" in name) name=$(urldec "${kv#*=}");; perm) perm=${kv#*=};; esac; done
  case "$name" in ''|*[!A-Za-z0-9\ ._-]*) fail "400 Bad Request" "$(tx "Invalid name: letters, digits, space, . - and _" "Nom invalide : lettres, chiffres, espace, . - et _" "Ungültiger Name: Buchstaben, Ziffern, Leerzeichen, . - und _")";; esac
  [ ${#name} -le 40 ] || fail "400 Bad Request" "$(tx "Name too long (40 characters max.)" "Nom trop long (40 caractères au plus)" "Name zu lang (höchstens 40 Zeichen)")"
  case "$perm" in ro|full) ;; *) fail "400 Bad Request" "$(tx "Invalid setting" "Réglage invalide" "Ungültige Einstellung")";; esac
  n=0; [ -r "$TOKENS" ] && while read -r _; do n=$((n + 1)); done < "$TOKENS"
  [ $n -lt 20 ] || fail "409 Conflict" "$(tx "20 tokens at most: revoke one first" "20 jetons au plus : en révoquer un d’abord" "Höchstens 20 Token: zuerst eines widerrufen")"
  id=$(rnd 8); salt=$(rnd 16); sec=$(rnd 32)
  [ ${#id} = 8 ] && [ ${#salt} = 16 ] && [ ${#sec} = 32 ] && ! grep -q "^$id:" "$TOKENS" 2>/dev/null \
    || fail "500 Internal Server Error" "$(tx "Cannot create the token, please retry" "Création du jeton impossible, réessayez" "Token kann nicht erstellt werden, bitte nochmal")"
  set -- $(printf '%s' "$salt$sec" | sha256sum)
  ( umask 077; { [ -r "$TOKENS" ] && cat "$TOKENS"; echo "$id:$name:$perm:$salt:$1:$(date +%s)"; } > "$TOKENS.tmp" ) && mv "$TOKENS.tmp" "$TOKENS" \
    || fail "500 Internal Server Error" "$(tx "Cannot write" "Écriture impossible" "Schreiben nicht möglich")"
  note "API token \"$name\" ($perm) created"
  jstr "$(tx "Token created: copy it now, it is not shown again" "Jeton créé : copiez-le maintenant, il ne sera plus affiché" "Token erstellt: jetzt kopieren, es wird nicht mehr angezeigt")"
  hdr application/json; printf '{"ok":true,"msg":"%s","id":"%s","token":"%s.%s"}\n' "$J" "$id" "$id" "$sec"
}
token_del() {
  id=; for kv in $(echo "$BODY" | tr '&' ' '); do [ "${kv%%=*}" = id ] && id=${kv#*=}; done
  case "$id" in ''|*[!A-Za-z0-9]*) fail "400 Bad Request" "$(tx "Invalid token" "Jeton invalide" "Ungültiges Token")";; esac
  name=; [ -r "$TOKENS" ] && while IFS=: read -r i n _; do [ "$i" = "$id" ] && name=$n; done < "$TOKENS"
  [ -n "$name" ] || fail "404 Not Found" "$(tx "Token not found" "Jeton introuvable" "Token nicht gefunden")"
  ( umask 077; while IFS= read -r l; do case $l in "$id":*) ;; *) printf '%s\n' "$l";; esac; done < "$TOKENS" > "$TOKENS.tmp" ) && mv "$TOKENS.tmp" "$TOKENS" \
    || fail "500 Internal Server Error" "$(tx "Cannot write" "Écriture impossible" "Schreiben nicht möglich")"
  note "API token \"$name\" revoked"
  ok "$(tx "Token revoked" "Jeton révoqué" "Token widerrufen")"
}

# --- Read answers and collector -------------------------------------------------
hist_json() { [ -r "$RUN/hwmon.hist" ] && awk '{ printf "%s\\n", $0 }' "$RUN/hwmon.hist"; }
calc() {	# calc key: JSON body of the GET answer (without header)
  case $1 in
    status) status ;; config) config_get ;; shares) shares_get ;; users) users_get ;;
    nfs) nfs_get ;; sys) sys_get ;; storage) storage_get ;; services) services_get ;;
    # page load in one request: status, storage, history
    all) printf '{"status":'; status; printf ',"storage":'; storage_get; printf ',"hist":"'; hist_json; printf '"}\n' ;;
  esac
}

# Collector (DIET_COLLECT=1, started by S95diet): recomputes the answers in $C,
# temporary file then mv. Pace: status every 15 s (the page reads it every 15 s, as a static file: /cache/) and the rest every 60 s while
# the interface is open (request seen less than 2 min ago, "seen" file written by
# the fast path); otherwise 60 s and 5 min. Immediate wake-up through a line in
# the "wake" FIFO: "seen" (interface reopened) or "all" (POST: settings changed)
# -> everything is recomputed. A POST also creates "invalid": a computation in
# progress, started before, is dropped instead of overwriting the emptied cache.
SLOW="storage services shares nfs sys users config"
write_cache() {	# write_cache key
  if calc "$1" > "$C/.$1.tmp" 2>/dev/null && [ -s "$C/.$1.tmp" ] && [ ! -e "$C/invalid" ]; then
    mv -f "$C/.$1.tmp" "$C/$1.json"
  else rm -f "$C/.$1.tmp"; fi
}
assemble() {	# all.json from the cache files (same content as calc all)
  { printf '{"status":'; cat "$C/status.json"; printf ',"storage":'; cat "$C/storage.json" 2>/dev/null || printf null
    printf ',"hist":"'; cat "$C/hist.frag" 2>/dev/null; printf '"}\n'; } > "$C/.all.tmp" && [ ! -e "$C/invalid" ] \
    && mv -f "$C/.all.tmp" "$C/all.json" || rm -f "$C/.all.tmp"
}
collect() {
  umask 022	# cache files served as static files by lighttpd, whoever started the collector
  mkdir -p "$C" || exit 1
  if read -r P 2>/dev/null < "$C/pid" && [ "$P" != $$ ] && kill -0 "$P" 2>/dev/null; then exit 0; fi	# already running
  [ -p "$C/wake" ] || { rm -f "$C/wake"; mkfifo -m 600 "$C/wake"; } || exit 1
  exec 3<> "$C/wake"
  echo $$ > "$C/pid"
  trap 'rm -f "$C"/*.json "$C"/.*.tmp "$C/metrics.prom" "$C/pid" "$C/active"; exit 0' TERM INT HUP
  _ct=1; _cl=0; _cs=0; _ca=
  while :; do
    read -r UP _ < "$R/proc/uptime"; _cn=${UP%.*}
    _cv=0; read -r _cv 2>/dev/null < "$C/seen"; int0 _cv
    if [ $((_cn - _cv)) -lt 120 ]; then
      [ -n "$_ca" ] || { : > "$C/active"; _ca=1; }
    elif [ -n "$_ca" ]; then rm -f "$C/active"; _ca=; fi
    if [ -n "$_ct" ] || [ "$_cn" -ge "$_cl" ]; then
      rm -f "$C/invalid"
      write_cache status; write_metrics
      hist_json > "$C/.hist.tmp" && mv -f "$C/.hist.tmp" "$C/hist.frag"
      for _ck in $SLOW; do write_cache "$_ck"; done
      [ -n "$_ca" ] && _cl=$((_cn + 60)) || _cl=$((_cn + 300))
      _cs=$_cn
    elif [ "$_cn" -ge "$_cs" ]; then
      write_cache status; write_metrics
    fi
    [ -r "$C/status.json" ] && assemble
    [ -n "$_ca" ] && _cs=$((_cn + 15)) || _cs=$((_cn + 60))
    _ct=; _cw=$((_cs < _cl ? _cs - _cn : _cl - _cn)); [ "$_cw" -ge 1 ] || _cw=1
    # wait without a process: FIFO read with a timeout (ash read -t)
    if read -t "$_cw" -r _cm <&3; then
      _ct=1; _cd=0; while [ $_cd -lt 50 ] && read -t 0.05 -r _cm <&3; do _cd=$((_cd + 1)); done
    fi
  done
}
# DIET_COLLECT=once: a single full round (tests on a PC, no FIFO, no wait)
if [ -n "${DIET_COLLECT:-}" ]; then
  if [ "$DIET_COLLECT" = once ]; then
    mkdir -p "$C"; rm -f "$C/invalid"; write_cache status; write_metrics; hist_json > "$C/hist.frag"
    for _ck in $SLOW; do write_cache "$_ck"; done; assemble; exit 0
  fi
  collect
fi
# POST: settings changed -> cache emptied, collector woken up (everything recomputed)
invalidate() {
  [ -d "$C" ] || return 0
  : > "$C/invalid"; rm -f "$C"/*.json
  [ -p "$C/wake" ] && echo all 1<> "$C/wake"
}
# DIET_REMOUNT=1: run after a background check (raid_verify, raid_quick)
if [ -n "${DIET_REMOUNT:-}" ]; then auto_rw; exit 0; fi

# POST body (form, < 4 KB) in $BODY
read_body() {
  BODY=""; CL=${CONTENT_LENGTH:-0}
  case "$CL" in *[!0-9]*) CL=0;; esac
  [ "$CL" -lt 4096 ] || fail "413 Request Entity Too Large" "$(tx "too much data" "trop de données" "zu viele Daten")"
  [ "$CL" -gt 0 ] && BODY=$(head -c "$CL")
  [ ${#BODY} -eq "$CL" ] || fail "500 Internal Server Error" "$(tx "Incomplete data received, please retry" "Données reçues incomplètes, réessayez" "Daten unvollständig angekommen, bitte nochmal")"
}

# /cgi-bin/setup: nothing else than the first setup is reachable through this name
[ -n "$SETUP" ] && { first_setup; exit 0; }

qp a; A=$QP
if [ "$REQUEST_METHOD" = "POST" ]; then
  # CSRF protection: a form from another site cannot set this header
  [ "$HTTP_X_DIET" = "1" ] || fail "403 Forbidden" "$(tx "Action only through the web interface" "Action réservée à l’interface" "Aktion nur über die Oberfläche")"
  # system update package: the body (streamed by lighttpd) goes straight to the USB stick
  if [ "$A" = update_upload ]; then
    if OUT=$(L=$L nas-update receive "${CONTENT_LENGTH:-}"); then note "Update: package uploaded"; invalidate; ok "$OUT"
    else fail "409 Conflict" "$OUT"; fi
    exit 0
  fi
  read_body
  case "$V1:$A" in 1:token_*) fail "403 Forbidden" "$(tx "Tokens are managed in the web interface only" "Les jetons se gèrent dans l’interface seulement" "Token werden nur in der Oberfläche verwaltet")";; esac
  case "$A" in
    smart_test) smart_test ;;
    spindown)
      for d in $(disks); do hdparm -y /dev/$d >/dev/null 2>&1; done; ok "$(tx "Disks spun down" "Disques en veille" "Platten schlafen")" ;;
    ksmbd)
      "$INITD/S70ksmbd" restart >/dev/null 2>&1; sleep 1
      pidof ksmbd.mountd >/dev/null && ok "$(tx "SMB restarted" "Partage SMB redémarré" "SMB neu gestartet")" || fail "500 Internal Server Error" "$(tx "ksmbd.mountd does not start" "ksmbd.mountd ne démarre pas" "ksmbd.mountd startet nicht")" ;;
    nfsd)
      svc_on NFS || fail "409 Conflict" "$(tx "NFS is stopped (Services card)" "NFS est arrêté (carte Services)" "NFS ist gestoppt (Karte Dienste)")"
      "$INITD/S60nfs" restart >/dev/null 2>&1; ok "$(tx "NFS restarted" "NFS redémarré" "NFS neu gestartet")" ;;
    ntp)
      bg "ntpd -q -n -p pool.ntp.org"; ok "$(tx "Time update requested" "Mise à l’heure demandée" "Zeitabgleich angestoßen")" ;;
    reboot)    guard; ok "$(tx "Restarting" "Redémarrage" "Neustart")"; bg "sleep 2; reboot" ;;
    poweroff)  guard; ok "$(tx "Powering off" "Extinction" "Ausschalten")"; bg ": > $RUN/poweroff; sleep 2; poweroff" ;;
    config)    config_set ;;
    share_add|share_del|share_set) shares_change "$A" ;;
    user_set|user_del) users_change "$A" ;;
    nfs_add|nfs_del) nfs_change "$A" ;;
    sys_set) sys_set ;;
    notify_test) notify_test ;;
    ssh_set) ssh_set ;;
    smb_enc) smb_enc ;;
    smb_sign) smb_sign ;;
    metrics_set) metrics_set ;;
    token_add) token_add ;;
    token_del) token_del ;;
    svc_set) svc_set ;;
    dlna_set) dlna_set ;;
    dlna_scan)
      svc_on MINIDLNA || fail "409 Conflict" "$(tx "MiniDLNA is stopped" "MiniDLNA est arrêté" "MiniDLNA ist gestoppt")"
      "$INITD/S60minidlnad" force-reload </dev/null >/dev/null 2>&1   # minidlnad -R
      note "MiniDLNA: full rescan"
      ok "$(tx "Full rescan started (slow on this processor)" "Réindexation complète lancée (longue sur ce processeur)" "Vollständige Neuindizierung gestartet (dauert auf diesem Prozessor)")" ;;
    rsync_pw) rsync_pw ;;
    rsync_c)
      on=""; for kv in $(echo "$BODY" | tr '&' ' '); do [ "${kv%%=*}" = on ] && on=${kv#*=}; done
      case "$on" in 0|1) ;; *) fail "400 Bad Request" "$(tx "Invalid setting" "Réglage invalide" "Ungültige Einstellung")";; esac
      [ -f "$CONF" ] || : > "$CONF"; setkey "$CONF" RSYNC_C "$on"
      accounts_update || :
      note "rsync: module c (administrator backup) = $on"
      ok "$(tx "Saved" "Enregistré" "Gespeichert")" ;;
    raid_verify)
      command -v nas-raid >/dev/null 2>&1 || fail "404 Not Found" "nas-raid ?"
      bg "nas-raid verify; DIET_REMOUNT=1 sh '$0'"; note "Storage: mirror check started"
      ok "$(tx "Check started (several hours, read-only)" "Vérification lancée (plusieurs heures, disques en lecture seule)" "Prüfung gestartet (mehrere Stunden, nur Lesen)")" ;;
    raid_quick)	# quick check (nas-raid quick-verify, docs/XRAID.md "Quick check")
      command -v nas-raid >/dev/null 2>&1 || fail "404 Not Found" "nas-raid ?"
      bg "nas-raid quick-verify; DIET_REMOUNT=1 sh '$0'"; note "Storage: quick mirror check started"
      ok "$(tx "Quick check started (1 to 3 minutes, read-only)" "Vérification rapide lancée (1 à 3 minutes, lecture seule)" "Schnellprüfung gestartet (1 bis 3 Minuten, nur Lesen)")" ;;
    raid_quick_accept)	# unclean superblock, no difference: typed word ACCEPT AND ticked box (yes=1)
      confirm=""; yes=""
      for kv in $(echo "$BODY" | tr '&' ' '); do case "${kv%%=*}" in confirm) confirm=$(urldec "${kv#*=}");; yes) yes=${kv#*=};; esac; done
      [ "$confirm" = ACCEPT ] || fail "400 Bad Request" "$(tx "confirmation word missing or wrong (ACCEPT)" "mot de confirmation manquant ou faux (ACCEPT)" "Bestätigungswort fehlt oder falsch (ACCEPT)")"
      [ "$yes" = 1 ] || fail "400 Bad Request" "$(tx "second confirmation missing" "seconde confirmation manquante" "zweite Bestätigung fehlt")"
      command -v nas-raid >/dev/null 2>&1 || fail "404 Not Found" "nas-raid ?"
      if OUTR=$(nas-raid quick-accept --confirm ACCEPT --yes 2>&1); then
        note "Storage: quick check accepted (residual risk)"
        if auto_rw; then ok "$(tx "Quick check accepted: /c remounted read-write" "Vérification rapide acceptée : /c remonté en écriture" "Schnellprüfung akzeptiert: /c schreibbar neu eingehängt")"
        elif grep -qx 'XRAID_RW=yes' "$NRCONF" 2>/dev/null; then
          m=; r=; read -r m r 2>/dev/null < "$RUN/nas-raid.mode"
          ok "$(tx "Quick check accepted, but /c stays read-only" "Vérification rapide acceptée, mais /c reste en lecture seule" "Schnellprüfung akzeptiert, aber /c bleibt schreibgeschützt") ($m${r:+ : $r})"
        else ok "$(tx "Quick check accepted (writing is off: /c stays read-only)" "Vérification rapide acceptée (écriture désactivée : /c reste en lecture seule)" "Schnellprüfung akzeptiert (Schreiben aus: /c bleibt schreibgeschützt)")"; fi
      else
        fail "409 Conflict" "$(tx "Refused" "Refusé" "Abgelehnt") : $(printf '%s' "$OUTR" | grep 'ERROR' | tail -n 1 | cut -c1-200)"
      fi ;;
    raid_plan|raid_run)	# md wizards (migrate, create...): disabled for now, docs/XRAID-MIGRATION.md
      fail "409 Conflict" "$(tx "md support is disabled for now: X-RAID only" "md désactivé pour l’instant : X-RAID seulement" "md vorerst deaktiviert: nur X-RAID")" ;;
    xraid_rw) xraid_rw ;;
    flexraid_rw) flexraid_rw ;;
    update_url|update_switch|update_cancel)	# system update (nas-update, docs/DIET.md)
      [ "$A" = update_switch ] && guard
      url=""; sha=""
      for kv in $(echo "$BODY" | tr '&' ' '); do case "${kv%%=*}" in url) url=$(urldec "${kv#*=}");; sha) sha=$(urldec "${kv#*=}");; esac; done
      case "$A" in update_url) set -- fetch "$url" "$sha";; update_switch) set -- switch;; *) set -- cancel;; esac
      if OUT=$(L=$L nas-update "$@"); then note "Update: $1"; ok "$OUT"; else fail "409 Conflict" "$OUT"; fi ;;
    *) fail "400 Bad Request" "$(tx "unknown action" "action inconnue" "unbekannte Aktion")" ;;
  esac
  invalidate
  exit 0
fi

# read without cache (collector stopped, or cache emptied by a POST): direct computation
case "$A" in
  ""|status|all|config|shares|users|nfs|sys|storage|services) hdr application/json; calc "${A:-status}" ;;
  hist) hdr 'text/plain; charset=utf-8'; cat "$RUN/hwmon.hist" 2>/dev/null ;;
  update) hdr application/json; L=$L nas-update status ;;
  tokens)
    [ -z "$V1" ] || fail "403 Forbidden" "$(tx "Tokens are managed in the web interface only" "Les jetons se gèrent dans l’interface seulement" "Token werden nur in der Oberfläche verwaltet")"
    hdr application/json; tokens_get ;;
  metrics)	# no collector file: computed now
    hdr 'text/plain; version=0.0.4; charset=utf-8'; status > /dev/null; metrics ;;
  log)
    hdr 'text/plain; charset=utf-8'
    qp f; case $QP in
      diet)     tail -n 300 "$LOG" 2>/dev/null ;;
      messages) tail -n 300 "$R/var/log/messages" 2>/dev/null ;;
      dmesg)    dmesg | tail -n 300 ;;
      storage) tail -n 300 "$R/var/lib/nas-raid/log" 2>/dev/null ;;
      update) tail -n 300 "$R/var/lib/nas-update/log" 2>/dev/null ;;
      *) tx "unknown log" "journal inconnu" "unbekanntes Protokoll"; echo ;;
    esac ;;
  smart)
    qp d; d=$QP
    disks | grep -qx "$d" || fail "400 Bad Request" "$(tx "unknown disk" "disque inconnu" "unbekannte Platte")"
    hdr 'text/plain; charset=utf-8'
    if [ -x "$R/usr/sbin/smartctl" ]; then "$R/usr/sbin/smartctl" -H -i -A /dev/$d 2>&1
    elif [ -x "$R/usr/sbin/smart-lite" ]; then "$R/usr/sbin/smart-lite" -f /dev/$d 2>&1
    else
      # no SMART tool: model, drivetemp temperature and kernel messages
      echo "$(tx "no SMART tool on this system; available information:" "aucun outil SMART sur ce système ; informations disponibles :" "kein SMART-Werkzeug auf diesem System; verfügbare Angaben:")"
      echo "  /dev/$d : $(cat "$R/sys/block/$d/device/model" 2>/dev/null), $(($(cat "$R/sys/block/$d/size" 2>/dev/null || echo 0) / 1953125)) GB, $(dtemp "$d"; echo "${DT:-?}") °C (drivetemp)"
      echo; dmesg | grep -w "$d" | tail -n 50
    fi ;;
  md)
    qp d; d=$QP
    mds | grep -qx "$d" || fail "400 Bad Request" "$(tx "unknown RAID volume" "volume RAID inconnu" "unbekanntes RAID-Volume")"
    hdr 'text/plain; charset=utf-8'
    mdadm --detail /dev/$d 2>&1 ;;
  *) fail "400 Bad Request" "$(tx "unknown" "inconnu" "unbekannt")" ;;
esac
