#!/bin/sh
# Assistant d'événements du noyau (/sbin/hotplug, CONFIG_UEVENT_HELPER) :
# padre_hwmon appelle « powerdown » (bouton maintenu 3 s) et « powersave »
# (appui court, sans effet : le Duo n'a pas d'écran). Tous les autres uevents
# passent aussi ici : sortir tout de suite.
case "$1" in
powerdown)
	echo "[$(date '+%F %T')] bouton d'alimentation : extinction" >> /var/log/diet.log
	: > /var/run/poweroff
	exec poweroff ;;
esac
exit 0
