#!/bin/sh
# Kernel event helper (/sbin/hotplug, CONFIG_UEVENT_HELPER): padre_hwmon calls
# "powerdown" (button held 3 s) and "powersave" (short press, ignored: the Duo
# has no display). Every other uevent comes here too: exit right away.
case "$1" in
powerdown)
	echo "[$(date '+%F %T')] power button: shutting down" >> /var/log/diet.log
	: > /var/run/poweroff
	exec poweroff ;;
esac
exit 0
