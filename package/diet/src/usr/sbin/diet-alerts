#!/bin/sh
# Prints the current problems on one line (md RAID, SMART, disk heat);
# nothing if all is well. Called every minute by diet-hwmon.
R=${DIET_ROOT:-}
[ -r $R/etc/diet-lang.sh ] && . $R/etc/diet-lang.sh || tx() { printf "%s" "$1"; }
RUN=$R/var/run
A=""
add() { A="${A:+$A ; }$1"; }
# md: a "_" in [UU] = missing member; (F) = failed member
x=$(awk '/^md[0-9]+ :/ { n = $1 } /\[[U_]*_[U_]*\]/ { printf "%s ", n }' $R/proc/mdstat 2>/dev/null)
[ -n "$x" ] && add "$(tx "RAID degraded (${x% })" "RAID dégradé (${x% })" "RAID beeinträchtigt (${x% })")"
x=$(awk '/^md[0-9]+ :/ { for (i = 5; i <= NF; i++) if ($i ~ /\(F\)/) { d = $i; sub(/\[.*/, "", d); printf "%s ", d } }' $R/proc/mdstat 2>/dev/null)
[ -n "$x" ] && add "$(tx "failed disk in the RAID (${x% })" "disque en panne dans le RAID (${x% })" "Platte im RAID ausgefallen (${x% })")"
# disks above DISK_HIGH (drivetemp)
DISK_HIGH=50; [ -r $R/etc/fan.conf ] && . $R/etc/fan.conf
for f in $R/sys/block/sd*/device/hwmon/hwmon*/temp1_input; do
	[ -r "$f" ] || continue
	t=$(($(cat "$f") / 1000)); d=${f#$R/sys/block/}; d=${d%%/*}
	[ $t -ge "$DISK_HIGH" ] && add "$(tx "$d at ${t} °C" "$d à ${t} °C" "$d bei ${t} °C")"
done
for f in $RUN/smart.*; do
	[ -r "$f" ] || continue
	health=""; realloc=0; pending=0; uncorr=0; . "$f"
	p=""
	[ -n "$health" ] && [ "$health" != PASSED ] && p="SMART $health"
	[ "$realloc" -gt 0 ] && p="${p:+$p, }$(tx "$realloc reallocated sectors" "$realloc secteurs réalloués" "$realloc Sektoren umgelagert")"
	[ "$pending" -gt 0 ] && p="${p:+$p, }$(tx "$pending pending sectors" "$pending secteurs en attente" "$pending Sektoren ausstehend")"
	[ "$uncorr" -gt 0 ] && p="${p:+$p, }$(tx "$uncorr unreadable sectors" "$uncorr secteurs illisibles" "$uncorr Sektoren unlesbar")"
	[ -n "$p" ] && add "${f##*.} : $p"
done
echo "$A"
