#!/bin/sh
# DIET monitoring (one sample per minute): temperature/fan history for the web
# interface, SMART summary (if smartctl exists), Telegram alerts on state
# change. Fan control and the emergency shutdown stay with padre-fan
# (/etc/fan.conf), whose /var/run/fan.state is read here.
# DIET_ROOT and DIET_ONCE=1 are only for tests on a PC.
R=${DIET_ROOT:-}
[ -r $R/etc/diet-lang.sh ] && . $R/etc/diet-lang.sh || tx() { printf "%s" "$1"; }
RUN=$R/var/run
LOG=$R/var/log/diet.log
log() { echo "[$(date '+%F %T')] hwmon: $*" >> $LOG; }
N=0
while true; do
	temp=0; fan=; pwm=
	for kv in $(cat $RUN/fan.state 2>/dev/null); do
		v=${kv#*=}; case "$v" in ''|*[!0-9]*) continue;; esac
		case "${kv%%=*}" in temp) temp=$v;; fan) fan=$v;; pwm) pwm=$v;; esac
	done
	# SMART every 5 minutes, without waking up a sleeping disk
	if [ $((N % 5)) -eq 0 ] && [ -x $R/usr/sbin/smartctl ]; then
		for b in $R/sys/block/sd*; do
			d=${b##*/}; [ -d "$b" ] || continue
			out=$($R/usr/sbin/smartctl -n standby -H -A /dev/$d 2>/dev/null)
			echo "$out" | grep -q STANDBY && continue
			sh=$(echo "$out" | sed -n 's/.*self-assessment test result: //p' | tr -cd 'A-Za-z')
			echo "$out" | awk -v h="$sh" '$1==5{r=$10} $1==9{p=$10} $1==197{c=$10} $1==198{u=$10}
				END{printf "health=%s realloc=%d pending=%d uncorr=%d hours=%d\n", h, r, c, u, p}' > $RUN/smart.$d
		done
	fi
	# history: time, temperature (- = unknown), rpm, setpoint; about 12 h
	echo "$(date +%s) $([ "$temp" -gt 0 ] && echo $temp || echo -) ${fan:-0} ${pwm:-0}" >> $RUN/hwmon.hist
	[ $((N % 60)) -eq 59 ] && tail -n 720 $RUN/hwmon.hist > $RUN/hwmon.hist.tmp && mv $RUN/hwmon.hist.tmp $RUN/hwmon.hist
	# alerts: notification only when the line changes
	AL=$(diet-alerts 2>/dev/null)
	[ -n "$fan" ] && [ "${pwm:-0}" -gt 0 ] && [ "$fan" -lt 300 ] && AL="${AL:+$AL ; }$(tx "fan at ${fan} rpm" "ventilateur à ${fan} tr/min" "Lüfter bei ${fan} U/min")"
	if [ "$AL" != "$(cat $RUN/alert.last 2>/dev/null)" ]; then
		echo "$AL" > $RUN/alert.last
		if [ -n "$AL" ]; then M="$(tx "ALERT: $AL" "ALERTE : $AL" "ALARM: $AL")"; else M="$(tx "Back to normal" "Retour à la normale" "Wieder normal")"; fi
		log "$M"; diet-notify "$M" >/dev/null 2>&1 &
	fi
	[ -n "$DIET_ONCE" ] && break
	N=$((N + 1)); sleep 60
done
