config BR2_PACKAGE_DIET
	bool "diet (ReadyNAS Duo v1 web dashboard)"
	depends on BR2_USE_MMU # lighttpd
	depends on !BR2_STATIC_LIBS # lighttpd
	depends on BR2_PACKAGE_KSMBD_TOOLS
	depends on BR2_PACKAGE_NFS_UTILS
	select BR2_PACKAGE_LIGHTTPD
	select BR2_PACKAGE_LIGHTTPD_MBEDTLS
	select BR2_PACKAGE_MBEDTLS_PROGRAMS # gen_key, cert_write
	select BR2_PACKAGE_MDADM
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_CURL
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  DIET dashboard ported to Linux 6.18: /www page and CGI API
	  (busybox shell and awk) served by lighttpd over HTTPS
	  (self-signed certificate created at first boot), ksmbd
	  shares, NFS exports, users, disks (libata, drivetemp),
	  md RAID (/proc/mdstat, mdadm), padre-fan display and
	  settings, Telegram notifications, network, language,
	  time (ntpd), shutdown.
	  Enables in busybox: ntpd. HTTPS downloads (Telegram, system
	  updates) go through curl, which checks the certificates.
	  See docs/DIET.md.

comment "diet needs ksmbd-tools, nfs-utils and shared libraries"
	depends on !BR2_PACKAGE_KSMBD_TOOLS || !BR2_PACKAGE_NFS_UTILS || BR2_STATIC_LIBS
