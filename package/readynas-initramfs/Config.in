config BR2_PACKAGE_READYNAS_INITRAMFS
	bool "readynas-initramfs"
	depends on BR2_LINUX_KERNEL
	help
	  Minimal initramfs built into the ReadyNAS Duo v1 kernel:
	  static busybox WITHOUT floating point (the Padre has no FPU)
	  and small tests (windows, load, float). The binaries go to
	  $(BINARIES_DIR)/readynas-initramfs, not to the target.
