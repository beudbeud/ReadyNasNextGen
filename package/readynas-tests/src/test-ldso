#!/bin/sh
# test-ldso [N]: runs N times (default 200) dynamic PIE programs
# (busybox sh/sed/ls/awk with floating point, mdadm, e2fsck), then counts the
# new "segfault ... ld-uClibc" lines in the kernel log. Success: 0 failures,
# 0 segfaults.
n=${1:-200}
before=$(dmesg | grep -c 'segfault.*ld-uClibc')
i=0
failures=0
while [ "$i" -lt "$n" ]; do
	/bin/sh -c 'echo a | /bin/sed s/a/b/ | /bin/grep -q b' || failures=$((failures + 1))
	/bin/ls / > /dev/null || failures=$((failures + 1))
	/sbin/mdadm --version > /dev/null 2>&1 || failures=$((failures + 1))
	/sbin/e2fsck -V > /dev/null 2>&1 || failures=$((failures + 1))
	# floating point in a dynamic program (regression of test r)
	[ "$(awk 'BEGIN{printf "%s %.2f", 1+1, 3/2}')" = "2 1.50" ] || failures=$((failures + 1))
	i=$((i + 1))
done
after=$(dmesg | grep -c 'segfault.*ld-uClibc')
echo "test-ldso: $n rounds, $failures failures, $((after - before)) ld-uClibc segfaults"
[ "$failures" = 0 ] && [ "$after" = "$before" ]
