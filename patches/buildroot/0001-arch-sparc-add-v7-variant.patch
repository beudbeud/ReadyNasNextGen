diff --git a/arch/Config.in.sparc b/arch/Config.in.sparc
index f5f4bd67..c57324a0 100644
--- a/arch/Config.in.sparc
+++ b/arch/Config.in.sparc
@@ -6,6 +6,14 @@ choice
 	help
 	  Specific CPU variant to use
 
+config BR2_sparc_v7
+	bool "v7"
+	depends on BR2_sparc
+	help
+	  SPARC V7: no hardware multiply/divide instructions (smul,
+	  umul, sdiv, udiv). Use this for CPUs whose divide unit is
+	  missing or broken, e.g. the Infrant IT3107 "Padre" of the
+	  NETGEAR ReadyNAS NV+/Duo v1, where sdiv gives wrong results.
 config BR2_sparc_v8
 	bool "v8"
 	depends on BR2_sparc
@@ -30,6 +38,7 @@ config BR2_ENDIAN
 
 config BR2_GCC_TARGET_CPU
 	default "leon3"		if BR2_sparc_leon3
+	default "v7"		if BR2_sparc_v7
 	default "v8"		if BR2_sparc_v8
 	default "ultrasparc"	if BR2_sparc_v9
 
diff --git a/package/gcc/gcc.mk b/package/gcc/gcc.mk
index c183bf88..c4e4d936 100644
--- a/package/gcc/gcc.mk
+++ b/package/gcc/gcc.mk
@@ -121,7 +121,7 @@ HOST_GCC_COMMON_CONF_ENV += LDFLAGS_FOR_TARGET="$(GCC_COMMON_TARGET_LDFLAGS)"
 HOST_GCC_COMMON_CONF_ENV += AR_FOR_TARGET=gcc-ar NM_FOR_TARGET=gcc-nm RANLIB_FOR_TARGET=gcc-ranlib
 
 # libitm needs sparc V9+
-ifeq ($(BR2_sparc_v8)$(BR2_sparc_leon3),y)
+ifeq ($(BR2_sparc_v7)$(BR2_sparc_v8)$(BR2_sparc_leon3),y)
 HOST_GCC_COMMON_CONF_OPTS += --disable-libitm
 endif
 
